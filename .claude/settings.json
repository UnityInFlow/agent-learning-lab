{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/opencode-review.sh",
            "if": "Bash(git push:*)",
            "async": true,
            "timeout": 900,
            "statusMessage": "opencode critic reviewing changed contracts"
          },
          {
            "type": "command",
            "command": ".claude/hooks/opencode-review.sh",
            "if": "Bash(gh pr create:*)",
            "async": true,
            "timeout": 900,
            "statusMessage": "opencode critic reviewing changed contracts"
          }
        ]
      }
    ]
  }
}
