ct(status().isOk)","+            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))","+    }","+","+    @Test","+    fun `returns 409 if order has a confirmed shipment`() {","+        mockMvc.perform(createOrder(\"O-7\")).andExpect(status().isCreated)","+","+        // Create a shipment and confirm it (by directly writing to the repository)","+        val shipment = Shipment(\"S-2\", \"O-7\", \"DHL\", ShipmentStatus.CONFIRMED)","+        shipmentRepository.save(shipment)","+","+        // Try to cancel the order - should fail with 409","+        mockMvc.perform(post(\"/orders/O-7/cancel\"))","+            .andExpect(status().isConflict)","+            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_HAS_CONFIRMED_SHIPMENT\"))","+            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)","+","+        // Verify the order is still ACTIVE","+        mockMvc.perform(get(\"/orders/O-7\"))","+            .andExpect(status().isOk)","+            .andExpect(jsonPath(\"$.status\").value(\"ACTIVE\"))","+    }","+","+    @Test","+    fun `returns 404 when cancelling a non-existent order`() {","+        mockMvc.perform(post(\"/orders/does-not-exist/cancel\"))","+            .andExpect(status().isNotFound)","+            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_NOT_FOUND\"))","+            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)","+    }"," }"]}],"userModified":false,"replaceAll":false}}
