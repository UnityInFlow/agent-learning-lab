{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017ZVc4dXNpuFWWHyyBcKS4Q","type":"tool_result","content":"1\tpackage com.unityinflow.sample.order\n2\t\n3\timport com.unityinflow.sample.api.ConflictException\n4\timport com.unityinflow.sample.api.ErrorCode\n5\timport com.unityinflow.sample.api.ResourceNotFoundException\n6\timport org.springframework.http.HttpStatus\n7\timport org.springframework.http.ResponseEntity\n8\timport org.springframework.web.bind.annotation.GetMapping\n9\timport org.springframework.web.bind.annotation.PathVariable\n10\timport org.springframework.web.bind.annotation.PostMapping\n11\timport org.springframework.web.bind.annotation.RequestBody\n12\timport org.springframework.web.bind.annotation.RequestMapping\n13\timport org.springframework.web.bind.annotation.RestController\n14\t\n15\t@RestController\n16\t@RequestMapping(\"/orders\")\n17\tclass OrderController(\n18\t    private val repository: InMemoryOrderRepository,\n19\t) {\n20\t\n21\t    @PostMapping\n22\t    fun create(@RequestBody request: CreateOrderRequest): ResponseEntity<Order> {\n23\t        if (repository.existsById(request.orderId)) {\n24\t            throw ConflictException(\n25\t                ErrorCode.ORDER_ALREADY_EXISTS,\n26\t                \"An order with id '${request.orderId}' already exists\",\n27\t            )\n28\t        }\n29\t\n30\t        val saved = repository.save(\n31\t            Order(request.orderId, request.customerId, request.amount, request.currency),\n32\t        )\n33\t        return ResponseEntity.status(HttpStatus.CREATED).body(saved)\n34\t    }\n35\t\n36\t    @GetMapping(\"/{orderId}\")\n37\t    fun getById(@PathVariable orderId: String): Order =\n38\t        repository.findById(orderId)\n39\t            ?: throw ResourceNotFoundException(\n40\t                ErrorCode.ORDER_NOT_FOUND,\n41\t                \"No order with id '$orderId'\",\n42\t            )\n43\t\n44\t    @GetMapping\n45\t    fun list(): List<Order> = reposit