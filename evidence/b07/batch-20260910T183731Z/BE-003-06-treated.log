(post(\"/shipments/S-2/confirm\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n\n        // Second confirm should also succeed\n        mockMvc.perform(post(\"/shipments/S-2/confirm\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n    }\n\n    @Test\n    fun `confirm rejects a cancelled shipment with 409`() {\n        mockMvc.perform(createShipment(\"S-3\")).andExpect(status().isCreated)\n\n        // Manually set shipment to CANCELLED state (simulating a cancelled shipment)\n        val shipment = repository.findById(\"S-3\")!!\n        repository.save(shipment.copy(status = ShipmentStatus.CANCELLED))\n\n        mockMvc.perform(post(\"/shipments/S-3/confirm\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_INVALID_STATE\"))\n    }\n\n    @Test\n    fun `confirm rejects unknown shipment with 404`() {\n        mockMvc.perform(post(\"/shipments/S-missing/confirm\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n    }\n}"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":673,"cache_read_input_tokens":18634,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":673},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"4933461b-8637-4fa4-a387-38e1aa5e566d","uuid":"ccb29f72-5256-4235-9c43-c5c8207ad2fc","timestamp":"2026-09-10T19:02:37.319Z","request_id":"req_011CevH1ueXS4N1Qne9ENC9W"}
