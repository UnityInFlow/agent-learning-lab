tatus().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_ALREADY_EXISTS\"))\n            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n    }\n}\n","structuredPatch":[{"oldStart":1,"oldLines":5,"newStart":1,"newLines":9,"lines":[" package com.unityinflow.sample.order"," ","+import com.unityinflow.sample.shipment.CreateShipmentRequest","+import com.unityinflow.sample.shipment.InMemoryShipmentRepository","+import com.unityinflow.sample.shipment.Shipment","+import com.unityinflow.sample.shipment.ShipmentStatus"," import org.junit.jupiter.api.BeforeEach"," import org.junit.jupiter.api.Test"," import org.springframework.beans.factory.annotation.Autowired"]},{"oldStart":29,"oldLines":8,"newStart":33,"newLines":14,"lines":["     @Autowired","     lateinit var repository: InMemoryOrderRepository"," ","+    @Autowired","+    lateinit var shipmentRepository: InMemoryShipmentRepository","+","     @BeforeEach","-    fun reset() = repository.clear()","+    fun reset() {","+        repository.clear()","+        shipmentRepository.clear()","+    }"," ","     private fun createOrder(orderId: String, amount: String = \"49.90\") =","         post(\"/orders\")"]},{"oldStart":39,"oldLines":6,"newStart":49,"newLines":17,"lines":["                 \"\"\"{\"orderId\":\"$orderId\",\"customerId\":\"C-1\",\"amount\":$amount,\"currency\":\"EUR\"}\"\"\",","             )"," ","+    private fun cancelOrder(orderId: String) =","+        post(\"/orders/$orderId/cancel\")","+            .contentType(MediaType.APPLICATION_JSON)","+","+    private fun createShipment(shipmentId: String, orderId: String) =","+        post(\"/shipments\")","+            .contentType(MediaType.APPLICATION_JSON)","+            .content(","+                \"\"\"{\"shipmentId\":\"$shipmentId\",\"orderId\":\"$orderId\",\"carrier\":\"DHL\"}\"\"\",","+            )","+","     @Test","     fun `creates an order and returns 201`() {","         mockMvc.perform(createOrder(\"O-1\"))"]},{"oldSta