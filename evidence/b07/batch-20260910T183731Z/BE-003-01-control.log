n list(): List<Shipment> = repository.findAll()\n}\n","structuredPatch":[{"oldStart":53,"oldLines":4,"newStart":53,"newLines":30,"lines":[" ","     @GetMapping","     fun list(): List<Shipment> = repository.findAll()","+","+    @PostMapping(\"/{shipmentId}/confirm\")","+    fun confirm(@PathVariable shipmentId: String): ResponseEntity<Shipment> {","+        val shipment = repository.findById(shipmentId)","+            ?: throw ResourceNotFoundException(","+                ErrorCode.SHIPMENT_NOT_FOUND,","+                \"No shipment with id '$shipmentId'\",","+            )","+","+        if (shipment.status == ShipmentStatus.CANCELLED) {","+            throw ConflictException(","+                ErrorCode.SHIPMENT_INVALID_STATE,","+                \"Cannot confirm a shipment in CANCELLED status\",","+            )","+        }","+","+        // If already CONFIRMED, return as-is (idempotent)","+        if (shipment.status == ShipmentStatus.CONFIRMED) {","+            return ResponseEntity.ok(shipment)","+        }","+","+        // Transition from CREATED to CONFIRMED","+        val confirmed = shipment.copy(status = ShipmentStatus.CONFIRMED)","+        val saved = repository.save(confirmed)","+        return ResponseEntity.ok(saved)","+    }"," }"]}],"userModified":false,"replaceAll":false}}
