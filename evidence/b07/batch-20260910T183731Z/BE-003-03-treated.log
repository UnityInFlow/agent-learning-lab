tus().isCreated)\n46\t            .andExpect(jsonPath(\"$.shipmentId\").value(\"S-1\"))\n47\t            .andExpect(jsonPath(\"$.status\").value(\"CREATED\"))\n48\t    }\n49\t\n50\t    @Test\n51\t    fun `rejects a duplicate shipment id with the error envelope`() {\n52\t        mockMvc.perform(createShipment(\"S-2\")).andExpect(status().isCreated)\n53\t\n54\t        mockMvc.perform(createShipment(\"S-2\"))\n55\t            .andExpect(status().isConflict)\n56\t            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_ALREADY_EXISTS\"))\n57\t    }\n58\t\n59\t    @Test\n60\t    fun `returns a shipment by id`() {\n61\t        mockMvc.perform(createShipment(\"S-3\")).andExpect(status().isCreated)\n62\t\n63\t        mockMvc.perform(get(\"/shipments/S-3\"))\n64\t            .andExpect(status().isOk)\n65\t            .andExpect(jsonPath(\"$.carrier\").value(\"DHL\"))\n66\t    }\n67\t\n68\t    @Test\n69\t    fun `reports an unknown shipment through the error envelope`() {\n70\t        mockMvc.perform(get(\"/shipments/S-missing\"))\n71\t            .andExpect(status().isNotFound)\n72\t            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n73\t    }\n74\t\n75\t    @Test\n76\t    fun `lists shipments in id order`() {\n77\t        mockMvc.perform(createShipment(\"S-b\")).andExpect(status().isCreated)\n78\t        mockMvc.perform(createShipment(\"S-a\")).andExpect(status().isCreated)\n79\t\n80\t        mockMvc.perform(get(\"/shipments\"))\n81\t            .andExpect(status().isOk)\n82\t            .andExpect(jsonPath(\"$[0].shipmentId\").value(\"S-a\"))\n83\t            .andExpect(jsonPath(\"$[1].shipmentId\").value(\"S-b\"))\n84\t    }\n85\t\n86\t    @Nested\n87\t    inner class Confirm {\n88\t\n89\t        @Test\n90\t        fun `confirms a created shipment and transitions to CONFIRMED`() {\n91\t            mockMvc.perform(createShipment(\"S-4\")).andExpect(status().isCreated)\n92\t\n93\t            mockMvc.perform(post(\"/shipments/S-4/confirm\"))\n94\t                .andExpect(status().isOk)\n95\t                .andExpect(jsonPath(\"$.shipmentId\").value(\"S-4\"))\n96\t                .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n97\t\n98\t            // Verify it persisted\n99\t            mockMvc.perform(get(\"/shipments/S-4\"))\n100\t                .andExpect(status().isOk)\n101\t                .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n102\t        }\n103\t\n104\t        @Test\n105\t        fun `confirming an already-confirmed shipment succeeds and changes nothing`() {\n106\t            mockMvc.perform(createShipment(\"S-5\")).andExpect(status().isCreated)\n107\t            mockMvc.perform(post(\"/shipments/S-5/confirm\")).andExpect(status().isOk)\n108\t\n109\t            // Confirm again\n110\t            mockMvc.perform(post(\"/shipments/S-5/confirm\"))\n111\t                .andExpect(status().isOk)\n112\t                .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n113\t        }\n114\t\n115\t        @Test\n116\t        fun `confirming a cancelled shipment returns 409 with error envelope`() {\n117\t            // Create and manually set to CANCELLED state in repository\n118\t            val shipment = Shipment(\n119\t                shipmentId = \"S-6\",\n120\t                orderId = \"O-1\",\n121\t                carrier = \"DHL\",\n122\t                status = ShipmentStatus.CANCELLED,\n123\t            )\n124\t            repository.save(shipment)\n125\t\n126\t            mockMvc.perform(post(\"/shipments/S-6/confirm\"))\n127\t                .andExpect(status().isConflict)\n128\t                .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_INVALID_STATE\"))\n129\t                .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n130\t        }\n131\t\n132\t        @Test\n133\t        fun `confirming a non-existent shipment returns 404 with error envelope`() {\n134\t            mockMvc.perform(post(\"/shipments/S-missing/confirm\"))\n135\t                .andExpect(status().isNotFound)\n136\t                .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n137\t                .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n138\t        }\n139\t    }\n140\t}\n141\t"}]},"parent_tool_use_id":null,"session_id":"682b858e-36a5-4eaa-b0b4-60f7b8e50fee","uuid":"ae6dc0f3-57ee-4e70-b041-bae1ee4a0f33","timestamp":"2026-09-10T18:48:47.806Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/jr/lwzz65cx5pndqqdgzhnym1pc0000gn/T/observatory-run-66aede74-98cf-482f-be94-545c119aef3b/sample-service/src/test/kotlin/com/unityinflow/sample/shipment/ShipmentControllerTest.kt","content":"package com.unityinflow.sample.shipment\n\nimport org.junit.jupiter.api.BeforeEach\nimport org.junit.jupiter.api.Test\nimport org.springframework.beans.factory.annotation.Autowired\nimport org.springframework.boot.test.context.SpringBootTest\nimport org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc\nimport org.springframework.http.MediaType\nimport org.springframework.test.web.servlet.MockMvc\nimport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get\nimport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post\nimport org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath\nimport org.springframework.test.web.servlet.result.MockMvcResultMatchers.status\nimport org.junit.jupiter.api.Nested\n\n/**\n * The shipment feature as it exists before BE-003.\n *\n * These are \"the existing tests\" for that benchmark: they must keep passing, and an agent\n * that breaks one has regressed the fixture rather than solved the task.\n */\n@SpringBootTest\n@AutoConfigureMockMvc\nclass ShipmentControllerTest {\n\n    @Autowired\n    lateinit var mockMvc: MockMvc\n\n    @Autowired\n    lateinit var repository: InMemoryShipmentRepository\n\n    @BeforeEach\n    fun reset() = repository.clear()\n\n    private fun createShipment(shipmentId: String) =\n        post(\"/shipments\")\n            .contentType(MediaType.APPLICATION_JSON)\n            .content(\n                \"\"\"{\"shipmentId\":\"$shipmentId\",\"orderId\":\"O-1\",\"carrier\":\"DHL\"}\"\"\",\n            )\n\n    @Test\n    fun `creates a shipment in CREATED status`() {\n        mockMvc.perform(createShipment(\"S-1\"))\n            .andExpect(status().isCreated)\n            .andExpect(jsonPath(\"$.shipmentId\").value(\"S-1\"))\n            .andExpect(jsonPath(\"$.status\").value(\"CREATED\"))\n    }\n\n    @Test\n    fun `rejects a duplicate shipment id with the error envelope`() {\n        mockMvc.perform(createShipment(\"S-2\")).andExpect(status().isCreated)\n\n        mockMvc.perform(createShipment(\"S-2\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_ALREADY_EXISTS\"))\n    }\n\n    @Test\n    fun `returns a shipment by id`() {\n        mockMvc.perform(createShipment(\"S-3\")).andExpect(status().isCreated)\n\n        mockMvc.perform(get(\"/shipments/S-3\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.carrier\").value(\"DHL\"))\n    }\n\n    @Test\n    fun `reports an unknown shipment through the error envelope`() {\n        mockMvc.perform(get(\"/shipments/S-missing\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n    }\n\n    @Test\n    fun `lists shipments in id order`() {\n        mockMvc.perform(createShipment(\"S-b\")).andExpect(status().isCreated)\n        mockMvc.perform(createShipment(\"S-a\")).andExpect(status().isCreated)\n\n        mockMvc.perform(get(\"/shipments\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$[0].shipmentId\").value(\"S-a\"))\n            .andExpect(jsonPath(\"$[1].shipmentId\").value(\"S-b\"))\n    }\n\n    @Nested\n    inner class Confirm {\n\n        @Test\n        fun `confirms a created shipment and transitions to CONFIRMED`() {\n            mockMvc.perform(createShipment(\"S-4\")).andExpect(status().isCreated)\n\n            mockMvc.perform(post(\"/shipments/S-4/confirm\"))\n                .andExpect(status().isOk)\n                .andExpect(jsonPath(\"$.shipmentId\").value(\"S-4\"))\n                .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n\n            // Verify it persisted\n            mockMvc.perform(get(\"/shipments/S-4\"))\n                .andExpect(status().isOk)\n                .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n        }\n\n        @Test\n        fun `confirming an already-confirmed shipment succeeds and changes nothing`() {\n            mockMvc.perform(createShipment(\"S-5\")).andExpect(status().isCreated)\n            mockMvc.perform(post(\"/shipments/S-5/confirm\")).andExpect(status().isOk)\n\n            // Confirm again\n            mockMvc.perform(post(\"/shipments/S-5/confirm\"))\n                .andExpect(status().isOk)\n                .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n        }\n\n        @Test\n        fun `confirming a cancelled shipment returns 409 with error envelope`() {\n            // Create and manually set to CANCELLED state in repository\n            val shipment = Shipment(\n                shipmentId = \"S-6\",\n                orderId = \"O-1\",\n                carrier = \"DHL\",\n                status = ShipmentStatus.CANCELLED,\n            )\n            repository.save(shipment)\n\n            mockMvc.perform(post(\"/shipments/S-6/confirm\"))\n                .andExpect(status().isConflict)\n                .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_INVALID_STATE\"))\n                .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n        }\n\n        @Test\n        fun `confirming a non-existent shipment returns 404 with error envelope`() {\n            mockMvc.perform(post(\"/shipments/S-missing/confirm\"))\n                .andExpect(status().isNotFound)\n                .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n                .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n        }\n    }\n}\n","numLines":141,"startLine":1,"totalLines":141}}}
