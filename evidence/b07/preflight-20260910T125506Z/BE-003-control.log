shipments/S-5/confirm\")).andExpect(status().isOk)\n\n        // Retry the confirm operation\n        mockMvc.perform(post(\"/shipments/S-5/confirm\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.shipmentId\").value(\"S-5\"))\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n    }\n\n    @Test\n    fun `rejects confirming a cancelled shipment with conflict error`() {\n        mockMvc.perform(createShipment(\"S-6\")).andExpect(status().isCreated)\n\n        // Manually set shipment to CANCELLED status\n        val shipment = repository.findById(\"S-6\")!!\n        repository.save(shipment.copy(status = ShipmentStatus.CANCELLED))\n\n        mockMvc.perform(post(\"/shipments/S-6/confirm\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_INVALID_STATE\"))\n    }\n\n    @Test\n    fun `rejects confirming a nonexistent shipment with not found error`() {\n        mockMvc.perform(post(\"/shipments/S-missing/confirm\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n    }\n}"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":664,"cache_read_input_tokens":21819,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":664},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"31693248-9567-48bf-9976-05b633e8f1e6","uuid":"833cb59d-4edc-43ff-9595-233358d38cda","timestamp":"2026-09-10T12:59:07.519Z","request_id":"req_011CeuoJDoMyXSQXrkKnvFuf"}
