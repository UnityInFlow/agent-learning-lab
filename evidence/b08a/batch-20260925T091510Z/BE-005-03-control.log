se {\n            service.listOrders(validLimit, validOffset)\n        }\n\n        val total = if (fulfilment != null) {\n            service.getTotalOrderCountByFulfilment(fulfilment)\n        } else {\n            service.getTotalOrderCount()\n        }\n\n        return ResponseEntity.ok()\n            .header(\"X-Total-Count\", total.toString())\n            .body(orders)\n    }\n\n    @PutMapping(\"/{orderId}/quantity\")\n    fun updateQuantity(\n        @PathVariable orderId: String,\n        @RequestBody request: UpdateOrderQuantityRequest,\n    ): ResponseEntity<Order> {\n        val order = service.updateOrderQuantity(orderId, request)\n        return ResponseEntity.ok(order)\n    }\n\n    private fun validateLimit(limit: Int): Int {\n        if (limit < 1 || limit > 100) {\n            throw com.unityinflow.sample.api.ValidationException(\n                \"Limit must be between 1 and 100\",\n                listOf(com.unityinflow.sample.api.FieldViolation(\"limit\", \"must be between 1 and 100\")),\n            )\n        }\n        return limit\n    }\n\n    private fun validateOffset(offset: Int): Int {\n        if (offset < 0) {\n            throw com.unityinflow.sample.api.ValidationException(\n                \"Offset must be 0 or greater\",\n                listOf(com.unityinflow.sample.api.FieldViolation(\"offset\", \"must be 0 or greater\")),\n            )\n        }\n        return offset\n    }\n}"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":1535,"cache_read_input_tokens":48515,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1535},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"024edd90-4227-4933-b6b0-302259787923","uuid":"6e87af44-4953-453e-a814-2e21ec6247ec"