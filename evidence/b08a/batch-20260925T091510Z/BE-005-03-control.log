{"type":"assistant","message":{"model":"claude-haiku-4-5-20251001","id":"msg_011CfPwZrkZnEaTTuh8M48AZ","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01CWcoX5YG1mQ1m9fEzbHfoL","name":"Write","input":{"file_path":"/private/var/folders/jr/lwzz65cx5pndqqdgzhnym1pc0000gn/T/observatory-run-421067b2-3190-4a63-a252-d189aeccfed6/sample-service/src/main/kotlin/com/unityinflow/sample/order/OrderService.kt","content":"package com.unityinflow.sample.order\n\nimport com.unityinflow.sample.api.ConflictException\nimport com.unityinflow.sample.api.ErrorCode\nimport com.unityinflow.sample.api.FieldViolation\nimport com.unityinflow.sample.api.ResourceNotFoundException\nimport com.unityinflow.sample.api.UnprocessableEntityException\nimport com.unityinflow.sample.api.ValidationException\nimport com.unityinflow.sample.customer.InMemoryCustomerRepository\nimport com.unityinflow.sample.shipment.InMemoryShipmentRepository\nimport com.unityinflow.sample.shipment.ShipmentStatus\nimport org.springframework.stereotype.Service\n\n@Service\nclass OrderService(\n    private val orderRepository: InMemoryOrderRepository,\n    private val shipmentRepository: InMemoryShipmentRepository,\n    private val customerRepository: InMemoryCustomerRepository,\n) {\n\n    fun createOrder(request: CreateOrderRequest): Order {\n        if (orderRepository.existsById(request.orderId)) {\n            throw ConflictException(\n                ErrorCode.ORDER_ALREADY_EXISTS,\n                \"An order with id '${request.orderId}' already exists\",\n            )\n        }\n\n        val quantity = request.quantity ?: 1\n        if (quantity < 1) {\n            throw ValidationException(\n                \"Quantity must be at least 1\",\n                listOf(FieldViolation(\"quantity\", \"must be at least 1\")),\n            )\n        }\n\n        val customer = customerRepository.findById(request.customerId)\n        if (customer == null) {\n            throw UnprocessableEntityException(\n                ErrorCode.CUSTOMER_NOT_FOUND,\n                \"Customer with id '${request.customerId}' does not exist\",\n            )\n        }\n\n        val order = Order(\n            orderId = request.orderId,\n            customerId = request.customerId,\n            amount = request.amount,\n            currency = request.currency,\n            quantity = quantity,\n        )\n        val savedOrder = orderRepository.save(order)\n        return savedOrder.withFulfilment()\n    }\n\n    fun getOrder(orderId: String): Order {\n        val order = orderRepository.findById(orderId)\n            ?: throw ResourceNotFoundException(\n                ErrorCode.ORDER_NOT_FOUND,\n                \"No order with id '$orderId'\",\n            )\n        return order.withFulfilment()\n    }\n\n    fun listOrders(limit: Int, offset: Int): List<Order> {\n        return orderRepository.findAll(limit, offset).map { it.withFulfilment() }\n    }\n\n    fun listOrdersByFulfilment(\n        fulfilmentStatus: String,\n        limit: Int,\n        offset: Int,\n    ): List<Order> {\n        validateFulfilmentStatus(fulfilmentStatus)\n        return orderRepository.findAllByFulfilment(fulfilmentStatus, limit, offset)\n            .map { it.withFulfilment() }\n    }\n\n    fun updateOrderQuantity(orderId: String, request: UpdateOrderQuantityRequest): Order {\n        val order = orderRepository.findById(orderId)\n            ?: throw ResourceNotFoundException(\n                ErrorCode.ORDER_NOT_FOUND,\n                \"No order with id '$orderId'\",\n            )\n\n        if (request.quantity < 1) {\n            throw ValidationException(\n                \"Quantity must be at least 1\",\n                listOf(FieldViolation(\"quantity\", \"must be at least 1\")),\n            )\n        }\n\n        val allocatedQuantity = calculateAllocatedQuantity(orderId)\n        if (request.quantity < allocatedQuantity) {\n            throw ConflictException(\n                ErrorCode.VALIDATION_FAILED,\n                \"Cannot reduce quantity below allocated quantity\",\n            )\n        }\n\n        val updatedOrder = order.copy(quantity = request.quantity)\n        val savedOrder = orderRepository.save(updatedOrder)\n        return savedOrder.withFulfilment()\n    }\n\n    fun getTotalOrderCount(): Int = orderRepository.countAll()\n\n    fun getTotalOrderCountByFulfilment(fulfilmentStatus: String): Int {\n        validateFulfilmentStatus(fulfilmentStatus)\n        return orderRepository.countByFulfilment(fulfilmentStatus)\n    }\n\n    private fun Order.withFulfilment(): Order {\n        val allocated = calculateAllocatedQuantity(this.orderId)\n        val delivered = calculateDeliveredQuantity(this.orderId)\n\n        val status = when {\n            delivered >= this.quantity -> OrderFulfilmentStatus.DELIVERED.name\n            allocated >= this.quantity -> OrderFulfilmentStatus.FULLY_ALLOCATED.name\n            allocated > 0 -> OrderFulfilmentStatus.PARTIALLY_ALLOCATED.name\n            else -> OrderFulfilmentStatus.UNALLOCATED.name\n        }\n\n        return this.copy(\n            fulfilment = FulfilmentStatus(\n                allocated = allocated,\n                delivered = delivered,\n                status = status,\n            ),\n        )\n    }\n\n    private fun calculateAllocatedQuantity(orderId: String): Int {\n        val shipments = shipmentRepository.findAllByOrderId(orderId)\n        return shipments\n            .filter { it.status != ShipmentStatus.CANCELLED }\n            .sumOf { it.quantity }\n    }\n\n    private fun calculateDeliveredQuantity(orderId: String): Int {\n        val shipments = shipmentRepository.findAllByOrderId(orderId)\n        return shipments\n            .filter { it.status == ShipmentStatus.DELIVERED }\n            .sumOf { it.quantity }\n    }\n\n    private fun validateFulfilmentStatus(status: String) {\n        try {\n            OrderFulfilmentStatus.valueOf(status)\n        } catch (e: IllegalArgumentException) {\n            throw ValidationException(\n                \"Invalid fulfilment status '$status'\",\n                listOf(FieldViolation(\"fulfilment\", \"invalid fulfilment status\")),\n            )\n        }\n    }\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":733,"cache_read_input_tokens":45655,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":733},"output_tokens":6,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"024edd90-4227-4933-b6b0-302259787923","uuid":"99027a1c-6403-4a78-94e6-c64365f7bac8","timestamp":"2026-09-25T09:44:16.887Z","request_id":"req_011CfPwZrNkqeGxNkfE22ANe","wire_tool_inputs":{"toolu_01CWcoX5YG1mQ1m9fEzbHfoL":{"file_path":"/private/var/folders/jr/lwzz65cx5pndqqdgzhnym1pc0000gn/T/observatory-run-421067b2-3190-4a63-a252-d189aeccfed6/sample-service/src/main/kotlin/com/unityinflow/sample/order/OrderService.kt","content":"package com.unityinflow.sample.order\n\nimport com.unityinflow.sample.api.ConflictException\nimport com.unityinflow.sample.api.ErrorCode\nimport com.unityinflow.sample.api.FieldViolation\nimport com.unityinflow.sample.api.ResourceNotFoundException\nimport com.unityinflow.sample.api.UnprocessableEntityException\nimport com.unityinflow.sample.api.ValidationException\nimport com.unityinflow.sample.customer.InMemoryCustomerRepository\nimport com.unityinflow.sample.shipment.InMemoryShipmentRepository\nimport com.unityinflow.sample.shipment.ShipmentStatus\nimport org.springframework.stereotype.Service\n\n@Service\nclass OrderService(\n    private val orderRepository: InMemoryOrderRepository,\n    private val shipmentRepository: InMemoryShipmentRepository,\n    private val customerRepository: InMemoryCustomerRepository,\n) {\n\n    fun createOrder(request: CreateOrderRequest): Order {\n        if (orderRepository.existsById(request.orderId)) {\n            throw ConflictException(\n                ErrorCode.ORDER_ALREADY_EXISTS,\n                \"An order with id '${request.orderId}' already exists\",\n            )\n        }\n\n        val quantity = request.quantity ?: 1\n        if (quantity < 1) {\n            throw ValidationException(\n                \"Quantity must be at least 1\",\n                listOf(FieldViolation(\"quantity\", \"must be at least 1\")),\n            )\n        }\n\n        val customer = customerRepository.findById(request.customerId)\n        if (customer == null) {\n            throw UnprocessableEntityException(\n                ErrorCode.CUSTOMER_NOT_FOUND,\n                \"Customer with id '${request.customerId}' does not exist\",\n            )\n        }\n\n        val order = Order(\n            orderId = request.orderId,\n            customerId = request.customerId,\n            amount = request.amount,\n            currency = request.currency,\n            quantity = quantity,\n        )\n        val savedOrder = orderRepository.save(order)\n        return savedOrder.withFulfilment()\n    }\n\n    fun getOrder(orderId: String): Order {\n        val order = orderRepository.findById(orderId)\n            ?: throw ResourceNotFoundException(\n                ErrorCode.ORDER_NOT_FOUND,\n                \"No order with id '$orderId'\",\n            )\n        return order.withFulfilment()\n    }\n\n    fun listOrders(limit: Int, offset: Int): List<Order> {\n        return orderRepository.findAll(limit, offset).map { it.withFulfilment() }\n    }\n\n    fun listOrdersByFulfilment(\n        fulfilmentStatus: String,\n        limit: Int,\n        offset: Int,\n    ): List<Order> {\n        validateFulfilmentStatus(fulfilmentStatus)\n        return orderRepository.findAllByFulfilment(fulfilmentStatus, limit, offset)\n            .map { it.withFulfilment() }\n    }\n\n    fun updateOrderQuantity(orderId: String, request: UpdateOrderQuantityRequest): Order {\n        val order = orderRepository.findById(orderId)\n            ?: throw ResourceNotFoundException(\n                ErrorCode.ORDER_NOT_FOUND,\n                \"No order with id '$orderId'\",\n            )\n\n        if (request.quantity < 1) {\n            throw ValidationException(\n                \"Quantity must be at least 1\",\n                listOf(FieldViolation(\"quantity\", \"must be at least 1\")),\n            )\n        }\n\n        val allocatedQuantity = calculateAllocatedQuantity(orderId)\n        if (request.quantity < allocatedQuantity) {\n            throw ConflictException(\n                ErrorCode.VALIDATION_FAILED,\n                \"Cannot reduce quantity below allocated quantity\",\n            )\n        }\n\n        val updatedOrder = order.copy(quantity = request.quantity)\n        val savedOrder = orderRepository.save(updatedOrder)\n        return savedOrder.withFulfilment()\n    }\n\n    fun getTotalOrderCount(): Int = orderRepository.countAll()\n\n    fun getTotalOrderCountByFulfilment(fulfilmentStatus: String): Int {\n        validateFulfilmentStatus(fulfilmentStatus)\n        return orderRepository.countByFulfilment(fulfilmentStatus)\n    }\n\n    private fun Order.withFulfilment(): Order {\n        val allocated = calculateAllocatedQuantity(this.orderId)\n        val delivered = calculateDeliveredQuantity(this.orderId)\n\n        val status = when {\n            delivered >= this.quantity -> OrderFulfilmentStatus.DELIVERED.name\n            allocated >= this.quantity -> OrderFulfilmentStatus.FULLY_ALLOCATED.name\n            allocated > 0 -> OrderFulfilmentStatus.PARTIALLY_ALLOCATED.name\n            else -> OrderFulfilmentStatus.UNALLOCATED.name\n        }\n\n        return this.copy(\n            fulfilment = FulfilmentStatus(\n                allocated = allocated,\n                delivered = delivered,\n                status = status,\n            ),\n        )\n    }\n\n    private fun calculateAllocatedQuantity(orderId: String): Int {\n        val shipments = shipmentRepository.findAllByOrderId(orderId)\n        return shipments\n            .filter { it.status != ShipmentStatus.CANCELLED }\n            .sumOf { it.quantity }\n    }\n\n    private fun calculateDeliveredQuantity(orderId: String): Int {\n        val shipments = shipmentRepository.findAllByOrderId(orderId)\n        return shipments\n            .filter { it.status == ShipmentStatus.DELIVERED }\n            .sumOf { it.quantity }\n    }\n\n    private fun validateFulfilmentStatus(status: String) {\n        try {\n            OrderFulfilmentStatus.valueOf(status)\n        } catch (e: IllegalArgumentException) {\n            throw ValidationException(\n                \"Invalid fulfilment status '$status'\",\n                listOf(FieldViolation(\"fulfilment\", \"invalid fulfilment status\")),\n            )\n        }\n    }\n}\n"}}}
