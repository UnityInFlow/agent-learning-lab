\n            Order(request.orderId, request.customerId, request.amount, request.currency),\n        )\n        return ResponseEntity.status(HttpStatus.CREATED).body(saved)\n    }\n\n    @GetMapping(\"/{orderId}\")\n    fun getById(@PathVariable orderId: String): Order =\n        repository.findById(orderId)\n            ?: throw ResourceNotFoundException(\n                ErrorCode.ORDER_NOT_FOUND,\n                \"No order with id '$orderId'\",\n            )\n\n    @GetMapping\n    fun list(): List<Order> = repository.findAll()\n}","newString":"package com.unityinflow.sample.order\n\nimport com.unityinflow.sample.api.ConflictException\nimport com.unityinflow.sample.api.ErrorCode\nimport com.unityinflow.sample.api.FieldViolation\nimport com.unityinflow.sample.api.ResourceNotFoundException\nimport com.unityinflow.sample.api.UnprocessableEntityException\nimport com.unityinflow.sample.api.ValidationException\nimport com.unityinflow.sample.customer.InMemoryCustomerRepository\nimport com.unityinflow.sample.shipment.InMemoryShipmentRepository\nimport org.springframework.http.HttpStatus\nimport org.springframework.http.ResponseEntity\nimport org.springframework.web.bind.annotation.GetMapping\nimport org.springframework.web.bind.annotation.PathVariable\nimport org.springframework.web.bind.annotation.PostMapping\nimport org.springframework.web.bind.annotation.PutMapping\nimport org.springframework.web.bind.annotation.RequestBody\nimport org.springframework.web.bind.annotation.RequestMapping\nimport org.springframework.web.bind.annotation.RequestParam\nimport org.springframework.web.bind.annotation.RestController\n\n@RestController\n@RequestMapping(\"/orders\")\nclass OrderController(\n    private val repository: InMemoryOrderRepository,\n    private val customerRepository: InMemoryCustomerRepository,\n    private val shipmentRepository: InMemoryShipmentRepository,\n) {\n\n    @PostMapping\n    fun create(@RequestBody request: CreateOrderRequest): ResponseEntity<Order> {\n        if (repository.existsById(request.orderId)) {\n            throw ConflictException(\n                ErrorCode.ORDER_ALREADY_EXISTS,\n                \"An order with id '${request.orderId}' already exists\",\n            )\n        }\n\n        if (!customerRepository.existsById(request.customerId)) {\n            throw UnprocessableEntityException(\n                ErrorCode.CUSTOMER_NOT_FOUND,\n                \"No customer with id '${request.customerId}'\",\n            )\n        }\n\n        val quantity = request.quantity ?: 1\n        if (quantity < 1) {\n            throw ValidationException(\n                \"Quantity must be at least 1\",\n                listOf(FieldViolation(\"quantity\", \"Quantity must be at least 1\")),\n            )\n        }\n\n        val saved = repository.save(\n            Order(\n                request.orderId,\n                request.customerId,\n                request.amount,\n                request.currency,\n                quantity,\n                calculateFulfilment(request.orderId, quantity),\n            ),\n        )\n        return ResponseEntity.status(HttpStatus.CREATED).body(saved)\n    }\n\n    @GetMapping(\"/{orderId}\")\n    fun getById(@PathVariable orderId: String): Order {\n        val order = repository.findById(orderId)\n            ?: throw ResourceNotFoundException(\n                ErrorCode.ORDER_NOT_FOUND,\n                \"No order with id '$orderId'\",\n            )\n        return order.copy(fulfilment = calculateFulfilment(orderId, order.quantity))\n    }\n\n    @GetMapping\n    fun list(\n        @RequestParam(required = false) fulfilment: String?,\n        @RequestParam(defaultValue = \"100\") limit: Int,\n        @RequestParam(defaultValue = \"0\") offset: Int,\n    ): ResponseEntity<List<Order>> {\n        if (limit < 1 || limit > 100) {\n            throw ValidationException(\n                \"Limit must be between 1 and 100\",\n                listOf(FieldViolation(\"limit\", \"Limit must be between 1 and 100\")),\n            )\n        }\n        if (offset < 0) {\n            throw ValidationException(\n                \"Offset must be 0 or greater\",\n                listOf(FieldViolation(\"offset\", \"Offset must be 0 or greater\")),\n            )\n        }\n\n        val fulfilmentFilter = if (fulfilment != null) {\n            try {\n                FulfilmentStatus.valueOf(fulfilment)\n            } catch (e: IllegalArgumentException) {\n                throw ValidationException(\n                    \"Invalid fulfilment status: $fulfilment\",\n                    listOf(FieldViolation(\"fulfilment\", \"Invalid fulfilment status\")),\n                )\n            }\n        } else {\n            null\n        }\n\n        val (orders, total) = repository.findAll(fulfilmentFilter, limit, offset)\n        val enriched = orders.map { it.copy(fulfilment = calculateFulfilment(it.orderId, it.quantity)) }\n        return ResponseEntity.ok()\n            .header(\"X-Total-Count\", total.toString())\n            .body(enriched)\n    }\n\n    @PutMapping(\"/{orderId}/quantity\")\n    fun updateQuantity(\n        @PathVariable orderId: String,\n        @RequestBody request: UpdateOrderQuantityRequest,\n    ): ResponseEntity<Order> {\n        val order = repository.findById(orderId)\n            ?: throw ResourceNotFoundException(\n                ErrorCode.ORDER_NOT_FOUND,\n                \"No order with id '$orderId'\",\n            )\n\n        if (request.quantity < 1) {\n            throw ValidationException(\n                \"Quantity must be at least 1\",\n                listOf(FieldViolation(\"quantity\", \"Quantity must be at least 1\")),\n            )\n        }\n\n        val allocated = calculateAllocated(orderId)\n        if (request.quantity < allocated) {\n            throw ConflictException(\n                ErrorCode.CONFLICT,\n                \"New quantity ${ request.quantity} is less than allocated $allocated\",\n            )\n        }\n\n        val updated = order.copy(\n            quantity = request.quantity,\n            fulfilment = calculateFulfilment(orderId, request.quantity),\n        )\n        repository.save(updated)\n        return ResponseEntity.ok(updated)\n    }\n\n    private fun calculateFulfilment(orderId: String, quantity: Int): Fulfilment {\n        val shipments = shipmentRepository.findByOrderId(orderId)\n        val allocated = shipments.filter { it.status != com.unityinflow.sample.shipment.ShipmentStatus.CANCELLED }\n            .sumOf { it.quantity }\n        val delivered = shipments.filter { it.status == com.unityinflow.sample.shipment.ShipmentStatus.DELIVERED }\n            .sumOf { it.quantity }\n\n        val status = when {\n            delivered >= quantity -> FulfilmentStatus.DELIVERED\n            allocated >= quantity -> FulfilmentStatus.FULLY_ALLOCATED\n            allocated > 0 -> FulfilmentStatus.PARTIALLY_ALLOCATED\n            else -> FulfilmentStatus.UNALLOCATED\n        }\n\n        return Fulfilment(allocated, delivered, status)\n    }\n\n    private fun calculateAllocated(orderId: String): Int {\n        val shipments = shipmentRepository.findByOrderId(orderId)\n        return shipments.filter { it.status != com.unityinflow.sample.shipment.ShipmentStatus.CANCELLED }\n            .sumOf { it.quantity }\n    }\n}","originalFile":"package com.unityinflow.sample.order\n\nimport com.unityinflow.sample.api.ConflictException\nimport com.unityinflow.sample.api.ErrorCode\nimport com.unityinflow.sample.api.ResourceNotFoundException\nimport org.springframework.http.HttpStatus\nimport org.springframework.http.ResponseEntity\nimport org.springframework.web.bind.annotation.GetMapping\nimport org.springframework.web.bind.annotation.PathVariable\nimport org.springframework.web.bind.annotation.PostMapping\nimport org.springframework.web.bind.annotation.RequestBody\nimport org.springframework.web.bind.annotation.RequestMapping\nimport org.s