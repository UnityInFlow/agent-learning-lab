        mockMvc.perform(createOrder()).andExpect(status().isCreated)\n        mockMvc.perform(createShipment(\"S-16\")).andExpect(status().isCreated)\n\n        mockMvc.perform(post(\"/shipments/S-16/confirm\"))\n            .andExpect(status().isOk)\n\n        mockMvc.perform(post(\"/shipments/S-16/cancel\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"VALIDATION_FAILED\"))\n    }\n\n    @Test\n    fun `cancelled shipment releases quantity and allows new shipment`() {\n        mockMvc.perform(createCustomer()).andExpect(status().isCreated)\n        mockMvc.perform(createOrder(quantity = 5)).andExpect(status().isCreated)\n\n        mockMvc.perform(createShipment(\"S-17\", quantity = \"5\"))\n            .andExpect(status().isCreated)\n\n        mockMvc.perform(post(\"/shipments/S-17/cancel\"))\n            .andExpect(status().isOk)\n\n        mockMvc.perform(createShipment(\"S-18\", quantity = \"5\"))\n            .andExpect(status().isCreated)\n    }\n\n    @Test\n    fun `lists shipments with pagination`() {\n        mockMvc.perform(createCustomer()).andExpect(status().isCreated)\n        mockMvc.perform(createOrder()).andExpect(status().isCreated)\n        mockMvc.perform(createShipment(\"S-a\")).andExpect(status().isCreated)\n        mockMvc.perform(createShipment(\"S-b\")).andExpect(status().isCreated)\n        mockMvc.perform(createShipment(\"S-c\")).andExpect(status().isCreated)\n\n        mockMvc.perform(get(\"/shipments?limit=2&offset=0\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$[0].shipmentId\").value(\"S-a\"))\n            .andExpect(jsonPath(\"$[1].shipmentId\").value(\"S-b\"))\n            .andExpect(jsonPath(\"$[2]\").doesNotExist)\n    }\n\n    @Test\n    fun `shipment list includes X-Total-Count header`() {\n        mockMvc.perform(createCustomer()).andExpect(status().isCreated)\n        mockMvc.perform(createOrder()).andExpect(status().isCreated)\n        mockMvc.perform(createShipment(\"S-a\")).andExpect(status().isCreated)\n        mockMvc.perform(createShipment(\"S-b\")).andExpect(status().isCreated)\n\n        mockMvc.perform(get(\"/shipments\"))\n            .andExpect(status().isOk)\n            .andExpect { result ->\n                assert(result.response.getHeader(\"X-Total-Count\") == \"2\")\n            }\n    }\n\n    @Test\n    fun `rejects invalid limit parameter`() {\n        mockMvc.perform(get(\"/shipments?limit=200\"))\n            .andExpect(status().isBadRequest)\n            .andExpect(jsonPath(\"$.error.code\").value(\"VALIDATION_FAILED\"))\n            .andExpect(jsonPath(\"$.error.fields[0].field\").value(\"limit\"))\n    }\n\n    @Test\n    fun `rejects negative offset parameter`() {\n        mockMvc.perform(get(\"/shipments?offset=-1\"))\n            .andExpect(status().isBadRequest)\n            .andExpect(jsonPath(\"$.error.code\").value(\"VALIDATION_FAILED\"))\n            .andExpect(jsonPath(\"$.error.fields[0].field\").value(\"offset\"))\n    }\n\n    @Test\n    fun `rejects confirm for non-existent shipment`() {\n        mockMvc.perform(post(\"/shipments/NONEXISTENT/confirm\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n    }\n\n    @Test\n    fun `rejects deliver for non-existent shipment`() {\n        mockMvc.perform(post(\"/shipments/NONEXISTENT/deliver\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n    }\n\n    @Test\n    fun `rejects cancel for non-existent shipment`() {\n        mockMvc.perform(post(\"/shipments/NONEXISTENT/cancel\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n    }\n}"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_crea