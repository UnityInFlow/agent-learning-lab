{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016P3z9EobZ3BqdgaiMvwi6x","type":"tool_result","content":"1\tpackage com.unityinflow.sample.shipment\n2\t\n3\timport com.unityinflow.sample.customer.InMemoryCustomerRepository\n4\timport com.unityinflow.sample.order.InMemoryOrderRepository\n5\timport org.junit.jupiter.api.BeforeEach\n6\timport org.junit.jupiter.api.Test\n7\timport org.springframework.beans.factory.annotation.Autowired\n8\timport org.springframework.boot.test.context.SpringBootTest\n9\timport org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc\n10\timport org.springframework.http.MediaType\n11\timport org.springframework.test.web.servlet.MockMvc\n12\timport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get\n13\timport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post\n14\timport org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath\n15\timport org.springframework.test.web.servlet.result.MockMvcResultMatchers.status\n16\t\n17\t/**\n18\t * The shipment feature as it exists before BE-003.\n19\t *\n20\t * These are \"the existing tests\" for that benchmark: they must keep passing, and an agent\n21\t * that breaks one has regressed the fixture rather than solved the task.\n22\t */\n23\t@SpringBootTest\n24\t@AutoConfigureMockMvc\n25\tclass ShipmentControllerTest {\n26\t\n27\t    @Autowired\n28\t    lateinit var mockMvc: MockMvc\n29\t\n30\t    @Autowired\n31\t    lateinit var shipmentRepository: InMemoryShipmentRepository\n32\t\n33\t    @Autowired\n34\t    lateinit var orderRepository: InMemoryOrderRepository\n35\t\n36\t    @Autowired\n37\t    lateinit var customerRepository: InMemoryCustomerRepository\n38\t\n39\t    @BeforeEach\n40\t    fun reset() {\n41\t        shipmentRepository.clear()\n42\t        orderRepository.clear()\n43\t        customerRepository.clear()\n44\t    }\n45\t\n46\t    private fun createCustomer(customerId: String = \"C-1\") =\n47\t        post(\"/customers\")\n48\t            .contentType(MediaType.APPLICATION_JSON)\n49\t            .content(\n50\t                \"\"\"{\"customerId\":\"$customerId\",\"name\":\"Test Customer\",\"email\":\"test@example.com\"}\"\"\",\n51\t            )\n52\t\n53\t    private fun createOrder(\n54\t        orderId: String = \"O-1\",\n55\t        customerId: String = \"C-1\",\n56\t        quantity: Int = 10,\n57\t    ) = post(\"/orders\")\n58\t        .contentType(MediaType.APPLICATION_JSON)\n59\t        .content(\n60\t            \"\"\"{\"orderId\":\"$orderId\",\"customerId\":\"$customerId\",\"amount\":49.90,\"currency\":\"EUR\",\"quantity\":$quantity}\"\"\",\n61\t        )\n62\t\n63\t    private fun createShipment(\n64\t        shipmentId: String,\n65\t        orderId: String = \"O-1\",\n66\t        quantity: String? = null,\n67\t    ) = post(\"/shipments\")\n68\t        .contentType(MediaType.APPLICATION_JSON)\n69\t        .content(\n70\t            if (quantity != null) {\n71\t                \"\"\"{\"shipmentId\":\"$shipmentId\",\"orderId\":\"$orderId\",\"carrier\":\"DHL\",\"quantity\":$quantity}\"\"\"\n72\t            } else {\n73\t                \"\"\"{\"shipmentId\":\"$shipmentId\",\"orderId\":\"$orderId\",\"carrier\":\"DHL\"}\"\"\"\n74\t            },\n75\t        )\n76\t\n77\t    @Test\n78\t    fun `creates a shipment in CREATED status`() {\n79\t        mockMvc.perform(createCustomer()).andExpect(status().isCreated)\n80\t        mockMvc.perform(createOrder()).andExpect(status().isCreated)\n81\t\n82\t        mockMvc.perform(createShipment(\"S-1\"))\n83\t            .andExpect(status().isCreated)\n84\t            .andExpect(jsonPath(\"$.shipmentId\").value(\"S-1\"))\n85\t            .andExpect(jsonPath(\"$.status\").value(\"CREATED\"))\n86\t    }\n87\t\n88\t    @Test\n89\t    fun `rejects a duplicate shipment id with the error envelope`() {\n90\t        mockMvc.perform(createCustomer()).andExpect(status().isCreated)\n91\t        mockMvc.perform(createOrder()).andExpect(status().isCreated)\n92\t        mockMvc.perform(createShipment(\"S-2\")).andExpect(status().isCreated)\n93\t\n94\t        mockMvc.perform(createShipment(\"S-2\"))\n95\t            .andExpect(status().isConflict)\n96\t            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_ALREADY_EXISTS\"))\n97\t    }\n98\t\n99\t    @Test\n100\t    fun `returns a shipment by id`() {\n101\t        mockMvc.perform(createCustomer()).andExpect(status().isCreated)\n102\t        mockMvc.perform(createOrder()).andExpect(status().isCreated)\n103\t        mockMvc.perform(createShipment(\"S-3\")).andExpect(status().isCreated)\n104\t\n105\t        mockMvc.perform(get(\"/shipments/S-3\"))\n106\t            .andExpect(status().isOk)\n107\t            .andExpect(jsonPath(\"$.carrier\").value(\"DHL\"))\n108\t    }\n109\t\n110\t    @Test\n111\t    fun `reports an unknown shipment through the error envelope`() {\n112\t        mockMvc.perform(get(\"/shipments/S-missing\"))\n113\t            .andExpect(status().isNotFound)\n114\t            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n115\t    }\n116\t\n117\t    @Test\n118\t    fun `lists shipments in id order`() {\n119\t        mockMvc.perform(createCustomer()).andExpect(status().isCreated)\n120\t        mockMvc.perform(createOrder()).andExpect(status().isCreated)\n121\t        mockMvc.perform(createShipment(\"S-b\")).andExpect(status().isCreated)\n122\t        mockMvc.perform(createShipment(\"S-a\")).andExpect(status().isCreated)\n123\t\n124\t        mockMvc.perform(get(\"/shipments\"))\n125\t            .andExpect(status().isOk)\n126\t            .andExpect(jsonPath(\"$[0].shipmentId\").value(\"S-a\"))\n127\t            .andExpect(jsonPath(\"$[1].shipmentId\").value(\"S-b\"))\n128\t    }\n129\t\n130\t    @Test\n131\t    fun `shipments default quantity to 1`() {\n132\t        mockMvc.perform(createCustomer()).andExpect(status().isCreated)\n133\t        mockMvc.perform(createOrder()).andExpect(status().isCreated)\n134\t\n135\t        mockMvc.perform(createShipment(\"S-4\"))\n136\t            .andExpect(status().isCreated)\n137\t            .andExpect(jsonPath(\"$.quantity\").value(1))\n138\t    }\n139\t\n140\t    @Test\n141\t    fun `shipments accept explicit quantity`() {\n142\t        mockMvc.perform(createCustomer()).andExpect(status().isCreated)\n143\t        mockMvc.perform(createOrder()).andExpect(status().isCreated)\n144\t\n145\t        mockMvc.perform(createShipment(\"S-5\", quantity = \"5\"))\n146\t            .andExpect(status().isCreated)\n147\t            .andExpect(jsonPath(\"$.quantity\").value(5))\n148\t    }\n149\t\n150\t    @Test\n151\t    fun `rejects shipment with quantity below 1`() {\n152\t        mockMvc.perform(createCustomer()).andExpect(status().isCreated)\n153\t        mockMvc.perform(createOrder()).andExpect(status().isCreated)\n154\t\n155\t        mockMvc.perform(createShipment(\"S-6\", quantity = \"0\"))\n156\t            .andExpect(status().isBadRequest)\n157\t            .andExpect(jsonPath(\"$.error.code\").value(\"VALIDATION_FAILED\"))\n158\t            .andExpect(jsonPath(\"$.error.fields[0].field\").value(\"quantity\"))\n159\t    }\n160\t\n161\t    @Test\n162\t    fun `rejects shipment that exceeds order quantity`() {\n163\t        mockMvc.perform(createCustomer()).andExpect(status().isCreated)\n164\t        mockMvc.perform(createOrder(quantity = 5)).andExpect(status().isCreated)\n165\t\n166\t        mockMvc.perform(createShipment(\"S-7\", quantity = \"10\"))\n167\t            .andExpect(status().isConflict)\n168\t            .andExpect(jsonPath(\"$.error.code\").value(\"VALIDATION_FAILED\"))\n169\t    }\n170\t\n171\t    @Test\n172\t    fun `rejects shipment that when combined with existing allocation exceeds order quantity`() {\n173\t        mockMvc.perform(createCustomer()).andExpect(status().isCreated)\n174\t        mockMvc.perform(createOrder(quantity = 5)).andExpect(status().isCreated)\n175\t\n176\t        mockMvc.pe