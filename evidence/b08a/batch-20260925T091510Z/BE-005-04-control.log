ntStatus }\n        } else {\n            allOrders\n        }\n        val total = filtered.size\n        val items = filtered.drop(offset).take(limit)\n        return PagedResult(items, total)\n    }","originalFile":"package com.unityinflow.sample.order\n\nimport java.util.concurrent.ConcurrentHashMap\nimport org.springframework.stereotype.Repository\n\ndata class PagedResult<T>(\n    val items: List<T>,\n    val total: Int,\n)\n\n@Repository\nclass InMemoryOrderRepository {\n\n    private val store = ConcurrentHashMap<String, Order>()\n\n    fun save(order: Order): Order {\n        store[order.orderId] = order\n        return order\n    }\n\n    fun existsById(orderId: String): Boolean = store.containsKey(orderId)\n\n    fun findById(orderId: String): Order? = store[orderId]\n\n    fun findAll(): List<Order> = store.values.sortedBy { it.orderId }\n\n    fun findAllPaged(\n        limit: Int,\n        offset: Int,\n        fulfilmentStatus: FulfilmentStatus? = null,\n    ): PagedResult<Order> {\n        val allOrders = store.values.sortedBy { it.orderId }\n        val filtered = if (fulfilmentStatus != null) {\n            allOrders.filter { it.fulfilment.status == fulfilmentStatus }\n        } else {\n            allOrders\n        }\n        val total = filtered.size\n        val items = filtered.drop(offset).take(limit)\n        return PagedResult(items, total)\n    }\n\n    fun clear() = store.clear()\n}\n","structuredPatch":[{"oldStart":28,"oldLines":8,"newStart":28,"newLines":15,"lines":["         limit: Int,","         offset: Int,","         fulfilmentStatus: FulfilmentStatus? = null,","+        fulfilmentCalculator: ((String, Int) -> Fulfilment)? = null,","     ): PagedResult<Order> {","-        val allOrders = store.values.sortedBy { it.orderId }","+        val allOrders = store.values.sortedBy { it.orderId }.map { order ->","+            if (fulfilmentCalculator != null) {","+                order.copy(fulfilment = fulfilmentCalculator(order.orderId, or