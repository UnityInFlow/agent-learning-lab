.http.ResponseEntity\nimport org.springframework.web.bind.annotation.GetMapping\nimport org.springframework.web.bind.annotation.PathVariable\nimport org.springframework.web.bind.annotation.PostMapping\nimport org.springframework.web.bind.annotation.PutMapping\nimport org.springframework.web.bind.annotation.RequestBody\nimport org.springframework.web.bind.annotation.RequestMapping\nimport org.springframework.web.bind.annotation.RequestParam\nimport org.springframework.web.bind.annotation.RestController\n\n@RestController\n@RequestMapping(\"/orders\")\nclass OrderController(\n    private val orderRepository: InMemoryOrderRepository,\n    private val customerRepository: InMemoryCustomerRepository,\n    private val shipmentRepository: InMemoryShipmentRepository,\n) {\n\n    @PostMapping\n    fun create(@RequestBody request: CreateOrderRequest): ResponseEntity<Order> {\n        if (orderRepository.existsById(request.orderId)) {\n            throw ConflictException(\n                ErrorCode.ORDER_ALREADY_EXISTS,\n                \"An order with id '${request.orderId}' already exists\",\n            )\n        }\n\n        if (customerRepository.findById(request.customerId) == null) {\n            throw UnprocessableException(\n                ErrorCode.CUSTOMER_NOT_FOUND,\n                \"No customer with id '${request.customerId}'\",\n            )\n        }\n\n        val quantity = request.quantity ?: 1\n        if (quantity < 1) {\n            throw ValidationException(\n                \"Invalid quantity\",\n                listOf(FieldViolation(\"quantity\", \"quantity must be at least 1\")),\n            )\n        }\n\n        val saved = orderRepository.save(\n            Order(\n                orderId = request.orderId,\n                customerId = request.customerId,\n                amount = request.amount,\n                currency = request.currency,\n                quantity = quantity,\n                fulfilment = Fulfilment(allocated = 0, delivered = 0, status = FulfilmentStatus.UNALLOCATED),\n            ),\n        )\n        return ResponseEntity.status(HttpStatus.CREATED).body(saved)\n    }\n\n    @GetMapping(\"/{orderId}\")\n    fun getById(@PathVariable orderId: String): Order {\n        val order = orderRepository.findById(orderId)\n            ?: throw ResourceNotFoundException(\n                ErrorCode.ORDER_NOT_FOUND,\n                \"No order with id '$orderId'\",\n            )\n        return order.copy(fulfilment = calculateFulfilment(orderId, order.quantity))\n    }\n\n    @GetMapping\n    fun list(\n        @RequestParam(defaultValue = \"100\") limit: Int,\n        @RequestParam(defaultValue = \"0\") offset: Int,\n        @RequestParam(required = false) fulfilment: String? = null,\n    ): ResponseEntity<List<Order>> {\n        if (limit < 1 || limit > 100) {\n            throw ValidationException(\n                \"Invalid limit\",\n                listOf(FieldViolation(\"limit\", \"limit must be between 1 and 100\")),\n            )\n        }\n        if (offset < 0) {\n            throw ValidationException(\n                \"Invalid offset\",\n                listOf(FieldViolation(\"offset\", \"offset must be non-negative\")),\n            )\n        }\n\n        val fulfilmentStatus = if (fulfilment != null) {\n            try {\n                FulfilmentStatus.valueOf(fulfilment)\n            } catch (e: IllegalArgumentException) {\n                throw ValidationException(\n                    \"Invalid fulfilment\",\n                    listOf(FieldViolation(\"fulfilment\", \"fulfilment must be a valid status\")),\n                )\n            }\n        } else {\n            null\n        }\n\n        val result = orderRepository.findAllPaged(limit, offset, fulfilmentStatus)\n        return ResponseEntity.ok()\n            .header(\"X-Total-Count\", result.total.toString())\n            .body(result.items)\n    }\n\n    @PutMapping(\"/{orderId}/quantity\")\n    fun updateQuantity(\n        @PathVariable orderId: String,\n        @RequestBody request: UpdateOrderQuantityRequest,\n    ): Order {\n        val order = orderRepository.findById(orderId)\n            ?: throw ResourceNotFoundException(\n                ErrorCode.ORDER_NOT_FOUND,\n                \"No order with id '$orderId'\",\n            )\n\n        if (request.quantity < 1) {\n            throw ValidationException(\n                \"Invalid quantity\",\n                listOf(FieldViolation(\"quantity\", \"quantity must be at least 1\")),\n            )\n        }\n\n        if (request.quantity < order.fulfilment.allocated) {\n            throw ConflictException(\n                ErrorCode.ORDER_NOT_FOUND,\n                \"Cannot set quantity below allocated amount\",\n            )\n        }\n\n        val updated = order.copy(\n            quantity = request.quantity,\n            fulfilment = calculateFulfilment(orderId, request.quantity),\n        )\n        orderRepository.save(updated)\n        return updated\n    }\n\n    private fun calculateFulfilment(orderId: String, orderQuantity: Int): Fulfilment {\n        val shipments = shipmentRepository.findAllByOrderId(orderId)\n        val allocated = shipments.filter { it.status != ShipmentStatus.CANCELLED }.sumOf { it.quantity }\n        val delivered = shipments.filter { it.status == ShipmentStatus.DELIVERED }.sumOf { it.quantity }\n\n        val status = when {\n            delivered >= orderQuantity -> FulfilmentStatus.DELIVERED\n            allocated >= orderQuantity -> FulfilmentStatus.FULLY_ALLOCATED\n            allocated > 0 -> FulfilmentStatus.PARTIALLY_ALLOCATED\n            else -> FulfilmentStatus.UNALLOCATED\n        }\n\n        return Fulfilment(allocated = allocated, delivered = delivered, status = status)\n    }\n}\n","structuredPatch":[{"oldStart":107,"oldLines":7,"newStart":107,"newLines":12,"lines":["             null","         }"," ","-        val result = orderRepository.findAllPaged(limit, offset, fulfilmentStatus)","+        val result = orderRepository.findAllPaged(","+            limit,","+            offset,","+            fulfilmentStatus,","+            ::calculateFulfilment,","+        )","         return ResponseEntity.ok()","             .header(\"X-Total-Count\", result.total.toString())","             .body(result.items)"]}],"userModified":false,"replaceAll":false}}
