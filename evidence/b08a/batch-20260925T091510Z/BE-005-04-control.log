order`() {\n        mockMvc.perform(get(\"/orders/does-not-exist\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_NOT_FOUND\"))\n            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n    }\n\n    @Test\n    fun `returns 409 with the error envelope for a duplicate order id`() {\n        mockMvc.perform(createCustomer()).andExpect(status().isCreated)\n        mockMvc.perform(createOrder(\"O-3\")).andExpect(status().isCreated)\n\n        mockMvc.perform(createOrder(\"O-3\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_ALREADY_EXISTS\"))\n            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n    }\n}"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":2440,"cache_read_input_tokens":47657,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2440},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"7ca75136-99c1-4882-9ef3-dfd0afe64ac9","uuid":"5e00b4be-47c7-4cfa-b9f8-3b06ed7a2f83","timestamp":"2026-09-25T10:00:12.311Z","request_id":"req_011CfPxnU7HQbqivuje4uT5S","wire_tool_inputs":{"toolu_01KzebiM4p6hj6ZS2EJnZLuU":{"file_path":"/private/var/folders/jr/lwzz65cx5pndqqdgzhnym1pc0000gn/T/observatory-run-4319e882-43a4-4dbd-9fe8-1424d30c13c5/sample-service/src/test/kotlin/com/unityinflow/sample/order/OrderControllerTest.kt","old_string":"package com.unityinflow.sample.order\n\nimport org.junit.jupiter.api.BeforeEach\nimport org.junit.jupiter.api.Test\nimport org.springframework.beans.factory.annotation.Autowired\nimport org.springframework.boot.test.context.SpringBootTest\nimport org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc\nimport