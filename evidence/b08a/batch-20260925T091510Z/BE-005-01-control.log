                ErrorCode.ORDER_NOT_FOUND,\n                \"No order with id '$orderId'\",\n            )\n\n    @GetMapping\n    fun list(): List<Order> = repository.findAll()\n}","new_string":"package com.unityinflow.sample.order\n\nimport com.unityinflow.sample.api.ConflictException\nimport com.unityinflow.sample.api.ErrorCode\nimport com.unityinflow.sample.api.FieldViolation\nimport com.unityinflow.sample.api.ResourceNotFoundException\nimport com.unityinflow.sample.api.UnprocessableEntityException\nimport com.unityinflow.sample.api.ValidationException\nimport com.unityinflow.sample.customer.InMemoryCustomerRepository\nimport org.springframework.http.HttpStatus\nimport org.springframework.http.ResponseEntity\nimport org.springframework.web.bind.annotation.GetMapping\nimport org.springframework.web.bind.annotation.PathVariable\nimport org.springframework.web.bind.annotation.PostMapping\nimport org.springframework.web.bind.annotation.PutMapping\nimport org.springframework.web.bind.annotation.RequestBody\nimport org.springframework.web.bind.annotation.RequestMapping\nimport org.springframework.web.bind.annotation.RequestParam\nimport org.springframework.web.bind.annotation.RestController\n\n@RestController\n@RequestMapping(\"/orders\")\nclass OrderController(\n    private val repository: InMemoryOrderRepository,\n    private val customerRepository: InMemoryCustomerRepository,\n) {\n\n    @PostMapping\n    fun create(@RequestBody request: CreateOrderRequest): ResponseEntity<Order> {\n        if (repository.existsById(request.orderId)) {\n            throw ConflictException(\n                ErrorCode.ORDER_ALREADY_EXISTS,\n                \"An order with id '${request.orderId}' already exists\",\n            )\n        }\n\n        if (customerRepository.findById(request.customerId) == null) {\n            throw UnprocessableEntityException(\n                ErrorCode.CUSTOMER_NOT_FOUND,\n                \"No customer with id '${request.customerId}'\",\n            )\n        }\n\n        val quantity = request.quantity ?: 1\n        if (quantity < 1) {\n            throw ValidationException(\n                \"Invalid order quantity\",\n                listOf(FieldViolation(\"quantity\", \"quantity must be at least 1\")),\n            )\n        }\n\n        val fulfilment = FulfilmentStatus(0, 0, FulfilmentStatusType.UNALLOCATED)\n        val saved = repository.save(\n            Order(\n                request.orderId,\n                request.customerId,\n                request.amount,\n                request.currency,\n                quantity,\n                fulfilment,\n            ),\n        )\n        return ResponseEntity.status(HttpStatus.CREATED).body(saved)\n    }\n\n    @GetMapping(\"/{orderId}\")\n    fun getById(@PathVariable orderId: String): Order =\n        repository.findById(orderId)\n            ?: throw ResourceNotFoundException(\n                ErrorCode.ORDER_NOT_FOUND,\n                \"No order with id '$orderId'\",\n            )\n\n    @GetMapping\n    fun list(\n        @RequestParam(defaultValue = \"100\") limit: Int,\n        @RequestParam(defaultValue = \"0\") offset: Int,\n        @RequestParam(required = false) fulfilment: String?,\n    ): ResponseEntity<List<Order>> {\n        if (limit < 1 || limit > 100) {\n            throw ValidationException(\n                \"Invalid pagination limit\",\n                listOf(FieldViolation(\"limit\", \"limit must be between 1 and 100\")),\n            )\n        }\n        if (offset < 0) {\n            throw ValidationException(\n                \"Invalid pagination offset\",\n                listOf(FieldViolation(\"offset\", \"offset must be 0 or greater\")),\n            )\n        }\n\n        val fulfilmentStatus = fulfilment?.let {\n            try {\n                FulfilmentStatusType.valueOf(it)\n            } catch (e: IllegalArgumentException) {\n                throw ValidationException(\n                    \"Invalid fulfilment status\",\n                    listOf(FieldViolation(\"fulfilment\", \"invalid fulfilment status value\")),\n                )\n            }\n        }\n\n        val (orders, total) = repository.findAll(limit, offset, fulfilmentStatus)\n        return ResponseEntity.ok()\n            .header(\"X-Total-Count\", total.toString())\n            .body(orders)\n    }\n\n    @PutMapping(\"/{orderId}/quantity\")\n    fun updateQuantity(\n        @PathVariable orderId: String,\n        @RequestBody request: UpdateQuantityRequest,\n    ): Order {\n        val order = repository.findById(orderId)\n            ?: throw ResourceNotFoundException(\n                ErrorCode.ORDER_NOT_FOUND,\n                \"No order with id '$orderId'\",\n            )\n\n        if (request.quantity < 1) {\n            throw ValidationException(\n                \"Invalid order quantity\",\n                listOf(FieldViolation(\"quantity\", \"quantity must be at least 1\")),\n            )\n        }\n\n        val allocated = order.fulfilment.allocated\n        if (request.quantity < allocated) {\n            throw ConflictException(\n                ErrorCode.VALIDATION_FAILED,\n                \"Cannot reduce order quantity below allocated quantity\",\n            )\n        }\n\n        val fulfilmentStatus = when {\n            order.fulfilment.delivered >= request.quantity -> FulfilmentStatusType.DELIVERED\n            allocated >= request.quantity -> FulfilmentStatusType.FULLY_ALLOCATED\n            allocated > 0 -> FulfilmentStatusType.PARTIALLY_ALLOCATED\n            else -> FulfilmentStatusType.UNALLOCATED\n        }\n\n        val updated = order.copy(\n            quantity = request.quantity,\n            fulfilment = order.fulfilment.copy(status = fulfilmentStatus),\n        )\n        repository.update(updated)\n        return updated\n    }\n}"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8