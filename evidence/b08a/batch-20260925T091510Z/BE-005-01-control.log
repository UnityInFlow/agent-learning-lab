rderId: String): Order? = store[orderId]?.let { refreshFulfilment(it) }\n\n    fun findAll(\n        limit: Int = 100,\n        offset: Int = 0,\n        fulfilmentStatus: FulfilmentStatusType? = null,\n    ): Pair<List<Order>, Int> {\n        val allOrders = store.values\n            .map { refreshFulfilment(it) }\n            .sortedBy { it.orderId }\n\n        val filtered = if (fulfilmentStatus != null) {\n            allOrders.filter { it.fulfilment.status == fulfilmentStatus }\n        } else {\n            allOrders\n        }\n\n        val paged = filtered.drop(offset).take(limit)\n        return paged to filtered.size\n    }\n\n    fun update(order: Order): Order {\n        store[order.orderId] = order\n        return order\n    }\n\n    private fun refreshFulfilment(order: Order): Order {\n        val shipments = shipmentRepository.findByOrderId(order.orderId)\n        val allocated = shipments\n            .filter { it.status != ShipmentStatus.CANCELLED }\n            .sumOf { it.quantity }\n        val delivered = shipments\n            .filter { it.status == ShipmentStatus.DELIVERED }\n            .sumOf { it.quantity }\n\n        val status = when {\n            delivered >= order.quantity -> FulfilmentStatusType.DELIVERED\n            allocated >= order.quantity -> FulfilmentStatusType.FULLY_ALLOCATED\n            allocated > 0 -> FulfilmentStatusType.PARTIALLY_ALLOCATED\n            else -> FulfilmentStatusType.UNALLOCATED\n        }\n\n        val newFulfilment = FulfilmentStatus(allocated, delivered, status)\n        return if (order.fulfilment != newFulfilment) {\n            val updated = order.copy(fulfilment = newFulfilment)\n            store[order.orderId] = updated\n            updated\n        } else {\n            order\n        }\n    }\n\n    fun clear() = store.clear()\n}"}}}
