in id order`() {\n        mockMvc.perform(createShipment(\"S-b\")).andExpect(status().isCreated)\n        mockMvc.perform(createShipment(\"S-a\")).andExpect(status().isCreated)\n\n        mockMvc.perform(get(\"/shipments\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$[0].shipmentId\").value(\"S-a\"))\n            .andExpect(jsonPath(\"$[1].shipmentId\").value(\"S-b\"))\n    }\n}\n","structuredPatch":[{"oldStart":1,"oldLines":5,"newStart":1,"newLines":6,"lines":[" package com.unityinflow.sample.shipment"," ","+import com.unityinflow.sample.order.InMemoryOrderRepository"," import org.junit.jupiter.api.BeforeEach"," import org.junit.jupiter.api.Test"," import org.springframework.beans.factory.annotation.Autowired"]},{"oldStart":12,"oldLines":12,"newStart":13,"newLines":6,"lines":[" import org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath"," import org.springframework.test.web.servlet.result.MockMvcResultMatchers.status"," ","-/**","- * The shipment feature as it exists before BE-003.","- *","- * These are \"the existing tests\" for that benchmark: they must keep passing, and an agent","- * that breaks one has regressed the fixture rather than solved the task.","- */"," @SpringBootTest"," @AutoConfigureMockMvc"," class ShipmentControllerTest {"]},{"oldStart":28,"oldLines":8,"newStart":23,"newLines":14,"lines":["     @Autowired","     lateinit var repository: InMemoryShipmentRepository"," ","+    @Autowired","+    lateinit var orderRepository: InMemoryOrderRepository","+","     @BeforeEach","-    fun reset() = repository.clear()","+    fun reset() {","+        repository.clear()","+        orderRepository.clear()","+    }"," ","     private fun createShipment(shipmentId: String) =","         post(\"/shipments\")"]}],"userModified":false,"replaceAll":false}}
