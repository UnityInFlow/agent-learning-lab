String, Order>()\n\n    fun save(order: Order): Order {\n        store[order.orderId] = order\n        return order\n    }\n\n    fun existsById(orderId: String): Boolean = store.containsKey(orderId)\n\n    fun findById(orderId: String): Order? = store[orderId]?.let { refreshFulfilment(it) }\n\n    fun findAll(\n        limit: Int = 100,\n        offset: Int = 0,\n        fulfilmentStatus: FulfilmentStatusType? = null,\n    ): Pair<List<Order>, Int> {\n        val allOrders = store.values\n            .map { refreshFulfilment(it) }\n            .sortedBy { it.orderId }\n\n        val filtered = if (fulfilmentStatus != null) {\n            allOrders.filter { it.fulfilment.status == fulfilmentStatus }\n        } else {\n            allOrders\n        }\n\n        val paged = filtered.drop(offset).take(limit)\n        return paged to filtered.size\n    }\n\n    fun update(order: Order): Order {\n        store[order.orderId] = order\n        return order\n    }\n\n    private fun refreshFulfilment(order: Order): Order {\n        val shipments = shipmentRepository.findByOrderId(order.orderId)\n        val allocated = shipments\n            .filter { it.status != ShipmentStatus.CANCELLED }\n            .sumOf { it.quantity }\n        val delivered = shipments\n            .filter { it.status == ShipmentStatus.DELIVERED }\n            .sumOf { it.quantity }\n\n        val status = when {\n            delivered >= order.quantity -> FulfilmentStatusType.DELIVERED\n            allocated >= order.quantity -> FulfilmentStatusType.FULLY_ALLOCATED\n            allocated > 0 -> FulfilmentStatusType.PARTIALLY_ALLOCATED\n            else -> FulfilmentStatusType.UNALLOCATED\n        }\n\n        val newFulfilment = FulfilmentStatus(allocated, delivered, status)\n        return if (order.fulfilment != newFulfilment) {\n            val updated = order.copy(fulfilment = newFulfilment)\n            store[order.orderId] = updated\n            updated\n        } else {\n            order\n        }\n    }\n\n    fun clear() = store.clear()\n}","originalFile":"package com.unityinflow.sample.order\n\nimport java.util.concurrent.ConcurrentHashMap\nimport org.springframework.stereotype.Repository\n\n/**\n * In-memory for the same reason as the customer store: a benchmark fixture must start\n * with `./mvnw test` and no external infrastructure.\n */\n@Repository\nclass InMemoryOrderRepository {\n\n    private val store = ConcurrentHashMap<String, Order>()\n\n    fun save(order: Order): Order {\n        store[order.orderId] = order\n        return order\n    }\n\n    fun existsById(orderId: String): Boolean = store.containsKey(orderId)\n\n    fun findById(orderId: String): Order? = store[orderId]\n\n    fun findAll(): List<Order> = store.values.sortedBy { it.orderId }\n\n    fun clear() = store.clear()\n}\n","structuredPatch":[{"oldStart":1,"oldLines":14,"newStart":1,"newLines":14,"lines":[" package com.unityinflow.sample.order"," ","+import com.unityinflow.sample.shipment.ShipmentRepository","+import com.unityinflow.sample.shipment.ShipmentStatus"," import java.util.concurrent.ConcurrentHashMap"," import org.springframework.stereotype.Repository"," ","-/**","- * In-memory for the same reason as the customer store: a benchmark fixture must start","- * with `./mvnw test` and no external infrastructure.","- */"," @Repository","-class InMemoryOrderRepository {","+class InMemoryOrderRepository(","+    private val shipmentRepository: ShipmentRepository,","+) {"," ","     private val store = ConcurrentHashMap<String, Order>()"," "]},{"oldStart":19,"oldLines":9,"newStart":19,"newLines":57,"lines":[" ","     fun existsById(orderId: String): Boolean = store.containsKey(orderId)"," ","-    fun findById(orderId: String): Order? = store[orderId]","+    fun findById(orderId: String): Order? = store[orderId]?.let { refreshFulfilment(it) }"," ","-    fun findAll(): List<Order> = store.values.sortedBy { it.orderId }","+    fun findAll(","+        limit: Int = 100,","+    