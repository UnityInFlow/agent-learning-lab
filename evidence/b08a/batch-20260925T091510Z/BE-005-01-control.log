reater\")),\n            )\n        }\n\n        val (shipments, total) = repository.findAll(limit, offset)\n        return ResponseEntity.ok()\n            .header(\"X-Total-Count\", total.toString())\n            .body(shipments)\n    }\n\n    @PostMapping(\"/{shipmentId}/confirm\")\n    fun confirm(@PathVariable shipmentId: String): Shipment {\n        val shipment = repository.findById(shipmentId)\n            ?: throw ResourceNotFoundException(\n                ErrorCode.SHIPMENT_NOT_FOUND,\n                \"No shipment with id '$shipmentId'\",\n            )\n\n        if (shipment.status != ShipmentStatus.CREATED) {\n            throw ConflictException(\n                ErrorCode.VALIDATION_FAILED,\n                \"Cannot confirm a shipment in ${shipment.status} status\",\n            )\n        }\n\n        val updated = shipment.copy(status = ShipmentStatus.CONFIRMED)\n        repository.update(updated)\n        updateOrderFulfilment(shipment.orderId)\n        return updated\n    }\n\n    @PostMapping(\"/{shipmentId}/deliver\")\n    fun deliver(@PathVariable shipmentId: String): Shipment {\n        val shipment = repository.findById(shipmentId)\n            ?: throw ResourceNotFoundException(\n                ErrorCode.SHIPMENT_NOT_FOUND,\n                \"No shipment with id '$shipmentId'\",\n            )\n\n        if (shipment.status != ShipmentStatus.CONFIRMED) {\n            throw ConflictException(\n                ErrorCode.VALIDATION_FAILED,\n                \"Cannot deliver a shipment in ${shipment.status} status\",\n            )\n        }\n\n        val updated = shipment.copy(status = ShipmentStatus.DELIVERED)\n        repository.update(updated)\n        updateOrderFulfilment(shipment.orderId)\n        return updated\n    }\n\n    @PostMapping(\"/{shipmentId}/cancel\")\n    fun cancel(@PathVariable shipmentId: String): Shipment {\n        val shipment = repository.findById(shipmentId)\n            ?: throw ResourceNotFoundException(\n                ErrorCode.SHIPMENT_NOT_FOUND,\n                \"No shipment with id '$shipmentId'\",\n            )\n\n        if (shipment.status != ShipmentStatus.CREATED) {\n            throw ConflictException(\n                ErrorCode.VALIDATION_FAILED,\n                \"Cannot cancel a shipment in ${shipment.status} status\",\n            )\n        }\n\n        val updated = shipment.copy(status = ShipmentStatus.CANCELLED)\n        repository.update(updated)\n        updateOrderFulfilment(shipment.orderId)\n        return updated\n    }\n\n    private fun updateOrderFulfilment(orderId: String) {\n        val order = orderRepository.findById(orderId) ?: return\n        val shipments = repository.findByOrderId(orderId)\n\n        val allocated = shipments\n            .filter { it.status != ShipmentStatus.CANCELLED }\n            .sumOf { it.quantity }\n        val delivered = shipments\n            .filter { it.status == ShipmentStatus.DELIVERED }\n            .sumOf { it.quantity }\n\n        val status = when {\n            delivered >= order.quantity -> FulfilmentStatusType.DELIVERED\n            allocated >= order.quantity -> FulfilmentStatusType.FULLY_ALLOCATED\n            allocated > 0 -> FulfilmentStatusType.PARTIALLY_ALLOCATED\n            else -> FulfilmentStatusType.UNALLOCATED\n        }\n\n        val fulfilment = FulfilmentStatus(allocated, delivered, status)\n        orderRepository.update(order.copy(fulfilment = fulfilment))\n    }\n}"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":1692,"cache_read_input_tokens":59965,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1692},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"57a99e63-a5d9-44ef-930b-5a8cc28cba15","uuid":"e0