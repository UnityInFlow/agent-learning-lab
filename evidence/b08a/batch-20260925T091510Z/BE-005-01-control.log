 shipments\n            .filter { it.status != ShipmentStatus.CANCELLED }\n            .sumOf { it.quantity }\n        val delivered = shipments\n            .filter { it.status == ShipmentStatus.DELIVERED }\n            .sumOf { it.quantity }\n\n        val status = when {\n            delivered >= order.quantity -> FulfilmentStatusType.DELIVERED\n            allocated >= order.quantity -> FulfilmentStatusType.FULLY_ALLOCATED\n            allocated > 0 -> FulfilmentStatusType.PARTIALLY_ALLOCATED\n            else -> FulfilmentStatusType.UNALLOCATED\n        }\n\n        val newFulfilment = FulfilmentStatus(allocated, delivered, status)\n        return if (order.fulfilment != newFulfilment) {\n            val updated = order.copy(fulfilment = newFulfilment)\n            store[order.orderId] = updated\n            updated\n        } else {\n            order\n        }\n    }\n\n    fun clear() = store.clear()\n}\n","structuredPatch":[{"oldStart":1,"oldLines":14,"newStart":1,"newLines":10,"lines":[" package com.unityinflow.sample.order"," ","-import com.unityinflow.sample.shipment.ShipmentRepository","-import com.unityinflow.sample.shipment.ShipmentStatus"," import java.util.concurrent.ConcurrentHashMap"," import org.springframework.stereotype.Repository"," "," @Repository","-class InMemoryOrderRepository(","-    private val shipmentRepository: ShipmentRepository,","-) {","+class InMemoryOrderRepository {"," ","     private val store = ConcurrentHashMap<String, Order>()"," "]},{"oldStart":19,"oldLines":16,"newStart":15,"newLines":14,"lines":[" ","     fun existsById(orderId: String): Boolean = store.containsKey(orderId)"," ","-    fun findById(orderId: String): Order? = store[orderId]?.let { refreshFulfilment(it) }","+    fun findById(orderId: String): Order? = store[orderId]"," ","     fun findAll(","         limit: Int = 100,","         offset: Int = 0,","         fulfilmentStatus: FulfilmentStatusType? = null,","     ): Pair<List<Order>, Int> {","-        val allO