HttpStatus,\n    val code: ErrorCode,\n    override val message: String,\n    val fields: List<FieldViolation> = emptyList(),\n) : RuntimeException(message)\n\n/** The addressed resource does not exist → 404. */\nclass ResourceNotFoundException(code: ErrorCode, message: String) :\n    ApiException(HttpStatus.NOT_FOUND, code, message)\n\n/** The request conflicts with the current state of the resource → 409. */\nclass ConflictException(code: ErrorCode, message: String) :\n    ApiException(HttpStatus.CONFLICT, code, message)\n\n/** The request violates a business rule → 422. */\nclass UnprocessableEntityException(code: ErrorCode, message: String) :\n    ApiException(HttpStatus.UNPROCESSABLE_ENTITY, code, message)\n\n/** The request is well-formed but violates a rule of the domain → 400. */\nclass ValidationException(\n    message: String,\n    fields: List<FieldViolation> = emptyList(),\n) : ApiException(HttpStatus.BAD_REQUEST, ErrorCode.VALIDATION_FAILED, message, fields)"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":895,"cache_read_input_tokens":24934,"cache_creation":{"ephemeral_5m_input_tokens":895,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":"toolu_01Xbczsa8JbWn9K7KTEHayLs","session_id":"2c44d6de-0b17-43ec-8f31-47c64a720500","uuid":"08444bb2-78c7-4868-a77d-0217965dd9bf","timestamp":"2026-09-25T12:43:51.979Z","request_id":"req_011CfQBGZPhmvVsZbJTf2P4Q","subagent_type":"implementer","task_description":"Implement BE-005 ticket"}
