{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011BajHuMoafUw46KkXvsWeM","type":"tool_result","content":"1\tpackage com.unityinflow.sample.order\n2\t\n3\timport com.unityinflow.sample.customer.InMemoryCustomerRepository\n4\timport com.unityinflow.sample.shipment.InMemoryShipmentRepository\n5\timport org.junit.jupiter.api.BeforeEach\n6\timport org.junit.jupiter.api.Test\n7\timport org.springframework.beans.factory.annotation.Autowired\n8\timport org.springframework.boot.test.context.SpringBootTest\n9\timport org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc\n10\timport org.springframework.http.MediaType\n11\timport org.springframework.test.web.servlet.MockMvc\n12\timport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get\n13\timport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post\n14\timport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.put\n15\timport org.springframework.test.web.servlet.result.MockMvcResultMatchers.header\n16\timport org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath\n17\timport org.springframework.test.web.servlet.result.MockMvcResultMatchers.status\n18\t\n19\t/**\n20\t * Baseline behaviour of the order feature. BE-002 must not break any of these.\n21\t *\n22\t * Note how the failure cases assert the response *body*, not just the status: the error\n23\t * envelope is part of the API contract, so a change that returns the right status with\n24\t * the wrong shape is a breaking change for clients.\n25\t */\n26\t@SpringBootTest\n27\t@AutoConfigureMockMvc\n28\tclass OrderControllerTest {\n29\t\n30\t    @Autowired\n31\t    lateinit var mockMvc: MockMvc\n32\t\n33\t    @Autowired\n34\t    lateinit var repository: InMemoryOrderRepository\n35\t\n36\t    @Autowired\n37\t    lateinit var customerRepository: InMemoryCustomerRepository\n38\t\n39\t    @Autowired\n40\t    lateinit var shipmentRepository: InMemoryShipmentRepository\n41\t\n42\t    @BeforeEach\n43\t    fun reset() {\n44\t        repository.clear()\n45\t        customerRepository.clear()\n46\t        shipmentRepository.clear()\n47\t    }\n48\t\n49\t    private fun createCustomer(customerId: String = \"C-1\") =\n50\t        post(\"/customers\")\n51\t            .contentType(MediaType.APPLICATION_JSON)\n52\t            .content(\"\"\"{\"customerId\":\"$customerId\",\"name\":\"Test Customer\",\"email\":\"test@example.com\"}\"\"\")\n53\t\n54\t    private fun createOrder(orderId: String, customerId: String = \"C-1\", amount: String = \"49.90\", quantity: String = \"1\") =\n55\t        post(\"/orders\")\n56\t            .contentType(MediaType.APPLICATION_JSON)\n57\t            .content(\n58\t                \"\"\"{\"orderId\":\"$orderId\",\"customerId\":\"$customerId\",\"amount\":$amount,\"currency\":\"EUR\",\"quantity\":$quantity}\"\"\",\n59\t            )\n60\t\n61\t    @Test\n62\t    fun `creates an order and returns 201`() {\n63\t        mockMvc.perform(createCustomer(\"C-1\")).andExpect(status().isCreated)\n64\t        mockMvc.perform(createOrder(\"O-1\"))\n65\t            .andExpect(status().isCreated)\n66\t            .andExpect(jsonPath(\"$.orderId\").value(\"O-1\"))\n67\t    }\n68\t\n69\t    @Test\n70\t    fun `reads back a created order`() {\n71\t        mockMvc.perform(createCustomer(\"C-1\")).andExpect(status().isCreated)\n72\t        mockMvc.perform(createOrder(\"O-2\")).andExpect(status().isCreated)\n73\t\n74\t        mockMvc.perform(get(\"/orders/O-2\"))\n75\t            .andExpect(status().isOk)\n76\t            .andExpect(jsonPath(\"$.currency\").value(\"EUR\"))\n77\t    }\n78\t\n79\t    @Test\n80\t    fun `returns 404 with the error envelope for an unknown order`() {\n81\t        mockMvc.perform(get(\"/orders/does-not-exist\"))\n82\t            .andExpect(status().isNotFound)\n83\t            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_NOT_FOUND\"))\n84\t            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n85\t    }\n86\t\n87\t    @Test\n88\t    fun `returns 409 with the error envelope for a duplicate order id`() {\n89\t        mockMvc.perform(createCustomer(\"C-1\")).andExpect(status().isCreated)\n90\t        mockMvc.perform(createOrder(\"O-3\")).andExpect(status().isCreated)\n91\t\n92\t        mockMvc.perform(createOrder(\"O-3\"))\n93\t            .andExpect(status().isConflict)\n94\t            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_ALREADY_EXISTS\"))\n95\t            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n96\t    }\n97\t\n98\t    @Test\n99\t    fun `rejects order for non-existent customer with 422`() {\n100\t        mockMvc.perform(createOrder(\"O-1\", customerId = \"C-nonexistent\"))\n101\t            .andExpect(status().isUnprocessableEntity)\n102\t            .andExpect(jsonPath(\"$.error.code\").value(\"CUSTOMER_REQUIRED\"))\n103\t    }\n104\t\n105\t    @Test\n106\t    fun `includes quantity in order response`() {\n107\t        mockMvc.perform(createCustomer(\"C-1\")).andExpect(status().isCreated)\n108\t        mockMvc.perform(createOrder(\"O-1\", quantity = \"5\"))\n109\t            .andExpect(status().isCreated)\n110\t            .andExpect(jsonPath(\"$.quantity\").value(5))\n111\t    }\n112\t\n113\t    @Test\n114\t    fun `includes fulfilment in order response`() {\n115\t        mockMvc.perform(createCustomer(\"C-1\")).andExpect(status().isCreated)\n116\t        mockMvc.perform(createOrder(\"O-1\", quantity = \"5\"))\n117\t            .andExpect(status().isCreated)\n118\t            .andExpect(jsonPath(\"$.fulfilment.allocated\").value(0))\n119\t            .andExpect(jsonPath(\"$.fulfilment.delivered\").value(0))\n120\t            .andExpect(jsonPath(\"$.fulfilment.status\").value(\"UNALLOCATED\"))\n121\t    }\n122\t\n123\t    @Test\n124\t    fun `defaults quantity to 1 when not provided`() {\n125\t        mockMvc.perform(createCustomer(\"C-1\")).andExpect(status().isCreated)\n126\t        mockMvc.perform(\n127\t            post(\"/orders\")\n128\t                .contentType(MediaType.APPLICATION_JSON)\n129\t                .content(\"\"\"{\"orderId\":\"O-1\",\"customerId\":\"C-1\",\"amount\":49.90,\"currency\":\"EUR\"}\"\"\"),\n130\t        )\n131\t            .andExpect(status().isCreated)\n132\t            .andExpect(jsonPath(\"$.quantity\").value(1))\n133\t    }\n134\t\n135\t    @Test\n136\t    fun `rejects order with invalid quantity`() {\n137\t        mockMvc.perform(createCustomer(\"C-1\")).andExpect(status().isCreated)\n138\t        mockMvc.perform(createOrder(\"O-1\", quantity = \"0\"))\n139\t            .andExpect(status().isBadRequest)\n140\t            .andExpect(jsonPath(\"$.error.code\").value(\"VALIDATION_FAILED\"))\n141\t    }\n142\t\n143\t    @Test\n144\t    fun `lists orders with pagination`() {\n145\t        mockMvc.perform(createCustomer(\"C-1\")).andExpect(status().isCreated)\n146\t        mockMvc.perform(createOrder(\"O-1\")).andExpect(status().isCreated)\n147\t        mockMvc.perform(createOrder(\"O-2\")).andExpect(status().isCreated)\n148\t        mockMvc.perform(createOrder(\"O-3\")).andExpect(status().isCreated)\n149\t\n150\t        mockMvc.perform(get(\"/orders?limit=2&offset=0\"))\n151\t            .andExpect(status().isOk)\n152\t            .andExpect(header().exists(\"X-Total-Count\"))\n153\t            .andExpect(header().string(\"X-Total-Count\", \"3\"))\n154\t    }\n155\t\n156\t    @Test\n157\t    fun `lists orders filtered by fulfilment status`() {\n158\t        mockMvc.perform(createCustomer(\"C-1\")).andExpect(status().isCreated)\n159\t        mockMvc.perform(createOrder(\"O-1\", quantity = \"1\")).andExpect(status().isCreated)\n160\t        mockMvc.perform(createOrder(\"O-2\", quantity = \"1\")).andExpect(status().isCreated)\n161\t\n162\t        mockMvc.perform(get(\"/orders?fulfilment=UNALLOCATED\"))\n163\t            .andExpect(status().isOk)\n164\t            .andExpect(header().string(\"X-Total-Count\", \"2\"))\n165\t    }\n166\t\n167\t    @Test\n168\t    fun `rejects invalid pagination parameters`() {\n169\t        mockMvc.perform(get(\"/orders?limit=0\"))\n170\t            .andExpect(status().isBadRequest)\n171\t            .andExpect(jsonPath(\"$.error.code\").value(\"VALIDATION_FAILED\"))\n172\t    }\n173\t\n174\t    @Test\n175\t    fun `updates order quantity`() {\n176\t        mockMvc.perform(createCustomer(\"C-1\")).andExpect(status().isCreated)\n177\t        mockMvc.perform(createOrder(\"O-1\", quantity = \"5\")).andExpect(status().isCreated)\n178\t\n179\t        mockMvc.perform(\n180\t            put(\"/orders/O-1/quantity\")\n181\t                .contentType(MediaType.APPLICATION_JSON)\n182\t                .content(\"\"\"{\"quantity\":10}\"\"\"),\n183\t        )\n184\t            .andExpect(status().isOk)\n185\t            .andExpect(jsonPath(\"$.quantity\").value(10))\n186\t    }\n187\t\n188\t    @Test\n189\t    fun `rejects quantity reduction below allocated shipments`() {\n190\t        mockMvc.perform(createCustomer(\"C-1\")).andExpect(status().isCreated)\n191\t        mockMvc.perform(createOrder(\"O-1\", quantity = \"10\")).andExpect(status().isCreated)\n192\t\n193\t        // Create a shipment for 5 units\n194\t        mockMvc.perform(\n195\t            post(\"/shipments\")\n196\t                .contentType(MediaType.APPLICATION_JSON)\n197\t                .content(\"\"\"{\"shipmentId\":\"S-1\",\"orderId\":\"O-1\",\"carrier\":\"DHL\",\"quantity\":5}\"\"\"),\n198\t        ).andExpect(status().isCreated)\n199\t\n200\t        // Try to reduce quantity to 3\n201\t        mockMvc.perform(\n202\t            put(\"/orders/O-1/quantity\")\n203\t                .contentType(MediaType.APPLICATION_JSON)\n204\t                .content(\"\"\"{\"quantity\":3}\"\"\"),\n205\t        )\n206\t            .andExpect(status().isConflict)\n207\t            .andExpect(jsonPath(\"$.error.code\").value(\"ALLOCATION_CONFLICT\"))\n208\t    }\n209\t}\n210\t"}]},"parent_tool_use_id":"toolu_01R461DzgmAU