{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MUjHMfQMoyRpeXY4B75AcM","type":"tool_result","content":"1\tpackage com.unityinflow.sample.order\n2\t\n3\timport com.unityinflow.sample.customer.InMemoryCustomerRepository\n4\timport com.unityinflow.sample.shipment.InMemoryShipmentRepository\n5\timport org.junit.jupiter.api.BeforeEach\n6\timport org.junit.jupiter.api.Test\n7\timport org.springframework.beans.factory.annotation.Autowired\n8\timport org.springframework.boot.test.context.SpringBootTest\n9\timport org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc\n10\timport org.springframework.http.MediaType\n11\timport org.springframework.test.web.servlet.MockMvc\n12\timport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get\n13\timport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post\n14\timport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.put\n15\timport org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath\n16\timport org.springframework.test.web.servlet.result.MockMvcResultMatchers.status\n17\t\n18\t/**\n19\t * Baseline behaviour of the order feature. BE-002 must not break any of these.\n20\t *\n21\t * Note how the failure cases assert the response *body*, not just the status: the error\n22\t * envelope is part of the API contract, so a change that returns the right status with\n23\t * the wrong shape is a breaking change for clients.\n24\t */\n25\t@SpringBootTest\n26\t@AutoConfigureMockMvc\n27\tclass OrderControllerTest {\n28\t\n29\t    @Autowired\n30\t    lateinit var mockMvc: MockMvc\n31\t\n32\t    @Autowired\n33\t    lateinit var repository: InMemoryOrderRepository\n34\t\n35\t    @Autowired\n36\t    lateinit var customerRepository: InMemoryCustomerRepository\n37\t\n38\t    @Autowired\n39\t    lateinit var shipmentRepository: InMemoryShipmentRepository\n40\t\n41\t    @BeforeEach\n42\t    fun reset() {\n43\t        repository.clear()\n44\t        customerRepository.clear()\n45\t        shipmentRepository.clear()\n46\t        // Create a test customer for use in tests\n47\t        mockMvc.perform(\n48\t            post(\"/customers\")\n49\t                .contentType(MediaType.APPLICATION_JSON)\n50\t                .content(\"\"\"{\"customerId\":\"C-1\",\"name\":\"Test Customer\",\"email\":\"test@example.com\"}\"\"\"),\n51\t        )\n52\t    }\n53\t\n54\t    private fun createOrder(orderId: String, amount: String = \"49.90\", quantity: Int? = null) =\n55\t        post(\"/orders\")\n56\t            .contentType(MediaType.APPLICATION_JSON)\n57\t            .content(\n58\t                if (quantity != null) {\n59\t                    \"\"\"{\"orderId\":\"$orderId\",\"customerId\":\"C-1\",\"amount\":$amount,\"currency\":\"EUR\",\"quantity\":$quantity}\"\"\"\n60\t                } else {\n61\t                    \"\"\"{\"orderId\":\"$orderId\",\"customerId\":\"C-1\",\"amount\":$amount,\"currency\":\"EUR\"}\"\"\"\n62\t                }\n63\t            )\n64\t\n65\t    @Test\n66\t    fun `creates an order and returns 201`() {\n67\t        mockMvc.perform(createOrder(\"O-1\"))\n68\t            .andExpect(status().isCreated)\n69\t            .andExpect(jsonPath(\"$.orderId\").value(\"O-1\"))\n70\t    }\n71\t\n72\t    @Test\n73\t    fun `reads back a created order`() {\n74\t        mockMvc.perform(createOrder(\"O-2\")).andExpect(status().isCreated)\n75\t\n76\t        mockMvc.perform(get(\"/orders/O-2\"))\n77\t            .andExpect(status().isOk)\n78\t            .andExpect(jsonPath(\"$.currency\").value(\"EUR\"))\n79\t    }\n80\t\n81\t    @Test\n82\t    fun `returns 404 with the error envelope for an unknown order`() {\n83\t        mockMvc.perform(get(\"/orders/does-not-exist\"))\n84\t            .andExpect(status().isNotFound)\n85\t            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_NOT_FOUND\"))\n86\t            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n87\t    }\n88\t\n89\t    @Test\n90\t    fun `returns 409 with the error envelope for a duplicate order id`() {\n91\t        mockMvc.perform(createOrder(\"O-3\")).andExpect(status().isCreated)\n92\t\n93\t        mockMvc.perform(createOrder(\"O-3\"))\n94\t            .andExpect(status().isConflict)\n95\t            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_ALREADY_EXISTS\"))\n96\t            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n97\t    }\n98\t\n99\t    @Test\n100\t    fun `returns 422 when order references unknown customer`() {\n101\t        mockMvc.perform(\n102\t            post(\"/orders\")\n103\t                .contentType(MediaType.APPLICATION_JSON)\n104\t                .content(\"\"\"{\"orderId\":\"O-new\",\"customerId\":\"C-unknown\",\"amount\":\"49.90\",\"currency\":\"EUR\"}\"\"\"),\n105\t        )\n106\t            .andExpect(status().`is`(422))\n107\t            .andExpect(jsonPath(\"$.error.code\").value(\"CUSTOMER_NOT_FOUND\"))\n108\t    }\n109\t\n110\t    @Test\n111\t    fun `order has default quantity of 1`() {\n112\t        mockMvc.perform(createOrder(\"O-qty-default\"))\n113\t            .andExpect(status().isCreated)\n114\t\n115\t        mockMvc.perform(get(\"/orders/O-qty-default\"))\n116\t            .andExpect(status().isOk)\n117\t            .andExpect(jsonPath(\"$.quantity\").value(1))\n118\t    }\n119\t\n120\t    @Test\n121\t    fun `order accepts explicit quantity`() {\n122\t        mockMvc.perform(createOrder(\"O-qty-5\", quantity = 5))\n123\t            .andExpect(status().isCreated)\n124\t\n125\t        mockMvc.perform(get(\"/orders/O-qty-5\"))\n126\t            .andExpect(status().isOk)\n127\t            .andExpect(jsonPath(\"$.quantity\").value(5))\n128\t    }\n129\t\n130\t    @Test\n131\t    fun `returns 400 for invalid quantity`() {\n132\t        mockMvc.perform(createOrder(\"O-invalid-qty\", quantity = 0))\n133\t            .andExpect(status().isBadRequest)\n134\t            .andExpect(jsonPath(\"$.error.code\").value(\"VALIDATION_FAILED\"))\n135\t    }\n136\t\n137\t    @Test\n138\t    fun `order initializes with UNALLOCATED fulfillment status`() {\n139\t        mockMvc.perform(createOrder(\"O-fulfilment\"))\n140\t            .andExpect(status().isCreated)\n141\t\n142\t        mockMvc.perform(get(\"/orders/O-fulfilment\"))\n143\t            .andExpect(status().isOk)\n144\t            .andExpect(jsonPath(\"$.fulfilment.status\").value(\"UNALLOCATED\"))\n145\t            .andExpect(jsonPath(\"$.fulfilment.allocated\").value(0))\n146\t            .andExpect(jsonPath(\"$.fulfilment.delivered\").value(0))\n147\t    }\n148\t\n149\t    @Test\n150\t    fun `amends order quantity`() {\n151\t        mockMvc.perform(createOrder(\"O-amend\", quantity = 5))\n152\t            .andExpect(status().isCreated)\n153\t\n154\t        mockMvc.perform(\n155\t            put(\"/orders/O-amend/quantity\")\n156\t                .contentType(MediaType.APPLICATION_JSON)\n157\t                .content(\"\"\"{\"quantity\":10}\"\"\"),\n158\t        )\n159\t            .andExpect(status().isOk)\n160\t            .andExpect(jsonPath(\"$.quantity\").value(10))\n161\t    }\n162\t\n163\t    @Test\n164\t    fun `rejects amendment to invalid quantity`() {\n165\t        mockMvc.perform(createOrder(\"O-amend-invalid\", quantity = 5))\n166\t            .andExpect(status().isCreated)\n167\t\n168\t        mockMvc.perform(\n169\t            put(\"/orders/O-amend-invalid/quantity\")\n170\t                .contentType(MediaType.APPLICATION_JSON)\n171\t                .content(\"\"\"{\"quantity\":0}\"\"\"),\n172\t        )\n173\t            .andExpect(status().isBadRequest)\n174\t    }\n175\t\n176\t    @Test\n177\t    fun `rejects amendment below allocated quantity`() {\n178\t        mockMvc.perform(createOrder(\"O-amend-below\", quantity = 10))\n179\t            .andExpect(status().isCreated)\n180\t\n181\t        // Create a shipment to allocate 5 units\n182\t        mockMvc.perform(\n183\t            post(\"/shipments\")\n184\t                .contentType(MediaType.APPLICATION_JSON)\n185\t                .content(\"\"\"{\"shipmentId\":\"S-1\",\"orderId\":\"O-amend-below\",\"carrier\":\"DHL\",\"quantity\":5}\"\"\"),\n186\t        ).andExpect(status().isCreated)\n187\t\n188\t        // Try to reduce quantity to 3 (below allocated 5)\n189\t        mockMvc.perform(\n190\t            put(\"/orders/O-amend-below/quantity\")\n191\t                .contentType(MediaType.APPLICATION_JSON)\n192\t                .content(\"\"\"{\"quantity\":3}\"\"\"),\n193\t        )\n194\t            .andExpect(status().isConflict)\n195\t    }\n196\t\n197\t    @Test\n198\t    fun `lists orders with pagination`() {\n199\t        mockMvc.perform(createOrder(\"O-page-1\")).andExpect(status().isCreated)\n200\t        mockMvc.perform(createOrder(\"O-page-2\")).andExpect(status().isCreated)\n201\t\n202\t        mockMvc.perform(get(\"/orders?limit=1&offset=0\"))\n203\t            .andExpect(status().isOk)\n204\t            .andExpect(jsonPath(\"$[0].orderId\").value(\"O-page-1\"))\n205\t            .andExpect(jsonPath(\"$.length()\").value(1))\n206\t    }\n207\t\n208\t    @Test\n209\t    fun `pagination header contains total count`() {\n210\t        mockMvc.perform(createOrder(\"O-header-1\")).andExpect(status().isCreated)\n211\t        mockMvc.perform(createOrder(\"O-header-2\")).andExpect(status().isCreated)\n212\t        mockMvc.perform(createOrder(\"O-header-3\")).andExpect(status().isCreated)\n213\t\n214\t        mockMvc.perform(get(\"/orders?limit=2&offset=0\"))\n215\t            .andExpect(status().isOk)\n216\t            .andExpect { result ->\n217\t                assert(result.response.getHeader(\"X-Total-Count\") == \"3\")\n218\t            }\n219\t    }\n220\t\n221\t    @Test\n222\t    fun `rejects invalid pagination limit`() {\n223\t        mockMvc.perform(get(\"/orders?limit=200\"))\n224\t            .andExpect(status().isBadRequest)\n225\t            .andExpect(jsonPath(\"$.error.code\").value(\"VALIDATION_FAILED\"))\n226\t    }\n227\t\n228\t    @Test\n229\t    fun `rejects negative offset`() {\n230\t        mockMvc.perform(get(\"/orders?offset=-1\"))\n231\t            .andExpect(status().isBadRequest)\n232\t            .andExpect(jsonPath(\"$.error.code\").value(\"VALIDATION_FAILED\"))\n233\t    }\n234\t\n235\t    @Test\n236\t    fun `filters orders by fulfillment status`() {\n237\t        mockMvc.perform(createOrder(\"O-unalloc\", quantity = 5)).andExpect(status().isCreated)\n238\t        mockMvc.perform(createOrder(\"O-partial\", quantity = 10)).andExpect(status().isCreated)\n239\t\n240\t        // Create a shipment to allocate the second order\n241\t        mockMvc.perform(\n242\t            post(\"/shipments\")\n243\t                .contentType(MediaType.APPLICATION_JSON)\n244\t                .content(\"\"\"{\"shipmentId\":\"S-filter\",\"orderId\":\"O-partial\",\"carrier\":\"DHL\",\"quantity\":5}\"\"\"),\n245\t        ).andExpect(status().isCreated)\n246\t\n247\t        mockMvc.perform(get(\"/orders?fulfilment=UNALLOCATED\"))\n248\t            .andExpect(status().isOk)\n249\t            .andExpect(jsonPath(\"$[0].orderId\").value(\"O-unalloc\"))\n250\t            .andExpect(jsonPath(\"$.length()\").value(1))\n251\t    }\n252\t\n253\t    @Test\n254\t    fun `rejects invalid fulfillment status filter`() {\n255\t        mockMvc.perform(get(\"/orders?fulfilment=INVALID\"))\n256\t            .andExpect(status().isBadRequest)\n257\t            .andExpect(jsonPath(\"$.error.code\").value(\"VALIDATION_FAILED\"))\n258\t    }\n259\t}\n260\t"}]},"parent_tool_use_id":"toolu_012t9mojqG6KNaKQw3Fo778i","session_id":"1bd79e49-f141-44f7-9deb-c27270448e07","uuid":"5fc30327-70e3-4536-96b8-ee4d678a6e7c","timestamp":"2026-09-25T10:23:48.970Z","subagent_type":"verifier","task_description":"Verify BE-005 implementation"}
