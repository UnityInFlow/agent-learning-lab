  @Test\n    fun `reads back a created customer`() {\n        mockMvc.perform(\n            post(\"/customers\")\n                .contentType(MediaType.APPLICATION_JSON)\n                .content(\"\"\"{\"customerId\":\"C-2\",\"name\":\"Grace Hopper\",\"email\":\"grace@example.com\"}\"\"\"),\n        ).andExpect(status().isCreated)\n\n        mockMvc.perform(get(\"/customers/C-2\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.name\").value(\"Grace Hopper\"))\n    }\n\n    @Test\n    fun `returns 404 with the error envelope for an unknown customer`() {\n        mockMvc.perform(get(\"/customers/does-not-exist\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"CUSTOMER_NOT_FOUND\"))\n            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n    }\n}","new_string":"package com.unityinflow.sample.customer\n\nimport org.junit.jupiter.api.BeforeEach\nimport org.junit.jupiter.api.Test\nimport org.springframework.beans.factory.annotation.Autowired\nimport org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc\nimport org.springframework.boot.test.context.SpringBootTest\nimport org.springframework.http.MediaType\nimport org.springframework.test.web.servlet.MockMvc\nimport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get\nimport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post\nimport org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath\nimport org.springframework.test.web.servlet.result.MockMvcResultMatchers.status\n\n/**\n * Baseline behaviour of the fixture. BE-001 must not break any of these.\n */\n@SpringBootTest\n@AutoConfigureMockMvc\nclass CustomerControllerTest {\n\n    @Autowired\n    lateinit var mockMvc: MockMvc\n\n    @Autowired\n    lateinit var repository: InMemoryCustomerRepository\n\n    @BeforeEach\n    fun reset() = repository.clear()\n\n    @Test\n    fun `creates a customer and returns 201`() {\n        mockMvc.perform(\n            post(\"/customers\")\n                .contentType(MediaType.APPLICATION_JSON)\n                .content(\"\"\"{\"customerId\":\"C-1\",\"name\":\"Ada Lovelace\",\"email\":\"ada@example.com\"}\"\"\"),\n        )\n            .andExpect(status().isCreated)\n            .andExpect(jsonPath(\"$.customerId\").value(\"C-1\"))\n    }\n\n    @Test\n    fun `reads back a created customer`() {\n        mockMvc.perform(\n            post(\"/customers\")\n                .contentType(MediaType.APPLICATION_JSON)\n                .content(\"\"\"{\"customerId\":\"C-2\",\"name\":\"Grace Hopper\",\"email\":\"grace@example.com\"}\"\"\"),\n        ).andExpect(status().isCreated)\n\n        mockMvc.perform(get(\"/customers/C-2\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.name\").value(\"Grace Hopper\"))\n    }\n\n    @Test\n    fun `returns 404 with the error envelope for an unknown customer`() {\n        mockMvc.perform(get(\"/customers/does-not-exist\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"CUSTOMER_NOT_FOUND\"))\n            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n    }\n\n    @Test\n    fun `lists customers with pagination`() {\n        mockMvc.perform(\n            post(\"/customers\")\n                .contentType(MediaType.APPLICATION_JSON)\n                .content(\"\"\"{\"customerId\":\"C-page-1\",\"name\":\"Customer 1\",\"email\":\"c1@example.com\"}\"\"\"),\n        ).andExpect(status().isCreated)\n        mockMvc.perform(\n            post(\"/customers\")\n                .contentType(MediaType.APPLICATION_JSON)\n                .content(\"\"\"{\"customerId\":\"C-page-2\",\"name\":\"Customer 2\",\"email\":\"c2@example.com\"}\"\"\"),\n        ).andExpect(status().isCreated)\n\n        mockMvc.perform(get(\"/customers?limit=1&offset=0\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$[0].customerId\").value(\"C-page-1\"))\n            .andExpect(jsonPath(\"$.length()\").value(1))\n    }\n\n    @Test\n    fun `customer pagination header contains total count`() {\n        mockMvc.perform(\n            post(\"/customers\")\n                .contentType(MediaType.APPLICATION_JSON)\n                .content(\"\"\"{\"customerId\":\"C-header-1\",\"name\":\"Customer 1\",\"email\":\"c1@example.com\"}\"\"\"),\n        ).andExpect(status().isCreated)\n        mockMvc.perform(\n            post(\"/customers\")\n                .contentType(MediaType.APPLICATION_JSON)\n                .content(\"\"\"{\"customerId\":\"C-header-2\",\"name\":\"Customer 2\",\"email\":\"c2@example.com\"}\"\"\"),\n        ).andExpect(status().isCreated)\n\n        mockMvc.perform(get(\"/customers?limit=1&offset=0\"))\n            .andExpect(status().isOk)\n            .andExpect { result ->\n                assert(result.response.getHeader(\"X-Total-Count\") == \"2\")\n            }\n    }\n\n    @Test\n    fun `rejects invalid pagination limit for customers`() {\n        mockMvc.perform(get(\"/customers?limit=200\"))\n            .andExpect(status().isBadRequest)\n            .andExpect(jsonPath(\"$.error.code\").value(\"VALIDATION_FAILED\"))\n    }\n\n    @Test\n    fun `rejects negative offset for customers`() {\n        mockMvc.perform(get(\"/customers?offset=-1\"))\n            .andExpect(status().isBadRequest)\n            .andExpect(jsonPath(\"$.error.code\").value(\"VALIDATION_FAILED\"))\n    }\n}"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":4116,"cache_read_input_tokens":48919,"cache_creation":{"ephemeral_5m_input_tokens":4116,"ephemeral_1h_input_tokens":0},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":"toolu_01LcDmQbRtv8hU