{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CBCZFQ7pfepvcGY6xLSaMn","type":"tool_result","content":"1\tpackage com.unityinflow.sample.shipment\n2\t\n3\timport com.unityinflow.sample.order.InMemoryOrderRepository\n4\timport com.unityinflow.sample.customer.InMemoryCustomerRepository\n5\timport org.junit.jupiter.api.BeforeEach\n6\timport org.junit.jupiter.api.Test\n7\timport org.springframework.beans.factory.annotation.Autowired\n8\timport org.springframework.boot.test.context.SpringBootTest\n9\timport org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc\n10\timport org.springframework.http.MediaType\n11\timport org.springframework.test.web.servlet.MockMvc\n12\timport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get\n13\timport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post\n14\timport org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath\n15\timport org.springframework.test.web.servlet.result.MockMvcResultMatchers.status\n16\timport java.math.BigDecimal\n17\t\n18\t/**\n19\t * The shipment feature as it exists before BE-003.\n20\t *\n21\t * These are \"the existing tests\" for that benchmark: they must keep passing, and an agent\n22\t * that breaks one has regressed the fixture rather than solved the task.\n23\t */\n24\t@SpringBootTest\n25\t@AutoConfigureMockMvc\n26\tclass ShipmentControllerTest {\n27\t\n28\t    @Autowired\n29\t    lateinit var mockMvc: MockMvc\n30\t\n31\t    @Autowired\n32\t    lateinit var repository: InMemoryShipmentRepository\n33\t\n34\t    @Autowired\n35\t    lateinit var orderRepository: InMemoryOrderRepository\n36\t\n37\t    @Autowired\n38\t    lateinit var customerRepository: InMemoryCustomerRepository\n39\t\n40\t    @BeforeEach\n41\t    fun reset() {\n42\t        repository.clear()\n43\t        orderRepository.clear()\n44\t        customerRepository.clear()\n45\t        // Create test customer and order\n46\t        mockMvc.perform(\n47\t            post(\"/customers\")\n48\t                .contentType(MediaType.APPLICATION_JSON)\n49\t                .content(\"\"\"{\"customerId\":\"C-1\",\"name\":\"Test Customer\",\"email\":\"test@example.com\"}\"\"\"),\n50\t        )\n51\t        mockMvc.perform(\n52\t            post(\"/orders\")\n53\t                .contentType(MediaType.APPLICATION_JSON)\n54\t                .content(\"\"\"{\"orderId\":\"O-1\",\"customerId\":\"C-1\",\"amount\":\"100.00\",\"currency\":\"EUR\",\"quantity\":10}\"\"\"),\n55\t        )\n56\t    }\n57\t\n58\t    private fun createShipment(shipmentId: String, quantity: Int? = null) =\n59\t        post(\"/shipments\")\n60\t            .contentType(MediaType.APPLICATION_JSON)\n61\t            .content(\n62\t                if (quantity != null) {\n63\t                    \"\"\"{\"shipmentId\":\"$shipmentId\",\"orderId\":\"O-1\",\"carrier\":\"DHL\",\"quantity\":$quantity}\"\"\"\n64\t                } else {\n65\t                    \"\"\"{\"shipmentId\":\"$shipmentId\",\"orderId\":\"O-1\",\"carrier\":\"DHL\"}\"\"\"\n66\t                }\n67\t            )\n68\t\n69\t    @Test\n70\t    fun `creates a shipment in CREATED status`() {\n71\t        mockMvc.perform(createShipment(\"S-1\"))\n72\t            .andExpect(status().isCreated)\n73\t            .andExpect(jsonPath(\"$.shipmentId\").value(\"S-1\"))\n74\t            .andExpect(jsonPath(\"$.status\").value(\"CREATED\"))\n75\t    }\n76\t\n77\t    @Test\n78\t    fun `rejects a duplicate shipment id with the error envelope`() {\n79\t        mockMvc.perform(createShipment(\"S-2\")).andExpect(status().isCreated)\n80\t\n81\t        mockMvc.perform(createShipment(\"S-2\"))\n82\t            .andExpect(status().isConflict)\n83\t            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_ALREADY_EXISTS\"))\n84\t    }\n85\t\n86\t    @Test\n87\t    fun `returns a shipment by id`() {\n88\t        mockMvc.perform(createShipment(\"S-3\")).andExpect(status().isCreated)\n89\t\n90\t        mockMvc.perform(get(\"/shipments/S-3\"))\n91\t            .andExpect(status().isOk)\n92\t            .andExpect(jsonPath(\"$.carrier\").value(\"DHL\"))\n93\t    }\n94\t\n95\t    @Test\n96\t    fun `reports an unknown shipment through the error envelope`() {\n97\t        mockMvc.perform(get(\"/shipments/S-missing\"))\n98\t            .andExpect(status().isNotFound)\n99\t            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n100\t    }\n101\t\n102\t    @Test\n103\t    fun `lists shipments in id order`() {\n104\t        mockMvc.perform(createShipment(\"S-b\")).andExpect(status().isCreated)\n105\t        mockMvc.perform(createShipment(\"S-a\")).andExpect(status().isCreated)\n106\t\n107\t        mockMvc.perform(get(\"/shipments\"))\n108\t            .andExpect(status().isOk)\n109\t            .andExpect(jsonPath(\"$[0].shipmentId\").value(\"S-a\"))\n110\t            .andExpect(jsonPath(\"$[1].shipmentId\").value(\"S-b\"))\n111\t    }\n112\t\n113\t    @Test\n114\t    fun `shipment has default quantity of 1`() {\n115\t        mockMvc.perform(createShipment(\"S-qty-default\"))\n116\t            .andExpect(status().isCreated)\n117\t\n118\t        mockMvc.perform(get(\"/shipments/S-qty-default\"))\n119\t            .andExpect(status().isOk)\n120\t            .andExpect(jsonPath(\"$.quantity\").value(1))\n121\t    }\n122\t\n123\t    @Test\n124\t    fun `shipment accepts explicit quantity`() {\n125\t        mockMvc.perform(createShipment(\"S-qty-5\", quantity = 5))\n126\t            .andExpect(status().isCreated)\n127\t\n128\t        mockMvc.perform(get(\"/shipments/S-qty-5\"))\n129\t            .andExpect(status().isOk)\n130\t            .andExpect(jsonPath(\"$.quantity\").value(5))\n131\t    }\n132\t\n133\t    @Test\n134\t    fun `returns 400 for invalid shipment quantity`() {\n135\t        mockMvc.perform(createShipment(\"S-invalid-qty\", quantity = 0))\n136\t            .andExpect(status().isBadRequest)\n137\t            .andExpect(jsonPath(\"$.error.code\").value(\"VALIDATION_FAILED\"))\n138\t    }\n139\t\n140\t    @Test\n141\t    fun `rejects shipment that exceeds order allocation`() {\n142\t        // Order O-1 has quantity 10\n143\t        // Create shipment with quantity 10 (succeeds)\n144\t        mockMvc.perform(createShipment(\"S-alloc-1\", quantity = 10))\n145\t            .andExpect(status().isCreated)\n146\t\n147\t        // Try to create another with quantity 5 (should fail - total would be 15 > 10)\n148\t        mockMvc.perform(createShipment(\"S-alloc-2\", quantity = 5))\n149\t            .andExpect(status().isConflict)\n150\t    }\n151\t\n152\t    @Test\n153\t    fun `confirms a shipment from CREATED to CONFIRMED`() {\n154\t        mockMvc.perform(createShipment(\"S-confirm\"))\n155\t            .andExpect(status().isCreated)\n156\t\n157\t        mockMvc.perform(post(\"/shipments/S-confirm/confirm\"))\n158\t            .andExpect(status().isOk)\n159\t            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n160\t    }\n161\t\n162\t    @Test\n163\t    fun `delivers a shipment from CONFIRMED to DELIVERED`() {\n164\t        mockMvc.perform(createShipment(\"S-deliver\"))\n165\t            .andExpect(status().isCreated)\n166\t\n167\t        mockMvc.perform(post(\"/shipments/S-deliver/confirm\"))\n168\t            .andExpect(status().isOk)\n169\t\n170\t        mockMvc.perform(post(\"/shipments/S-deliver/deliver\"))\n171\t            .andExpect(status().isOk)\n172\t            .andExpect(jsonPath(\"$.status\").value(\"DELIVERED\"))\n173\t    }\n174\t\n175\t    @Test\n176\t    fun `cancels a shipment from CREATED to CANCELLED`() {\n177\t        mockMvc.perform(createShipment(\"S-cancel\"))\n178\t            .andExpect(status().isCreated)\n179\t\n180\t        mockMvc.perform(post(\"/shipments/S-cancel/cancel\"))\n181\t            .andExpect(status().isOk)\n182\t            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n183\t    }\n184\t\n185\t    @Test\n186\t    fun `rejects invalid state transition confirm from non-CREATED`() {\n187\t        mockMvc.perform(createShipment(\"S-invalid-confirm\"))\n188\t            .andExpect(status().isCreated)\n189\t\n190\t        // Confirm once (succeeds)\n191\t        mockMvc.perform(post(\"/shipments/S-invalid-confirm/confirm\"))\n192\t            .andExpect(status().isOk)\n193\t\n194\t        // Try to confirm again (should fail)\n195\t        mockMvc.perform(post(\"/shipments/S-invalid-confirm/confirm\"))\n196\t            .andExpect(status().isConflict)\n197\t    }\n198\t\n199\t    @Test\n200\t    fun `rejects invalid state transition deliver from non-CONFIRMED`() {\n201\t        mockMvc.perform(createShipment(\"S-invalid-deliver\"))\n202\t            .andExpect(status().isCreated)\n203\t\n204\t        // Try to deliver without confirming (should fail)\n205\t        mockMvc.perform(post(\"/shipments/S-invalid-deliver/deliver\"))\n206\t            .andExpect(status().isConflict)\n207\t    }\n208\t\n209\t    @Test\n210\t    fun `rejects invalid state transition cancel from non-CREATED`() {\n211\t        mockMvc.perform(createShipment(\"S-invalid-cancel\"))\n212\t            .andExpect(status().isCreated)\n213\t\n214\t        // Confirm first\n215\t        mockMvc.perform(post(\"/shipments/S-invalid-cancel/confirm\"))\n216\t            .andExpect(status().isOk)\n217\t\n218\t        // Try to cancel (should fail - not in CREATED state)\n219\t        mockMvc.perform(post(\"/shipments/S-invalid-cancel/cancel\"))\n220\t            .andExpect(status().isConflict)\n221\t    }\n222\t\n223\t    @Test\n224\t    fun `lists shipments with pagination`() {\n225\t        mockMvc.perform(createShipment(\"S-page-1\")).andExpect(status().isCreated)\n226\t        mockMvc.perform(createShipment(\"S-page-2\")).andExpect(status().isCreated)\n227\t\n228\t        mockMvc.perform(get(\"/shipments?limit=1&offset=0\"))\n229\t            .andExpect(status().isOk)\n230\t            .andExpect(jsonPath(\"$[0].shipmentId\").value(\"S-page-1\"))\n231\t            .andExpect(jsonPath(\"$.length()\").value(1))\n232\t    }\n233\t\n234\t    @Test\n235\t    fun `shipment pagination header contains total count`() {\n236\t        mockMvc.perform(createShipment(\"S-header-1\")).andExpect(status().isCreated)\n237\t        mockMvc.perform(createShipment(\"S-header-2\")).andExpect(status().isCreated)\n238\t\n239\t        mockMvc.perform(get(\"/shipments?limit=1&offset=0\"))\n240\t            .andExpect(status().isOk)\n241\t            .andExpect { result ->\n242\t                assert(result.response.getHeader(\"X-Total-Count\") == \"2\")\n243\t            }\n244\t    }\n245\t\n246\t    @Test\n247\t    fun `rejects invalid pagination limit for shipments`() {\n248\t        mockMvc.perform(get(\"/shipments?limit=200\"))\n249\t            .andExpect(status().isBadRequest)\n250\t            .andExpect(jsonPath(\"$.error.code\").value(\"VALIDATION_FAILED\"))\n251\t    }\n252\t}\n253\t"}]},"parent_tool_use_id":"toolu_012t9mojqG6KNaKQw3Fo778i","session_id":"1bd79e49-f141-44f7-9deb-c27270448e07","uuid":"ee87286e-bab2-4b17-935a-59bbffcfe31e","timestamp":"2026-09-25T10:23:52.001Z","subagent_type":"verifier","task_description":"Verify BE-005 implementation"}
