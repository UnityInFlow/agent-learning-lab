   @Test\n    fun `creates a shipment in CREATED status`() {\n        mockMvc.perform(createShipment(\"S-1\"))\n            .andExpect(status().isCreated)\n            .andExpect(jsonPath(\"$.shipmentId\").value(\"S-1\"))\n            .andExpect(jsonPath(\"$.status\").value(\"CREATED\"))\n    }\n\n    @Test\n    fun `rejects a duplicate shipment id with the error envelope`() {\n        mockMvc.perform(createShipment(\"S-2\")).andExpect(status().isCreated)\n\n        mockMvc.perform(createShipment(\"S-2\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_ALREADY_EXISTS\"))\n    }\n\n    @Test\n    fun `returns a shipment by id`() {\n        mockMvc.perform(createShipment(\"S-3\")).andExpect(status().isCreated)\n\n        mockMvc.perform(get(\"/shipments/S-3\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.carrier\").value(\"DHL\"))\n    }\n\n    @Test\n    fun `reports an unknown shipment through the error envelope`() {\n        mockMvc.perform(get(\"/shipments/S-missing\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n    }\n\n    @Test\n    fun `lists shipments in id order`() {\n        mockMvc.perform(createShipment(\"S-b\")).andExpect(status().isCreated)\n        mockMvc.perform(createShipment(\"S-a\")).andExpect(status().isCreated)\n\n        mockMvc.perform(get(\"/shipments\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$[0].shipmentId\").value(\"S-a\"))\n            .andExpect(jsonPath(\"$[1].shipmentId\").value(\"S-b\"))\n    }\n}","new_string":"package com.unityinflow.sample.shipment\n\nimport com.unityinflow.sample.customer.InMemoryCustomerRepository\nimport com.unityinflow.sample.order.InMemoryOrderRepository\nimport org.junit.jupiter.api.BeforeEach\nimport org.junit.jupiter.api.Test\nimport org.springframework.beans.factory.annotation.Autowired\nimport org.springframework.boot.test.context.SpringBootTest\nimport org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc\nimport org.springframework.http.MediaType\nimport org.springframework.test.web.servlet.MockMvc\nimport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get\nimport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post\nimport org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath\nimport org.springframework.test.web.servlet.result.MockMvcResultMatchers.status\n\n/**\n * The shipment feature as it exists before BE-003.\n *\n * These are \"the existing tests\" for that benchmark: they must keep passing, and an agent\n * that breaks one has regressed the fixture rather than solved the task.\n */\n@SpringBootTest\n@AutoConfigureMockMvc\nclass ShipmentControllerTest {\n\n    @Autowired\n    lateinit var mockMvc: MockMvc\n\n    @Autowired\n    lateinit var repository: InMemoryShipmentRepository\n\n    @Autowired\n    lateinit var orderRepository: InMemoryOrderRepository\n\n    @Autowired\n    lateinit var customerRepository: InMemoryCustomerRepository\n\n    @BeforeEach\n    fun reset() {\n        repository.clear()\n        orderRepository.clear()\n        customerRepository.clear()\n        createCustomer(\"C-1\")\n        createOrder(\"O-1\", 10)\n    }\n\n    private fun createCustomer(customerId: String) {\n        mockMvc.perform(\n            post(\"/customers\")\n                .contentType(MediaType.APPLICATION_JSON)\n                .content(\"\"\"{\"customerId\":\"$customerId\",\"name\":\"Test\",\"email\":\"test@example.com\"}\"\"\"),\n        )\n    }\n\n    private fun createOrder(orderId: String, quantity: Int) {\n        mockMvc.perform(\n            post(\"/orders\")\n                .contentType(MediaType.APPLICATION_JSON)\n                .content(\"\"\"{\"orderId\":\"$orderId\",\"customerId\":\"C-1\",\"amount\":100.00,\"currency\":\"EUR\",\"quantity\":$quantity}\"\"\"),\n        )\n    }\n\n    private fun createShipment(shipmentId: String, orderId: String = \"O-1\", quantity: String? = null) =\n        post(\"/shipments\")\n            .contentType(MediaType.APPLICATION_JSON)\n            .content(\n                if (quantity != null) {\n                    \"\"\"{\"shipmentId\":\"$shipmentId\",\"orderId\":\"$orderId\",\"carrier\":\"DHL\",\"quantity\":$quantity}\"\"\"\n                } else {\n                    \"\"\"{\"shipmentId\":\"$shipmentId\",\"orderId\":\"$orderId\",\"carrier\":\"DHL\"}\"\"\"\n                },\n            )\n\n    @Test\n    fun `creates a shipment in CREATED status`() {\n        mockMvc.perform(createShipment(\"S-1\"))\n            .andExpect(status().isCreated)\n            .andExpect(jsonPath(\"$.shipmentId\").value(\"S-1\"))\n            .andExpect(jsonPath(\"$.status\").value(\"CREATED\"))\n    }\n\n    @Test\n    fun `rejects a duplicate shipment id with the error envelope`() {\n        mockMvc.perform(createShipment(\"S-2\")).andExpect(status().isCreated)\n\n        mockMvc.perform(createShipment(\"S-2\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_ALREADY_EXISTS\"))\n    }\n\n    @Test\n    fun `returns a shipment by id`() {\n        mockMvc.perform(createShipment(\"S-3\")).andExpect(status().isCreated)\n\n        mockMvc.perform(get(\"/shipments/S-3\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.carrier\").value(\"DHL\"))\n    }\n\n    @Test\n    fun `reports an unknown shipment through the error envelope`() {\n        mockMvc.perform(get(\"/shipments/S-missing\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n    }\n\n    @Test\n    fun `lists shipments in id order`() {\n        mockMvc.perform(createShipment(\"S-b\")).andExpect(status().isCreated)\n        mockMvc.perform(createShipment(\"S-a\")).andExpect(status().isCreated)\n\n        mockMvc.perform(get(\"/shipments\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$[0].shipmentId\").value(\"S-a\"))\n            .andExpect(jsonPath(\"$[1].shipmentId\").value(\"S-b\"))\n    }\n\n    @Test\n    fun `creates a shipment with custom quantity`() {\n        mockMvc.perform(createShipment(\"S-4\", quantity = \"5\"))\n            .andExpect(status().isCreated)\n            .andExpect(jsonPath(\"$.quantity\").value(5))\n    }\n\n    @Test\n    fun `returns 400 for invalid quantity in shipment creation`() {\n        mockMvc.perform(createShipment(\"S-5\", quantity = \"0\"))\n            .andExpect(status().isBadRequest)\n            .andExpect(jsonPath(\"$.error.code\").value(\"VALIDATION_FAILED\"))\n    }\n\n    @Test\n    fun `returns 409 when shipment quantity exceeds order quantity`() {\n        mockMvc.perform(createShipment(\"S-6\", quantity = \"15\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ALLOCATION_CONFLICT\"))\n    }\n\n    @Test\n    fun `confirms a shipment`() {\n        mockMvc.perform(createShipment(\"S-7\"))\n            .andExpect(status().isCreated)\n\n        mockMvc.perform(post(\"/shipments/S-7/confirm\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n    }\n\n    @Test\n    fun `delivers a shipment`() {\n        mockMvc.perform(createShipment(\"S-8\"))\n            .andExpect(status().isCreated)\n\n        mockMvc.perform(post(\"/shipments/S-8/confirm\"))\n            .andExpect(status().isOk)\n\n        mockMvc.perform(post(\"/shipments/S-8/deliver\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"DELIVERED\"))\n    }\n\n    @Test\n    fun `cancels a shipment`() {\n        mockMvc.perform(createShipment(\"S-9\"))\n            .andExpect(status().isCreated)\n\n        mockMvc.perform(post(\"/shipments/S-9/cancel\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n    }\n\n    @Test\n    fun `returns 409 for invalid state transition`() {\n        mockMvc.perform(createShipment(\"S-10\"))\n            .andExpect(status().isCreated)\n\n        mockMvc.perform(post(\"/shipments/S-10/deliver\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"INVALID_TRANSITION\"))\n    }\n\n    @Test\n    fun `returns 404 for non-existent shipment transition`() {\n        mockMvc.perform(post(\"/shipments/S-missing/confirm\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n    }\n\n    @Test\n    fun `lists shipments with pagination`() {\n        mockMvc.perform(createShipment(\"S-c\"))\n            .andExpect(status().isCreated)\n        mockMvc.perform(createShipment(\"S-d\"))\n            .andExpect(status().isCreated)\n\n        mockMvc.perform(get(\"/shipments?limit=1&offset=0\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$[0].shipmentId\").value(\"S-c\"))\n            .andExpect(jsonPath(\"$.length()\").value(1))\n    }\n\n    @Test\n    fun `returns X-Total-Count header in shipment list`() {\n        mockMvc.perform(createShipment(\"S-e\"))\n            .andExpect(status().isCreated)\n        mockMvc.perform(createShipment(\"S-f\"))\n            .andExpect(status().isCreated)\n\n        mockMvc.perform(get(\"/shipments?limit=1&offset=0\"))\n            .andExpect(status().isOk)\n            .andExpect { response ->\n                assert(response.getHeader(\"X-Total-Count\") == \"2\")\n            }\n    }\n\n    @Test\n    fun `validates shipment limit parameter`() {\n        mockMvc.perform(get(\"/shipments?limit=0\"))\n            .andExpect(status().isBadRequest)\n            .andExpect(jsonPath(\"$.error.code\").value(\"VALIDATION_FAILED\"))\n    }\n\n    @Test\n    fun `validates shipment offset parameter`() {\n        mockMvc.perform(get(\"/shipments?offset=-1\"))\n            .andExpect(status().isBadRequest)\n            .andExpect(jsonPath(\"$.error.code\").value(\"VALIDATION_FAILED\"))\n    }\n}"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":3681,"cache_read_input_tokens":37311,"cache_creation":{"ephemeral_5m_input_tokens":3681,"ephemeral_1h_input_tokens":0},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":"toolu_01N1MS5EhS1bpKfW7NuxtfdT","session_id":"ed641a0f-949a-40cd-8812-cb41c2b69a72","uuid":"bd20444c-4fbb-4587-bbbe-64804b1bf62b","timestamp":"2026-09-25T13:04:54.670Z","request_id":"req_011CfQCrgVtvBB7TKm9W4UHj","subagent_type":"implementer","task_description":"Implement BE-005 ticket"}
