dates offset parameter`() {\n179\t        mockMvc.perform(get(\"/orders?offset=-1\"))\n180\t            .andExpect(status().isBadRequest)\n181\t            .andExpect(jsonPath(\"$.error.code\").value(\"VALIDATION_FAILED\"))\n182\t    }\n183\t\n184\t    @Test\n185\t    fun `updates order quantity`() {\n186\t        mockMvc.perform(createOrder(\"O-8\", quantity = \"10\"))\n187\t            .andExpect(status().isCreated)\n188\t\n189\t        mockMvc.perform(\n190\t            put(\"/orders/O-8/quantity\")\n191\t                .contentType(MediaType.APPLICATION_JSON)\n192\t                .content(\"\"\"{\"quantity\":15}\"\"\"),\n193\t        )\n194\t            .andExpect(status().isOk)\n195\t            .andExpect(jsonPath(\"$.quantity\").value(15))\n196\t    }\n197\t\n198\t    @Test\n199\t    fun `returns 400 for invalid quantity in update`() {\n200\t        mockMvc.perform(createOrder(\"O-9\", quantity = \"10\"))\n201\t            .andExpect(status().isCreated)\n202\t\n203\t        mockMvc.perform(\n204\t            put(\"/orders/O-9/quantity\")\n205\t                .contentType(MediaType.APPLICATION_JSON)\n206\t                .content(\"\"\"{\"quantity\":0}\"\"\"),\n207\t        )\n208\t            .andExpect(status().isBadRequest)\n209\t            .andExpect(jsonPath(\"$.error.code\").value(\"VALIDATION_FAILED\"))\n210\t    }\n211\t\n212\t    @Test\n213\t    fun `returns 404 for updating non-existent order`() {\n214\t        mockMvc.perform(\n215\t            put(\"/orders/O-missing/quantity\")\n216\t                .contentType(MediaType.APPLICATION_JSON)\n217\t                .content(\"\"\"{\"quantity\":10}\"\"\"),\n218\t        )\n219\t            .andExpect(status().isNotFound)\n220\t            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_NOT_FOUND\"))\n221\t    }\n222\t\n223\t    @Test\n224\t    fun `filters orders by UNALLOCATED fulfilment status`() {\n225\t        mockMvc.perform(createOrder(\"O-u1\", quantity = \"5\")).andExpect(status().isCreated)\n226\t        mockMvc.perform(createOrder(\"O-u2\", quantity = \"5\")).andExpect(status().isCreated)\n227\t        mockMvc.perform(\n228\t            post(\"/shipments\")\n229\t                .contentType(MediaType.APPLICATION_JSON)\n230\t                .content(\"\"\"{\"shipmentId\":\"S-1\",\"orderId\":\"O-u2\",\"carrier\":\"DHL\",\"quantity\":5}\"\"\"),\n231\t        ).andExpect(status().isCreated)\n232\t\n233\t        mockMvc.perform(get(\"/orders?fulfilment=UNALLOCATED\"))\n234\t            .andExpect(status().isOk)\n235\t            .andExpect(jsonPath(\"$.length()\").value(1))\n236\t            .andExpect(jsonPath(\"$[0].orderId\").value(\"O-u1\"))\n237\t    }\n238\t\n239\t    @Test\n240\t    fun `filters orders by FULLY_ALLOCATED fulfilment status`() {\n241\t        mockMvc.perform(createOrder(\"O-f1\", quantity = \"5\")).andExpect(status().isCreated)\n242\t        mockMvc.perform(createOrder(\"O-f2\", quantity = \"5\")).andExpect(status().isCreated)\n243\t        mockMvc.perform(\n244\t            post(\"/shipments\")\n245\t                .contentType(MediaType.APPLICATION_JSON)\n246\t                .content(\"\"\"{\"shipmentId\":\"S-2\",\"orderId\":\"O-f1\",\"carrier\":\"DHL\",\"quantity\":5}\"\"\"),\n247\t        ).andExpect(status().isCreated)\n248\t\n249\t        mockMvc.perform(get(\"/orders?fulfilment=FULLY_ALLOCATED\"))\n250\t            .andExpect(status().isOk)\n251\t            .andExpect(jsonPath(\"$.length()\").value(1))\n252\t            .andExpect(jsonPath(\"$[0].orderId\").value(\"O-f1\"))\n253\t            .andExpect(jsonPath(\"$[0].fulfilment.allocated\").value(5))\n254\t            .andExpect(jsonPath(\"$[0].fulfilment.status\").value(\"FULLY_ALLOCATED\"))\n255\t    }\n256\t\n257\t    @Test\n258\t    fun `filters orders by PARTIALLY_ALLOCATED fulfilment status`() {\n259\t        mockMvc.perform(createOrder(\"O-p1\", quantity = \"10\")).andExpect(status().isCreated)\n260\t        mockMvc.perform(createOrder(\"O-p2\", quantity = \"1