(\"$.fulfilment.allocated\").value(5))\n334\t            .andExpect(jsonPath(\"$.fulfilment.status\").value(\"PARTIALLY_ALLOCATED\"))\n335\t\n336\t        mockMvc.perform(post(\"/shipments/S-rel/cancel\"))\n337\t            .andExpect(status().isOk)\n338\t\n339\t        mockMvc.perform(get(\"/orders/O-rel\"))\n340\t            .andExpect(status().isOk)\n341\t            .andExpect(jsonPath(\"$.fulfilment.allocated\").value(0))\n342\t            .andExpect(jsonPath(\"$.fulfilment.status\").value(\"UNALLOCATED\"))\n343\t    }\n344\t\n345\t    @Test\n346\t    fun `amends order quantity and recalculates fulfilment with existing shipments`() {\n347\t        mockMvc.perform(createOrder(\"O-amend\", quantity = \"10\")).andExpect(status().isCreated)\n348\t        mockMvc.perform(\n349\t            post(\"/shipments\")\n350\t                .contentType(MediaType.APPLICATION_JSON)\n351\t                .content(\"\"\"{\"shipmentId\":\"S-amend\",\"orderId\":\"O-amend\",\"carrier\":\"DHL\",\"quantity\":5}\"\"\"),\n352\t        ).andExpect(status().isCreated)\n353\t\n354\t        mockMvc.perform(get(\"/orders/O-amend\"))\n355\t            .andExpect(status().isOk)\n356\t            .andExpect(jsonPath(\"$.quantity\").value(10))\n357\t            .andExpect(jsonPath(\"$.fulfilment.allocated\").value(5))\n358\t            .andExpect(jsonPath(\"$.fulfilment.status\").value(\"PARTIALLY_ALLOCATED\"))\n359\t\n360\t        mockMvc.perform(\n361\t            put(\"/orders/O-amend/quantity\")\n362\t                .contentType(MediaType.APPLICATION_JSON)\n363\t                .content(\"\"\"{\"quantity\":20}\"\"\"),\n364\t        ).andExpect(status().isOk)\n365\t\n366\t        mockMvc.perform(get(\"/orders/O-amend\"))\n367\t            .andExpect(status().isOk)\n368\t            .andExpect(jsonPath(\"$.quantity\").value(20))\n369\t            .andExpect(jsonPath(\"$.fulfilment.allocated\").value(5))\n370\t            .andExpect(jsonPath(\"$.fulfilment.status\").value(\"PARTIALLY_ALLOCATED\"))\n371\t    }\n372\t\n373\t    @Test\n374\t    fun `returns 409 when updating order quantity below allocated quantity`() {\n375\t        mockMvc.perform(createOrder(\"O-below\", quantity = \"10\")).andExpect(status().isCreated)\n376\t        mockMvc.perform(\n377\t            post(\"/shipments\")\n378\t                .contentType(MediaType.APPLICATION_JSON)\n379\t                .content(\"\"\"{\"shipmentId\":\"S-below\",\"orderId\":\"O-below\",\"carrier\":\"DHL\",\"quantity\":5}\"\"\"),\n380\t        ).andExpect(status().isCreated)\n381\t\n382\t        mockMvc.perform(\n383\t            put(\"/orders/O-below/quantity\")\n384\t                .contentType(MediaType.APPLICATION_JSON)\n385\t                .content(\"\"\"{\"quantity\":3}\"\"\"),\n386\t        )\n387\t            .andExpect(status().isConflict)\n388\t            .andExpect(jsonPath(\"$.error.code\").value(\"ALLOCATION_CONFLICT\"))\n389\t    }\n390\t}\n391\t"}]},"parent_tool_use_id":"toolu_014X9E78apwcDKDDqwUZzvyf","session_id":"ed641a0f-949a-40cd-8812-cb41c2b69a72","uuid":"39a82b52-386c-469e-8b85-422d3ceaeb74","timestamp":"2026-09-25T13:12:39.106Z","subagent_type":"verifier","task_description":"Final verification of BE-005 implementation"}
