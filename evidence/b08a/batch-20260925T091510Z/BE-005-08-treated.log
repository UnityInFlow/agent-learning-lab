{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Wd8H1h9RtapxMYzayirRmF","type":"tool_result","content":"1\tpackage com.unityinflow.sample.order\n2\t\n3\timport com.unityinflow.sample.api.ConflictException\n4\timport com.unityinflow.sample.api.ErrorCode\n5\timport com.unityinflow.sample.api.ResourceNotFoundException\n6\timport com.unityinflow.sample.api.UnprocessableEntityException\n7\timport com.unityinflow.sample.api.ValidationException\n8\timport com.unityinflow.sample.api.FieldViolation\n9\timport com.unityinflow.sample.customer.InMemoryCustomerRepository\n10\timport com.unityinflow.sample.shipment.InMemoryShipmentRepository\n11\timport com.unityinflow.sample.shipment.ShipmentStatus\n12\timport org.springframework.http.HttpStatus\n13\timport org.springframework.http.ResponseEntity\n14\timport org.springframework.web.bind.annotation.GetMapping\n15\timport org.springframework.web.bind.annotation.PathVariable\n16\timport org.springframework.web.bind.annotation.PostMapping\n17\timport org.springframework.web.bind.annotation.PutMapping\n18\timport org.springframework.web.bind.annotation.RequestBody\n19\timport org.springframework.web.bind.annotation.RequestMapping\n20\timport org.springframework.web.bind.annotation.RequestParam\n21\timport org.springframework.web.bind.annotation.RestController\n22\t\n23\t@RestController\n24\t@RequestMapping(\"/orders\")\n25\tclass OrderController(\n26\t    private val repository: InMemoryOrderRepository,\n27\t    private val customerRepository: InMemoryCustomerRepository,\n28\t    private val shipmentRepository: InMemoryShipmentRepository,\n29\t) {\n30\t\n31\t    @PostMapping\n32\t    fun create(@RequestBody request: CreateOrderRequest): ResponseEntity<Order> {\n33\t        if (repository.existsById(request.orderId)) {\n34\t            throw ConflictException(\n35\t                ErrorCode.ORDER_ALREADY_EXISTS,\n36\t                \"An order with id '${request.orderId}' already exists\",\n37\t            )\n38\t        }\n39\t\n40\t        // Validate quantity\n41\t        val quantity = request.quantity ?: 1\n42\t        if (quantity < 1) {\n43\t            throw ValidationException(\n44\t                \"Quantity must be at least 1\",\n45\t                listOf(FieldViolation(\"quantity\", \"Quantity must be at least 1\")),\n46\t            )\n47\t        }\n48\t\n49\t        // Validate customer exists\n50\t        if (!customerRepository.existsById(request.customerId)) {\n51\t            throw UnprocessableEntityException(\n52\t                ErrorCode.INVALID_CUSTOMER,\n53\t                \"Customer with id '${request.customerId}' does not exist\",\n54\t            )\n55\t        }\n56\t\n57\t        val saved = repository.save(\n58\t            Order(\n59\t                request.orderId,\n60\t                request.customerId,\n61\t                request.amount,\n62\t                request.currency,\n63\t                quantity,\n64\t                Fulfilment(0, 0, FulfilmentStatus.UNALLOCATED),\n65\t            ),\n66\t        )\n67\t        return ResponseEntity.status(HttpStatus.CREATED).body(saved)\n68\t    }\n69\t\n70\t    @GetMapping(\"/{orderId}\")\n71\t    fun getById(@PathVariable orderId: String): Order {\n72\t        val order = repository.findById(orderId)\n73\t            ?: throw ResourceNotFoundException(\n74\t                ErrorCode.ORDER_NOT_FOUND,\n75\t                \"No order with id '$orderId'\",\n76\t            )\n77\t        return order.withFulfilment(shipmentRepository)\n78\t    }\n79\t\n80\t    @GetMapping\n81\t    fun list(\n82\t        @RequestParam(required = false) fulfilment: String?,\n83\t        @RequestParam(defaultValue = \"100\") limit: Int,\n84\t        @RequestParam(defaultValue = \"0\") offset: Int,\n85\t    ): ResponseEntity<List<Order>> {\n86\t        // Validate limit\n87\t        if (limit < 1 || limit > 100) {\n88\t            throw ValidationException(\n89\t                \"Limit must be between 1 and 100\",\n90\t                listOf(FieldViolation(\"limit\", \"Limit must be between 1 and 100\")),\n91\t            )\n92\t        }\n93\t\n94\t        // Validate offset\n95\t        if (offset < 0) {\n96\t            throw ValidationException(\n97\t                \"Offset must be non-negative\",\n98\t                listOf(FieldViolation(\"offset\", \"Offset must be non-negative\")),\n99\t            )\n100\t        }\n101\t\n102\t        // Validate fulfilment parameter\n103\t        var allOrders = repository.findAll()\n104\t        if (fulfilment != null) {\n105\t            val status = try {\n106\t                FulfilmentStatus.valueOf(fulfilment)\n107\t            } catch (e: IllegalArgumentException) {\n108\t                throw ValidationException(\n109\t                    \"Invalid fulfilment status: $fulfilment\",\n110\t                    listOf(FieldViolation(\"fulfilment\", \"Invalid fulfilment status\")),\n111\t                )\n112\t            }\n113\t            allOrders = allOrders.filter { order ->\n114\t                order.withFulfilment(shipmentRepository).fulfilment?.status == status\n115\t            }\n116\t        } else {\n117\t            allOrders = allOrders.map { it.withFulfilment(shipmentRepository) }\n118\t        }\n119\t\n120\t        val total = allOrders.size\n121\t        val paged = allOrders.drop(offset).take(limit)\n122\t\n123\t        return ResponseEntity.ok()\n124\t            .header(\"X-Total-Count\", total.toString())\n125\t            .body(paged)\n126\t    }\n127\t\n128\t    @PutMapping(\"/{orderId}/quantity\")\n129\t    fun updateQuantity(\n130\t        @PathVariable orderId: String,\n131\t        @RequestBody request: UpdateOrderQuantityRequest,\n132\t    ): Order {\n133\t        val order = repository.findById(orderId)\n134\t            ?: throw ResourceNotFoundException(\n135\t                ErrorCode.ORDER_NOT_FOUND,\n136\t                \"No order with id '$orderId'\",\n137\t            )\n138\t\n139\t        // Validate quantity\n140\t        if (request.quantity < 1) {\n141\t            throw ValidationException(\n142\t                \"Quantity must be at least 1\",\n143\t                listOf(FieldViolation(\"quantity\", \"Quantity must be at least 1\")),\n144\t            )\n145\t        }\n146\t\n147\t        // Check if new quantity is below allocated quantity\n148\t        val shipments = shipmentRepository.findByOrderId(orderId)\n149\t        val allocated = shipments\n150\t            .filter { it.status != ShipmentStatus.CANCELLED }\n151\t            .sumOf { it.quantity }\n152\t\n153\t        if (request.quantity < allocated) {\n154\t            throw ConflictException(\n155\t                ErrorCode.ALLOCATION_CONFLICT,\n156\t                \"Cannot reduce quantity below allocated quantity of $allocated\",\n157\t            )\n158\t        }\n159\t\n160\t        val updated = order.copy(quantity = request.quantity)\n161\t            .withFulfilment(shipmentRepository)\n162\t        repository.save(updated)\n163\t        return updated\n164\t    }\n165\t}\n166\t\n167\tfun Order.withFulfilment(shipmentRepository: InMemoryShipmentRepository): Order {\n168\t    val shipments = shipmentRepository.findByOrderId(this.orderId)\n169\t    val allocated = shipments\n170\t        .filter { it.status != ShipmentStatus.CANCELLED }\n171\t        .sumOf { it.quantity }\n172\t    val delivered = shipments\n173\t        .filter { it.status == ShipmentStatus.DELIVERED }\n174\t        .sumOf { it.quantity }\n175\t\n176\t    val status = when {\n177\t        delivered >= this.quantity -> FulfilmentStatus.DELIVERED\n178\t        allocated >= this.quantity -> FulfilmentStatus.FULLY_ALLOCATED\n179\t        allocated > 0 -> FulfilmentStatus.PARTIALLY_ALLOCATED\n180\t        else -> FulfilmentStatus.UNALLOCATED\n181\t    }\n182\t\n183\t    return this.copy(\n184\t        fulfilment = Fulfilment(allocated, delivered, status),\n185\t    )\n186\t}\n187\t"}]},"parent_tool_u