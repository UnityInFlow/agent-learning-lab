{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AN43vN4krkQ3Co6VZ4J36h","type":"tool_result","content":"1\tpackage com.unityinflow.sample.order\n2\t\n3\timport com.unityinflow.sample.customer.InMemoryCustomerRepository\n4\timport org.junit.jupiter.api.BeforeEach\n5\timport org.junit.jupiter.api.Test\n6\timport org.springframework.beans.factory.annotation.Autowired\n7\timport org.springframework.boot.test.context.SpringBootTest\n8\timport org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc\n9\timport org.springframework.http.MediaType\n10\timport org.springframework.test.web.servlet.MockMvc\n11\timport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get\n12\timport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post\n13\timport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.put\n14\timport org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath\n15\timport org.springframework.test.web.servlet.result.MockMvcResultMatchers.status\n16\t\n17\t/**\n18\t * Baseline behaviour of the order feature. BE-002 must not break any of these.\n19\t *\n20\t * Note how the failure cases assert the response *body*, not just the status: the error\n21\t * envelope is part of the API contract, so a change that returns the right status with\n22\t * the wrong shape is a breaking change for clients.\n23\t */\n24\t@SpringBootTest\n25\t@AutoConfigureMockMvc\n26\tclass OrderControllerTest {\n27\t\n28\t    @Autowired\n29\t    lateinit var mockMvc: MockMvc\n30\t\n31\t    @Autowired\n32\t    lateinit var repository: InMemoryOrderRepository\n33\t\n34\t    @Autowired\n35\t    lateinit var customerRepository: InMemoryCustomerRepository\n36\t\n37\t    @BeforeEach\n38\t    fun reset() {\n39\t        repository.clear()\n40\t        customerRepository.clear()\n41\t        createCustomer(\"C-1\", \"John Doe\", \"john@example.com\")\n42\t    }\n43\t\n44\t    private fun createCustomer(customerId: String, name: String, email: String) {\n45\t        mockMvc.perform(\n46\t            post(\"/customers\")\n47\t                .contentType(MediaType.APPLICATION_JSON)\n48\t                .content(\"\"\"{\"customerId\":\"$customerId\",\"name\":\"$name\",\"email\":\"$email\"}\"\"\"),\n49\t        )\n50\t    }\n51\t\n52\t    private fun createOrder(orderId: String, customerId: String = \"C-1\", amount: String = \"49.90\", quantity: String? = null) =\n53\t        post(\"/orders\")\n54\t            .contentType(MediaType.APPLICATION_JSON)\n55\t            .content(\n56\t                if (quantity != null) {\n57\t                    \"\"\"{\"orderId\":\"$orderId\",\"customerId\":\"$customerId\",\"amount\":$amount,\"currency\":\"EUR\",\"quantity\":$quantity}\"\"\"\n58\t                } else {\n59\t                    \"\"\"{\"orderId\":\"$orderId\",\"customerId\":\"$customerId\",\"amount\":$amount,\"currency\":\"EUR\"}\"\"\"\n60\t                },\n61\t            )\n62\t\n63\t    @Test\n64\t    fun `creates an order and returns 201`() {\n65\t        mockMvc.perform(createOrder(\"O-1\"))\n66\t            .andExpect(status().isCreated)\n67\t            .andExpect(jsonPath(\"$.orderId\").value(\"O-1\"))\n68\t    }\n69\t\n70\t    @Test\n71\t    fun `reads back a created order`() {\n72\t        mockMvc.perform(createOrder(\"O-2\")).andExpect(status().isCreated)\n73\t\n74\t        mockMvc.perform(get(\"/orders/O-2\"))\n75\t            .andExpect(status().isOk)\n76\t            .andExpect(jsonPath(\"$.currency\").value(\"EUR\"))\n77\t    }\n78\t\n79\t    @Test\n80\t    fun `returns 404 with the error envelope for an unknown order`() {\n81\t        mockMvc.perform(get(\"/orders/does-not-exist\"))\n82\t            .andExpect(status().isNotFound)\n83\t            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_NOT_FOUND\"))\n84\t            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n85\t    }\n86\t\n87\t    @Test\n88\t    fun `returns 409 with the error envelope for a duplicate order id`() {\n89\t        mockMvc.perform(createOrder(\"O-3\")).andExpect(status().isCreated)\n90\t\n91\t        mockMvc.perform(createOrder(\"O-3\"))\n92\t            .andExpect(status().isConflict)\n93\t            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_ALREADY_EXISTS\"))\n94\t            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n95\t    }\n96\t\n97\t    @Test\n98\t    fun `returns 422 with error envelope for non-existent customer`() {\n99\t        mockMvc.perform(createOrder(\"O-4\", customerId = \"C-non-existent\"))\n100\t            .andExpect(status().isUnprocessableEntity)\n101\t            .andExpect(jsonPath(\"$.error.code\").value(\"INVALID_CUSTOMER\"))\n102\t            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n103\t    }\n104\t\n105\t    @Test\n106\t    fun `creates an order with custom quantity`() {\n107\t        mockMvc.perform(createOrder(\"O-5\", quantity = \"5\"))\n108\t            .andExpect(status().isCreated)\n109\t            .andExpect(jsonPath(\"$.quantity\").value(5))\n110\t    }\n111\t\n112\t    @Test\n113\t    fun `returns 400 for invalid quantity in order creation`() {\n114\t        mockMvc.perform(createOrder(\"O-6\", quantity = \"0\"))\n115\t            .andExpect(status().isBadRequest)\n116\t            .andExpect(jsonPath(\"$.error.code\").value(\"VALIDATION_FAILED\"))\n117\t            .andExpect(jsonPath(\"$.error.fields[0].field\").value(\"quantity\"))\n118\t    }\n119\t\n120\t    @Test\n121\t    fun `returns order with fulfilment status UNALLOCATED`() {\n122\t        mockMvc.perform(createOrder(\"O-7\", quantity = \"10\"))\n123\t            .andExpect(status().isCreated)\n124\t\n125\t        mockMvc.perform(get(\"/orders/O-7\"))\n126\t            .andExpect(status().isOk)\n127\t            .andExpect(jsonPath(\"$.fulfilment.status\").value(\"UNALLOCATED\"))\n128\t            .andExpect(jsonPath(\"$.fulfilment.allocated\").value(0))\n129\t            .andExpect