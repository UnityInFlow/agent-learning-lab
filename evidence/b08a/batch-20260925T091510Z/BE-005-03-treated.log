   .andExpect(jsonPath(\"$.fulfilment.status\").value(\"UNALLOCATED\"))\n    }\n\n    @Test\n    fun `computes fulfilment status as DELIVERED when all shipments are delivered`() {\n        mockMvc.perform(createCustomer(\"C-1\")).andExpect(status().isCreated)\n        mockMvc.perform(createOrder(\"O-11\", quantity = \"5\")).andExpect(status().isCreated)\n\n        shipmentRepository.save(Shipment(\"S-6\", \"O-11\", \"DHL\", ShipmentStatus.CREATED, 5))\n\n        mockMvc.perform(get(\"/orders/O-11\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.fulfilment.status\").value(\"FULLY_ALLOCATED\"))\n\n        shipmentRepository.save(Shipment(\"S-6\", \"O-11\", \"DHL\", ShipmentStatus.DELIVERED, 5))\n\n        mockMvc.perform(get(\"/orders/O-11\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.fulfilment.status\").value(\"DELIVERED\"))\n            .andExpect(jsonPath(\"$.fulfilment.delivered\").value(5))\n    }\n\n    @Test\n    fun `rejects invalid fulfilment parameter with validation error`() {\n        mockMvc.perform(get(\"/orders?fulfilment=INVALID_STATUS\"))\n            .andExpect(status().isBadRequest)\n            .andExpect(jsonPath(\"$.error.code\").value(\"VALIDATION_FAILED\"))\n            .andExpect(jsonPath(\"$.error.fields[0].field\").value(\"fulfilment\"))\n    }\n}"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":980,"cache_read_input_tokens":23261,"cache_creation":{"ephemeral_5m_input_tokens":980,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":"toolu_01XiHL6FkauztqFVa1A5pnVn","session_id":"db6ff8fc-02cf-48f4-a54d-512a55c9ddf2","uuid":"b8a82cce-5168-47e0-a78f-f525f1b46fac","timestamp":"2026-09-25T09:55:49.047Z","request_id":"req_0