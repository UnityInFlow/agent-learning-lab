e.api.ResourceNotFoundException\nimport com.unityinflow.sample.api.UnprocessableEntityException\nimport com.unityinflow.sample.api.ValidationException\nimport com.unityinflow.sample.api.FieldViolation\nimport com.unityinflow.sample.customer.InMemoryCustomerRepository\nimport com.unityinflow.sample.shipment.InMemoryShipmentRepository\nimport com.unityinflow.sample.shipment.ShipmentStatus\nimport org.springframework.http.HttpStatus\nimport org.springframework.http.ResponseEntity\nimport org.springframework.web.bind.annotation.GetMapping\nimport org.springframework.web.bind.annotation.PathVariable\nimport org.springframework.web.bind.annotation.PostMapping\nimport org.springframework.web.bind.annotation.PutMapping\nimport org.springframework.web.bind.annotation.RequestBody\nimport org.springframework.web.bind.annotation.RequestMapping\nimport org.springframework.web.bind.annotation.RequestParam\nimport org.springframework.web.bind.annotation.RestController\n\n@RestController\n@RequestMapping(\"/orders\")\nclass OrderController(\n    private val repository: InMemoryOrderRepository,\n    private val customerRepository: InMemoryCustomerRepository,\n    private val shipmentRepository: InMemoryShipmentRepository,\n) {\n\n    @PostMapping\n    fun create(@RequestBody request: CreateOrderRequest): ResponseEntity<Order> {\n        if (repository.existsById(request.orderId)) {\n            throw ConflictException(\n                ErrorCode.ORDER_ALREADY_EXISTS,\n                \"An order with id '${request.orderId}' already exists\",\n            )\n        }\n\n        if (!customerRepository.existsById(request.customerId)) {\n            throw UnprocessableEntityException(\n                ErrorCode.UNPROCESSABLE_ENTITY,\n                \"Customer with id '${request.customerId}' does not exist\",\n            )\n        }\n\n        val quantity = request.quantity ?: 1\n        if (quantity < 1) {\n            throw ValidationException(\n                \"quantity must be positive\",\n                listOf(FieldViolation(\"quantity\", \"must be at least 1\")),\n            )\n        }\n\n        val order = Order(request.orderId, request.customerId, request.amount, request.currency, quantity)\n        val saved = repository.save(order)\n        return ResponseEntity.status(HttpStatus.CREATED).body(saved)\n    }\n\n    @GetMapping(\"/{orderId}\")\n    fun getById(@PathVariable orderId: String): Order {\n        val order = repository.findById(orderId)\n            ?: throw ResourceNotFoundException(\n                ErrorCode.ORDER_NOT_FOUND,\n                \"No order with id '$orderId'\",\n            )\n        return computeFulfilment(order)\n    }\n\n    @GetMapping\n    fun list(\n        @RequestParam(required = false) fulfilment: String? = null,\n        @RequestParam(defaultValue = \"100\") limit: Int,\n        @RequestParam(defaultValue = \"0\") offset: Int,\n    ): ResponseEntity<List<Order>> {\n        if (limit < 1 || limit > 100) {\n            throw ValidationException(\n                \"limit must be between 1 and 100\",\n                listOf(FieldViolation(\"limit\", \"must be between 1 and 100\")),\n            )\n        }\n        if (offset < 0) {\n            throw ValidationException(\n                \"offset must be 0 or greater\",\n                listOf(FieldViolation(\"offset\", \"must be 0 or greater\")),\n            )\n        }\n\n        val allOrders = repository.findAll()\n        val allWithFulfilment = allOrders.map { computeFulfilment(it) }\n\n        val filtered = if (fulfilment != null) {\n            val status = try {\n                FulfilmentStatus.valueOf(fulfilment)\n            } catch (e: IllegalArgumentException) {\n                throw ValidationException(\"fulfilment is not a valid status\")\n            }\n            allWithFulfilment.filter { it.fulfilment.status == status }\n        } else {\n            allWithFulfilment\n        }\n\n        val total = filtered.size\n        val paged = filtered.drop(offset).take(limit)\n        return ResponseEntity.ok()\n            .header(\"X-Total-Count\", total.toString())\n            .body(paged)\n    }\n\n    @PutMapping(\"/{orderId}/quantity\")\n    fun updateQuantity(\n        @PathVariable orderId: String,\n        @RequestBody request: UpdateOrderQuantityRequest,\n    ): Order {\n        val order = repository.findById(orderId)\n            ?: throw ResourceNotFoundException(\n                ErrorCode.ORDER_NOT_FOUND,\n                \"No order with id '$orderId'\",\n            )\n\n        if (request.quantity < 1) {\n            throw ValidationException(\n                \"quantity must be positive\",\n                listOf(FieldViolation(\"quantity\", \"must be at least 1\")),\n            )\n        }\n\n        val allocated = shipmentRepository.findByOrderId(orderId)\n            .filter { it.status != ShipmentStatus.CANCELLED }\n            .sumOf { it.quantity }\n\n        if (request.quantity < allocated) {\n            throw ConflictException(\n                ErrorCode.ORDER_ALREADY_EXISTS,\n                \"Cannot reduce quantity below allocated quantity\",\n            )\n        }\n\n        val updated = order.copy(quantity = request.quantity)\n        val saved = repository.save(updated)\n        return computeFulfilment(saved)\n    }\n\n    private fun computeFulfilment(order: Order): Order {\n        val shipments = shipmentRepository.findByOrderId(order.orderId)\n        val allocated = shipments.filter { it.status != ShipmentStatus.CANCELLED }.sumOf { it.quantity }\n        val delivered = shipments.filter { it.status == ShipmentStatus.DELIVERED }.sumOf { it.quantity }\n\n        val status = when {\n            delivered >= order.quantity -> FulfilmentStatus.DELIVERED\n            allocated >= order.quantity -> FulfilmentStatus.FULLY_ALLOCATED\n            allocated > 0 -> FulfilmentStatus.PARTIALLY_ALLOCATED\n            else -> FulfilmentStatus.UNALLOCATED\n        }\n\n        return order.copy(fulfilment = OrderFulfilment(allocated, delivered, status))\n    }\n}\n","structuredPatch":[{"oldStart":93,"oldLines":7,"newStart":93,"newLines":10,"lines":["             val status = try {","                 FulfilmentStatus.valueOf(fulfilment)","             } catch (e: IllegalArgumentException) {","-                throw ValidationException(\"fulfilment is not a valid status\")","+                throw ValidationException(","+                    \"fulfilment is not a valid status\",","+                    listOf(FieldViolation(\"fulfilment\", \"must be a valid fulfillment status\")),","+                )","             }","             allWithFulfilment.filter { it.fulfilment.status == status }","         } else {"]}],"userModified":false,"replaceAll":false}}
