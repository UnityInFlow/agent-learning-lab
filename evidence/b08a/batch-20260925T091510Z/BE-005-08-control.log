er(\n                request.orderId,\n                request.customerId,\n                request.amount,\n                request.currency,\n                quantity,\n                Fulfilment(0, 0, FulfilmentStatus.UNALLOCATED),\n            ),\n        )\n        return ResponseEntity.status(HttpStatus.CREATED).body(saved)\n    }\n\n    @GetMapping(\"/{orderId}\")\n    fun getById(@PathVariable orderId: String): Order =\n        repository.findById(orderId)\n            ?: throw ResourceNotFoundException(\n                ErrorCode.ORDER_NOT_FOUND,\n                \"No order with id '$orderId'\",\n            )\n\n    @GetMapping\n    fun list(\n        @RequestParam(defaultValue = \"100\") limit: Int,\n        @RequestParam(defaultValue = \"0\") offset: Int,\n        @RequestParam(required = false) fulfilment: String? = null,\n    ): ResponseEntity<List<Order>> {\n        if (limit < 1 || limit > 100) {\n            throw ValidationException(\n                \"Invalid limit\",\n                listOf(FieldViolation(\"limit\", \"must be between 1 and 100\")),\n            )\n        }\n        if (offset < 0) {\n            throw ValidationException(\n                \"Invalid offset\",\n                listOf(FieldViolation(\"offset\", \"must be 0 or more\")),\n            )\n        }\n\n        val fulfilmentFilter = if (fulfilment != null) {\n            try {\n                FulfilmentStatus.valueOf(fulfilment)\n            } catch (e: IllegalArgumentException) {\n                throw ValidationException(\n                    \"Invalid fulfilment\",\n                    listOf(FieldViolation(\"fulfilment\", \"must be a valid status\")),\n                )\n            }\n        } else {\n            null\n        }\n\n        val (orders, total) = repository.findAll(limit, offset, fulfilmentFilter)\n        return ResponseEntity.ok()\n            .header(\"X-Total-Count\", total.toString())\n            .body(orders)\n    }\n\n    @PutMapping(\"/{orderId}/quantity\")\n    fun updateQuantity(\n        @PathVariable orderId: String,\n        @RequestBody request: UpdateQuantityRequest,\n    ): Order {\n        val order = repository.findById(orderId)\n            ?: throw ResourceNotFoundException(\n                ErrorCode.ORDER_NOT_FOUND,\n                \"No order with id '$orderId'\",\n            )\n\n        if (request.quantity < 1) {\n            throw ValidationException(\n                \"Invalid quantity\",\n                listOf(FieldViolation(\"quantity\", \"must be at least 1\")),\n            )\n        }\n\n        val newOrder = orderService.updateOrderQuantity(order, request.quantity)\n        repository.save(newOrder)\n        return newOrder\n    }\n}\n\ndata class UpdateQuantityRequest(val quantity: Int)"}}}
