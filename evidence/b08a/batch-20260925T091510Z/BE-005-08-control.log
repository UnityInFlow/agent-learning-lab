on(order: Order, shipmentQuantity: Int) {\n        if (!canAllocateShipment(order, shipmentQuantity)) {\n            throw ConflictException(\n                ErrorCode.CONFLICT,\n                \"Shipment would exceed order quantity\",\n            )\n        }\n    }\n\n    fun updateOrderQuantity(order: Order, newQuantity: Int): Order {\n        val shipments = shipmentRepository.findByOrderId(order.orderId)\n        val currentAllocated = shipments\n            .filter { it.status != com.unityinflow.sample.shipment.ShipmentStatus.CANCELLED }\n            .sumOf { it.quantity }\n\n        if (newQuantity < currentAllocated) {\n            throw ConflictException(\n                ErrorCode.CONFLICT,\n                \"New quantity is below allocated quantity\",\n            )\n        }\n\n        val newOrder = order.copy(quantity = newQuantity)\n        val newFulfilment = calculateFulfilment(newOrder)\n        return newOrder.copy(fulfilment = newFulfilment)\n    }\n\n    fun updateOrderFulfilment(orderId: String) {\n        val order = orderRepository.findById(orderId) ?: return\n        val newFulfilment = calculateFulfilment(order)\n        val updatedOrder = order.copy(fulfilment = newFulfilment)\n        orderRepository.save(updatedOrder)\n    }\n}\n"}}}
