{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FX2zjui9gDvczhqYQrif12","type":"tool_result","content":"1\tpackage com.unityinflow.sample.customer\n2\t\n3\timport org.junit.jupiter.api.BeforeEach\n4\timport org.junit.jupiter.api.Test\n5\timport org.springframework.beans.factory.annotation.Autowired\n6\timport org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc\n7\timport org.springframework.boot.test.context.SpringBootTest\n8\timport org.springframework.http.MediaType\n9\timport org.springframework.test.web.servlet.MockMvc\n10\timport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get\n11\timport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post\n12\timport org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath\n13\timport org.springframework.test.web.servlet.result.MockMvcResultMatchers.status\n14\timport org.springframework.test.web.servlet.result.MockMvcResultMatchers.header\n15\t\n16\t/**\n17\t * Baseline behaviour of the fixture. BE-001 must not break any of these.\n18\t */\n19\t@SpringBootTest\n20\t@AutoConfigureMockMvc\n21\tclass CustomerControllerTest {\n22\t\n23\t    @Autowired\n24\t    lateinit var mockMvc: MockMvc\n25\t\n26\t    @Autowired\n27\t    lateinit var repository: InMemoryCustomerRepository\n28\t\n29\t    @BeforeEach\n30\t    fun reset() = repository.clear()\n31\t\n32\t    @Test\n33\t    fun `creates a customer and returns 201`() {\n34\t        mockMvc.perform(\n35\t            post(\"/customers\")\n36\t                .contentType(MediaType.APPLICATION_JSON)\n37\t                .content(\"\"\"{\"customerId\":\"C-1\",\"name\":\"Ada Lovelace\",\"email\":\"ada@example.com\"}\"\"\"),\n38\t        )\n39\t            .andExpect(status().isCreated)\n40\t            .andExpect(jsonPath(\"$.customerId\").value(\"C-1\"))\n41\t    }\n42\t\n43\t    @Test\n44\t    fun `reads back a created customer`() {\n45\t        mockMvc.perform(\n46\t            post(\"/customers\")\n47\t                .contentType(MediaType.APPLICATION_JSON)\n48\t                .content(\"\"\"{\"customerId\":\"C-2\",\"name\":\"Grace Hopper\",\"email\":\"grace@example.com\"}\"\"\"),\n49\t        ).andExpect(status().isCreated)\n50\t\n51\t        mockMvc.perform(get(\"/customers/C-2\"))\n52\t            .andExpect(status().isOk)\n53\t            .andExpect(jsonPath(\"$.name\").value(\"Grace Hopper\"))\n54\t    }\n55\t\n56\t    @Test\n57\t    fun `returns 404 through error envelope for an unknown customer`() {\n58\t        mockMvc.perform(get(\"/customers/does-not-exist\"))\n59\t            .andExpect(status().isNotFound)\n60\t            .andExpect(jsonPath(\"$.error.code\").value(\"CUSTOMER_NOT_FOUND\"))\n61\t            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n62\t    }\n63\t\n64\t    @Test\n65\t    fun `lists customers with pagination`() {\n66\t        mockMvc.perform(\n67\t            post(\"/customers\")\n68\t                .contentType(MediaType.APPLICATION_JSON)\n69\t                .content(\"\"\"{\"customerId\":\"C-x\",\"name\":\"Customer X\",\"email\":\"x@example.com\"}\"\"\"),\n70\t        ).andExpect(status().isCreated)\n71\t\n72\t        mockMvc.perform(\n73\t            post(\"/customers\")\n74\t                .contentType(MediaType.APPLICATION_JSON)\n75\t                .content(\"\"\"{\"customerId\":\"C-y\",\"name\":\"Customer Y\",\"email\":\"y@example.com\"}\"\"\"),\n76\t        ).andExpect(status().isCreated)\n77\t\n78\t        mockMvc.perform(get(\"/customers?offset=0&limit=1\"))\n79\t            .andExpect(status().isOk)\n80\t            .andExpect(header().exists(\"X-Total-Count\"))\n81\t            .andExpect(jsonPath(\"$.length()\").value(1))\n82\t            .andExpect(jsonPath(\"$[0].customerId\").value(\"C-x\"))\n83\t    }\n84\t\n85\t    @Test\n86\t    fun `rejects invalid pagination parameters`() {\n87\t        mockMvc.perform(get(\"/customers?offset=-1\"))\n88\t            .andExpect(status().is