   @Test\n    fun `creates a shipment in CREATED status`() {\n        mockMvc.perform(createShipment(\"S-1\"))\n            .andExpect(status().isCreated)\n            .andExpect(jsonPath(\"$.shipmentId\").value(\"S-1\"))\n            .andExpect(jsonPath(\"$.status\").value(\"CREATED\"))\n    }\n\n    @Test\n    fun `rejects a duplicate shipment id with the error envelope`() {\n        mockMvc.perform(createShipment(\"S-2\")).andExpect(status().isCreated)\n\n        mockMvc.perform(createShipment(\"S-2\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_ALREADY_EXISTS\"))\n    }\n\n    @Test\n    fun `returns a shipment by id`() {\n        mockMvc.perform(createShipment(\"S-3\")).andExpect(status().isCreated)\n\n        mockMvc.perform(get(\"/shipments/S-3\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.carrier\").value(\"DHL\"))\n    }\n\n    @Test\n    fun `reports an unknown shipment through the error envelope`() {\n        mockMvc.perform(get(\"/shipments/S-missing\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n    }\n\n    @Test\n    fun `lists shipments in id order`() {\n        mockMvc.perform(createShipment(\"S-b\")).andExpect(status().isCreated)\n        mockMvc.perform(createShipment(\"S-a\")).andExpect(status().isCreated)\n\n        mockMvc.perform(get(\"/shipments\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$[0].shipmentId\").value(\"S-a\"))\n            .andExpect(jsonPath(\"$[1].shipmentId\").value(\"S-b\"))\n    }\n}","new_string":"package com.unityinflow.sample.shipment\n\nimport com.unityinflow.sample.order.InMemoryOrderRepository\nimport com.unityinflow.sample.order.Order\nimport com.unityinflow.sample.order.Fulfilment\nimport com.unityinflow.sample.order.FulfilmentStatus\nimport com.unityinflow.sample.customer.InMemoryCustomerRepository\nimport com.unityinflow.sample.customer.Customer\nimport java.math.BigDecimal\nimport org.junit.jupiter.api.BeforeEach\nimport org.junit.jupiter.api.Test\nimport org.springframework.beans.factory.annotation.Autowired\nimport org.springframework.boot.test.context.SpringBootTest\nimport org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc\nimport org.springframework.http.MediaType\nimport org.springframework.test.web.servlet.MockMvc\nimport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get\nimport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post\nimport org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath\nimport org.springframework.test.web.servlet.result.MockMvcResultMatchers.status\nimport org.springframework.test.web.servlet.result.MockMvcResultMatchers.header\n\n/**\n * The shipment feature as it exists before BE-003.\n *\n * These are \"the existing tests\" for that benchmark: they must keep passing, and an agent\n * that breaks one has regressed the fixture rather than solved the task.\n */\n@SpringBootTest\n@AutoConfigureMockMvc\nclass ShipmentControllerTest {\n\n    @Autowired\n    lateinit var mockMvc: MockMvc\n\n    @Autowired\n    lateinit var repository: InMemoryShipmentRepository\n\n    @Autowired\n    lateinit var orderRepository: InMemoryOrderRepository\n\n    @Autowired\n    lateinit var customerRepository: InMemoryCustomerRepository\n\n    @BeforeEach\n    fun reset() {\n        repository.clear()\n        orderRepository.clear()\n        customerRepository.clear()\n    }\n\n    private fun createShipment(shipmentId: String, orderId: String = \"O-1\", quantity: String = \"\") =\n        post(\"/shipments\")\n            .contentType(MediaType.APPLICATION_JSON)\n            .content(\n                if (quantity.isEmpty()) {\n                    \"\"\"{\"shipmentId\":\"$shipmentId\",\"orderId\":\"$orderId\",\"carrier\":\"DHL\"}\"\"\"\n                } else {\n                    \"\"\"{\"shipmentId\":\"$shipmentId\",\"orderId\":\"$orderId\",\"carrier\":\"DHL\",\"quantity\":$quantity}\"\"\"\n                },\n            )\n\n    private fun createOrder(orderId: String, quantity: Int = 10) {\n        customerRepository.save(Customer(\"C-1\", \"Test\", \"test@example.com\"))\n        orderRepository.save(\n            Order(\n                orderId,\n                \"C-1\",\n                BigDecimal(\"100\"),\n                \"EUR\",\n                quantity,\n                Fulfilment(0, 0, FulfilmentStatus.UNALLOCATED),\n            ),\n        )\n    }\n\n    @Test\n    fun `creates a shipment in CREATED status`() {\n        createOrder(\"O-1\")\n\n        mockMvc.perform(createShipment(\"S-1\"))\n            .andExpect(status().isCreated)\n            .andExpect(jsonPath(\"$.shipmentId\").value(\"S-1\"))\n            .andExpect(jsonPath(\"$.status\").value(\"CREATED\"))\n    }\n\n    @Test\n    fun `rejects a duplicate shipment id with the error envelope`() {\n        createOrder(\"O-1\")\n\n        mockMvc.perform(createShipment(\"S-2\")).andExpect(status().isCreated)\n\n        mockMvc.perform(createShipment(\"S-2\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_ALREADY_EXISTS\"))\n    }\n\n    @Test\n    fun `returns a shipment by id`() {\n        createOrder(\"O-1\")\n\n        mockMvc.perform(createShipment(\"S-3\")).andExpect(status().isCreated)\n\n        mockMvc.perform(get(\"/shipments/S-3\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.carrier\").value(\"DHL\"))\n    }\n\n    @Test\n    fun `reports an unknown shipment through the error envelope`() {\n        mockMvc.perform(get(\"/shipments/S-missing\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n    }\n\n    @Test\n    fun `lists shipments in id order`() {\n        createOrder(\"O-1\")\n\n        mockMvc.perform(createShipment(\"S-b\")).andExpect(status().isCreated)\n        mockMvc.perform(createShipment(\"S-a\")).andExpect(status().isCreated)\n\n        mockMvc.perform(get(\"/shipments\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$[0].shipmentId\").value(\"S-a\"))\n            .andExpect(jsonPath(\"$[1].shipmentId\").value(\"S-b\"))\n    }\n\n    @Test\n    fun `creates shipment with default quantity of 1`() {\n        createOrder(\"O-1\")\n\n        mockMvc.perform(createShipment(\"S-4\"))\n            .andExpect(status().isCreated)\n            .andExpect(jsonPath(\"$.quantity\").value(1))\n    }\n\n    @Test\n    fun `rejects shipment with quantity less than 1`() {\n        createOrder(\"O-1\")\n\n        mockMvc.perform(createShipment(\"S-5\", quantity = \"0\"))\n            .andExpect(status().isBadRequest)\n            .andExpect(jsonPath(\"$.error.code\").value(\"VALIDATION_FAILED\"))\n    }\n\n    @Test\n    fun `rejects shipment that exceeds order quantity`() {\n        createOrder(\"O-qty-limit\", quantity = 5)\n\n        mockMvc.perform(createShipment(\"S-overflow\", \"O-qty-limit\", quantity = \"6\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ALLOCATION_EXCEEDS_ORDER_QUANTITY\"))\n    }\n\n    @Test\n    fun `lists shipments with pagination`() {\n        createOrder(\"O-1\")\n\n        mockMvc.perform(createShipment(\"S-x\"))\n            .andExpect(status().isCreated)\n        mockMvc.perform(createShipment(\"S-y\"))\n            .andExpect(status().isCreated)\n\n        mockMvc.perform(get(\"/shipments?offset=0&limit=1\"))\n            .andExpect(status().isOk)\n            .andExpect(header().exists(\"X-Total-Count\"))\n            .andExpect(jsonPath(\"$.length()\").value(1))\n            .andExpect(jsonPath(\"$[0].shipmentId\").value(\"S-x\"))\n    }\n\n    @Test\n    fun `confirms a shipment from CREATED to CONFIRMED`() {\n        createOrder(\"O-1\")\n\n        mockMvc.perform(createShipment(\"S-conf\"))\n            .andExpect(status().isCreated)\n\n        mockMvc.perform(post(\"/shipments/S-conf/confirm\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n    }\n\n    @Test\n    fun `delivers a shipment from CONFIRMED to DELIVERED`() {\n        createOrder(\"O-1\")\n\n        mockMvc.perform(createShipment(\"S-deliv\"))\n            .andExpect(status().isCreated)\n\n        mockMvc.perform(post(\"/shipments/S-deliv/confirm\"))\n            .andExpect(status().isOk)\n\n        mockMvc.perform(post(\"/shipments/S-deliv/deliver\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"DELIVERED\"))\n    }\n\n    @Test\n    fun `cancels a shipment from CREATED to CANCELLED`() {\n        createOrder(\"O-1\")\n\n        mockMvc.perform(createShipment(\"S-cancel\"))\n            .andExpect(status().isCreated)\n\n        mockMvc.perform(post(\"/shipments/S-cancel/cancel\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n    }\n\n    @Test\n    fun `rejects invalid shipment status transitions`() {\n        createOrder(\"O-1\")\n\n        mockMvc.perform(createShipment(\"S-invalid\"))\n            .andExpect(status().isCreated)\n\n        // Try to deliver without confirming first\n        mockMvc.perform(post(\"/shipments/S-invalid/deliver\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"INVALID_SHIPMENT_STATUS_TRANSITION\"))\n    }\n\n    @Test\n    fun `cancelling shipment releases its quantity`() {\n        createOrder(\"O-release\", quantity = 5)\n\n        mockMvc.perform(createShipment(\"S-rel1\", \"O-release\", quantity = \"3\"))\n            .andExpect(status().isCreated)\n\n        // Check order is allocated\n        mockMvc.perform(get(\"/orders/O-release\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.fulfilment.allocated\").value(3))\n\n        // Cancel the shipment\n        mockMvc.perform(post(\"/shipments/S-rel1/cancel\"))\n            .andExpect(status().isOk)\n\n        // Check order is back to unallocated\n        mockMvc.perform(get(\"/orders/O-release\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.fulfilment.allocated\").value(0))\n            .andExpect(jsonPath(\"$.fulfilment.status\").value(\"UNALLOCATED\"))\n    }\n}"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":3506,"cache_read_input_tokens":37937,"cache_creation":{"ephemeral_5m_input_tokens":3506,"ephemeral_1h_input_tokens":0},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":"toolu_019cMbotagjYKmjHGFV1poBV","session_id":"08f1547f-a645-4a88-9a28-f55cfc4fe79b","uuid":"50d5497a-6c24-453c-ad53-8a9ea500ddf7","timestamp":"2026-09-25T09:38:04.042Z","request_id":"req_011CfPw62Y9xG9MLoZbmuaMY","subagent_type":"implementer","task_description":"Implement BE-005 ticket"}
