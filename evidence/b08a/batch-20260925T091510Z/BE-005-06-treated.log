{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Pg5YBvL2yqvcBkvEYaxPA1","type":"tool_result","content":"1\tpackage com.unityinflow.sample.order\n2\t\n3\timport com.unityinflow.sample.customer.InMemoryCustomerRepository\n4\timport com.unityinflow.sample.shipment.InMemoryShipmentRepository\n5\timport org.junit.jupiter.api.BeforeEach\n6\timport org.junit.jupiter.api.Test\n7\timport org.springframework.beans.factory.annotation.Autowired\n8\timport org.springframework.boot.test.context.SpringBootTest\n9\timport org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc\n10\timport org.springframework.http.MediaType\n11\timport org.springframework.test.web.servlet.MockMvc\n12\timport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get\n13\timport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post\n14\timport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.put\n15\timport org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath\n16\timport org.springframework.test.web.servlet.result.MockMvcResultMatchers.status\n17\t\n18\t/**\n19\t * Tests for partial fulfillment: quantities, allocation, and fulfilment status.\n20\t */\n21\t@SpringBootTest\n22\t@AutoConfigureMockMvc\n23\tclass OrderFulfilmentTest {\n24\t\n25\t    @Autowired\n26\t    lateinit var mockMvc: MockMvc\n27\t\n28\t    @Autowired\n29\t    lateinit var orderRepository: InMemoryOrderRepository\n30\t\n31\t    @Autowired\n32\t    lateinit var shipmentRepository: InMemoryShipmentRepository\n33\t\n34\t    @Autowired\n35\t    lateinit var customerRepository: InMemoryCustomerRepository\n36\t\n37\t    @BeforeEach\n38\t    fun reset() {\n39\t        orderRepository.clear()\n40\t        shipmentRepository.clear()\n41\t        customerRepository.clear()\n42\t    }\n43\t\n44\t    private fun createCustomer(customerId: String) =\n45\t        post(\"/customers\")\n46\t            .contentType(MediaType.APPLICATION_JSON)\n47\t            .content(\"\"\"{\"customerId\":\"$customerId\",\"name\":\"Test\",\"email\":\"test@example.com\"}\"\"\")\n48\t\n49\t    private fun createOrder(orderId: String, quantity: Int = 10) =\n50\t        post(\"/orders\")\n51\t            .contentType(MediaType.APPLICATION_JSON)\n52\t            .content(\"\"\"{\"orderId\":\"$orderId\",\"customerId\":\"C-1\",\"amount\":49.90,\"currency\":\"EUR\",\"quantity\":$quantity}\"\"\")\n53\t\n54\t    private fun createShipment(shipmentId: String, orderId: String = \"O-1\", quantity: Int = 1) =\n55\t        post(\"/shipments\")\n56\t            .contentType(MediaType.APPLICATION_JSON)\n57\t            .content(\"\"\"{\"shipmentId\":\"$shipmentId\",\"orderId\":\"$orderId\",\"carrier\":\"DHL\",\"quantity\":$quantity}\"\"\")\n58\t\n59\t    @Test\n60\t    fun `order starts with UNALLOCATED fulfilment status`() {\n61\t        mockMvc.perform(createCustomer(\"C-1\")).andExpect(status().isCreated)\n62\t        mockMvc.perform(createOrder(\"O-1\", 5)).andExpect(status().isCreated)\n63\t\n64\t        mockMvc.perform(get(\"/orders/O-1\"))\n65\t            .andExpect(status().isOk)\n66\t            .andExpect(jsonPath(\"$.quantity\").value(5))\n67\t            .andExpect(jsonPath(\"$.fulfilment.allocated\").value(0))\n68\t            .andExpect(jsonPath(\"$.fulfilment.delivered\").value(0))\n69\t            .andExpect(jsonPath(\"$.fulfilment.status\").value(\"UNALLOCATED\"))\n70\t    }\n71\t\n72\t    @Test\n73\t    fun `shipment quantity is allocated when created`() {\n74\t        mockMvc.perform(createCustomer(\"C-1\")).andExpect(status().isCreated)\n75\t        mockMvc.perform(createOrder(\"O-1\", 5)).andExpect(status().isCreated)\n76\t        mockMvc.perform(createShipment(\"S-1\", \"O-1\", 3)).andExpect(status().isCreated)\n77\t\n78\t        mockMvc.perform(get(\"/orders/O-1\"))\n79\t            .andExpect(status().isOk)\n80\t            .andExpect(jsonPath(\"$.fulfilment.allocated\").value(3))\n81\t            .andExpect(jsonPath(\"$.fulfilment.status\").value(\"PARTIALLY_ALLOCATED\"))\n82\t    }\n83\t\n84\t    @Test\n85\t    fun `fulfilment status is FULLY_ALLOCATED when allocated equals quantity`() {\n86\t        mockMvc.perform(createCustomer(\"C-1\")).andExpect(status().isCreated)\n87\t        mockMvc.perform(createOrder(\"O-1\", 5)).andExpect(status().isCreated)\n88\t        mockMvc.perform(createShipment(\"S-1\", \"O-1\", 5)).andExpect(status().isCreated)\n89\t\n90\t        mockMvc.perform(get(\"/orders/O-1\"))\n91\t            .andExpect(status().isOk)\n92\t            .andExpect(jsonPath(\"$.fulfilment.allocated\").value(5))\n93\t            .andExpect(jsonPath(\"$.fulfilment.status\").value(\"FULLY_ALLOCATED\"))\n94\t    }\n95\t\n96\t    @Test\n97\t    fun `fulfilment status is DELIVERED when all shipments are delivered`() {\n98\t        mockMvc.perform(createCustomer(\"C-1\")).andExpect(status().isCreated)\n99\t        mockMvc.perform(createOrder(\"O-1\", 5)).andExpect(status().isCreated)\n100\t        mockMvc.perform(createShipment(\"S-1\", \"O-1\", 5)).andExpect(status().isCreated)\n101\t\n102\t        // Confirm and deliver the shipment\n103\t        mockMvc.perform(post(\"/shipments/S-1/confirm\")).andExpect(status().isOk)\n104\t        mockMvc.perform(post(\"/shipments/S-1/deliver\")).andExpect(status().isOk)\n105\t\n106\t        mockMvc.perform(get(\"/orders/O-1\"))\n107\t            .andExpect(status().isOk)\n108\t            .andExpect(jsonPath(\"$.fulfilment.delivered\").value(5))\n109\t            .andExpect(jsonPath(\"$.fulfilment.status\").value(\"DELIVERED\"))\n110\t    }\n111\t\n112\t    @Test\n113\t    fun `rejected when shipment quantity exceeds remaining order quantity`() {\n114\t        mockMvc.perform(createCustomer(\"C-1\")).andExpect(status().isCreated)\n115\t        mockMvc.perform(createOrder(\"O-1\", 5)).andExpect(status().isCreated)\n116\t        mockMvc.perform(createShipment(\"S-1\", \"O-1\", 3)).andExpect(status().isCreated)\n117\t\n118\t        mockMvc.perform(createShipment(\"S-2\", \"O-1\", 3))\n119\t            .andExpect(status().isConflict)\n120\t            .andExpect(jsonPath(\"$.error.code\").value(\"VALIDATION_FAILED\"))\n121\t    }\n122\t\n123\t    @Test\n124\t    fun `cancelled shipment releases its quantity`() {\n125\t        mockMvc.perform(createCustomer(\"C-1\")).andExpect(status().isCreated)\n126\t        mockMvc.perform(createOrder(\"O-1\", 5)).andExpect(status().isCreated)\n127\t        mockMvc.perform(createShipment(\"S-1\", \"O-1\", 5)).andExpect(status().isCreated)\n128\t\n129\t        // Verify allocated\n130\t        mockMvc.perform(get(\"/orders/O-1\"))\n131\t            .andExpect(status().isOk)\n132\t            .andExpect(jsonPath(\"$.fulfilment.allocated\").value(5))\n133\t            .andExpect(jsonPath(\"$.fulfilment.status\").value(\"FULLY_ALLOCATED\"))\n134\t\n135\t        // Cancel the shipment\n136\t        mockMvc.perform(post(\"/shipments/S-1/cancel\")).andExpect(status().isOk)\n137\t\n138\t        // Verify released\n139\t        mockMvc.perform(get(\"/orders/O-1\"))\n140\t            .andExpect(status().isOk)\n141\t            .andExpect(jsonPath(\"$.fulfilment.allocated\").value(0))\n142\t            .andExpect(jsonPath(\"$.fulfilment.status\").value(\"UNALLOCATED\"))\n143\t\n144\t        // Can now create a new shipment\n145\t        mockMvc.perform(createShipment(\"S-2\", \"O-1\", 5))\n146\t            .andExpect(status().isCreated)\n147\t    }\n148\t\n149\t    @Test\n150\t    fun `order quantity can be amended upward`() {\n151\t        mockMvc.perform(createCustomer(\"C-1\")).andExpect(status().isCreated)\n152\t        mockMvc.perform(createOrder(\"O-1\", 4)).andExpect(status().isCreated)\n153\t        mockMvc.perform(createShipment(\"S-1\", \"O-1\", 4)).andExpect(status().isCreated)\n154\t\n155\t        // Initially FULLY_ALLOCATED at quantity 4\n156\t        mockMvc.perform(get(\"/orders/O-1\"))\n157\t            .andExpect(jsonPath(\"$.fulfilment.status\").value(\"FULLY_ALLOCATED\"))\n158\t\n159\t        // Amend quantity to 6\n160\t        mockMvc.perform(\n161\t            put(\"/orders/O-1/quantity\")\n162\t                .contentType(MediaType.APPLICATION_JSON)\n163\t                .content(\"\"\"{\"quantity\":6}\"\"\"),\n164\t        ).andExpect(status().isOk)\n165\t\n166\t        // Now PARTIALLY_ALLOCATED\n167\t        mockMvc.perform(get(\"/orders/O-1\"))\n168\t            .andExpect(status().isOk)\n169\t            .andExpect(jsonPath(\"$.quantity\").value(6))\n170\t            .andExpect(jsonPath(\"$.fulfilment.allocated\").value(4))\n171\t            .andExpect(jsonPath(\"$.fulfilment.status\").value(\"PARTIALLY_ALLOCATED\"))\n172\t\n173\t        // Can create another shipment for the remaining 2\n174\t        mockMvc.perform(createShipment(\"S-2\", \"O-1\", 2))\n175\t            .andExpect(status().isCreated)\n176\t    }\n177\t\n178\t    @Test\n179\t    fun `amendment is rejected when new quantity is below allocated`() {\n180\t        mockMvc.perform(createCustomer(\"C-1\")).andExpect(status().isCreated)\n181\t        mockMvc.perform(createOrder(\"O-1\", 10)).andExpect(status().isCreated)\n182\t        mockMvc.perform(createShipment(\"S-1\", \"O-1\", 5)).andExpect(status().isCreated)\n183\t\n184\t        mockMvc.perform(\n185\t            put(\"/orders/O-1/quantity\")\n186\t                .contentType(MediaType.APPLICATION_JSON)\n187\t                .content(\"\"\"{\"quantity\":3}\"\"\"),\n188\t        )\n189\t            .andExpect(status().isConflict)\n190\t            .andExpect(jsonPath(\"$.error.code\").value(\"VALIDATION_FAILED\"))\n191\t    }\n192\t\n193\t    @Test\n194\t    fun `fulfilment filter lists only orders matching status`() {\n195\t        mockMvc.perform(createCustomer(\"C-1\")).andExpect(status().isCreated)\n196\t\n197\t        // Create three orders in different states\n198\t        mockMvc.perform(createOrder(\"O-1\", 5)).andExpect(status().isCreated)\n199\t        mockMvc.perform(createOrder(\"O-2\", 5)).andExpect(status().isCreated)\n200\t        mockMvc.perform(createOrder(\"O-3\", 5)).andExpect(status().isCreated)\n201\t\n202\t        // O-1: UNALLOCATED (no shipments)\n203\t        // O-2: PARTIALLY_ALLOCATED\n204\t        mockMvc.perform(createShipment(\"S-2\", \"O-2\", 2)).andExpect(status().isCreated)\n205\t\n206\t        // O-3: FULLY_ALLOCATED\n207\t        mockMvc.perform(createShipment(\"S-3\", \"O-3\", 5)).andExpect(status().isCreated)\n208\t\n209\t        // Filter by UNALLOCATED\n210\t        mockMvc.perform(get(\"/orders?fulfilment=UNALLOCATED\"))\n211\t            .andExpect(status().isOk)\n212\t            .andExpect(jsonPath(\"$.length()\").value(1))\n213\t            .andExpect(jsonPath(\"$[0].orderId\").value(\"O-1\"))\n214\t\n215\t        // Filter by PARTIALLY_ALLOCATED\n216\t        mockMvc.perform(get(\"/orders?fulfilment=PARTIALLY_ALLOCATED\"))\n217\t            .andExpect(status().isOk)\n218\t            .andExpect(jsonPath(\"$.length()\").value(1))\n219\t            .andExpect(jsonPath(\"$[0].orderId\").value(\"O-2\"))\n220\t\n221\t        // Filter by FULLY_ALLOCATED\n222\t        mockMvc.perform(get(\"/orders?fulfilment=FULLY_ALLOCATED\"))\n223\t            .andExpect(status().isOk)\n224\t            .andExpect(jsonPath(\"$.length()\").value(1))\n225\t            .andExpect(jsonPath(\"$[0].orderId\").value(\"O-3\"))\n226\t    }\n227\t\n228\t    @Test\n229\t    fun `invalid fulfilment filter value returns 400`() {\n230\t        mockMvc.perform(get(\"/orders?fulfilment=INVALID\"))\n231\t            .andExpect(status().isBadRequest)\n232\t            .andExpect(jsonPath(\"$.error.code\").value(\"VALIDATION_FAILED\"))\n233\t    }\n234\t\n235\t    @Test\n236\t    fun `list endpoint pagination`() {\n237\t        mockMvc.perform(createCustomer(\"C-1\")).andExpect(status().isCreated)\n238\t\n239\t        for (i in 1..5) {\n240\t            mockMvc.perform(createOrder(\"O-$i\", 5)).andExpect(status().isCreated)\n241\t        }\n242\t\n243\t        // First page (2 items)\n244\t        mockMvc.perform(get(\"/orders?limit=2&offset=0\"))\n245\t            .andExpect(status().isOk)\n246\t            .andExpect(jsonPath(\"$.length()\").value(2))\n247\t            .andExpect { result -> assert(result.response.getHeader(\"X-Total-Count\") == \"5\") }\n248\t\n249\t        // Second page\n250\t        mockMvc.perform(get(\"/orders?limit=2&offset=2\"))\n251\t            .andExpect(status().isOk)\n252\t            .andExpect(jsonPath(\"$.length()\").value(2))\n253\t            .andExpect(jsonPath(\"$[0].orderId\").value(\"O-3\"))\n254\t    }\n255\t\n256\t    @Test\n257\t    fun `X-Total-Count reflects fulfilment filter`() {\n258\t        mockMvc.perform(createCustomer(\"C-1\")).andExpect(status().isCreated)\n259\t\n260\t        // Create 3 orders, 2 allocated, 1 not\n261\t        for (i in 1..2) {\n262\t            mockMvc.perform(createOrder(\"O-$i\", 5)).andExpect(status().isCreated)\n263\t            mockMvc.perform(createShipment(\"S-$i\", \"O-$i\", 5)).andExpect(status().isCreated)\n264\t        }\n265\t        mockMvc.perform(createOrder(\"O-3\", 5)).andExpect(status().isCreated)\n266\t\n267\t        mockMvc.perform(get(\"/orders?fulfilment=FULLY_ALLOCATED\"))\n268\t            .andExpect { result -> assert(result.response.getHeader(\"X-Total-Count\") == \"2\") }\n269\t\n270\t        mockMvc.perform(get(\"/orders?fulfilment=UNALLOCATED\"))\n271\t            .andExpect { result -> assert(result.response.getHeader(\"X-Total-Count\") == \"1\") }\n272\t    }\n273\t}\n274\t"}]},"parent_tool_use_id":"toolu_01JvKoM3sf1TM8ZQpn5VWv4C","session_id":"42799910-08be-447c-8309-9c80ab7c85db","uuid":"31c2a7a1-2827-4dae-8be0-2d75a26af6bd","timestamp":"2026-09-25T10:39:20.459Z","subagent_type":"verifier","task_description":"Verify BE-005 implementation"}
