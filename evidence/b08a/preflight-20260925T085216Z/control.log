notation.RequestParam\nimport org.springframework.web.bind.annotation.RestController\n\n@RestController\n@RequestMapping(\"/customers\")\nclass CustomerController(\n    private val repository: InMemoryCustomerRepository,\n) {\n\n    @PostMapping\n    fun create(@RequestBody request: CreateCustomerRequest): ResponseEntity<Customer> {\n        val saved = repository.save(Customer(request.customerId, request.name, request.email))\n        return ResponseEntity.status(HttpStatus.CREATED).body(saved)\n    }\n\n    @GetMapping(\"/{customerId}\")\n    fun getById(@PathVariable customerId: String): Customer =\n        repository.findById(customerId)\n            ?: throw ResourceNotFoundException(\n                ErrorCode.CUSTOMER_NOT_FOUND,\n                \"No customer with id '$customerId'\",\n            )\n\n    @GetMapping\n    fun list(\n        @RequestParam(required = false, defaultValue = \"100\") limit: Int?,\n        @RequestParam(required = false, defaultValue = \"0\") offset: Int?,\n    ): ResponseEntity<List<Customer>> {\n        val actualLimit = limit ?: 100\n        val actualOffset = offset ?: 0\n\n        if (actualLimit < 1 || actualLimit > 100) {\n            throw ValidationException(\n                \"Invalid pagination limit\",\n                listOf(FieldViolation(\"limit\", \"must be between 1 and 100\")),\n            )\n        }\n        if (actualOffset < 0) {\n            throw ValidationException(\n                \"Invalid pagination offset\",\n                listOf(FieldViolation(\"offset\", \"must be 0 or more\")),\n            )\n        }\n\n        val (paged, total) = repository.findAll(actualLimit, actualOffset)\n        return ResponseEntity.ok()\n            .header(HttpHeaders.X_TOTAL_COUNT, total.toString())\n            .body(paged)\n    }\n}\n","structuredPatch":[{"oldStart":58,"oldLines":7,"newStart":58,"newLines":7,"lines":[" ","         val (paged, total) = repository.findAll(actualLimit, actualOffset)","         retur