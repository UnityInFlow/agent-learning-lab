.sample.api.ErrorCode\nimport com.unityinflow.sample.api.FieldViolation\nimport com.unityinflow.sample.api.ResourceNotFoundException\nimport com.unityinflow.sample.api.UnprocessableEntityException\nimport com.unityinflow.sample.api.ValidationException\nimport com.unityinflow.sample.customer.InMemoryCustomerRepository\nimport com.unityinflow.sample.shipment.InMemoryShipmentRepository\nimport org.springframework.http.HttpStatus\nimport org.springframework.http.ResponseEntity\nimport org.springframework.web.bind.annotation.GetMapping\nimport org.springframework.web.bind.annotation.PathVariable\nimport org.springframework.web.bind.annotation.PostMapping\nimport org.springframework.web.bind.annotation.PutMapping\nimport org.springframework.web.bind.annotation.RequestBody\nimport org.springframework.web.bind.annotation.RequestMapping\nimport org.springframework.web.bind.annotation.RequestParam\nimport org.springframework.web.bind.annotation.RestController","originalFile":"package com.unityinflow.sample.order\n\nimport com.unityinflow.sample.api.ConflictException\nimport com.unityinflow.sample.api.ErrorCode\nimport com.unityinflow.sample.api.FieldViolation\nimport com.unityinflow.sample.api.ResourceNotFoundException\nimport com.unityinflow.sample.api.UnprocessableEntityException\nimport com.unityinflow.sample.api.ValidationException\nimport com.unityinflow.sample.customer.InMemoryCustomerRepository\nimport com.unityinflow.sample.shipment.InMemoryShipmentRepository\nimport org.springframework.http.HttpHeaders\nimport org.springframework.http.HttpStatus\nimport org.springframework.http.ResponseEntity\nimport org.springframework.web.bind.annotation.GetMapping\nimport org.springframework.web.bind.annotation.PathVariable\nimport org.springframework.web.bind.annotation.PostMapping\nimport org.springframework.web.bind.annotation.PutMapping\nimport org.springframework.web.bind.annotation.RequestBody\nimport org.springframework.web.bind.annotation.RequestMapping\nimport org.springframework.web.bind.annotation.RequestParam\nimport org.springframework.web.bind.annotation.RestController\n\n@RestController\n@RequestMapping(\"/orders\")\nclass OrderController(\n    private val repository: InMemoryOrderRepository,\n    private val customerRepository: InMemoryCustomerRepository,\n    private val shipmentRepository: InMemoryShipmentRepository,\n) {\n\n    @PostMapping\n    fun create(@RequestBody request: CreateOrderRequest): ResponseEntity<Order> {\n        if (repository.existsById(request.orderId)) {\n            throw ConflictException(\n                ErrorCode.ORDER_ALREADY_EXISTS,\n                \"An order with id '${request.orderId}' already exists\",\n            )\n        }\n\n        if (customerRepository.findById(request.customerId) == null) {\n            throw UnprocessableEntityException(\n                ErrorCode.CUSTOMER_NOT_FOUND,\n                \"Customer with id '${request.customerId}' does not exist\",\n            )\n        }\n\n        val quantity = request.quantity ?: 1\n        if (quantity < 1) {\n            throw ValidationException(\n                \"Invalid quantity\",\n                listOf(FieldViolation(\"quantity\", \"must be at least 1\")),\n            )\n        }\n\n        val saved = repository.save(\n            Order(\n                request.orderId,\n                request.customerId,\n                request.amount,\n                request.currency,\n                quantity,\n            ),\n        )\n        return ResponseEntity.status(HttpStatus.CREATED).body(saved)\n    }\n\n    @GetMapping(\"/{orderId}\")\n    fun getById(@PathVariable orderId: String): Order =\n        repository.findById(orderId)\n            ?.let { calculateFulfilment(it) }\n            ?: throw ResourceNotFoundException(\n                ErrorCode.ORDER_NOT_FOUND,\n                \"No order with id '$orderId'\",\n            )\n\n    @GetMapping\n    fun list(\n        @RequestParam(required = false) fulfilment: String?,\n        @RequestParam(required = false, defaultValue = \"100\") limit: Int?,\n        @RequestParam(required = false, defaultValue = \"0\") offset: Int?,\n    ): ResponseEntity<List<Order>> {\n        val actualLimit = limit ?: 100\n        val actualOffset = offset ?: 0\n\n        if (actualLimit < 1 || actualLimit > 100) {\n            throw ValidationException(\n                \"Invalid pagination limit\",\n                listOf(FieldViolation(\"limit\", \"must be between 1 and 100\")),\n            )\n        }\n        if (actualOffset < 0) {\n            throw ValidationException(\n                \"Invalid pagination offset\",\n                listOf(FieldViolation(\"offset\", \"must be 0 or more\")),\n            )\n        }\n\n        val (paged, total) = if (fulfilment != null) {\n            try {\n                val status = FulfilmentStatus.valueOf(fulfilment)\n                repository.findAllByFulfilment(status, actualLimit, actualOffset)\n            } catch (e: IllegalArgumentException) {\n                throw ValidationException(\n                    \"Invalid fulfilment status\",\n                    listOf(FieldViolation(\"fulfilment\", \"invalid status value\")),\n                )\n            }\n        } else {\n            repository.findAll(actualLimit, actualOffset)\n        }\n\n        val withFulfilment = paged.map { calculateFulfilment(it) }\n        return ResponseEntity.ok()\n            .header(\"X-Total-Count\", total.toString())\n            .body(withFulfilment)\n    }\n\n    @PutMapping(\"/{orderId}/quantity\")\n    fun updateQuantity(\n        @PathVariable orderId: String,\n        @RequestBody request: UpdateQuantityRequest,\n    ): Order {\n        if (request.quantity < 1) {\n            throw ValidationException(\n                \"Invalid quantity\",\n                listOf(FieldViolation(\"quantity\", \"must be at least 1\")),\n            )\n        }\n\n        val order = repository.findById(orderId)\n            ?: throw ResourceNotFoundException(\n                ErrorCode.ORDER_NOT_FOUND,\n                \"No order with id '$orderId'\",\n            )\n\n        val shipments = shipmentRepository.findByOrderId(orderId)\n        val allocated = shipments\n            .filter { it.status != com.unityinflow.sample.shipment.ShipmentStatus.CANCELLED }\n            .sumOf { it.quantity }\n\n        if (request.quantity < allocated) {\n            throw ConflictException(\n                ErrorCode.UNPROCESSABLE_ENTITY,\n                \"New quantity cannot be less than allocated quantity\",\n            )\n        }\n\n        val updated = order.copy(quantity = request.quantity)\n        repository.save(updated)\n        return calculateFulfilment(updated)\n    }\n\n    private fun calculateFulfilment(order: Order): Order {\n        val shipments = shipmentRepository.findByOrderId(order.orderId)\n        val allocated = shipments\n            .filter { it.status != com.unityinflow.sample.shipment.ShipmentStatus.CANCELLED }\n            .sumOf { it.quantity }\n        val delivered = shipments\n            .filter { it.status == com.unityinflow.sample.shipment.ShipmentStatus.DELIVERED }\n            .sumOf { it.quantity }\n\n        val status = when {\n            delivered >= order.quantity -> FulfilmentStatus.DELIVERED\n            allocated >= order.quantity -> FulfilmentStatus.FULLY_ALLOCATED\n            allocated > 0 -> FulfilmentStatus.PARTIALLY_ALLOCATED\n            else -> FulfilmentStatus.UNALLOCATED\n        }\n\n        return order.copy(\n            fulfilment = OrderFulfilment(\n                allocated = allocated,\n                delivered = delivered,\n                status = status,\n            ),\n        )\n    }\n}\n","structuredPatch":[{"oldStart":8,"oldLines":7,"newStart":8,"newLines":6,"lines":[" import com.unityinflow.sample.api.ValidationException"," import com.unityinflow.sample.customer.InMemoryCustomerRepository"," import com.unityinflow.sample.shipment.InMemoryShipmentRepository","-import org.springframework.http.HttpHeaders"," import org.springframework.http.HttpStatus"," import org.springframework.http.ResponseEntity"," import org.springframework.web.bind.annotation.GetMapping"]}],"userModified":false,"replaceAll":false}}
