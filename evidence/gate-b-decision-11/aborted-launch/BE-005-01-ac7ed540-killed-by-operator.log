\",","+            )","+        }","+","+        val cancelled = shipment.copy(status = ShipmentStatus.CANCELLED)","+        repository.save(cancelled)","+        return cancelled","+    }","+","     @GetMapping","-    fun list(): List<Shipment> = repository.findAll()","+    fun list(","+        @RequestParam(defaultValue = \"100\") limit: Int,","+        @RequestParam(defaultValue = \"0\") offset: Int,","+    ): ResponseEntity<List<Shipment>> {","+        validatePagination(limit, offset)","+        val all = repository.findAll()","+        val total = all.size","+        val paginated = all.drop(offset).take(limit)","+        return ResponseEntity.ok()","+            .header(\"X-Total-Count\", total.toString())","+            .body(paginated)","+    }"," }","+","+private fun validatePagination(limit: Int, offset: Int) {","+    if (limit < 1 || limit > 100) {","+        throw ValidationException(","+            \"Invalid limit\",","+            listOf(FieldViolation(\"limit\", \"Must be between 1 and 100\")),","+        )","+    }","+    if (offset < 0) {","+        throw ValidationException(","+            \"Invalid offset\",","+            listOf(FieldViolation(\"offset\", \"Must be 0 or greater\")),","+        )","+    }","+}"]}],"userModified":false,"replaceAll":false}}
