"+            .header(\"X-Total-Count\", total.toString())","+            .body(paginated)","+    }","+","+    private fun enrichFulfilment(order: Order): Order {","+        val shipments = shipmentRepository.findByOrderId(order.orderId)","+        val allocated = shipments.filter { it.status != ShipmentStatus.CANCELLED }","+            .sumOf { it.quantity }","+        val delivered = shipments.filter { it.status == ShipmentStatus.DELIVERED }","+            .sumOf { it.quantity }","+","+        val status = when {","+            delivered >= order.quantity -> FulfilmentStatus.DELIVERED","+            allocated >= order.quantity -> FulfilmentStatus.FULLY_ALLOCATED","+            allocated > 0 -> FulfilmentStatus.PARTIALLY_ALLOCATED","+            else -> FulfilmentStatus.UNALLOCATED","+        }","+","+        return order.copy(","+            fulfilment = Fulfilment(allocated, delivered, status),","+        )","+    }"," }","+","+private fun validatePagination(limit: Int, offset: Int) {","+    if (limit < 1 || limit > 100) {","+        throw ValidationException(","+            \"Invalid limit\",","+            listOf(FieldViolation(\"limit\", \"Must be between 1 and 100\")),","+        )","+    }","+    if (offset < 0) {","+        throw ValidationException(","+            \"Invalid offset\",","+            listOf(FieldViolation(\"offset\", \"Must be 0 or greater\")),","+        )","+    }","+}"]}],"userModified":false,"replaceAll":false}}
