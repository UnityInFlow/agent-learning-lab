       \"Invalid quantity\",\n                listOf(FieldViolation(\"quantity\", \"Must be 1 or greater\")),\n            )\n        }\n\n        val customer = customerRepository.findById(request.customerId)\n        if (customer == null) {\n            throw UnprocessableEntityException(\n                ErrorCode.CUSTOMER_NOT_FOUND,\n                \"No customer with id '${request.customerId}'\",\n            )\n        }\n\n        val order = Order(\n            orderId = request.orderId,\n            customerId = request.customerId,\n            amount = request.amount,\n            currency = request.currency,\n            quantity = quantity,\n            fulfilment = Fulfilment(allocated = 0, delivered = 0, status = FulfilmentStatus.UNALLOCATED),\n        )\n        val saved = repository.save(order)\n        return ResponseEntity.status(HttpStatus.CREATED).body(saved)\n    }\n\n    @GetMapping(\"/{orderId}\")\n    fun getById(@PathVariable orderId: String): Order {\n        val order = repository.findById(orderId)\n            ?: throw ResourceNotFoundException(\n                ErrorCode.ORDER_NOT_FOUND,\n                \"No order with id '$orderId'\",\n            )\n        return enrichFulfilment(order)\n    }\n\n    @GetMapping\n    fun list(\n        @RequestParam(required = false) fulfilment: String?,\n        @RequestParam(defaultValue = \"100\") limit: Int,\n        @RequestParam(defaultValue = \"0\") offset: Int,\n    ): ResponseEntity<List<Order>> {\n        validatePagination(limit, offset)\n\n        var orders = repository.findAll().map { enrichFulfilment(it) }\n\n        if (fulfilment != null) {\n            val status = try {\n                FulfilmentStatus.valueOf(fulfilment)\n            } catch (e: IllegalArgumentException) {\n                throw ValidationException(\n                    \"Invalid fulfilment status\",\n                    listOf(FieldViolation(\"fulfilment\", \"Unknown status: $fulfilment\")),\n                )\n            }\n            orders = orders.filter { it.fulfilment.status == status }\n        }\n\n        val total = orders.size\n        val paginated = orders.drop(offset).take(limit)\n        return ResponseEntity.ok()\n            .header(\"X-Total-Count\", total.toString())\n            .body(paginated)\n    }\n\n    private fun enrichFulfilment(order: Order): Order {\n        val shipments = shipmentRepository.findByOrderId(order.orderId)\n        val allocated = shipments.filter { it.status != ShipmentStatus.CANCELLED }\n            .sumOf { it.quantity }\n        val delivered = shipments.filter { it.status == ShipmentStatus.DELIVERED }\n            .sumOf { it.quantity }\n\n        val status = when {\n            delivered >= order.quantity -> FulfilmentStatus.DELIVERED\n            allocated >= order.quantity -> FulfilmentStatus.FULLY_ALLOCATED\n            allocated > 0 -> FulfilmentStatus.PARTIALLY_ALLOCATED\n            else -> FulfilmentStatus.UNALLOCATED\n        }\n\n        return order.copy(\n            fulfilment = Fulfilment(allocated, delivered, status),\n        )\n    }\n}\n\nprivate fun validatePagination(limit: Int, offset: Int) {\n    if (limit < 1 || limit > 100) {\n        throw ValidationException(\n            \"Invalid limit\",\n            listOf(FieldViolation(\"limit\", \"Must be between 1 and 100\")),\n        )\n    }\n    if (offset < 0) {\n        throw ValidationException(\n            \"Invalid offset\",\n            listOf(FieldViolation(\"offset\", \"Must be 0 or greater\")),\n        )\n    }\n}"}}}
