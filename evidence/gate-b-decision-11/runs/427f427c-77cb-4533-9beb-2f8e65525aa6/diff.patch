+    private fun updateFulfilment(order: Order): Order {
+        val shipmentRepository = shipmentRepositoryProvider.getIfAvailable()
+            ?: return order
+        val shipments = shipmentRepository.findByOrderId(order.orderId)
+        val allocated = shipments
+            .filter { it.status != ShipmentStatus.CANCELLED }
+            .sumOf { it.quantity }
+        val delivered = shipments
+            .filter { it.status == ShipmentStatus.DELIVERED }
+            .sumOf { it.quantity }
+
+        val status = when {
+            delivered >= order.quantity -> OrderFulfilmentState.DELIVERED
+            allocated >= order.quantity -> OrderFulfilmentState.FULLY_ALLOCATED
+            allocated > 0 -> OrderFulfilmentState.PARTIALLY_ALLOCATED
+            else -> OrderFulfilmentState.UNALLOCATED
+        }
+
+        val fulfilment = FulfilmentStatus(
+            allocated = allocated,
+            delivered = delivered,
+            status = status,
+        )
+        return order.copy(fulfilment = fulfilment)
+    }
 
     fun clear() = store.clear()
