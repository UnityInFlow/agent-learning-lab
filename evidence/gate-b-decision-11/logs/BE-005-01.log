ect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_ALREADY_EXISTS\"))\n            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n    }\n}\n","structuredPatch":[{"oldStart":1,"oldLines":5,"newStart":1,"newLines":6,"lines":[" package com.unityinflow.sample.order"," ","+import com.unityinflow.sample.customer.InMemoryCustomerRepository"," import org.junit.jupiter.api.BeforeEach"," import org.junit.jupiter.api.Test"," import org.springframework.beans.factory.annotation.Autowired"]},{"oldStart":29,"oldLines":14,"newStart":30,"newLines":28,"lines":["     @Autowired","     lateinit var repository: InMemoryOrderRepository"," ","+    @Autowired","+    lateinit var customerRepository: InMemoryCustomerRepository","+","     @BeforeEach","-    fun reset() = repository.clear()","+    fun reset() {","+        repository.clear()","+        customerRepository.clear()","+        createCustomer(\"C-1\")","+    }"," ","-    private fun createOrder(orderId: String, amount: String = \"49.90\") =","+    private fun createCustomer(customerId: String) =","+        mockMvc.perform(","+            post(\"/customers\")","+                .contentType(MediaType.APPLICATION_JSON)","+                .content(\"\"\"{\"customerId\":\"$customerId\",\"name\":\"Test\",\"email\":\"test@example.com\"}\"\"\"),","+        )","+","+    private fun createOrder(orderId: String, amount: String = \"49.90\", customerId: String = \"C-1\") =","         post(\"/orders\")","             .contentType(MediaType.APPLICATION_JSON)","             .content(","-                \"\"\"{\"orderId\":\"$orderId\",\"customerId\":\"C-1\",\"amount\":$amount,\"currency\":\"EUR\"}\"\"\",","+                \"\"\"{\"orderId\":\"$orderId\",\"customerId\":\"$customerId\",\"amount\":$amount,\"currency\":\"EUR\"}\"\"\",","             )"," ","     @Test"]}],"userModified":false,"replaceAll":false}}
