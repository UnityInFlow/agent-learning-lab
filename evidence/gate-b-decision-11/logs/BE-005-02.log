 {\n155\t        val shipment = repository.findById(shipmentId)\n156\t            ?: throw ResourceNotFoundException(\n157\t                ErrorCode.SHIPMENT_NOT_FOUND,\n158\t                \"No shipment with id '$shipmentId'\",\n159\t            )\n160\t\n161\t        if (shipment.status != ShipmentStatus.CREATED) {\n162\t            throw ConflictException(\n163\t                ErrorCode.VALIDATION_FAILED,\n164\t                \"Shipment cannot transition from ${shipment.status} to CANCELLED\",\n165\t            )\n166\t        }\n167\t\n168\t        val updated = shipment.copy(status = ShipmentStatus.CANCELLED)\n169\t        val saved = repository.save(updated)\n170\t        updateOrderFulfilment(shipment.orderId)\n171\t        return saved\n172\t    }\n173\t\n174\t    private fun updateOrderFulfilment(orderId: String) {\n175\t        val order = orderRepository.findById(orderId) ?: return\n176\t        val shipments = repository.findByOrderId(orderId)\n177\t\n178\t        val allocated = shipments.filter { it.status != ShipmentStatus.CANCELLED }.sumOf { it.quantity }\n179\t        val delivered = shipments.filter { it.status == ShipmentStatus.DELIVERED }.sumOf { it.quantity }\n180\t\n181\t        val status = when {\n182\t            delivered >= order.quantity -> FulfilmentStatus.DELIVERED\n183\t            allocated >= order.quantity -> FulfilmentStatus.FULLY_ALLOCATED\n184\t            allocated > 0 -> FulfilmentStatus.PARTIALLY_ALLOCATED\n185\t            else -> FulfilmentStatus.UNALLOCATED\n186\t        }\n187\t\n188\t        val updatedOrder = order.copy(fulfilment = Fulfilment(allocated, delivered, status))\n189\t        orderRepository.save(updatedOrder)"}]},"parent_tool_use_id":null,"session_id":"608df81a-3cec-4901-9808-e36541aa49f3","uuid":"4a499c0b-ac3d-492e-9393-6d5bc5cd2a44","timestamp":"2026-09-17T08:32:33.003Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/jr/lwzz65cx5pndqqdgzhnym1pc0000gn/T/observatory-run-171cce49-22a0-4b53-afaf-2ff516ee3d7d/sample-service/src/main/kotlin/com/unityinflow/sample/shipment/ShipmentController.kt","content":"            .body(result.items)\n    }\n\n    @PostMapping(\"/{shipmentId}/confirm\")\n    fun confirm(@PathVariable shipmentId: String): Shipment {\n        val shipment = repository.findById(shipmentId)\n            ?: throw ResourceNotFoundException(\n                ErrorCode.SHIPMENT_NOT_FOUND,\n                \"No shipment with id '$shipmentId'\",\n            )\n\n        if (shipment.status != ShipmentStatus.CREATED) {\n            throw ConflictException(\n                ErrorCode.VALIDATION_FAILED,\n                \"Shipment cannot transition from ${shipment.status} to CONFIRMED\",\n            )\n        }\n\n        val updated = shipment.copy(status = ShipmentStatus.CONFIRMED)\n        return repository.save(updated)\n    }\n\n    @PostMapping(\"/{shipmentId}/deliver\")\n    fun deliver(@PathVariable shipmentId: String): Shipment {\n        val shipment = repository.findById(shipmentId)\n            ?: throw ResourceNotFoundException(\n                ErrorCode.SHIPMENT_NOT_FOUND,\n                \"No shipment with id '$shipmentId'\",\n            )\n\n        if (shipment.status != ShipmentStatus.CONFIRMED) {\n            throw ConflictException(\n                ErrorCode.VALIDATION_FAILED,\n                \"Shipment cannot transition from ${shipment.status} to DELIVERED\",\n            )\n        }\n\n        val updated = shipment.copy(status = ShipmentStatus.DELIVERED)\n        val saved = repository.save(updated)\n        updateOrderFulfilment(shipment.orderId)\n        return saved\n    }\n\n    @PostMapping(\"/{shipmentId}/cancel\")\n    fun cancel(@PathVariable shipmentId: String): Shipment {\n        val shipment = repository.findById(shipmentId)\n            ?: throw ResourceNotFoundException(\n                ErrorCode.SHIPMENT_NOT_FOUND,\n                \"No shipment with id '$shipmentId'\",\n            )\n\n        if (shipment.status != ShipmentStatus.CREATED) {\n            throw ConflictException(\n                ErrorCode.VALIDATION_FAILED,\n                \"Shipment cannot transition from ${shipment.status} to CANCELLED\",\n            )\n        }\n\n        val updated = shipment.copy(status = ShipmentStatus.CANCELLED)\n        val saved = repository.save(updated)\n        updateOrderFulfilment(shipment.orderId)\n        return saved\n    }\n\n    private fun updateOrderFulfilment(orderId: String) {\n        val order = orderRepository.findById(orderId) ?: return\n        val shipments = repository.findByOrderId(orderId)\n\n        val allocated = shipments.filter { it.status != ShipmentStatus.CANCELLED }.sumOf { it.quantity }\n        val delivered = shipments.filter { it.status == ShipmentStatus.DELIVERED }.sumOf { it.quantity }\n\n        val status = when {\n            delivered >= order.quantity -> FulfilmentStatus.DELIVERED\n            allocated >= order.quantity -> FulfilmentStatus.FULLY_ALLOCATED\n            allocated > 0 -> FulfilmentStatus.PARTIALLY_ALLOCATED\n            else -> FulfilmentStatus.UNALLOCATED\n        }\n\n        val updatedOrder = order.copy(fulfilment = Fulfilment(allocated, delivered, status))\n        orderRepository.save(updatedOrder)","numLines":80,"startLine":110,"totalLines":192}}}
