    ErrorCode.SHIPMENT_ALREADY_EXISTS,\n                \"A shipment with id '${request.shipmentId}' already exists\",\n            )\n        }\n\n        val saved = repository.save(\n            Shipment(\n                shipmentId = request.shipmentId,\n                orderId = request.orderId,\n                carrier = request.carrier,\n                status = ShipmentStatus.CREATED,\n            ),\n        )\n        return ResponseEntity.status(HttpStatus.CREATED).body(saved)\n    }\n\n    @GetMapping(\"/{shipmentId}\")\n    fun getById(@PathVariable shipmentId: String): Shipment =\n        repository.findById(shipmentId)\n            ?: throw ResourceNotFoundException(\n                ErrorCode.SHIPMENT_NOT_FOUND,\n                \"No shipment with id '$shipmentId'\",\n            )\n\n    @GetMapping\n    fun list(): List<Shipment> = repository.findAll()\n}","new_string":"package com.unityinflow.sample.shipment\n\nimport com.unityinflow.sample.api.ConflictException\nimport com.unityinflow.sample.api.ErrorCode\nimport com.unityinflow.sample.api.FieldViolation\nimport com.unityinflow.sample.api.ResourceNotFoundException\nimport com.unityinflow.sample.api.ValidationException\nimport com.unityinflow.sample.order.FulfilmentStatus\nimport com.unityinflow.sample.order.Fulfilment\nimport com.unityinflow.sample.order.InMemoryOrderRepository\nimport org.springframework.http.HttpStatus\nimport org.springframework.http.ResponseEntity\nimport org.springframework.web.bind.annotation.GetMapping\nimport org.springframework.web.bind.annotation.PathVariable\nimport org.springframework.web.bind.annotation.PostMapping\nimport org.springframework.web.bind.annotation.RequestBody\nimport org.springframework.web.bind.annotation.RequestMapping\nimport org.springframework.web.bind.annotation.RequestParam\nimport org.springframework.web.bind.annotation.RestController\n\n/**\n * Baseline shipment API: create, read, list.\n *\n * There is deliberately no way to confirm a shipment. That is BE-003.\n */\n@RestController\n@RequestMapping(\"/shipments\")\nclass ShipmentController(\n    private val repository: InMemoryShipmentRepository,\n    private val orderRepository: InMemoryOrderRepository,\n) {\n\n    @PostMapping\n    fun create(@RequestBody request: CreateShipmentRequest): ResponseEntity<Shipment> {\n        if (repository.existsById(request.shipmentId)) {\n            throw ConflictException(\n                ErrorCode.SHIPMENT_ALREADY_EXISTS,\n                \"A shipment with id '${request.shipmentId}' already exists\",\n            )\n        }\n\n        val quantity = request.quantity ?: 1\n        if (quantity < 1) {\n            throw ValidationException(\n                \"Quantity must be at least 1\",\n                listOf(FieldViolation(\"quantity\", \"must be at least 1\")),\n            )\n        }\n\n        val order = orderRepository.findById(request.orderId)\n        if (order != null) {\n            val shipments = repository.findByOrderId(request.orderId)\n            val allocatedQuantity = shipments.filter { it.status != ShipmentStatus.CANCELLED }.sumOf { it.quantity }\n            if (allocatedQuantity + quantity > order.quantity) {\n                throw ConflictException(\n                    ErrorCode.VALIDATION_FAILED,\n                    \"Adding this shipment would exceed the order's quantity\",\n                )\n            }\n        }\n\n        val shipment = Shipment(\n            shipmentId = request.shipmentId,\n            orderId = request.orderId,\n            carrier = request.carrier,\n            status = ShipmentStatus.CREATED,\n            quantity = quantity,\n        )\n        val saved = repository.save(shipment)\n        \n        if (order != null) {\n            updateOrderFulfilment(request.orderId)\n        }\n\n        return ResponseEntity.status(HttpStatus.CREATED).body(saved)\n    }\n\n    @GetMapping(\"/{shipmentId}\")\n    fun getById(@PathVariable shipmentId: String): Shipment =\n        repository.findById(shipmentId)\n            ?: throw ResourceNotFoundException(\n                ErrorCode.SHIPMENT_NOT_FOUND,\n                \"No shipment with id '$shipmentId'\",\n            )\n\n    @GetMapping\n    fun list(\n        @RequestParam(required = false) limit: Int?,\n        @RequestParam(required = false) offset: Int?,\n    ): ResponseEntity<List<Shipment>> {\n        val validatedLimit = limit ?: 100\n        val validatedOffset = offset ?: 0\n\n        if (validatedLimit < 1 || validatedLimit > 100) {\n            throw ValidationException(\n                \"Limit must be between 1 and 100\",\n                listOf(FieldViolation(\"limit\", \"must be between 1 and 100\")),\n            )\n        }\n        if (validatedOffset < 0) {\n            throw ValidationException(\n                \"Offset must be non-negative\",\n                listOf(FieldViolation(\"offset\", \"must be non-negative\")),\n            )\n        }\n\n        val result = repository.findAll(validatedLimit, validatedOffset)\n        return ResponseEntity.ok()\n            .header(\"X-Total-Count\", result.totalCount.toString())\n            .body(result.items)\n    }\n\n    @PostMapping(\"/{shipmentId}/confirm\")\n    fun confirm(@PathVariable shipmentId: String): Shipment {\n        val shipment = repository.findById(shipmentId)\n            ?: throw ResourceNotFoundException(\n                ErrorCode.SHIPMENT_NOT_FOUND,\n                \"No shipment with id '$shipmentId'\",\n            )\n\n        if (shipment.status != ShipmentStatus.CREATED) {\n            throw ConflictException(\n                ErrorCode.VALIDATION_FAILED,\n                \"Shipment cannot transition from ${shipment.status} to CONFIRMED\",\n            )\n        }\n\n        val updated = shipment.copy(status = ShipmentStatus.CONFIRMED)\n        return repository.save(updated)\n    }\n\n    @PostMapping(\"/{shipmentId}/deliver\")\n    fun deliver(@PathVariable shipmentId: String): Shipment {\n        val shipment = repository.findById(shipmentId)\n            ?: throw ResourceNotFoundException(\n                ErrorCode.SHIPMENT_NOT_FOUND,\n                \"No shipment with id '$shipmentId'\",\n            )\n\n        if (shipment.status != ShipmentStatus.CONFIRMED) {\n            throw ConflictException(\n                ErrorCode.VALIDATION_FAILED,\n                \"Shipment cannot transition from ${shipment.status} to DELIVERED\",\n            )\n        }\n\n        val updated = shipment.copy(status = ShipmentStatus.DELIVERED)\n        val saved = repository.save(updated)\n        updateOrderFulfilment(shipment.orderId)\n        return saved\n    }\n\n    @PostMapping(\"/{shipmentId}/cancel\")\n    fun cancel(@PathVariable shipmentId: String): Shipment {\n        val shipment = repository.findById(shipmentId)\n            ?: throw ResourceNotFoundException(\n                ErrorCode.SHIPMENT_NOT_FOUND,\n                \"No shipment with id '$shipmentId'\",\n            )\n\n        if (shipment.status != ShipmentStatus.CREATED) {\n            throw ConflictException(\n                ErrorCode.VALIDATION_FAILED,\n                \"Shipment cannot transition from ${shipment.status} to CANCELLED\",\n            )\n        }\n\n        val updated = shipment.copy(status = ShipmentStatus.CANCELLED)\n        val saved = repository.save(updated)\n        updateOrderFulfilment(shipment.orderId)\n        return saved\n    }\n\n    private fun updateOrderFulfilment(orderId: String) {\n        val order = orderRepository.findById(orderId) ?: return\n        val shipments = repository.findByOrderId(orderId)\n        \n        val allocated = shipments.filter { it.status != ShipmentStatus.CANCELLED }.sumOf { it.quantity }\n        val delivered = shipments.filter { it.status == ShipmentStatus.DELIVERED }.sumOf { it.quantity }\n        \n        val status = when {\n            delivered >= order.quantity -> FulfilmentStatus.DELIVERED\n            allocated >= order.quantity -> FulfilmentStatus.FULLY_ALLOCATED\n            allocated > 0 -> FulfilmentStatus.PARTIALLY_ALLOCATED\n            else -> FulfilmentStatus.UNALLOCATED\n        }\n\n        val updatedOrder = order.copy(fulfilment = Fulfilment(allocated, delivered, status))\n        orderRepository.save(updatedOrder)\n    }\n}"}}}
