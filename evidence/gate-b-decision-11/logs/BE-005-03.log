row ConflictException(\n                ErrorCode.ORDER_ALREADY_EXISTS,\n                \"An order with id '${request.orderId}' already exists\",\n            )\n        }\n\n        val saved = repository.save(\n            Order(\n                request.orderId,\n                request.customerId,\n                request.amount,\n                request.currency,\n                request.quantity,\n                FulfilmentStatus(0, 0, OrderFulfilmentState.UNALLOCATED),\n            ),\n        )\n        return ResponseEntity.status(HttpStatus.CREATED).body(saved)\n    }\n\n    @GetMapping(\"/{orderId}\")\n    fun getById(@PathVariable orderId: String): Order =\n        repository.findById(orderId)\n            ?: throw ResourceNotFoundException(\n                ErrorCode.ORDER_NOT_FOUND,\n                \"No order with id '$orderId'\",\n            )\n\n    @GetMapping\n    fun list(\n        @RequestParam(required = false) fulfilment: String?,\n        @RequestParam(defaultValue = \"100\") limit: Int,\n        @RequestParam(defaultValue = \"0\") offset: Int,\n    ): ResponseEntity<List<Order>> {\n        if (limit < 1 || limit > 100) {\n            throw ValidationException(\n                \"Invalid limit parameter\",\n                listOf(FieldViolation(\"limit\", \"must be between 1 and 100\")),\n            )\n        }\n        if (offset < 0) {\n            throw ValidationException(\n                \"Invalid offset parameter\",\n                listOf(FieldViolation(\"offset\", \"must be greater than or equal to 0\")),\n            )\n        }\n\n        val all = if (fulfilment != null) {\n            val state = try {\n                OrderFulfilmentState.valueOf(fulfilment)\n            } catch (e: IllegalArgumentException) {\n                throw ValidationException(\n                    \"Invalid fulfilment parameter\",\n                    listOf(FieldViolation(\"fulfilment\", \"must be a valid fulfilment status\")),\n                )