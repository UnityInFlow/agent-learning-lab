     if (repository.existsById(request.orderId)) {\n            throw ConflictException(\n                ErrorCode.ORDER_ALREADY_EXISTS,\n                \"An order with id '${request.orderId}' already exists\",\n            )\n        }\n\n        val quantity = request.quantity ?: 1\n        if (quantity < 1) {\n            throw ValidationException(\n                \"Invalid order parameters\",\n                listOf(FieldViolation(\"quantity\", \"must be at least 1\")),\n            )\n        }\n\n        if (customerRepository.findById(request.customerId) == null) {\n            throw UnprocessableEntityException(\n                ErrorCode.CUSTOMER_NOT_FOUND,\n                \"No customer with id '${request.customerId}'\",\n            )\n        }\n\n        val order = Order(\n            request.orderId,\n            request.customerId,\n            request.amount,\n            request.currency,\n            quantity,\n            Fulfilment(0, 0, FulfilmentStatus.UNALLOCATED),\n        )\n        val saved = repository.save(order)\n        return ResponseEntity.status(HttpStatus.CREATED).body(saved)\n    }\n\n    @GetMapping(\"/{orderId}\")\n    fun getById(@PathVariable orderId: String): Order {\n        val order = repository.findById(orderId)\n            ?: throw ResourceNotFoundException(\n                ErrorCode.ORDER_NOT_FOUND,\n                \"No order with id '$orderId'\",\n            )\n        return enrichWithFulfilment(order)\n    }\n\n    @GetMapping\n    fun list(\n        @RequestParam(defaultValue = \"100\") limit: Int?,\n        @RequestParam(defaultValue = \"0\") offset: Int?,\n        @RequestParam(required = false) fulfilment: String?,\n    ): ResponseEntity<List<Order>> {\n        val actualLimit = limit ?: 100\n        val actualOffset = offset ?: 0\n\n        if (actualLimit < 1 || actualLimit > 100) {\n            throw ValidationException(\n                \"Invalid pagination parameters\",\n                listOf(FieldViolation(\"limit\", \"must be between 1 and 100\")),\n            )\n        }\n        if (actualOffset < 0) {\n            throw ValidationException(\n                \"Invalid pagination parameters\",\n                listOf(FieldViolation(\"offset\", \"must be 0 or greater\")),\n            )\n        }\n\n        val status = if (fulfilment != null) {\n            try {\n                FulfilmentStatus.valueOf(fulfilment)\n            } catch (e: IllegalArgumentException) {\n                throw ValidationException(\n                    \"Invalid fulfilment parameter\",\n                    listOf(FieldViolation(\"fulfilment\", \"must be a valid fulfilment status\")),\n                )\n            }\n        } else {\n            null\n        }\n\n        val result = repository.findAllPaged(actualLimit, actualOffset, status)\n        val enriched = result.items.map { enrichWithFulfilment(it) }\n        return ResponseEntity.ok()\n            .header(\"X-Total-Count\", result.total.toString())\n            .body(enriched)\n    }\n\n    private fun enrichWithFulfilment(order: Order): Order {\n        val shipments = shipmentRepository.findByOrderId(order.orderId)\n        val allocated = shipments\n            .filter { it.status != ShipmentStatus.CANCELLED }\n            .sumOf { it.quantity }\n        val delivered = shipments\n            .filter { it.status == ShipmentStatus.DELIVERED }\n            .sumOf { it.quantity }\n\n        val fulfilmentStatus = when {\n            delivered >= order.quantity -> FulfilmentStatus.DELIVERED\n            allocated >= order.quantity -> FulfilmentStatus.FULLY_ALLOCATED\n            allocated > 0 -> FulfilmentStatus.PARTIALLY_ALLOCATED\n            else -> FulfilmentStatus.UNALLOCATED\n        }\n\n        return order.copy(fulfilment = Fulfilment(allocated, delivered, fulfilmentStatus))\n    }\n}","originalFile":"package com.unityinflow.sample.order\n\nimport com.unityinflow.sample.api.ConflictException\nimport com