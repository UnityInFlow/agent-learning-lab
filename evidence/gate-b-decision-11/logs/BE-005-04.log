         throw ValidationException(\n                \"Quantity must be at least 1\",\n                listOf(FieldViolation(\"quantity\", \"must be at least 1\")),\n            )\n        }\n\n        if (customerRepository.findById(request.customerId) == null) {\n            throw UnprocessableException(\n                ErrorCode.CUSTOMER_NOT_FOUND,\n                \"No customer with id '${request.customerId}'\",\n            )\n        }\n\n        val order = Order(\n            request.orderId,\n            request.customerId,\n            request.amount,\n            request.currency,\n            quantity,\n            calculateFulfilment(request.orderId, quantity),\n        )\n        val saved = repository.save(order)\n        return ResponseEntity.status(HttpStatus.CREATED).body(saved)\n    }\n\n    @GetMapping(\"/{orderId}\")\n    fun getById(@PathVariable orderId: String): Order {\n        val order = repository.findById(orderId)\n            ?: throw ResourceNotFoundException(\n                ErrorCode.ORDER_NOT_FOUND,\n                \"No order with id '$orderId'\",\n            )\n        return order.copy(fulfilment = calculateFulfilment(orderId, order.quantity))\n    }\n\n    @GetMapping\n    fun list(\n        @RequestParam(defaultValue = \"100\") limit: Int?,\n        @RequestParam(defaultValue = \"0\") offset: Int?,\n        @RequestParam(required = false) fulfilment: String?,\n    ): ResponseEntity<List<Order>> {\n        val l = limit ?: 100\n        val o = offset ?: 0\n\n        if (l < 1 || l > 100) {\n            throw ValidationException(\n                \"Limit must be between 1 and 100\",\n                listOf(FieldViolation(\"limit\", \"must be between 1 and 100\")),\n            )\n        }\n\n        if (o < 0) {\n            throw ValidationException(\n                \"Offset must be non-negative\",\n                listOf(FieldViolation(\"offset\", \"must be non-negative\")),\n            )\n        }\n\n        val fulfilmentStatus = if (fulfilment != null) {\n            try {\n                FulfilmentStatus.valueOf(fulfilment)\n            } catch (e: IllegalArgumentException) {\n                throw ValidationException(\n                    \"Invalid fulfilment status\",\n                    listOf(FieldViolation(\"fulfilment\", \"invalid status\")),\n                )\n            }\n        } else {\n            null\n        }\n\n        val (orders, total) = repository.findAll(l, o, fulfilmentStatus)\n        val enriched = orders.map { it.copy(fulfilment = calculateFulfilment(it.orderId, it.quantity)) }\n\n        val headers = HttpHeaders()\n        headers.set(\"X-Total-Count\", total.toString())\n        return ResponseEntity.ok().headers(headers).body(enriched)\n    }\n\n    private fun calculateFulfilment(orderId: String, quantity: Int): OrderFulfilment {\n        val shipments = shipmentRepository.findByOrderId(orderId)\n        val allocated = shipments.filter { it.status != ShipmentStatus.CANCELLED }.sumOf { it.quantity }\n        val delivered = shipments.filter { it.status == ShipmentStatus.DELIVERED }.sumOf { it.quantity }\n\n        val status = when {\n            delivered >= quantity -> FulfilmentStatus.DELIVERED\n            allocated >= quantity -> FulfilmentStatus.FULLY_ALLOCATED\n            allocated > 0 -> FulfilmentStatus.PARTIALLY_ALLOCATED\n            else -> FulfilmentStatus.UNALLOCATED\n        }\n\n        return OrderFulfilment(allocated, delivered, status)\n    }\n}"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":763,"cache_read_input_tokens":41697,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":763},"output_tokens":4,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"8dc4e942-d9e8-474a-a044-fcc0db998b69","uui