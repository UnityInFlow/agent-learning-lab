   FulfilmentStatus.valueOf(fulfilment)\n            } catch (e: IllegalArgumentException) {\n                throw ValidationException(\n                    \"Invalid fulfilment status\",\n                    listOf(FieldViolation(\"fulfilment\", \"invalid status\")),\n                )\n            }\n        } else {\n            null\n        }\n\n        val (orders, total) = repository.findAll(l, o, fulfilmentStatus)\n        val enriched = orders.map { it.copy(fulfilment = calculateFulfilment(it.orderId, it.quantity)) }\n\n        val headers = HttpHeaders()\n        headers.set(\"X-Total-Count\", total.toString())\n        return ResponseEntity.ok().headers(headers).body(enriched)\n    }\n\n    private fun calculateFulfilment(orderId: String, quantity: Int): OrderFulfilment {\n        val shipments = shipmentRepository.findByOrderId(orderId)\n        val allocated = shipments.filter { it.status != ShipmentStatus.CANCELLED }.sumOf { it.quantity }\n        val delivered = shipments.filter { it.status == ShipmentStatus.DELIVERED }.sumOf { it.quantity }\n\n        val status = when {\n            delivered >= quantity -> FulfilmentStatus.DELIVERED\n            allocated >= quantity -> FulfilmentStatus.FULLY_ALLOCATED\n            allocated > 0 -> FulfilmentStatus.PARTIALLY_ALLOCATED\n            else -> FulfilmentStatus.UNALLOCATED\n        }\n\n        return OrderFulfilment(allocated, delivered, status)\n    }\n}"}}}
