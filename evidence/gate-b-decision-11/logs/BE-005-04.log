yinflow.sample.order.InMemoryOrderRepository\nimport org.springframework.http.HttpHeaders\nimport org.springframework.http.HttpStatus\nimport org.springframework.http.ResponseEntity\nimport org.springframework.web.bind.annotation.GetMapping\nimport org.springframework.web.bind.annotation.PathVariable\nimport org.springframework.web.bind.annotation.PostMapping\nimport org.springframework.web.bind.annotation.RequestBody\nimport org.springframework.web.bind.annotation.RequestMapping\nimport org.springframework.web.bind.annotation.RequestParam\nimport org.springframework.web.bind.annotation.RestController\n\n@RestController\n@RequestMapping(\"/shipments\")\nclass ShipmentController(\n    private val repository: InMemoryShipmentRepository,\n    private val orderRepository: InMemoryOrderRepository,\n) {\n\n    @PostMapping\n    fun create(@RequestBody request: CreateShipmentRequest): ResponseEntity<Shipment> {\n        if (repository.existsById(request.shipmentId)) {\n            throw ConflictException(\n                ErrorCode.SHIPMENT_ALREADY_EXISTS,\n                \"A shipment with id '${request.shipmentId}' already exists\",\n            )\n        }\n\n        val quantity = request.quantity ?: 1\n        if (quantity < 1) {\n            throw ValidationException(\n                \"Quantity must be at least 1\",\n                listOf(FieldViolation(\"quantity\", \"must be at least 1\")),\n            )\n        }\n\n        val order = orderRepository.findById(request.orderId)\n        if (order != null) {\n            val shipments = repository.findByOrderId(request.orderId)\n            val allocated = shipments.filter { it.status != ShipmentStatus.CANCELLED }.sumOf { it.quantity }\n            if (allocated + quantity > order.quantity) {\n                throw ConflictException(\n                    ErrorCode.VALIDATION_FAILED,\n                    \"Shipment would exceed order quantity\",\n                )\n            }\n        }\n\n        val saved = repository.save(\n            Shipment(\n                shipmentId = request.shipmentId,\n                orderId = request.orderId,\n                carrier = request.carrier,\n                status = ShipmentStatus.CREATED,\n                quantity = quantity,\n            ),\n        )\n        return ResponseEntity.status(HttpStatus.CREATED).body(saved)\n    }\n\n    @GetMapping(\"/{shipmentId}\")\n    fun getById(@PathVariable shipmentId: String): Shipment =\n        repository.findById(shipmentId)\n            ?: throw ResourceNotFoundException(\n                ErrorCode.SHIPMENT_NOT_FOUND,\n                \"No shipment with id '$shipmentId'\",\n            )\n\n    @GetMapping\n    fun list(\n        @RequestParam(defaultValue = \"100\") limit: Int?,\n        @RequestParam(defaultValue = \"0\") offset: Int?,\n    ): ResponseEntity<List<Shipment>> {\n        val l = limit ?: 100\n        val o = offset ?: 0\n\n        if (l < 1 || l > 100) {\n            throw ValidationException(\n                \"Limit must be between 1 and 100\",\n                listOf(FieldViolation(\"limit\", \"must be between 1 and 100\")),\n            )\n        }\n\n        if (o < 0) {\n            throw ValidationException(\n                \"Offset must be non-negative\",\n                listOf(FieldViolation(\"offset\", \"must be non-negative\")),\n            )\n        }\n\n        val (shipments, total) = repository.findAll(l, o)\n        val headers = HttpHeaders()\n        headers.set(\"X-Total-Count\", total.toString())\n        return ResponseEntity.ok().headers(headers).body(shipments)\n    }\n\n    @PostMapping(\"/{shipmentId}/confirm\")\n    fun confirm(@PathVariable shipmentId: String): ResponseEntity<Shipment> {\n        val shipment = repository.findById(shipmentId)\n            ?: throw ResourceNotFoundException(\n                ErrorCode.SHIPMENT_NOT_FOUND,\n                \"No shipment with id '$shipmentId'\",\n            )\n\n        if (shipment.status != ShipmentStatus.CREATED) {\n            throw ConflictException(\n                ErrorCode.INVALID_TRANSITION,\n                \"Cannot confirm a shipment in ${shipment.status} status\",\n            )\n        }\n\n        val updated = shipment.copy(status = ShipmentStatus.CONFIRMED)\n        repository.save(updated)\n        return ResponseEntity.ok(updated)\n    }\n\n    @PostMapping(\"/{shipmentId}/deliver\")\n    fun deliver(@PathVariable shipmentId: String): ResponseEntity<Shipment> {\n        val shipment = repository.findById(shipmentId)\n            ?: throw ResourceNotFoundException(\n                ErrorCode.SHIPMENT_NOT_FOUND,\n                \"No shipment with id '$shipmentId'\",\n            )\n\n        if (shipment.status != ShipmentStatus.CONFIRMED) {\n            throw ConflictException(\n                ErrorCode.INVALID_TRANSITION,\n                \"Cannot deliver a shipment in ${shipment.status} status\",\n            )\n        }\n\n        val updated = shipment.copy(status = ShipmentStatus.DELIVERED)\n        repository.save(updated)\n        return ResponseEntity.ok(updated)\n    }\n\n    @PostMapping(\"/{shipmentId}/cancel\")\n    fun cancel(@PathVariable shipmentId: String): ResponseEntity<Shipment> {\n        val shipment = repository.findById(shipmentId)\n            ?: throw ResourceNotFoundException(\n                ErrorCode.SHIPMENT_NOT_FOUND,\n                \"No shipment with id '$shipmentId'\",\n            )\n\n        if (shipment.status != ShipmentStatus.CREATED) {\n            throw ConflictException(\n                ErrorCode.INVALID_TRANSITION,\n                \"Cannot cancel a shipment in ${shipment.status} status\",\n            )\n        }\n\n        val updated = shipment.copy(status = ShipmentStatus.CANCELLED)\n        repository.save(updated)\n        return ResponseEntity.ok(updated)\n    }\n}"}}}
