m(post(\"/shipments/S-5/confirm\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n\n        // Second confirm should succeed and change nothing\n        mockMvc.perform(post(\"/shipments/S-5/confirm\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.shipmentId\").value(\"S-5\"))\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n    }\n\n    @Test\n    fun `confirming a CANCELLED shipment is rejected with HTTP 409`() {\n        // Create and then manually set to CANCELLED\n        mockMvc.perform(createShipment(\"S-6\")).andExpect(status().isCreated)\n        val shipment = repository.findById(\"S-6\")!!\n        repository.save(shipment.copy(status = ShipmentStatus.CANCELLED))\n\n        mockMvc.perform(post(\"/shipments/S-6/confirm\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_CANNOT_BE_CONFIRMED\"))\n    }\n\n    @Test\n    fun `confirming a non-existent shipment is rejected with HTTP 404`() {\n        mockMvc.perform(post(\"/shipments/S-missing/confirm\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n    }\n}"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":1499,"cache_read_input_tokens":26717,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1499},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"9501a774-79dd-4ea6-8c94-b6b68d526d94","uuid":"96686dac-b29b-4060-8ac3-9df913149bad","timestamp":"2026-09-05T17:31:57.109Z","request_id":"req_011Cekh4TTXPQ4nRvE33h6J7"}
