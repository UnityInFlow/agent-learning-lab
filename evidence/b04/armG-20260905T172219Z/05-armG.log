dExpect(status().isCreated)\n\n        // First confirmation\n        mockMvc.perform(\n            post(\"/shipments/S-5/confirm\")\n                .contentType(MediaType.APPLICATION_JSON)\n        )\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n\n        // Retry confirmation — must succeed and change nothing\n        mockMvc.perform(\n            post(\"/shipments/S-5/confirm\")\n                .contentType(MediaType.APPLICATION_JSON)\n        )\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n    }\n\n    @Test\n    fun `rejects confirmation of a cancelled shipment with 409`() {\n        // Create and manually set to CANCELLED\n        mockMvc.perform(createShipment(\"S-6\")).andExpect(status().isCreated)\n        repository.save(\n            Shipment(\n                shipmentId = \"S-6\",\n                orderId = \"O-1\",\n                carrier = \"DHL\",\n                status = ShipmentStatus.CANCELLED,\n            ),\n        )\n\n        mockMvc.perform(\n            post(\"/shipments/S-6/confirm\")\n                .contentType(MediaType.APPLICATION_JSON)\n        )\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_CANNOT_BE_CONFIRMED\"))\n    }\n\n    @Test\n    fun `rejects confirmation of a non-existent shipment with 404`() {\n        mockMvc.perform(\n            post(\"/shipments/S-missing/confirm\")\n                .contentType(MediaType.APPLICATION_JSON)\n        )\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n    }\n}"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":775,"cache_read_input_tokens":29025,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":77