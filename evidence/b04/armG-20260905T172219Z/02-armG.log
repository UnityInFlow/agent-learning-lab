{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SqJYLHnWn24LmWwB2RBMeP","type":"tool_result","content":"1\tpackage com.unityinflow.sample.shipment\n2\t\n3\timport com.unityinflow.sample.api.ConflictException\n4\timport com.unityinflow.sample.api.ErrorCode\n5\timport com.unityinflow.sample.api.ResourceNotFoundException\n6\timport org.springframework.http.HttpStatus\n7\timport org.springframework.http.ResponseEntity\n8\timport org.springframework.web.bind.annotation.GetMapping\n9\timport org.springframework.web.bind.annotation.PathVariable\n10\timport org.springframework.web.bind.annotation.PostMapping\n11\timport org.springframework.web.bind.annotation.RequestBody\n12\timport org.springframework.web.bind.annotation.RequestMapping\n13\timport org.springframework.web.bind.annotation.RestController\n14\t\n15\t/**\n16\t * Shipment API: create, read, list, and confirm.\n17\t */\n18\t@RestController\n19\t@RequestMapping(\"/shipments\")\n20\tclass ShipmentController(\n21\t    private val repository: InMemoryShipmentRepository,\n22\t) {\n23\t\n24\t    @PostMapping\n25\t    fun create(@RequestBody request: CreateShipmentRequest): ResponseEntity<Shipment> {\n26\t        if (repository.existsById(request.shipmentId)) {\n27\t            throw ConflictException(\n28\t                ErrorCode.SHIPMENT_ALREADY_EXISTS,\n29\t                \"A shipment with id '${request.shipmentId}' already exists\",\n30\t            )\n31\t        }\n32\t\n33\t        val saved = repository.save(\n34\t            Shipment(\n35\t                shipmentId = request.shipmentId,\n36\t                orderId = request.orderId,\n37\t                carrier = request.carrier,\n38\t                status = ShipmentStatus.CREATED,\n39\t            ),\n40\t        )\n41\t        return ResponseEntity.status(HttpStatus.CREATED).body(saved)\n42\t    }\n43\t\n44\t    @GetMapping(\"/{shipmentId}\")\n45\t    fun getById(@PathVariable shipmentId: String): Shipment =\n46\t        repository.findById(shipmentId)\n47\t            ?: throw ResourceNotFoundException(\n48\t                ErrorCode.SHIPMENT_NOT_FOUND,\n49\t                \"No shipment with id '$shipmentId'\",\n50\t            )\n51\t\n52\t    @GetMapping\n53\t    fun list(): List<Shipment> = repository.findAll()\n54\t\n55\t    @PostMapping(\"/{shipmentId}/confirm\")\n56\t    fun confirm(@PathVariable shipmentId: String): Shipment {\n57\t        val shipment = repository.findById(shipmentId)\n58\t            ?: throw ResourceNotFoundException(\n59\t                ErrorCode.SHIPMENT_NOT_FOUND,\n60\t                \"No shipment with id '$shipmentId'\",\n61\t            )\n62\t\n63\t        return when (shipment.status) {\n64\t            ShipmentStatus.CREATED -> {\n65\t                val confirmed = shipment.copy(status = ShipmentStatus.CONFIRMED)\n66\t                repository.save(confirmed)\n67\t            }\n68\t            ShipmentStatus.CONFIRMED -> {\n69\t                // Idempotent: already confirmed, return as-is\n70\t                shipment\n71\t            }\n72\t            ShipmentStatus.CANCELLED -> {\n73\t                throw ConflictException(\n74\t                    ErrorCode.SHIPMENT_INVALID_STATE,\n75\t                    \"Cannot confirm a shipment with id '$shipmentId' in CANCELLED status\",\n76\t                )\n77\t            }\n78\t        }\n79\t    }\n80\t}\n81\t"}]},"parent_tool_use_id":null,"session_id":"b5f5e5a2-cbc1-4137-b488-4e88ddc953ee","uuid":"982b0ec5-4437-473f-bf2b-85be2c226128","timestamp":"2026-09-05T17:28:05.677Z","tool_use_result":{"type":"text","file":{"filePath":"/var/folders/jr/lwzz65cx5pndqqdgzhnym1pc0000gn/T/observatory-run-461e2185-c4f1-4b84-b062-e9f950028eac/sample-service/src/main/kotlin/com/unityinflow/sample/shipment/ShipmentController.kt","content":"package com.unityinflow.sample.shipment\n\nimport com.unityinflow.sample.api.ConflictException\nimport com.unityinflow.sample.api.ErrorCode\nimport com.unityinflow.sample.api.ResourceNotFoundException\nimport org.springframework.http.HttpStatus\nimport org.springframework.http.ResponseEntity\nimport org.springframework.web.bind.annotation.GetMapping\nimport org.springframework.web.bind.annotation.PathVariable\nimport org.springframework.web.bind.annotation.PostMapping\nimport org.springframework.web.bind.annotation.RequestBody\nimport org.springframework.web.bind.annotation.RequestMapping\nimport org.springframework.web.bind.annotation.RestController\n\n/**\n * Shipment API: create, read, list, and confirm.\n */\n@RestController\n@RequestMapping(\"/shipments\")\nclass ShipmentController(\n    private val repository: InMemoryShipmentRepository,\n) {\n\n    @PostMapping\n    fun create(@RequestBody request: CreateShipmentRequest): ResponseEntity<Shipment> {\n        if (repository.existsById(request.shipmentId)) {\n            throw ConflictException(\n                ErrorCode.SHIPMENT_ALREADY_EXISTS,\n                \"A shipment with id '${request.shipmentId}' already exists\",\n            )\n        }\n\n        val saved = repository.save(\n            Shipment(\n                shipmentId = request.shipmentId,\n                orderId = request.orderId,\n                carrier = request.carrier,\n                status = ShipmentStatus.CREATED,\n            ),\n        )\n        return ResponseEntity.status(HttpStatus.CREATED).body(saved)\n    }\n\n    @GetMapping(\"/{shipmentId}\")\n    fun getById(@PathVariable shipmentId: String): Shipment =\n        repository.findById(shipmentId)\n            ?: throw ResourceNotFoundException(\n                ErrorCode.SHIPMENT_NOT_FOUND,\n                \"No shipment with id '$shipmentId'\",\n            )\n\n    @GetMapping\n    fun list(): List<Shipment> = repository.findAll()\n\n    @PostMapping(\"/{shipmentId}/confirm\")\n    fun confirm(@PathVariable shipmentId: String): Shipment {\n        val shipment = repository.findById(shipmentId)\n            ?: throw ResourceNotFoundException(\n                ErrorCode.SHIPMENT_NOT_FOUND,\n                \"No shipment with id '$shipmentId'\",\n            )\n\n        return when (shipment.status) {\n            ShipmentStatus.CREATED -> {\n                val confirmed = shipment.copy(status = ShipmentStatus.CONFIRMED)\n                repository.save(confirmed)\n            }\n            ShipmentStatus.CONFIRMED -> {\n                // Idempotent: already confirmed, return as-is\n                shipment\n            }\n            ShipmentStatus.CANCELLED -> {\n                throw ConflictException(\n                    ErrorCode.SHIPMENT_INVALID_STATE,\n                    \"Cannot confirm a shipment with id '$shipmentId' in CANCELLED status\",\n                )\n            }\n        }\n    }\n}\n","numLines":81,"startLine":1,"totalLines":81}}}
