{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AqffcsYQ3HEg8tou4KL4v9","type":"tool_result","content":"1\tpackage com.unityinflow.sample.shipment\n2\t\n3\timport org.junit.jupiter.api.BeforeEach\n4\timport org.junit.jupiter.api.Test\n5\timport org.springframework.beans.factory.annotation.Autowired\n6\timport org.springframework.boot.test.context.SpringBootTest\n7\timport org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc\n8\timport org.springframework.http.MediaType\n9\timport org.springframework.test.web.servlet.MockMvc\n10\timport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get\n11\timport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post\n12\timport org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath\n13\timport org.springframework.test.web.servlet.result.MockMvcResultMatchers.status\n14\t\n15\t/**\n16\t * Tests for the shipment feature, including BE-003 (confirm endpoint).\n17\t */\n18\t@SpringBootTest\n19\t@AutoConfigureMockMvc\n20\tclass ShipmentControllerTest {\n21\t\n22\t    @Autowired\n23\t    lateinit var mockMvc: MockMvc\n24\t\n25\t    @Autowired\n26\t    lateinit var repository: InMemoryShipmentRepository\n27\t\n28\t    @BeforeEach\n29\t    fun reset() = repository.clear()\n30\t\n31\t    private fun createShipment(shipmentId: String) =\n32\t        post(\"/shipments\")\n33\t            .contentType(MediaType.APPLICATION_JSON)\n34\t            .content(\n35\t                \"\"\"{\"shipmentId\":\"$shipmentId\",\"orderId\":\"O-1\",\"carrier\":\"DHL\"}\"\"\",\n36\t            )\n37\t\n38\t    private fun confirmShipment(shipmentId: String) =\n39\t        post(\"/shipments/$shipmentId/confirm\")\n40\t            .contentType(MediaType.APPLICATION_JSON)\n41\t\n42\t    @Test\n43\t    fun `creates a shipment in CREATED status`() {\n44\t        mockMvc.perform(createShipment(\"S-1\"))\n45\t            .andExpect(status().isCreated)\n46\t            .andExpect(jsonPath(\"$.shipmentId\").value(\"S-1\"))\n47\t            .andExpect(jsonPath(\"$.status\").value(\"CREATED\"))\n48\t    }\n49\t\n50\t    @Test\n51\t    fun `rejects a duplicate shipment id with the error envelope`() {\n52\t        mockMvc.perform(createShipment(\"S-2\")).andExpect(status().isCreated)\n53\t\n54\t        mockMvc.perform(createShipment(\"S-2\"))\n55\t            .andExpect(status().isConflict)\n56\t            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_ALREADY_EXISTS\"))\n57\t    }\n58\t\n59\t    @Test\n60\t    fun `returns a shipment by id`() {\n61\t        mockMvc.perform(createShipment(\"S-3\")).andExpect(status().isCreated)\n62\t\n63\t        mockMvc.perform(get(\"/shipments/S-3\"))\n64\t            .andExpect(status().isOk)\n65\t            .andExpect(jsonPath(\"$.carrier\").value(\"DHL\"))\n66\t    }\n67\t\n68\t    @Test\n69\t    fun `reports an unknown shipment through the error envelope`() {\n70\t        mockMvc.perform(get(\"/shipments/S-missing\"))\n71\t            .andExpect(status().isNotFound)\n72\t            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n73\t    }\n74\t\n75\t    @Test\n76\t    fun `lists shipments in id order`() {\n77\t        mockMvc.perform(createShipment(\"S-b\")).andExpect(status().isCreated)\n78\t        mockMvc.perform(createShipment(\"S-a\")).andExpect(status().isCreated)\n79\t\n80\t        mockMvc.perform(get(\"/shipments\"))\n81\t            .andExpect(status().isOk)\n82\t            .andExpect(jsonPath(\"$[0].shipmentId\").value(\"S-a\"))\n83\t            .andExpect(jsonPath(\"$[1].shipmentId\").value(\"S-b\"))\n84\t    }\n85\t\n86\t    @Test\n87\t    fun `confirms a shipment in CREATED status and moves it to CONFIRMED`() {\n88\t        mockMvc.perform(createShipment(\"S-4\")).andExpect(status().isCreated)\n89\t\n90\t        mockMvc.perform(confirmShipment(\"S-4\"))\n91\t            .andExpect(status().isOk)\n92\t            .andExpect(jsonPath(\"$.shipmentId\").value(\"S-4\"))\n93\t            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n94\t    }\n95\t\n96\t    @Test\n97\t    fun `confirms an already CONFIRMED shipment idempotently`() {\n98\t        mockMvc.perform(createShipment(\"S-5\")).andExpect(status().isCreated)\n99\t        mockMvc.perform(confirmShipment(\"S-5\")).andExpect(status().isOk)\n100\t\n101\t        // Second confirm should succeed and return the same state\n102\t        mockMvc.perform(confirmShipment(\"S-5\"))\n103\t            .andExpect(status().isOk)\n104\t            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n105\t    }\n106\t\n107\t    @Test\n108\t    fun `rejects confirmation of a CANCELLED shipment with 409 Conflict`() {\n109\t        // Create and save a cancelled shipment directly to the repository\n110\t        val cancelled = Shipment(\n111\t            shipmentId = \"S-6\",\n112\t            orderId = \"O-1\",\n113\t            carrier = \"DHL\",\n114\t            status = ShipmentStatus.CANCELLED,\n115\t        )\n116\t        repository.save(cancelled)\n117\t\n118\t        mockMvc.perform(confirmShipment(\"S-6\"))\n119\t            .andExpect(status().isConflict)\n120\t            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_INVALID_STATE\"))\n121\t    }\n122\t\n123\t    @Test\n124\t    fun `rejects confirmation of a non-existent shipment with 404 Not Found`() {\n125\t        mockMvc.perform(confirmShipment(\"S-missing\"))\n126\t            .andExpect(status().isNotFound)\n127\t            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n128\t    }\n129\t}\n130\t"}]},"parent_tool_use_id":null,"session_id":"b5f5e5a2-cbc1-4137-b488-4e88ddc953ee","uuid":"f424a401-cbdf-48bf-bc5d-75c613a994a2","timestamp":"2026-09-05T17:28:10.256Z","tool_use_result":{"type":"text","file":{"filePath":"/var/folders/jr/lwzz65cx5pndqqdgzhnym1pc0000gn/T/observatory-run-461e2185-c4f1-4b84-b062-e9f950028eac/sample-service/src/test/kotlin/com/unityinflow/sample/shipment/ShipmentControllerTest.kt","content":"package com.unityinflow.sample.shipment\n\nimport org.junit.jupiter.api.BeforeEach\nimport org.junit.jupiter.api.Test\nimport org.springframework.beans.factory.annotation.Autowired\nimport org.springframework.boot.test.context.SpringBootTest\nimport org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc\nimport org.springframework.http.MediaType\nimport org.springframework.test.web.servlet.MockMvc\nimport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get\nimport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post\nimport org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath\nimport org.springframework.test.web.servlet.result.MockMvcResultMatchers.status\n\n/**\n * Tests for the shipment feature, including BE-003 (confirm endpoint).\n */\n@SpringBootTest\n@AutoConfigureMockMvc\nclass ShipmentControllerTest {\n\n    @Autowired\n    lateinit var mockMvc: MockMvc\n\n    @Autowired\n    lateinit var repository: InMemoryShipmentRepository\n\n    @BeforeEach\n    fun reset() = repository.clear()\n\n    private fun createShipment(shipmentId: String) =\n        post(\"/shipments\")\n            .contentType(MediaType.APPLICATION_JSON)\n            .content(\n                \"\"\"{\"shipmentId\":\"$shipmentId\",\"orderId\":\"O-1\",\"carrier\":\"DHL\"}\"\"\",\n            )\n\n    private fun confirmShipment(shipmentId: String) =\n        post(\"/shipments/$shipmentId/confirm\")\n            .contentType(MediaType.APPLICATION_JSON)\n\n    @Test\n    fun `creates a shipment in CREATED status`() {\n        mockMvc.perform(createShipment(\"S-1\"))\n            .andExpect(status().isCreated)\n            .andExpect(jsonPath(\"$.shipmentId\").value(\"S-1\"))\n            .andExpect(jsonPath(\"$.status\").value(\"CREATED\"))\n    }\n\n    @Test\n    fun `rejects a duplicate shipment id with the error envelope`() {\n        mockMvc.perform(createShipment(\"S-2\")).andExpect(status().isCreated)\n\n        mockMvc.perform(createShipment(\"S-2\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_ALREADY_EXISTS\"))\n    }\n\n    @Test\n    fun `returns a shipment by id`() {\n        mockMvc.perform(createShipment(\"S-3\")).andExpect(status().isCreated)\n\n        mockMvc.perform(get(\"/shipments/S-3\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.carrier\").value(\"DHL\"))\n    }\n\n    @Test\n    fun `reports an unknown shipment through the error envelope`() {\n        mockMvc.perform(get(\"/shipments/S-missing\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n    }\n\n    @Test\n    fun `lists shipments in id order`() {\n        mockMvc.perform(createShipment(\"S-b\")).andExpect(status().isCreated)\n        mockMvc.perform(createShipment(\"S-a\")).andExpect(status().isCreated)\n\n        mockMvc.perform(get(\"/shipments\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$[0].shipmentId\").value(\"S-a\"))\n            .andExpect(jsonPath(\"$[1].shipmentId\").value(\"S-b\"))\n    }\n\n    @Test\n    fun `confirms a shipment in CREATED status and moves it to CONFIRMED`() {\n        mockMvc.perform(createShipment(\"S-4\")).andExpect(status().isCreated)\n\n        mockMvc.perform(confirmShipment(\"S-4\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.shipmentId\").value(\"S-4\"))\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n    }\n\n    @Test\n    fun `confirms an already CONFIRMED shipment idempotently`() {\n        mockMvc.perform(createShipment(\"S-5\")).andExpect(status().isCreated)\n        mockMvc.perform(confirmShipment(\"S-5\")).andExpect(status().isOk)\n\n        // Second confirm should succeed and return the same state\n        mockMvc.perform(confirmShipment(\"S-5\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n    }\n\n    @Test\n    fun `rejects confirmation of a CANCELLED shipment with 409 Conflict`() {\n        // Create and save a cancelled shipment directly to the repository\n        val cancelled = Shipment(\n            shipmentId = \"S-6\",\n            orderId = \"O-1\",\n            carrier = \"DHL\",\n            status = ShipmentStatus.CANCELLED,\n        )\n        repository.save(cancelled)\n\n        mockMvc.perform(confirmShipment(\"S-6\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_INVALID_STATE\"))\n    }\n\n    @Test\n    fun `rejects confirmation of a non-existent shipment with 404 Not Found`() {\n        mockMvc.perform(confirmShipment(\"S-missing\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n    }\n}\n","numLines":130,"startLine":1,"totalLines":130}}}
