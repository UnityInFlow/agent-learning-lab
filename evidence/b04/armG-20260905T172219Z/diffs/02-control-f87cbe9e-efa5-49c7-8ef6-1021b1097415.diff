+    }
+
+    @Test
+    fun `confirming a cancelled shipment is rejected with conflict`() {
+        mockMvc.perform(createShipment("S-6")).andExpect(status().isCreated)
+        repository.save(repository.findById("S-6")!!.copy(status = ShipmentStatus.CANCELLED))
+
+        mockMvc.perform(post("/shipments/S-6/confirm"))
+            .andExpect(status().isConflict)
+            .andExpect(jsonPath("$.error.code").value("SHIPMENT_CANNOT_BE_CONFIRMED"))
+    }
