+
+    @Test
+    fun `confirms a shipment from CREATED to CONFIRMED`() {
+        mockMvc.perform(createShipment("S-4")).andExpect(status().isCreated)
+
+        mockMvc.perform(
+            post("/shipments/S-4/confirm")
+                .contentType(MediaType.APPLICATION_JSON)
+        )
+            .andExpect(status().isOk)
+            .andExpect(jsonPath("$.shipmentId").value("S-4"))
+            .andExpect(jsonPath("$.status").value("CONFIRMED"))
+    }
+
+    @Test
+    fun `confirms an already-confirmed shipment idempotently`() {
+        mockMvc.perform(createShipment("S-5")).andExpect(status().isCreated)
+
+        // First confirmation
+        mockMvc.perform(
+            post("/shipments/S-5/confirm")
+                .contentType(MediaType.APPLICATION_JSON)
+        )
+            .andExpect(status().isOk)
+            .andExpect(jsonPath("$.status").value("CONFIRMED"))
+
+        // Retry confirmation — must succeed and change nothing
+        mockMvc.perform(
+            post("/shipments/S-5/confirm")
+                .contentType(MediaType.APPLICATION_JSON)
+        )
+            .andExpect(status().isOk)
+            .andExpect(jsonPath("$.status").value("CONFIRMED"))
+    }
+
+    @Test
+    fun `rejects confirmation of a cancelled shipment with 409`() {
+        // Create and manually set to CANCELLED
+        mockMvc.perform(createShipment("S-6")).andExpect(status().isCreated)
+        repository.save(
+            Shipment(
+                shipmentId = "S-6",
+                orderId = "O-1",
+                carrier = "DHL",
+                status = ShipmentStatus.CANCELLED,
+            ),
+        )
+
+        mockMvc.perform(
+            post("/shipments/S-6/confirm")
+                .contentType(MediaType.APPLICATION_JSON)
+        )
+            .andExpect(status().isConflict)
+            .andExpect(jsonPath("$.error.code").value("SHIPMENT_CANNOT_BE_CONFIRMED"))
+    }
+
+    @Test
+    fun `rejects confirmation of a non-existent shipment with 404`() {
+        mockMvc.perform(
+            post("/shipments/S-missing/confirm")
+                .contentType(MediaType.APPLICATION_JSON)
+        )
+            .andExpect(status().isNotFound)
+            .andExpect(jsonPath("$.error.code").value("SHIPMENT_NOT_FOUND"))
+    }
 }
