diff --git a/sample-service/src/main/kotlin/com/unityinflow/sample/shipment/ShipmentController.kt b/sample-service/src/main/kotlin/com/unityinflow/sample/shipment/ShipmentController.kt
index 88727b7..7503d64 100644
--- a/sample-service/src/main/kotlin/com/unityinflow/sample/shipment/ShipmentController.kt
+++ b/sample-service/src/main/kotlin/com/unityinflow/sample/shipment/ShipmentController.kt
@@ -53,4 +53,30 @@ class ShipmentController(
 
     @GetMapping
     fun list(): List<Shipment> = repository.findAll()
+
+    @PostMapping("/{shipmentId}/confirm")
+    fun confirm(@PathVariable shipmentId: String): ResponseEntity<Shipment> {
+        val shipment = repository.findById(shipmentId)
+            ?: throw ResourceNotFoundException(
+                ErrorCode.SHIPMENT_NOT_FOUND,
+                "No shipment with id '$shipmentId'",
+            )
+
+        if (shipment.status == ShipmentStatus.CANCELLED) {
+            throw ConflictException(
+                ErrorCode.SHIPMENT_CANNOT_BE_CONFIRMED,
+                "Cannot confirm a cancelled shipment",
+            )
+        }
+
+        // If already CONFIRMED, return it as-is (idempotent)
+        if (shipment.status == ShipmentStatus.CONFIRMED) {
+            return ResponseEntity.ok(shipment)
+        }
+
+        // Transition from CREATED to CONFIRMED
+        val confirmed = shipment.copy(status = ShipmentStatus.CONFIRMED)
+        val saved = repository.save(confirmed)
+        return ResponseEntity.ok(saved)
+    }
 }
