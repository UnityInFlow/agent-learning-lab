+    @Test
+    fun `confirms a CREATED shipment and moves it to CONFIRMED`() {
+        mockMvc.perform(createShipment("S-1")).andExpect(status().isCreated)
+
+        mockMvc.perform(post("/shipments/S-1/confirm"))
+            .andExpect(status().isOk)
+            .andExpect(jsonPath("$.shipmentId").value("S-1"))
+            .andExpect(jsonPath("$.status").value("CONFIRMED"))
+    }
+
+    @Test
+    fun `confirming an already CONFIRMED shipment succeeds and changes nothing`() {
+        mockMvc.perform(createShipment("S-2")).andExpect(status().isCreated)
+        mockMvc.perform(post("/shipments/S-2/confirm")).andExpect(status().isOk)
+
+        mockMvc.perform(post("/shipments/S-2/confirm"))
+            .andExpect(status().isOk)
+            .andExpect(jsonPath("$.shipmentId").value("S-2"))
+            .andExpect(jsonPath("$.status").value("CONFIRMED"))
+    }
+
+    @Test
+    fun `confirming a CANCELLED shipment is rejected with HTTP 409`() {
+        mockMvc.perform(createShipment("S-3")).andExpect(status().isCreated)
+        repository.save(
+            Shipment(
+                shipmentId = "S-cancelled",
+                orderId = "O-1",
+                carrier = "DHL",
+                status = ShipmentStatus.CANCELLED,
+            ),
+        )
+
+        mockMvc.perform(post("/shipments/S-cancelled/confirm"))
+            .andExpect(status().isConflict)
+            .andExpect(jsonPath("$.error.code").value("SHIPMENT_CANNOT_CONFIRM"))
+    }
+
+    @Test
+    fun `confirming an unknown shipment is rejected with HTTP 404`() {
