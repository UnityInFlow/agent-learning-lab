+
+    @Test
+    fun `confirms a created shipment and moves it to CONFIRMED status`() {
+        mockMvc.perform(createShipment("S-4")).andExpect(status().isCreated)
+
+        mockMvc.perform(
+            post("/shipments/S-4/confirm")
+                .contentType(MediaType.APPLICATION_JSON)
+        )
+            .andExpect(status().isOk)
+            .andExpect(jsonPath("$.shipmentId").value("S-4"))
+            .andExpect(jsonPath("$.status").value("CONFIRMED"))
+    }
+
+    @Test
+    fun `confirming an already confirmed shipment succeeds and changes nothing`() {
+        mockMvc.perform(createShipment("S-5")).andExpect(status().isCreated)
+        mockMvc.perform(
+            post("/shipments/S-5/confirm")
+                .contentType(MediaType.APPLICATION_JSON)
+        ).andExpect(status().isOk)
+
+        // Confirm again - should be idempotent
+        mockMvc.perform(
+            post("/shipments/S-5/confirm")
+                .contentType(MediaType.APPLICATION_JSON)
+        )
+            .andExpect(status().isOk)
+            .andExpect(jsonPath("$.shipmentId").value("S-5"))
+            .andExpect(jsonPath("$.status").value("CONFIRMED"))
+    }
+
+    @Test
+    fun `confirming a cancelled shipment is rejected with 409 conflict`() {
+        // Create a shipment
+        mockMvc.perform(createShipment("S-6")).andExpect(status().isCreated)
+
+        // Manually set it to CANCELLED in the repository
+        val shipment = repository.findById("S-6")!!
+        repository.save(shipment.copy(status = ShipmentStatus.CANCELLED))
+
+        mockMvc.perform(
+            post("/shipments/S-6/confirm")
+                .contentType(MediaType.APPLICATION_JSON)
+        )
+            .andExpect(status().isConflict)
+            .andExpect(jsonPath("$.error.code").value("SHIPMENT_CANNOT_CONFIRM"))
+    }
+
+    @Test
+    fun `confirming a non-existent shipment is rejected with 404`() {
+        mockMvc.perform(
+            post("/shipments/S-missing/confirm")
+                .contentType(MediaType.APPLICATION_JSON)
+        )
+            .andExpect(status().isNotFound)
+            .andExpect(jsonPath("$.error.code").value("SHIPMENT_NOT_FOUND"))
+    }
 }
