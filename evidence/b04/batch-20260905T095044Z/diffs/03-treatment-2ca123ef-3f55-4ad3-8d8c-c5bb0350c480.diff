             .andExpect(jsonPath("$[0].shipmentId").value("S-a"))
             .andExpect(jsonPath("$[1].shipmentId").value("S-b"))
     }
+
+    @Test
+    fun `confirms a CREATED shipment to CONFIRMED`() {
+        mockMvc.perform(createShipment("S-1")).andExpect(status().isCreated)
+
+        mockMvc.perform(post("/shipments/S-1/confirm"))
+            .andExpect(status().isOk)
+            .andExpect(jsonPath("$.shipmentId").value("S-1"))
+            .andExpect(jsonPath("$.status").value("CONFIRMED"))
+    }
+
+    @Test
+    fun `confirming an already CONFIRMED shipment succeeds and changes nothing`() {
+        mockMvc.perform(createShipment("S-2")).andExpect(status().isCreated)
+
+        // First confirm
+        mockMvc.perform(post("/shipments/S-2/confirm"))
+            .andExpect(status().isOk)
+            .andExpect(jsonPath("$.status").value("CONFIRMED"))
+
+        // Second confirm (retry) should succeed and return the same state
+        mockMvc.perform(post("/shipments/S-2/confirm"))
+            .andExpect(status().isOk)
+            .andExpect(jsonPath("$.status").value("CONFIRMED"))
+    }
+
+    @Test
+    fun `confirming a CANCELLED shipment returns 409`() {
+        // Create and directly modify to CANCELLED status in repository
+        mockMvc.perform(createShipment("S-3")).andExpect(status().isCreated)
+        val shipment = repository.findById("S-3")!!
+        repository.save(shipment.copy(status = ShipmentStatus.CANCELLED))
+
+        mockMvc.perform(post("/shipments/S-3/confirm"))
+            .andExpect(status().isConflict)
+            .andExpect(jsonPath("$.error.code").value("SHIPMENT_CANNOT_BE_CONFIRMED"))
+    }
+
+    @Test
+    fun `confirming a non-existent shipment returns 404`() {
+        mockMvc.perform(post("/shipments/S-missing/confirm"))
+            .andExpect(status().isNotFound)
+            .andExpect(jsonPath("$.error.code").value("SHIPMENT_NOT_FOUND"))
+    }
 }
