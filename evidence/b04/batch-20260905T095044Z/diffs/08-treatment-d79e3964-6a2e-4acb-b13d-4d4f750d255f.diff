 @RestController
 @RequestMapping("/shipments")
@@ -53,4 +51,30 @@ class ShipmentController(
 
     @GetMapping
     fun list(): List<Shipment> = repository.findAll()
+
+    @PostMapping("/{shipmentId}/confirm")
+    fun confirm(@PathVariable shipmentId: String): Shipment {
+        val shipment = repository.findById(shipmentId)
+            ?: throw ResourceNotFoundException(
+                ErrorCode.SHIPMENT_NOT_FOUND,
+                "No shipment with id '$shipmentId'",
+            )
+
+        if (shipment.status == ShipmentStatus.CANCELLED) {
+            throw ConflictException(
+                ErrorCode.SHIPMENT_CANCELLED,
+                "Cannot confirm a cancelled shipment with id '$shipmentId'",
+            )
+        }
+
+        // If already CONFIRMED, do nothing (idempotent). If CREATED, transition to CONFIRMED.
+        val updatedShipment = if (shipment.status == ShipmentStatus.CREATED) {
+            shipment.copy(status = ShipmentStatus.CONFIRMED)
+        } else {
+            shipment
+        }
+
+        repository.save(updatedShipment)
+        return updatedShipment
+    }
 }
