+    @Test
+    fun `confirms a created shipment and moves it to confirmed status`() {
+        mockMvc.perform(createShipment("S-4")).andExpect(status().isCreated)
+
+        mockMvc.perform(post("/shipments/S-4/confirm"))
+            .andExpect(status().isOk)
