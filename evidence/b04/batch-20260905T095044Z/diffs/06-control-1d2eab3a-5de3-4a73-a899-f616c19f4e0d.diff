+            .andExpect(jsonPath("$.status").value("CONFIRMED"))
+    }
+
+    @Test
+    fun `confirming a cancelled shipment is rejected with 409 conflict`() {
+        val shipment = Shipment("S-6", "O-6", "DHL", ShipmentStatus.CANCELLED)
+        repository.save(shipment)
+
+        mockMvc.perform(post("/shipments/S-6/confirm"))
+            .andExpect(status().isConflict)
+            .andExpect(jsonPath("$.error.code").value("SHIPMENT_CANCELLED"))
+    }
+
