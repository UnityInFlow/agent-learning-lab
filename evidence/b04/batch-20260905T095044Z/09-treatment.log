hipments/S-5/confirm\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n\n        // Retry should also succeed and return the same CONFIRMED status\n        mockMvc.perform(post(\"/shipments/S-5/confirm\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n    }\n\n    @Test\n    fun `rejecting confirmation of a CANCELLED shipment with 409`() {\n        mockMvc.perform(createShipment(\"S-6\")).andExpect(status().isCreated)\n\n        // Manually set the shipment to CANCELLED status\n        val shipment = repository.findById(\"S-6\")!!\n        repository.save(shipment.copy(status = ShipmentStatus.CANCELLED))\n\n        mockMvc.perform(post(\"/shipments/S-6/confirm\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_CANCELLED\"))\n    }\n\n    @Test\n    fun `rejecting confirmation of a non-existent shipment with 404`() {\n        mockMvc.perform(post(\"/shipments/S-missing/confirm\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n    }\n}"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":997,"cache_read_input_tokens":19089,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":997},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"2c1f3b49-3c6c-4068-87f0-db610e16bd4f","uuid":"a9d98607-f437-45fd-9c7c-d4763755fedc","timestamp":"2026-09-05T10:27:44.036Z","request_id":"req_011Cek8i4YbPVyKeDFLMWQma"}
