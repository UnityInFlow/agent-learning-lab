ndExpect(status().isCreated)\n        mockMvc.perform(\n            post(\"/shipments/S-5/confirm\")\n                .contentType(MediaType.APPLICATION_JSON),\n        ).andExpect(status().isOk)\n\n        mockMvc.perform(\n            post(\"/shipments/S-5/confirm\")\n                .contentType(MediaType.APPLICATION_JSON),\n        )\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.shipmentId\").value(\"S-5\"))\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n    }\n\n    @Test\n    fun `rejecting confirm of a cancelled shipment with conflict error`() {\n        mockMvc.perform(createShipment(\"S-6\")).andExpect(status().isCreated)\n        repository.save(Shipment(\"S-6\", \"O-1\", \"DHL\", ShipmentStatus.CANCELLED))\n\n        mockMvc.perform(\n            post(\"/shipments/S-6/confirm\")\n                .contentType(MediaType.APPLICATION_JSON),\n        )\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_ALREADY_CANCELLED\"))\n    }\n\n    @Test\n    fun `rejecting confirm of non-existent shipment with not found error`() {\n        mockMvc.perform(\n            post(\"/shipments/S-missing/confirm\")\n                .contentType(MediaType.APPLICATION_JSON),\n        )\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n    }\n}"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":609,"cache_read_input_tokens":32296,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":609},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"b7bdbd26-1d1f-4e5e-9b38-8ca47767bb89","uuid":"30c77513-2792-4864-bd1b-6ad827dc70b7","timestamp":"2026-09-05T10:21:08.536Z","reques