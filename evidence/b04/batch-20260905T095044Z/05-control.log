\")).andExpect(status().isOk)\n\n        mockMvc.perform(post(\"/shipments/S-5/confirm\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n    }\n\n    @Test\n    fun `confirming a cancelled shipment returns conflict`() {\n        mockMvc.perform(createShipment(\"S-6\")).andExpect(status().isCreated)\n\n        repository.save(\n            Shipment(\n                shipmentId = \"S-cancelled\",\n                orderId = \"O-1\",\n                carrier = \"DHL\",\n                status = ShipmentStatus.CANCELLED,\n            ),\n        )\n\n        mockMvc.perform(post(\"/shipments/S-cancelled/confirm\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_CANCELLED\"))\n    }\n\n    @Test\n    fun `confirming a non-existent shipment returns not found`() {\n        mockMvc.perform(post(\"/shipments/S-missing/confirm\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n    }\n}"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":1313,"cache_read_input_tokens":32039,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1313},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"387bc6d2-d992-44d8-8056-7a58eafd9b94","uuid":"05ee30ef-8a88-4299-947e-66f44d8c2d7a","timestamp":"2026-09-05T10:12:28.063Z","request_id":"req_011Cek7YWDnfPfJ9G1ohCQRG"}
