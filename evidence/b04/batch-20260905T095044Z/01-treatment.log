{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01L3ZogJdZVD7xJzt9D7RWiv","type":"tool_result","content":"1\tpackage com.unityinflow.sample.shipment\n2\t\n3\timport org.junit.jupiter.api.BeforeEach\n4\timport org.junit.jupiter.api.Test\n5\timport org.springframework.beans.factory.annotation.Autowired\n6\timport org.springframework.boot.test.context.SpringBootTest\n7\timport org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc\n8\timport org.springframework.http.MediaType\n9\timport org.springframework.test.web.servlet.MockMvc\n10\timport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get\n11\timport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post\n12\timport org.springframework.test.web.servlet.result.MockMvcResultMatchers.content\n13\timport org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath\n14\timport org.springframework.test.web.servlet.result.MockMvcResultMatchers.status\n15\t\n16\t/**\n17\t * The shipment feature as it exists before BE-003.\n18\t *\n19\t * These are \"the existing tests\" for that benchmark: they must keep passing, and an agent\n20\t * that breaks one has regressed the fixture rather than solved the task.\n21\t */\n22\t@SpringBootTest\n23\t@AutoConfigureMockMvc\n24\tclass ShipmentControllerTest {\n25\t\n26\t    @Autowired\n27\t    lateinit var mockMvc: MockMvc\n28\t\n29\t    @Autowired\n30\t    lateinit var repository: InMemoryShipmentRepository\n31\t\n32\t    @BeforeEach\n33\t    fun reset() = repository.clear()\n34\t\n35\t    private fun createShipment(shipmentId: String) =\n36\t        post(\"/shipments\")\n37\t            .contentType(MediaType.APPLICATION_JSON)\n38\t            .content(\n39\t                \"\"\"{\"shipmentId\":\"$shipmentId\",\"orderId\":\"O-1\",\"carrier\":\"DHL\"}\"\"\",\n40\t            )\n41\t\n42\t    @Test\n43\t    fun `creates a shipment in CREATED status`() {\n44\t        mockMvc.perform(createShipment(\"S-1\"))\n45\t            .andExpect(status().isCreated)\n46\t            .andExpect(jsonPath(\"$.shipmentId\").value(\"S-1\"))\n47\t            .andExpect(jsonPath(\"$.status\").value(\"CREATED\"))\n48\t    }\n49\t\n50\t    @Test\n51\t    fun `rejects a duplicate shipment id with the error envelope`() {\n52\t        mockMvc.perform(createShipment(\"S-2\")).andExpect(status().isCreated)\n53\t\n54\t        mockMvc.perform(createShipment(\"S-2\"))\n55\t            .andExpect(status().isConflict)\n56\t            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_ALREADY_EXISTS\"))\n57\t    }\n58\t\n59\t    @Test\n60\t    fun `returns a shipment by id`() {\n61\t        mockMvc.perform(createShipment(\"S-3\")).andExpect(status().isCreated)\n62\t\n63\t        mockMvc.perform(get(\"/shipments/S-3\"))\n64\t            .andExpect(status().isOk)\n65\t            .andExpect(jsonPath(\"$.carrier\").value(\"DHL\"))\n66\t    }\n67\t\n68\t    @Test\n69\t    fun `reports an unknown shipment through the error envelope`() {\n70\t        mockMvc.perform(get(\"/shipments/S-missing\"))\n71\t            .andExpect(status().isNotFound)\n72\t            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n73\t    }\n74\t\n75\t    @Test\n76\t    fun `lists shipments in id order`() {\n77\t        mockMvc.perform(createShipment(\"S-b\")).andExpect(status().isCreated)\n78\t        mockMvc.perform(createShipment(\"S-a\")).andExpect(status().isCreated)\n79\t\n80\t        mockMvc.perform(get(\"/shipments\"))\n81\t            .andExpect(status().isOk)\n82\t            .andExpect(jsonPath(\"$[0].shipmentId\").value(\"S-a\"))\n83\t            .andExpect(jsonPath(\"$[1].shipmentId\").value(\"S-b\"))\n84\t    }\n85\t\n86\t    @Test\n87\t    fun `confirms a CREATED shipment and moves it to CONFIRMED`() {\n88\t        mockMvc.perform(createShipment(\"S-4\")).andExpect(status().isCreated)\n89\t\n90\t        mockMvc.perform(post(\"/shipments/S-4/confirm\"))\n91\t            .andExpect(status().isOk)\n92\t            .andExpect(jsonPath(\"$.shipmentId\").value(\"S-4\"))\n93\t            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n94\t    }\n95\t\n96\t    @Test\n97\t    fun `confirms an already CONFIRMED shipment succeeds and changes nothing`() {\n98\t        mockMvc.perform(createShipment(\"S-5\")).andExpect(status().isCreated)\n99\t        mockMvc.perform(post(\"/shipments/S-5/confirm\"))\n100\t            .andExpect(status().isOk)\n101\t            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n102\t\n103\t        // Confirm again - should succeed and not change\n104\t        mockMvc.perform(post(\"/shipments/S-5/confirm\"))\n105\t            .andExpect(status().isOk)\n106\t            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n107\t    }\n108\t\n109\t    @Test\n110\t    fun `rejects confirming a CANCELLED shipment with 409 Conflict`() {\n111\t        // Create a shipment and set it to CANCELLED directly in the repository\n112\t        val cancelled = Shipment(\n113\t            shipmentId = \"S-6\",\n114\t            orderId = \"O-1\",\n115\t            carrier = \"DHL\",\n116\t            status = ShipmentStatus.CANCELLED,\n117\t        )\n118\t        repository.save(cancelled)\n119\t\n120\t        mockMvc.perform(post(\"/shipments/S-6/confirm\"))\n121\t            .andExpect(status().isConflict)\n122\t            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_ALREADY_CANCELLED\"))\n123\t    }\n124\t\n125\t    @Test\n126\t    fun `rejects confirming a non-existent shipment with 404 Not Found`() {\n127\t        mockMvc.perform(post(\"/shipments/S-nonexistent/confirm\"))\n128\t            .andExpect(status().isNotFound)\n129\t            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n130\t    }\n131\t}\n132\t"}]},"parent_tool_use_id":null,"session_id":"fc41f387-28f4-47bd-8da2-5a4ca42b9142","uuid":"06b99ae2-5e71-4324-90bd-ffc42b2b9346","timestamp":"2026-09-05T09:52:16.471Z","tool_use_result":{"type":"text","file":{"filePath":"/var/folders/jr/lwzz65cx5pndqqdgzhnym1pc0000gn/T/observatory-run-1c905fc9-f7bf-4308-9a34-5a86a7497545/sample-service/src/test/kotlin/com/unityinflow/sample/shipment/ShipmentControllerTest.kt","content":"package com.unityinflow.sample.shipment\n\nimport org.junit.jupiter.api.BeforeEach\nimport org.junit.jupiter.api.Test\nimport org.springframework.beans.factory.annotation.Autowired\nimport org.springframework.boot.test.context.SpringBootTest\nimport org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc\nimport org.springframework.http.MediaType\nimport org.springframework.test.web.servlet.MockMvc\nimport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get\nimport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post\nimport org.springframework.test.web.servlet.result.MockMvcResultMatchers.content\nimport org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath\nimport org.springframework.test.web.servlet.result.MockMvcResultMatchers.status\n\n/**\n * The shipment feature as it exists before BE-003.\n *\n * These are \"the existing tests\" for that benchmark: they must keep passing, and an agent\n * that breaks one has regressed the fixture rather than solved the task.\n */\n@SpringBootTest\n@AutoConfigureMockMvc\nclass ShipmentControllerTest {\n\n    @Autowired\n    lateinit var mockMvc: MockMvc\n\n    @Autowired\n    lateinit var repository: InMemoryShipmentRepository\n\n    @BeforeEach\n    fun reset() = repository.clear()\n\n    private fun createShipment(shipmentId: String) =\n        post(\"/shipments\")\n            .contentType(MediaType.APPLICATION_JSON)\n            .content(\n                \"\"\"{\"shipmentId\":\"$shipmentId\",\"orderId\":\"O-1\",\"carrier\":\"DHL\"}\"\"\",\n            )\n\n    @Test\n    fun `creates a shipment in CREATED status`() {\n        mockMvc.perform(createShipment(\"S-1\"))\n            .andExpect(status().isCreated)\n            .andExpect(jsonPath(\"$.shipmentId\").value(\"S-1\"))\n            .andExpect(jsonPath(\"$.status\").value(\"CREATED\"))\n    }\n\n    @Test\n    fun `rejects a duplicate shipment id with the error envelope`() {\n        mockMvc.perform(createShipment(\"S-2\")).andExpect(status().isCreated)\n\n        mockMvc.perform(createShipment(\"S-2\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_ALREADY_EXISTS\"))\n    }\n\n    @Test\n    fun `returns a shipment by id`() {\n        mockMvc.perform(createShipment(\"S-3\")).andExpect(status().isCreated)\n\n        mockMvc.perform(get(\"/shipments/S-3\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.carrier\").value(\"DHL\"))\n    }\n\n    @Test\n    fun `reports an unknown shipment through the error envelope`() {\n        mockMvc.perform(get(\"/shipments/S-missing\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n    }\n\n    @Test\n    fun `lists shipments in id order`() {\n        mockMvc.perform(createShipment(\"S-b\")).andExpect(status().isCreated)\n        mockMvc.perform(createShipment(\"S-a\")).andExpect(status().isCreated)\n\n        mockMvc.perform(get(\"/shipments\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$[0].shipmentId\").value(\"S-a\"))\n            .andExpect(jsonPath(\"$[1].shipmentId\").value(\"S-b\"))\n    }\n\n    @Test\n    fun `confirms a CREATED shipment and moves it to CONFIRMED`() {\n        mockMvc.perform(createShipment(\"S-4\")).andExpect(status().isCreated)\n\n        mockMvc.perform(post(\"/shipments/S-4/confirm\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.shipmentId\").value(\"S-4\"))\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n    }\n\n    @Test\n    fun `confirms an already CONFIRMED shipment succeeds and changes nothing`() {\n        mockMvc.perform(createShipment(\"S-5\")).andExpect(status().isCreated)\n        mockMvc.perform(post(\"/shipments/S-5/confirm\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n\n        // Confirm again - should succeed and not change\n        mockMvc.perform(post(\"/shipments/S-5/confirm\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n    }\n\n    @Test\n    fun `rejects confirming a CANCELLED shipment with 409 Conflict`() {\n        // Create a shipment and set it to CANCELLED directly in the repository\n        val cancelled = Shipment(\n            shipmentId = \"S-6\",\n            orderId = \"O-1\",\n            carrier = \"DHL\",\n            status = ShipmentStatus.CANCELLED,\n        )\n        repository.save(cancelled)\n\n        mockMvc.perform(post(\"/shipments/S-6/confirm\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_ALREADY_CANCELLED\"))\n    }\n\n    @Test\n    fun `rejects confirming a non-existent shipment with 404 Not Found`() {\n        mockMvc.perform(post(\"/shipments/S-nonexistent/confirm\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n    }\n}\n","numLines":132,"startLine":1,"totalLines":132}}}
