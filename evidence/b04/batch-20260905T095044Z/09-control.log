erform(createShipment(\"S-5\")).andExpect(status().isCreated)\n        mockMvc.perform(\n            post(\"/shipments/S-5/confirm\")\n                .contentType(MediaType.APPLICATION_JSON),\n        ).andExpect(status().isOk)\n\n        mockMvc.perform(\n            post(\"/shipments/S-5/confirm\")\n                .contentType(MediaType.APPLICATION_JSON),\n        )\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n    }\n\n    @Test\n    fun `confirming a cancelled shipment returns 409 conflict`() {\n        mockMvc.perform(createShipment(\"S-6\")).andExpect(status().isCreated)\n        val shipment = repository.findById(\"S-6\")!!\n        repository.save(shipment.copy(status = ShipmentStatus.CANCELLED))\n\n        mockMvc.perform(\n            post(\"/shipments/S-6/confirm\")\n                .contentType(MediaType.APPLICATION_JSON),\n        )\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_CANCELLED\"))\n    }\n\n    @Test\n    fun `confirming a non-existent shipment returns 404 not found`() {\n        mockMvc.perform(\n            post(\"/shipments/S-missing/confirm\")\n                .contentType(MediaType.APPLICATION_JSON),\n        )\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n    }\n}"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":725,"cache_read_input_tokens":32685,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":725},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"6b4c2f03-e5c4-48bc-9da6-cc1b19b7667e","uuid":"d82a8923-251f-473c-bc67-a9bbc949a51e","timestamp":"2026-09-05T10:30:08.662Z","request_id":"req_011Ce