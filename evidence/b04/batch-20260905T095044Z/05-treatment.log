{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LFvKQ5o71Dc21nTaNr5XbZ","type":"tool_result","content":"1\tpackage com.unityinflow.sample.shipment\n2\t\n3\timport org.junit.jupiter.api.BeforeEach\n4\timport org.junit.jupiter.api.Test\n5\timport org.springframework.beans.factory.annotation.Autowired\n6\timport org.springframework.boot.test.context.SpringBootTest\n7\timport org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc\n8\timport org.springframework.http.MediaType\n9\timport org.springframework.test.web.servlet.MockMvc\n10\timport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get\n11\timport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post\n12\timport org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath\n13\timport org.springframework.test.web.servlet.result.MockMvcResultMatchers.status\n14\t\n15\t/**\n16\t * The shipment feature including BE-003: confirm endpoint.\n17\t */\n18\t@SpringBootTest\n19\t@AutoConfigureMockMvc\n20\tclass ShipmentControllerTest {\n21\t\n22\t    @Autowired\n23\t    lateinit var mockMvc: MockMvc\n24\t\n25\t    @Autowired\n26\t    lateinit var repository: InMemoryShipmentRepository\n27\t\n28\t    @BeforeEach\n29\t    fun reset() = repository.clear()\n30\t\n31\t    private fun createShipment(shipmentId: String) =\n32\t        post(\"/shipments\")\n33\t            .contentType(MediaType.APPLICATION_JSON)\n34\t            .content(\n35\t                \"\"\"{\"shipmentId\":\"$shipmentId\",\"orderId\":\"O-1\",\"carrier\":\"DHL\"}\"\"\",\n36\t            )\n37\t\n38\t    @Test\n39\t    fun `creates a shipment in CREATED status`() {\n40\t        mockMvc.perform(createShipment(\"S-1\"))\n41\t            .andExpect(status().isCreated)\n42\t            .andExpect(jsonPath(\"$.shipmentId\").value(\"S-1\"))\n43\t            .andExpect(jsonPath(\"$.status\").value(\"CREATED\"))\n44\t    }\n45\t\n46\t    @Test\n47\t    fun `rejects a duplicate shipment id with the error envelope`() {\n48\t        mockMvc.perform(createShipment(\"S-2\")).andExpect(status().isCreated)\n49\t\n50\t        mockMvc.perform(createShipment(\"S-2\"))\n51\t            .andExpect(status().isConflict)\n52\t            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_ALREADY_EXISTS\"))\n53\t    }\n54\t\n55\t    @Test\n56\t    fun `returns a shipment by id`() {\n57\t        mockMvc.perform(createShipment(\"S-3\")).andExpect(status().isCreated)\n58\t\n59\t        mockMvc.perform(get(\"/shipments/S-3\"))\n60\t            .andExpect(status().isOk)\n61\t            .andExpect(jsonPath(\"$.carrier\").value(\"DHL\"))\n62\t    }\n63\t\n64\t    @Test\n65\t    fun `reports an unknown shipment through the error envelope`() {\n66\t        mockMvc.perform(get(\"/shipments/S-missing\"))\n67\t            .andExpect(status().isNotFound)\n68\t            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n69\t    }\n70\t\n71\t    @Test\n72\t    fun `lists shipments in id order`() {\n73\t        mockMvc.perform(createShipment(\"S-b\")).andExpect(status().isCreated)\n74\t        mockMvc.perform(createShipment(\"S-a\")).andExpect(status().isCreated)\n75\t\n76\t        mockMvc.perform(get(\"/shipments\"))\n77\t            .andExpect(status().isOk)\n78\t            .andExpect(jsonPath(\"$[0].shipmentId\").value(\"S-a\"))\n79\t            .andExpect(jsonPath(\"$[1].shipmentId\").value(\"S-b\"))\n80\t    }\n81\t\n82\t    @Test\n83\t    fun `confirms a CREATED shipment and moves it to CONFIRMED`() {\n84\t        mockMvc.perform(createShipment(\"S-4\")).andExpect(status().isCreated)\n85\t\n86\t        mockMvc.perform(post(\"/shipments/S-4/confirm\"))\n87\t            .andExpect(status().isOk)\n88\t            .andExpect(jsonPath(\"$.shipmentId\").value(\"S-4\"))\n89\t            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n90\t    }\n91\t\n92\t    @Test\n93\t    fun `confirming an already CONFIRMED shipment succeeds and changes nothing`() {\n94\t        mockMvc.perform(createShipment(\"S-5\")).andExpect(status().isCreated)\n95\t        mockMvc.perform(post(\"/shipments/S-5/confirm\")).andExpect(status().isOk)\n96\t\n97\t        // First retry should also succeed\n98\t        mockMvc.perform(post(\"/shipments/S-5/confirm\"))\n99\t            .andExpect(status().isOk)\n100\t            .andExpect(jsonPath(\"$.shipmentId\").value(\"S-5\"))\n101\t            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n102\t\n103\t        // Second retry should also succeed (idempotent)\n104\t        mockMvc.perform(post(\"/shipments/S-5/confirm\"))\n105\t            .andExpect(status().isOk)\n106\t            .andExpect(jsonPath(\"$.shipmentId\").value(\"S-5\"))\n107\t            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n108\t    }\n109\t\n110\t    @Test\n111\t    fun `rejecting confirm of a CANCELLED shipment with HTTP 409`() {\n112\t        // Create a shipment and set it to CANCELLED directly in the repository\n113\t        repository.save(\n114\t            Shipment(\n115\t                shipmentId = \"S-cancelled\",\n116\t                orderId = \"O-1\",\n117\t                carrier = \"DHL\",\n118\t                status = ShipmentStatus.CANCELLED,\n119\t            ),\n120\t        )\n121\t\n122\t        mockMvc.perform(post(\"/shipments/S-cancelled/confirm\"))\n123\t            .andExpect(status().isConflict)\n124\t            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_CANNOT_CONFIRM\"))\n125\t    }\n126\t\n127\t    @Test\n128\t    fun `rejecting confirm of a non-existent shipment with HTTP 404`() {\n129\t        mockMvc.perform(post(\"/shipments/S-missing/confirm\"))\n130\t            .andExpect(status().isNotFound)\n131\t            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n132\t    }\n133\t}\n134\t"}]},"parent_tool_use_id":null,"session_id":"8063c825-6e6a-49a1-af1f-b5e9a35a4cbe","uuid":"3af6f734-2c36-4d0c-8958-4309d43ec40c","timestamp":"2026-09-05T10:10:20.190Z","tool_use_result":{"type":"text","file":{"filePath":"/var/folders/jr/lwzz65cx5pndqqdgzhnym1pc0000gn/T/observatory-run-079f72e9-60e0-4a06-9f72-ce4db89de82d/sample-service/src/test/kotlin/com/unityinflow/sample/shipment/ShipmentControllerTest.kt","content":"package com.unityinflow.sample.shipment\n\nimport org.junit.jupiter.api.BeforeEach\nimport org.junit.jupiter.api.Test\nimport org.springframework.beans.factory.annotation.Autowired\nimport org.springframework.boot.test.context.SpringBootTest\nimport org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc\nimport org.springframework.http.MediaType\nimport org.springframework.test.web.servlet.MockMvc\nimport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get\nimport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post\nimport org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath\nimport org.springframework.test.web.servlet.result.MockMvcResultMatchers.status\n\n/**\n * The shipment feature including BE-003: confirm endpoint.\n */\n@SpringBootTest\n@AutoConfigureMockMvc\nclass ShipmentControllerTest {\n\n    @Autowired\n    lateinit var mockMvc: MockMvc\n\n    @Autowired\n    lateinit var repository: InMemoryShipmentRepository\n\n    @BeforeEach\n    fun reset() = repository.clear()\n\n    private fun createShipment(shipmentId: String) =\n        post(\"/shipments\")\n            .contentType(MediaType.APPLICATION_JSON)\n            .content(\n                \"\"\"{\"shipmentId\":\"$shipmentId\",\"orderId\":\"O-1\",\"carrier\":\"DHL\"}\"\"\",\n            )\n\n    @Test\n    fun `creates a shipment in CREATED status`() {\n        mockMvc.perform(createShipment(\"S-1\"))\n            .andExpect(status().isCreated)\n            .andExpect(jsonPath(\"$.shipmentId\").value(\"S-1\"))\n            .andExpect(jsonPath(\"$.status\").value(\"CREATED\"))\n    }\n\n    @Test\n    fun `rejects a duplicate shipment id with the error envelope`() {\n        mockMvc.perform(createShipment(\"S-2\")).andExpect(status().isCreated)\n\n        mockMvc.perform(createShipment(\"S-2\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_ALREADY_EXISTS\"))\n    }\n\n    @Test\n    fun `returns a shipment by id`() {\n        mockMvc.perform(createShipment(\"S-3\")).andExpect(status().isCreated)\n\n        mockMvc.perform(get(\"/shipments/S-3\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.carrier\").value(\"DHL\"))\n    }\n\n    @Test\n    fun `reports an unknown shipment through the error envelope`() {\n        mockMvc.perform(get(\"/shipments/S-missing\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n    }\n\n    @Test\n    fun `lists shipments in id order`() {\n        mockMvc.perform(createShipment(\"S-b\")).andExpect(status().isCreated)\n        mockMvc.perform(createShipment(\"S-a\")).andExpect(status().isCreated)\n\n        mockMvc.perform(get(\"/shipments\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$[0].shipmentId\").value(\"S-a\"))\n            .andExpect(jsonPath(\"$[1].shipmentId\").value(\"S-b\"))\n    }\n\n    @Test\n    fun `confirms a CREATED shipment and moves it to CONFIRMED`() {\n        mockMvc.perform(createShipment(\"S-4\")).andExpect(status().isCreated)\n\n        mockMvc.perform(post(\"/shipments/S-4/confirm\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.shipmentId\").value(\"S-4\"))\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n    }\n\n    @Test\n    fun `confirming an already CONFIRMED shipment succeeds and changes nothing`() {\n        mockMvc.perform(createShipment(\"S-5\")).andExpect(status().isCreated)\n        mockMvc.perform(post(\"/shipments/S-5/confirm\")).andExpect(status().isOk)\n\n        // First retry should also succeed\n        mockMvc.perform(post(\"/shipments/S-5/confirm\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.shipmentId\").value(\"S-5\"))\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n\n        // Second retry should also succeed (idempotent)\n        mockMvc.perform(post(\"/shipments/S-5/confirm\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.shipmentId\").value(\"S-5\"))\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n    }\n\n    @Test\n    fun `rejecting confirm of a CANCELLED shipment with HTTP 409`() {\n        // Create a shipment and set it to CANCELLED directly in the repository\n        repository.save(\n            Shipment(\n                shipmentId = \"S-cancelled\",\n                orderId = \"O-1\",\n                carrier = \"DHL\",\n                status = ShipmentStatus.CANCELLED,\n            ),\n        )\n\n        mockMvc.perform(post(\"/shipments/S-cancelled/confirm\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_CANNOT_CONFIRM\"))\n    }\n\n    @Test\n    fun `rejecting confirm of a non-existent shipment with HTTP 404`() {\n        mockMvc.perform(post(\"/shipments/S-missing/confirm\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n    }\n}\n","numLines":134,"startLine":1,"totalLines":134}}}
