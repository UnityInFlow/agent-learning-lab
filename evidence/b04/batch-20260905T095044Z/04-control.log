orm(post(\"/shipments/S-5/confirm\")).andExpect(status().isOk)\n\n        mockMvc.perform(post(\"/shipments/S-5/confirm\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.shipmentId\").value(\"S-5\"))\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n    }\n\n    @Test\n    fun `rejects confirming a non-existent shipment with 404`() {\n        mockMvc.perform(post(\"/shipments/S-missing/confirm\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n    }\n\n    @Test\n    fun `rejects confirming a cancelled shipment with 409`() {\n        val cancelledShipment = Shipment(\n            shipmentId = \"S-6\",\n            orderId = \"O-1\",\n            carrier = \"DHL\",\n            status = ShipmentStatus.CANCELLED,\n        )\n        repository.save(cancelledShipment)\n\n        mockMvc.perform(post(\"/shipments/S-6/confirm\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_INVALID_STATE\"))\n    }\n}"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":620,"cache_read_input_tokens":32173,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":620},"output_tokens":4,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"76f1a0e9-0d10-48eb-9038-84461294f020","uuid":"07d10869-6c32-4934-818d-fc28baf1b98c","timestamp":"2026-09-05T10:07:43.469Z","request_id":"req_011Cek7BaRDDr2cTzxpUv4gW"}
