{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DgZdA9uU5UYmPhnMZ9CNzS","type":"tool_result","content":"1\tpackage com.unityinflow.sample.shipment\n2\t\n3\timport org.junit.jupiter.api.BeforeEach\n4\timport com.unityinflow.sample.shipment.ShipmentStatus.CANCELLED\n5\timport com.unityinflow.sample.shipment.ShipmentStatus.CONFIRMED\n6\timport com.unityinflow.sample.shipment.ShipmentStatus.CREATED\n7\timport org.junit.jupiter.api.Test\n8\timport org.springframework.beans.factory.annotation.Autowired\n9\timport org.springframework.boot.test.context.SpringBootTest\n10\timport org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc\n11\timport org.springframework.http.MediaType\n12\timport org.springframework.test.web.servlet.MockMvc\n13\timport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get\n14\timport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post\n15\timport org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath\n16\timport org.springframework.test.web.servlet.result.MockMvcResultMatchers.status\n17\t\n18\t/**\n19\t * The shipment feature as it exists before BE-003.\n20\t *\n21\t * These are \"the existing tests\" for that benchmark: they must keep passing, and an agent\n22\t * that breaks one has regressed the fixture rather than solved the task.\n23\t */\n24\t@SpringBootTest\n25\t@AutoConfigureMockMvc\n26\tclass ShipmentControllerTest {\n27\t\n28\t    @Autowired\n29\t    lateinit var mockMvc: MockMvc\n30\t\n31\t    @Autowired\n32\t    lateinit var repository: InMemoryShipmentRepository\n33\t\n34\t    @BeforeEach\n35\t    fun reset() = repository.clear()\n36\t\n37\t    private fun createShipment(shipmentId: String) =\n38\t        post(\"/shipments\")\n39\t            .contentType(MediaType.APPLICATION_JSON)\n40\t            .content(\n41\t                \"\"\"{\"shipmentId\":\"$shipmentId\",\"orderId\":\"O-1\",\"carrier\":\"DHL\"}\"\"\",\n42\t            )\n43\t\n44\t    @Test\n45\t    fun `creates a shipment in CREATED status`() {\n46\t        mockMvc.perform(createShipment(\"S-1\"))\n47\t            .andExpect(status().isCreated)\n48\t            .andExpect(jsonPath(\"$.shipmentId\").value(\"S-1\"))\n49\t            .andExpect(jsonPath(\"$.status\").value(\"CREATED\"))\n50\t    }\n51\t\n52\t    @Test\n53\t    fun `rejects a duplicate shipment id with the error envelope`() {\n54\t        mockMvc.perform(createShipment(\"S-2\")).andExpect(status().isCreated)\n55\t\n56\t        mockMvc.perform(createShipment(\"S-2\"))\n57\t            .andExpect(status().isConflict)\n58\t            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_ALREADY_EXISTS\"))\n59\t    }\n60\t\n61\t    @Test\n62\t    fun `returns a shipment by id`() {\n63\t        mockMvc.perform(createShipment(\"S-3\")).andExpect(status().isCreated)\n64\t\n65\t        mockMvc.perform(get(\"/shipments/S-3\"))\n66\t            .andExpect(status().isOk)\n67\t            .andExpect(jsonPath(\"$.carrier\").value(\"DHL\"))\n68\t    }\n69\t\n70\t    @Test\n71\t    fun `reports an unknown shipment through the error envelope`() {\n72\t        mockMvc.perform(get(\"/shipments/S-missing\"))\n73\t            .andExpect(status().isNotFound)\n74\t            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n75\t    }\n76\t\n77\t    @Test\n78\t    fun `lists shipments in id order`() {\n79\t        mockMvc.perform(createShipment(\"S-b\")).andExpect(status().isCreated)\n80\t        mockMvc.perform(createShipment(\"S-a\")).andExpect(status().isCreated)\n81\t\n82\t        mockMvc.perform(get(\"/shipments\"))\n83\t            .andExpect(status().isOk)\n84\t            .andExpect(jsonPath(\"$[0].shipmentId\").value(\"S-a\"))\n85\t            .andExpect(jsonPath(\"$[1].shipmentId\").value(\"S-b\"))\n86\t    }\n87\t\n88\t    @Test\n89\t    fun `confirms a created shipment and moves it to CONFIRMED`() {\n90\t        mockMvc.perform(createShipment(\"S-4\")).andExpect(status().isCreated)\n91\t\n92\t        mockMvc.perform(post(\"/shipments/S-4/confirm\"))\n93\t            .andExpect(status().isOk)\n94\t            .andExpect(jsonPath(\"$.shipmentId\").value(\"S-4\"))\n95\t            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n96\t\n97\t        // Verify it persisted\n98\t        mockMvc.perform(get(\"/shipments/S-4\"))\n99\t            .andExpect(status().isOk)\n100\t            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n101\t    }\n102\t\n103\t    @Test\n104\t    fun `confirming an already confirmed shipment succeeds without change`() {\n105\t        mockMvc.perform(createShipment(\"S-5\")).andExpect(status().isCreated)\n106\t        mockMvc.perform(post(\"/shipments/S-5/confirm\")).andExpect(status().isOk)\n107\t\n108\t        // Confirm again - should succeed and not change anything\n109\t        mockMvc.perform(post(\"/shipments/S-5/confirm\"))\n110\t            .andExpect(status().isOk)\n111\t            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n112\t\n113\t        // Verify status is still CONFIRMED\n114\t        mockMvc.perform(get(\"/shipments/S-5\"))\n115\t            .andExpect(status().isOk)\n116\t            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n117\t    }\n118\t\n119\t    @Test\n120\t    fun `confirming a cancelled shipment returns 409 conflict`() {\n121\t        mockMvc.perform(createShipment(\"S-6\")).andExpect(status().isCreated)\n122\t\n123\t        // Manually set to CANCELLED status in repository\n124\t        val cancelledShipment = Shipment(\"S-6\", \"O-1\", \"DHL\", CANCELLED)\n125\t        repository.save(cancelledShipment)\n126\t\n127\t        mockMvc.perform(post(\"/shipments/S-6/confirm\"))\n128\t            .andExpect(status().isConflict)\n129\t            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_INVALID_STATUS\"))\n130\t    }\n131\t\n132\t    @Test\n133\t    fun `confirming a non-existent shipment returns 404 not found