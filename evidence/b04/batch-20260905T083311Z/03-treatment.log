ng a cancelled shipment returns 409 conflict`() {\n118\t        // Create a shipment and manually set it to CANCELLED in the repository\n119\t        val shipment = Shipment(\n120\t            shipmentId = \"S-6\",\n121\t            orderId = \"O-1\",\n122\t            carrier = \"DHL\",\n123\t            status = ShipmentStatus.CANCELLED,\n124\t        )\n125\t        repository.save(shipment)\n126\t\n127\t        mockMvc.perform(\n128\t            post(\"/shipments/S-6/confirm\")\n129\t                .contentType(MediaType.APPLICATION_JSON),\n130\t        )\n131\t            .andExpect(status().isConflict)\n132\t            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_INVALID_STATE_TRANSITION\"))\n133\t    }\n134\t\n135\t    @Test\n136\t    fun `confirming a non-existent shipment returns 404 not found`() {\n137\t        mockMvc.perform(\n138\t            post(\"/shipments/S-missing/confirm\")\n139\t                .contentType(MediaType.APPLICATION_JSON),\n140\t        )\n141\t            .andExpect(status().isNotFound)\n142\t            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n143\t    }\n144\t}\n145\t"}]},"parent_tool_use_id":null,"session_id":"57fbb6fa-bd6c-4b31-8736-7d558496a47a","uuid":"ac32c38e-78b1-445d-be05-6d6f53c1151e","timestamp":"2026-09-05T08:58:59.977Z","tool_use_result":{"type":"text","file":{"filePath":"/var/folders/jr/lwzz65cx5pndqqdgzhnym1pc0000gn/T/observatory-run-32ad6715-0bf5-47c8-901d-cb360c1742a7/sample-service/src/test/kotlin/com/unityinflow/sample/shipment/ShipmentControllerTest.kt","content":"    fun `lists shipments in id order`() {\n        mockMvc.perform(createShipment(\"S-b\")).andExpect(status().isCreated)\n        mockMvc.perform(createShipment(\"S-a\")).andExpect(status().isCreated)\n\n        mockMvc.perform(get(\"/shipments\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$[0].shipmentId\").value(\"S-a\"))\n            .andExpect(jsonPath(\"$[1].shipmentId\").value(\"S-b\"))\n    }\n\n    @Test\n    fun `confirms a created shipment and changes status to CONFIRMED`() {\n        mockMvc.perform(createShipment(\"S-4\")).andExpect(status().isCreated)\n\n        mockMvc.perform(\n            post(\"/shipments/S-4/confirm\")\n                .contentType(MediaType.APPLICATION_JSON),\n        )\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.shipmentId\").value(\"S-4\"))\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n    }\n\n    @Test\n    fun `confirming an already confirmed shipment succeeds and changes nothing`() {\n        mockMvc.perform(createShipment(\"S-5\")).andExpect(status().isCreated)\n        mockMvc.perform(\n            post(\"/shipments/S-5/confirm\")\n                .contentType(MediaType.APPLICATION_JSON),\n        ).andExpect(status().isOk)\n\n        // Second confirm should also succeed\n        mockMvc.perform(\n            post(\"/shipments/S-5/confirm\")\n                .contentType(MediaType.APPLICATION_JSON),\n        )\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.shipmentId\").value(\"S-5\"))\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n    }\n\n    @Test\n    fun `confirming a cancelled shipment returns 409 conflict`() {\n        // Create a shipment and manually set it to CANCELLED in the repository\n        val shipment = Shipment(\n            shipmentId = \"S-6\",\n            orderId = \"O-1\",\n            carrier = \"DHL\",\n            status = ShipmentStatus.CANCELLED,\n        )\n        repository.save(shipment)\n\n        mockMvc.perform(\n            post(\"/shipments/S-6/confirm\")\n                .contentType(MediaType.APPLICATION_JSON),\n        )\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_INVALID_STATE_TRANSITION\"))\n    }\n\n    @Test\n    fun `confirming a non-existent shipment returns 404 not found`() {\n        mockMvc.perform(\n            post(\"/shipments/S-missing/confirm\")\n                .contentType(MediaType.APPLICATION_JSON),\n        )\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n    }\n}\n","numLines":71,"startLine":75,"totalLines":145}}}
