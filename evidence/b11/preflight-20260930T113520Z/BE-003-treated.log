vc.perform(post(\"/shipments/S-5/confirm\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n\n        // Second confirm should also succeed\n        mockMvc.perform(post(\"/shipments/S-5/confirm\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n    }\n\n    @Test\n    fun `rejects confirming a CANCELLED shipment with conflict`() {\n        // Create a shipment and manually set it to CANCELLED\n        val shipment = Shipment(\n            shipmentId = \"S-6\",\n            orderId = \"O-1\",\n            carrier = \"DHL\",\n            status = ShipmentStatus.CANCELLED,\n        )\n        repository.save(shipment)\n\n        mockMvc.perform(post(\"/shipments/S-6/confirm\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_CANNOT_CONFIRM\"))\n    }\n\n    @Test\n    fun `rejects confirming a non-existent shipment with 404`() {\n        mockMvc.perform(post(\"/shipments/S-missing/confirm\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n    }\n}"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":631,"cache_read_input_tokens":20034,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":631},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"b5f4cc45-03f1-4812-afc5-8194131e3c45","uuid":"c154f9c7-2c6e-4b71-9d2f-be80f968cedd","timestamp":"2026-09-30T11:37:27.844Z","request_id":"req_011CfZZFQRH1igkVJjVjP6dZ","wire_tool_inputs":{"toolu_01VhwFgN52rnxG4mrgfAoLh8":{"file_path":"/private/var/folders/jr/lwzz65cx5pndqqdgzhnym1pc0000gn/T/observat