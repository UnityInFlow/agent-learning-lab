hipmentRepository.findById(\"S-confirmed\")?.status == ShipmentStatus.CONFIRMED)\n        // Verify already-cancelled shipment stays cancelled\n        assert(shipmentRepository.findById(\"S-cancelled\")?.status == ShipmentStatus.CANCELLED)\n    }","newString":"    @Test\n    fun `cancelling an order cancels all CREATED shipments but not CANCELLED ones`() {\n        mockMvc.perform(createOrder(\"O-8\")).andExpect(status().isCreated)\n\n        // Create multiple shipments with different statuses\n        shipmentRepository.save(Shipment(\"S-created-1\", \"O-8\", \"DHL\", ShipmentStatus.CREATED))\n        shipmentRepository.save(Shipment(\"S-created-2\", \"O-8\", \"UPS\", ShipmentStatus.CREATED))\n        shipmentRepository.save(Shipment(\"S-cancelled\", \"O-8\", \"TNT\", ShipmentStatus.CANCELLED))\n\n        // Cancel the order\n        mockMvc.perform(cancelOrder(\"O-8\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n\n        // Verify created shipments are now cancelled\n        assert(shipmentRepository.findById(\"S-created-1\")?.status == ShipmentStatus.CANCELLED)\n        assert(shipmentRepository.findById(\"S-created-2\")?.status == ShipmentStatus.CANCELLED)\n        // Verify already-cancelled shipment stays cancelled\n        assert(shipmentRepository.findById(\"S-cancelled\")?.status == ShipmentStatus.CANCELLED)\n    }","originalFile":"package com.unityinflow.sample.order\n\nimport com.unityinflow.sample.shipment.InMemoryShipmentRepository\nimport com.unityinflow.sample.shipment.Shipment\nimport com.unityinflow.sample.shipment.ShipmentStatus\nimport org.junit.jupiter.api.BeforeEach\nimport org.junit.jupiter.api.Test\nimport org.springframework.beans.factory.annotation.Autowired\nimport org.springframework.boot.test.context.SpringBootTest\nimport org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc\nimport org.springframework.http.MediaType\nimport org.springframework.test.web.servlet.MockMvc\nimport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get\nimport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post\nimport org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath\nimport org.springframework.test.web.servlet.result.MockMvcResultMatchers.status\n\n/**\n * Baseline behaviour of the order feature. BE-002 must not break any of these.\n *\n * Note how the failure cases assert the response *body*, not just the status: the error\n * envelope is part of the API contract, so a change that returns the right status with\n * the wrong shape is a breaking change for clients.\n */\n@SpringBootTest\n@AutoConfigureMockMvc\nclass OrderControllerTest {\n\n    @Autowired\n    lateinit var mockMvc: MockMvc\n\n    @Autowired\n    lateinit var repository: InMemoryOrderRepository\n\n    @Autowired\n    lateinit var shipmentRepository: InMemoryShipmentRepository\n\n    @BeforeEach\n    fun reset() {\n        repository.clear()\n        shipmentRepository.clear()\n    }\n\n    private fun createOrder(orderId: String, amount: String = \"49.90\") =\n        post(\"/orders\")\n            .contentType(MediaType.APPLICATION_JSON)\n            .content(\n                \"\"\"{\"orderId\":\"$orderId\",\"customerId\":\"C-1\",\"amount\":$amount,\"currency\":\"EUR\"}\"\"\",\n            )\n\n    private fun cancelOrder(orderId: String) =\n        post(\"/orders/$orderId/cancel\")\n            .contentType(MediaType.APPLICATION_JSON)\n\n    @Test\n    fun `creates an order and returns 201`() {\n        mockMvc.perform(createOrder(\"O-1\"))\n            .andExpect(status().isCreated)\n            .andExpect(jsonPath(\"$.orderId\").value(\"O-1\"))\n    }\n\n    @Test\n    fun `reads back a created order`() {\n        mockMvc.perform(createOrder(\"O-2\")).andExpect(status().isCreated)\n\n        mockMvc.perform(get(\"/orders/O-2\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.currency\").value(\"EUR\"))\n    }\n\n    @Test\n    fun `returns 404 with the error envelope for an unknown order`() {\n        mockMvc.perform(get(\"/orders/does-not-exist\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_NOT_FOUND\"))\n            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n    }\n\n    @Test\n    fun `returns 409 with the error envelope for a duplicate order id`() {\n        mockMvc.perform(createOrder(\"O-3\")).andExpect(status().isCreated)\n\n        mockMvc.perform(createOrder(\"O-3\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_ALREADY_EXISTS\"))\n            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n    }\n\n    @Test\n    fun `newly created order has ACTIVE status`() {\n        mockMvc.perform(createOrder(\"O-4\"))\n            .andExpect(status().isCreated)\n            .andExpect(jsonPath(\"$.status\").value(\"ACTIVE\"))\n    }\n\n    @Test\n    fun `cancels an active order and returns CANCELLED status`() {\n        mockMvc.perform(createOrder(\"O-5\")).andExpect(status().isCreated)\n\n        mockMvc.perform(cancelOrder(\"O-5\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n            .andExpect(jsonPath(\"$.orderId\").value(\"O-5\"))\n    }\n\n    @Test\n    fun `cancelling an already cancelled order is idempotent`() {\n        mockMvc.perform(createOrder(\"O-6\")).andExpect(status().isCreated)\n        mockMvc.perform(cancelOrder(\"O-6\")).andExpect(status().isOk)\n\n        mockMvc.perform(cancelOrder(\"O-6\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n    }\n\n    @Test\n    fun `cancelling a non-existent order returns 404`() {\n        mockMvc.perform(cancelOrder(\"O-does-not-exist\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_NOT_FOUND\"))\n            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n    }\n\n    @Test\n    fun `cancelling an order with a CONFIRMED shipment fails with 409 and changes nothing`() {\n        mockMvc.perform(createOrder(\"O-7\")).andExpect(status().isCreated)\n\n        // Create a confirmed shipment\n        val confirmedShipment = Shipment(\n            shipmentId = \"S-confirmed\",\n            orderId = \"O-7\",\n            carrier = \"DHL\",\n            status = ShipmentStatus.CONFIRMED,\n        )\n        shipmentRepository.save(confirmedShipment)\n\n        // Attempt cancel\n        mockMvc.perform(cancelOrder(\"O-7\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_CANNOT_BE_CANCELLED\"))\n            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n\n        // Verify order is still ACTIVE\n        mockMvc.perform(get(\"/orders/O-7\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"ACTIVE\"))\n\n        // Verify shipment is still CONFIRMED\n        val shipment = shipmentRepository.findById(\"S-confirmed\")\n        assert(shipment?.status == ShipmentStatus.CONFIRMED)\n    }\n\n    @Test\n    fun `cancelling an order cancels all CREATED shipments but not CONFIRMED ones`() {\n        mockMvc.perform(createOrder(\"O-8\")).andExpect(status().isCreated)\n\n        // Create multiple shipments with different statuses\n        shipmentRepository.save(Shipment(\"S-created-1\", \"O-8\", \"DHL\", ShipmentStatus.CREATED))\n        shipmentRepository.save(Shipment(\"S-created-2\", \"O-8\", \"UPS\", ShipmentStatus.CREATED))\n        shipmentRepository.save(Shipment(\"S-confirmed\", \"O-8\", \"FedEx\", ShipmentStatus.CONFIRMED))\n        shipmentRepository.save(Shipment(\"S-cancelled\", \"O-8\", \"TNT\", ShipmentStatus.CANCELLED))\n\n        // Cancel the order\n        mockMvc.perform(cancelOrder(\"O-8\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n\n        // Verify created shipments are now cancelled\n        assert(shipmentRepository.findById(\"S-created-1\")?.status == ShipmentStatus.CANCELLED)\n        assert(shipmentRepository.findById(\"S-created-2\")?.status == ShipmentStatus.CANCELLED)\n        // Verified confirmed shipment stays confirmed\n        assert(shipmentRepository.findById(\"S-confirmed\")?.status == ShipmentStatus.CONFIRMED)\n        // Verify already-cancelled shipment stays cancelled\n        assert(shipmentRepository.findById(\"S-cancelled\")?.status == ShipmentStatus.CANCELLED)\n    }\n}\n","structuredPatch":[{"oldStart":151,"oldLines":13,"newStart":151,"newLines":12,"lines":["     }"," ","     @Test","-    fun `cancelling an order cancels all CREATED shipments but not CONFIRMED ones`() {","+    fun `cancelling an order cancels all CREATED shipments but not CANCELLED ones`() {","         mockMvc.perform(createOrder(\"O-8\")).andExpect(status().isCreated)"," ","         // Create multiple shipments with different statuses","         shipmentRepository.save(Shipment(\"S-created-1\", \"O-8\", \"DHL\", ShipmentStatus.CREATED))","         shipmentRepository.save(Shipment(\"S-created-2\", \"O-8\", \"UPS\", ShipmentStatus.CREATED))","-        shipmentRepository.save(Shipment(\"S-confirmed\", \"O-8\", \"FedEx\", ShipmentStatus.CONFIRMED))","         shipmentRepository.save(Shipment(\"S-cancelled\", \"O-8\", \"TNT\", ShipmentStatus.CANCELLED))"," ","         // Cancel the order"]},{"oldStart":168,"oldLines":8,"newStart":167,"newLines":6,"lines":["         // Verify created shipments are now cancelled","         assert(shipmentRepository.findById(\"S-created-1\")?.status == ShipmentStatus.CANCELLED)","         assert(shipmentRepository.findById(\"S-created-2\")?.status == ShipmentStatus.CANCELLED)","-        // Verified confirmed shipment stays confirmed","-        assert(shipmentRepository.findById(\"S-confirmed\")?.status == ShipmentStatus.CONFIRMED)","         // Verify already-cancelled shipment stays cancelled","         assert(shipmentRepository.findById(\"S-cancelled\")?.status == ShipmentStatus.CANCELLED)","     }"]}],"userModified":false,"replaceAll":false}}
