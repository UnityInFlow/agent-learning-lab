ndExpect(status().isCreated)\n            .andExpect(jsonPath(\"$.status\").value(\"ACTIVE\"))\n    }\n\n    @Test\n    fun `cancels an active order and returns CANCELLED status`() {\n        mockMvc.perform(createOrder(\"O-5\")).andExpect(status().isCreated)\n\n        mockMvc.perform(cancelOrder(\"O-5\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n            .andExpect(jsonPath(\"$.orderId\").value(\"O-5\"))\n    }\n\n    @Test\n    fun `cancelling an already cancelled order is idempotent`() {\n        mockMvc.perform(createOrder(\"O-6\")).andExpect(status().isCreated)\n        mockMvc.perform(cancelOrder(\"O-6\")).andExpect(status().isOk)\n\n        mockMvc.perform(cancelOrder(\"O-6\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n    }\n\n    @Test\n    fun `cancelling a non-existent order returns 404`() {\n        mockMvc.perform(cancelOrder(\"O-does-not-exist\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_NOT_FOUND\"))\n            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n    }\n\n    @Test\n    fun `cancelling an order with a CONFIRMED shipment fails with 409 and changes nothing`() {\n        mockMvc.perform(createOrder(\"O-7\")).andExpect(status().isCreated)\n\n        // Create a confirmed shipment\n        val confirmedShipment = Shipment(\n            shipmentId = \"S-confirmed\",\n            orderId = \"O-7\",\n            carrier = \"DHL\",\n            status = ShipmentStatus.CONFIRMED,\n        )\n        shipmentRepository.save(confirmedShipment)\n\n        // Attempt cancel\n        mockMvc.perform(cancelOrder(\"O-7\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_CANNOT_BE_CANCELLED\"))\n            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n\n        // Verify order is still ACTIVE\n        mockMvc.perform(get(\"/orders/O-7\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"ACTIVE\"))\n\n        // Verify shipment is still CONFIRMED\n        val shipment = shipmentRepository.findById(\"S-confirmed\")\n        assert(shipment?.status == ShipmentStatus.CONFIRMED)\n    }\n\n    @Test\n    fun `cancelling an order cancels all CREATED shipments but not CONFIRMED ones`() {\n        mockMvc.perform(createOrder(\"O-8\")).andExpect(status().isCreated)\n\n        // Create multiple shipments with different statuses\n        shipmentRepository.save(Shipment(\"S-created-1\", \"O-8\", \"DHL\", ShipmentStatus.CREATED))\n        shipmentRepository.save(Shipment(\"S-created-2\", \"O-8\", \"UPS\", ShipmentStatus.CREATED))\n        shipmentRepository.save(Shipment(\"S-confirmed\", \"O-8\", \"FedEx\", ShipmentStatus.CONFIRMED))\n        shipmentRepository.save(Shipment(\"S-cancelled\", \"O-8\", \"TNT\", ShipmentStatus.CANCELLED))\n\n        // Cancel the order\n        mockMvc.perform(cancelOrder(\"O-8\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n\n        // Verify created shipments are now cancelled\n        assert(shipmentRepository.findById(\"S-created-1\")?.status == ShipmentStatus.CANCELLED)\n        assert(shipmentRepository.findById(\"S-created-2\")?.status == ShipmentStatus.CANCELLED)\n        // Verified confirmed shipment stays confirmed\n        assert(shipmentRepository.findById(\"S-confirmed\")?.status == ShipmentStatus.CONFIRMED)\n        // Verify already-cancelled shipment stays cancelled\n        assert(shipmentRepository.findById(\"S-cancelled\")?.status == ShipmentStatus.CANCELLED)\n    }\n}"}}}
