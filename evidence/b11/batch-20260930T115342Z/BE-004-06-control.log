{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01B2tzYWYwhKajB1XodfVyz1","type":"tool_result","content":"1\tpackage com.unityinflow.sample.api\n2\t\n3\t/**\n4\t * The error contract of this service.\n5\t *\n6\t * Every error response carries the same envelope, so clients can branch on a stable\n7\t * `code` instead of parsing prose:\n8\t *\n9\t * ```json\n10\t * { \"error\": { \"code\": \"ORDER_NOT_FOUND\", \"message\": \"No order with id 'O-9'\", \"fields\": [] } }\n11\t * ```\n12\t *\n13\t * Responses are produced centrally by [GlobalExceptionHandler]; controllers throw an\n14\t * [ApiException] rather than assembling bodies themselves.\n15\t */\n16\tdata class ApiError(val error: ApiErrorBody)\n17\t\n18\tdata class ApiErrorBody(\n19\t    val code: ErrorCode,\n20\t    val message: String,\n21\t    val fields: List<FieldViolation> = emptyList(),\n22\t)\n23\t\n24\t/** Which input was rejected and why — populated for validation failures. */\n25\tdata class FieldViolation(val field: String, val message: String)\n26\t\n27\t/**\n28\t * The closed set of machine-readable error codes. Clients switch on these, so a code is\n29\t * part of the public API: add one deliberately, never rename one casually.\n30\t */\n31\tenum class ErrorCode {\n32\t    ORDER_NOT_FOUND,\n33\t    ORDER_ALREADY_EXISTS,\n34\t    SHIPMENT_NOT_FOUND,\n35\t    SHIPMENT_ALREADY_EXISTS,\n36\t    VALIDATION_FAILED,\n37\t}\n38\t"}]},"parent_tool_use_id":null,"session_id":"94d75db5-65e7-4fc0-91ff-a6f68444aa3c","uuid":"2edd4ff0-cb0b-4e86-9705-51bafb49c8ad","timestamp":"2026-09-30T16:00:44.693Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/jr/lwzz65cx5pndqqdgzhnym1pc0000gn/T/observatory-run-886fcc90-4a75-4095-a48e-b0920006b8f5/sample-service/src/main/kotlin/com/unityinflow/sample/api/ApiError.kt","content":"package com.unityinflow.sample.api\n\n/**\n * The error contract of this service.\n *\n * Every error response carries the same envelope, so clients can branch on a stable\n * `code` instead of parsing prose:\n *\n * ```json\n * { \"error\": { \"code\": \"ORDER_NOT_FOUND\", \"message\": \"No order with id 'O-9'\", \"fields\": [] } }\n * ```\n *\n * Responses are produced centrally by [GlobalExceptionHandler]; controllers throw an\n * [ApiException] rather than assembling bodies themselves.\n */\ndata class ApiError(val error: ApiErrorBody)\n\ndata class ApiErrorBody(\n    val code: ErrorCode,\n    val message: String,\n    val fields: List<FieldViolation> = emptyList(),\n)\n\n/** Which input was rejected and why — populated for validation failures. */\ndata class FieldViolation(val field: String, val message: String)\n\n/**\n * The closed set of machine-readable error codes. Clients switch on these, so a code is\n * part of the public API: add one deliberately, never rename one casually.\n */\nenum class ErrorCode {\n    ORDER_NOT_FOUND,\n    ORDER_ALREADY_EXISTS,\n    SHIPMENT_NOT_FOUND,\n    SHIPMENT_ALREADY_EXISTS,\n    VALIDATION_FAILED,\n}\n","numLines":38,"startLine":1,"totalLines":38}}}
