er(\"O-5\")).andExpect(status().isCreated)\n\n        mockMvc.perform(cancelOrder(\"O-5\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.orderId\").value(\"O-5\"))\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n    }\n\n    @Test\n    fun `cancel already CANCELLED order succeeds (idempotent)`() {\n        mockMvc.perform(createOrder(\"O-6\")).andExpect(status().isCreated)\n\n        mockMvc.perform(cancelOrder(\"O-6\")).andExpect(status().isOk)\n\n        // Second cancel should also succeed\n        mockMvc.perform(cancelOrder(\"O-6\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n    }\n\n    @Test\n    fun `cancel nonexistent order returns 404`() {\n        mockMvc.perform(cancelOrder(\"O-missing\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_NOT_FOUND\"))\n    }\n\n    @Test\n    fun `cancel order with CONFIRMED shipment returns 409 and changes nothing`() {\n        mockMvc.perform(createOrder(\"O-7\")).andExpect(status().isCreated)\n\n        // Manually insert a CONFIRMED shipment (BE-003 hasn't implemented confirm endpoint)\n        val confirmedShipment = Shipment(\n            shipmentId = \"S-1\",\n            orderId = \"O-7\",\n            carrier = \"DHL\",\n            status = ShipmentStatus.CONFIRMED,\n        )\n        shipmentRepository.save(confirmedShipment)\n\n        mockMvc.perform(cancelOrder(\"O-7\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_CONFLICT_SHIPMENT_CONFIRMED\"))\n\n        // Verify order still ACTIVE\n        mockMvc.perform(get(\"/orders/O-7\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"ACTIVE\"))\n    }\n\n    @Test\n    fun `cancel order cancels CREATED shipments`() {\n        mockMvc.perform(createOrder(\"O-8\")).andExpect(status().isCreated)\n\n        // Manually insert a CREATED shipment\n        val createdShipment = Shipment(\n            shipmentId = \"S-2\",\n            orderId = \"O-8\",\n            carrier = \"UPS\",\n            status = ShipmentStatus.CREATED,\n        )\n        shipmentRepository.save(createdShipment)\n\n        mockMvc.perform(cancelOrder(\"O-8\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n\n        // Verify shipment is CANCELLED\n        mockMvc.perform(get(\"/shipments/S-2\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n    }\n\n    @Test\n    fun `cancel order leaves CANCELLED shipments unchanged`() {\n        mockMvc.perform(createOrder(\"O-9\")).andExpect(status().isCreated)\n\n        // Manually insert a CANCELLED shipment\n        val cancelledShipment = Shipment(\n            shipmentId = \"S-3\",\n            orderId = \"O-9\",\n            carrier = \"FedEx\",\n            status = ShipmentStatus.CANCELLED,\n        )\n        shipmentRepository.save(cancelledShipment)\n\n        mockMvc.perform(cancelOrder(\"O-9\"))\n            .andExpect(status().isOk)\n\n        // Verify shipment is still CANCELLED\n        mockMvc.perform(get(\"/shipments/S-3\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n    }\n}"}}}
