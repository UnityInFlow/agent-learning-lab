derId'\",\n            )\n\n    @GetMapping\n    fun list(): List<Order> = repository.findAll()\n\n    @PostMapping(\"/{orderId}/cancel\")\n    fun cancel(@PathVariable orderId: String): ResponseEntity<Order> {\n        val order = repository.findById(orderId)\n            ?: throw ResourceNotFoundException(\n                ErrorCode.ORDER_NOT_FOUND,\n                \"No order with id '$orderId'\",\n            )\n\n        // Idempotent: if already cancelled, return success\n        if (order.status == OrderStatus.CANCELLED) {\n            return ResponseEntity.ok(order)\n        }\n\n        // Check all shipments: if any is CONFIRMED, reject with 409 (all-or-nothing)\n        val shipments = shipmentRepository.findByOrderId(orderId)\n        if (shipments.any { it.status == ShipmentStatus.CONFIRMED }) {\n            throw ConflictException(\n                ErrorCode.ORDER_CONFLICT_SHIPMENT_CONFIRMED,\n                \"Cannot cancel order with confirmed shipments\",\n            )\n        }\n\n        // Cancel the order\n        val cancelledOrder = order.copy(status = OrderStatus.CANCELLED)\n        repository.save(cancelledOrder)\n\n        // Cancel all CREATED shipments\n        shipments.forEach { shipment ->\n            if (shipment.status == ShipmentStatus.CREATED) {\n                shipmentRepository.save(shipment.copy(status = ShipmentStatus.CANCELLED))\n            }\n        }\n\n        return ResponseEntity.ok(cancelledOrder)\n    }\n}"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":710,"cache_read_input_tokens":27381,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":710},"output_tokens":4,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"433df6c2-b876-4030-a60d-1ae9ca64aae9","uuid":"