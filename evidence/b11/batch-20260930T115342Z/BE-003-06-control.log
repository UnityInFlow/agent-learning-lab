{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MD91pn9sGpvSNyRhYdz16V","type":"tool_result","content":"1\tpackage com.unityinflow.sample.shipment\n2\t\n3\timport org.junit.jupiter.api.BeforeEach\n4\timport org.junit.jupiter.api.Test\n5\timport org.springframework.beans.factory.annotation.Autowired\n6\timport org.springframework.boot.test.context.SpringBootTest\n7\timport org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc\n8\timport org.springframework.http.MediaType\n9\timport org.springframework.test.web.servlet.MockMvc\n10\timport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get\n11\timport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post\n12\timport org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath\n13\timport org.springframework.test.web.servlet.result.MockMvcResultMatchers.status\n14\timport org.hamcrest.Matchers.not\n15\timport org.hamcrest.Matchers.nullValue\n16\t\n17\t/**\n18\t * The shipment feature as it exists before BE-003.\n19\t *\n20\t * These are \"the existing tests\" for that benchmark: they must keep passing, and an agent\n21\t * that breaks one has regressed the fixture rather than solved the task.\n22\t */\n23\t@SpringBootTest\n24\t@AutoConfigureMockMvc\n25\tclass ShipmentControllerTest {\n26\t\n27\t    @Autowired\n28\t    lateinit var mockMvc: MockMvc\n29\t\n30\t    @Autowired\n31\t    lateinit var repository: InMemoryShipmentRepository\n32\t\n33\t    @BeforeEach\n34\t    fun reset() = repository.clear()\n35\t\n36\t    private fun createShipment(shipmentId: String) =\n37\t        post(\"/shipments\")\n38\t            .contentType(MediaType.APPLICATION_JSON)\n39\t            .content(\n40\t                \"\"\"{\"shipmentId\":\"$shipmentId\",\"orderId\":\"O-1\",\"carrier\":\"DHL\"}\"\"\",\n41\t            )\n42\t\n43\t    @Test\n44\t    fun `creates a shipment in CREATED status`() {\n45\t        mockMvc.perform(createShipment(\"S-1\"))\n46\t            .andExpect(status().isCreated)\n47\t            .andExpect(jsonPath(\"$.shipmentId\").value(\"S-1\"))\n48\t            .andExpect(jsonPath(\"$.status\").value(\"CREATED\"))\n49\t    }\n50\t\n51\t    @Test\n52\t    fun `rejects a duplicate shipment id with the error envelope`() {\n53\t        mockMvc.perform(createShipment(\"S-2\")).andExpect(status().isCreated)\n54\t\n55\t        mockMvc.perform(createShipment(\"S-2\"))\n56\t            .andExpect(status().isConflict)\n57\t            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_ALREADY_EXISTS\"))\n58\t    }\n59\t\n60\t    @Test\n61\t    fun `returns a shipment by id`() {\n62\t        mockMvc.perform(createShipment(\"S-3\")).andExpect(status().isCreated)\n63\t\n64\t        mockMvc.perform(get(\"/shipments/S-3\"))\n65\t            .andExpect(status().isOk)\n66\t            .andExpect(jsonPath(\"$.carrier\").value(\"DHL\"))\n67\t    }\n68\t\n69\t    @Test\n70\t    fun `reports an unknown shipment through the error envelope`() {\n71\t        mockMvc.perform(get(\"/shipments/S-missing\"))\n72\t            .andExpect(status().isNotFound)\n73\t            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n74\t    }\n75\t\n76\t    @Test\n77\t    fun `lists shipments in id order`() {\n78\t        mockMvc.perform(createShipment(\"S-b\")).andExpect(status().isCreated)\n79\t        mockMvc.perform(createShipment(\"S-a\")).andExpect(status().isCreated)\n80\t\n81\t        mockMvc.perform(get(\"/shipments\"))\n82\t            .andExpect(status().isOk)\n83\t            .andExpect(jsonPath(\"$[0].shipmentId\").value(\"S-a\"))\n84\t            .andExpect(jsonPath(\"$[1].shipmentId\").value(\"S-b\"))\n85\t    }\n86\t\n87\t    @Test\n88\t    fun `confirms a CREATED shipment and transitions to CONFIRMED`() {\n89\t        mockMvc.perform(createShipment(\"S-4\")).andExpect(status().isCreated)\n90\t\n91\t        mockMvc.perform(post(\"/shipments/S-4/confirm\"))\n92\t            .andExpect(status().isOk)\n93\t            .andExpect(jsonPath(\"$.shipmentId\").value(\"S-4\"))\n94\t            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n95\t    }\n96\t\n97\t    @Test\n98\t    fun `retrying confirm on CONFIRMED shipment succeeds idempotently`() {\n99\t        mockMvc.perform(createShipment(\"S-5\")).andExpect(status().isCreated)\n100\t        mockMvc.perform(post(\"/shipments/S-5/confirm\")).andExpect(status().isOk)\n101\t\n102\t        mockMvc.perform(post(\"/shipments/S-5/confirm\"))\n103\t            .andExpect(status().isOk)\n104\t            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n105\t    }\n106\t\n107\t    @Test\n108\t    fun `rejects confirm on CANCELLED shipment with 409`() {\n109\t        // Directly save a cancelled shipment\n110\t        repository.save(\n111\t            Shipment(\n112\t                shipmentId = \"S-6\",\n113\t                orderId = \"O-1\",\n114\t                carrier = \"DHL\",\n115\t                status = ShipmentStatus.CANCELLED,\n116\t            ),\n117\t        )\n118\t\n119\t        mockMvc.perform(post(\"/shipments/S-6/confirm\"))\n120\t            .andExpect(status().isConflict)\n121\t            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_INVALID_STATE\"))\n122\t            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n123\t    }\n124\t\n125\t    @Test\n126\t    fun `rejects confirm on unknown shipment with 404`() {\n127\t        mockMvc.perform(post(\"/shipments/S-missing/confirm\"))\n128\t            .andExpect(status().isNotFound)\n129\t            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n130\t            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n131\t    }\n132\t}\n133\t"}]},"parent_tool_use_id":null,"session_id":"155b8b87-65ec-41ac-b1b0-010e3e0916ed","uuid":"0627778f-5848-461e-8af3-6079eb71a795","timestamp":"2026-09-30T14:58:17.180Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/jr/lwzz65cx5pndqqdgzhnym1pc0000gn/T/observatory-run-61d691d8-2f20-49da-adfc-14647605f5c4/sample-service/src/test/kotlin/com/unityinflow/sample/shipment/ShipmentControllerTest.kt","content":"package com.unityinflow.sample.shipment\n\nimport org.junit.jupiter.api.BeforeEach\nimport org.junit.jupiter.api.Test\nimport org.springframework.beans.factory.annotation.Autowired\nimport org.springframework.boot.test.context.SpringBootTest\nimport org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc\nimport org.springframework.http.MediaType\nimport org.springframework.test.web.servlet.MockMvc\nimport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get\nimport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post\nimport org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath\nimport org.springframework.test.web.servlet.result.MockMvcResultMatchers.status\nimport org.hamcrest.Matchers.not\nimport org.hamcrest.Matchers.nullValue\n\n/**\n * The shipment feature as it exists before BE-003.\n *\n * These are \"the existing tests\" for that benchmark: they must keep passing, and an agent\n * that breaks one has regressed the fixture rather than solved the task.\n */\n@SpringBootTest\n@AutoConfigureMockMvc\nclass ShipmentControllerTest {\n\n    @Autowired\n    lateinit var mockMvc: MockMvc\n\n    @Autowired\n    lateinit var repository: InMemoryShipmentRepository\n\n    @BeforeEach\n    fun reset() = repository.clear()\n\n    private fun createShipment(shipmentId: String) =\n        post(\"/shipments\")\n            .contentType(MediaType.APPLICATION_JSON)\n            .content(\n                \"\"\"{\"shipmentId\":\"$shipmentId\",\"orderId\":\"O-1\",\"carrier\":\"DHL\"}\"\"\",\n            )\n\n    @Test\n    fun `creates a shipment in CREATED status`() {\n        mockMvc.perform(createShipment(\"S-1\"))\n            .andExpect(status().isCreated)\n            .andExpect(jsonPath(\"$.shipmentId\").value(\"S-1\"))\n            .andExpect(jsonPath(\"$.status\").value(\"CREATED\"))\n    }\n\n    @Test\n    fun `rejects a duplicate shipment id with the error envelope`() {\n        mockMvc.perform(createShipment(\"S-2\")).andExpect(status().isCreated)\n\n        mockMvc.perform(createShipment(\"S-2\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_ALREADY_EXISTS\"))\n    }\n\n    @Test\n    fun `returns a shipment by id`() {\n        mockMvc.perform(createShipment(\"S-3\")).andExpect(status().isCreated)\n\n        mockMvc.perform(get(\"/shipments/S-3\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.carrier\").value(\"DHL\"))\n    }\n\n    @Test\n    fun `reports an unknown shipment through the error envelope`() {\n        mockMvc.perform(get(\"/shipments/S-missing\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n    }\n\n    @Test\n    fun `lists shipments in id order`() {\n        mockMvc.perform(createShipment(\"S-b\")).andExpect(status().isCreated)\n        mockMvc.perform(createShipment(\"S-a\")).andExpect(status().isCreated)\n\n        mockMvc.perform(get(\"/shipments\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$[0].shipmentId\").value(\"S-a\"))\n            .andExpect(jsonPath(\"$[1].shipmentId\").value(\"S-b\"))\n    }\n\n    @Test\n    fun `confirms a CREATED shipment and transitions to CONFIRMED`() {\n        mockMvc.perform(createShipment(\"S-4\")).andExpect(status().isCreated)\n\n        mockMvc.perform(post(\"/shipments/S-4/confirm\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.shipmentId\").value(\"S-4\"))\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n    }\n\n    @Test\n    fun `retrying confirm on CONFIRMED shipment succeeds idempotently`() {\n        mockMvc.perform(createShipment(\"S-5\")).andExpect(status().isCreated)\n        mockMvc.perform(post(\"/shipments/S-5/confirm\")).andExpect(status().isOk)\n\n        mockMvc.perform(post(\"/shipments/S-5/confirm\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n    }\n\n    @Test\n    fun `rejects confirm on CANCELLED shipment with 409`() {\n        // Directly save a cancelled shipment\n        repository.save(\n            Shipment(\n                shipmentId = \"S-6\",\n                orderId = \"O-1\",\n                carrier = \"DHL\",\n                status = ShipmentStatus.CANCELLED,\n            ),\n        )\n\n        mockMvc.perform(post(\"/shipments/S-6/confirm\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_INVALID_STATE\"))\n            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n    }\n\n    @Test\n    fun `rejects confirm on unknown shipment with 404`() {\n        mockMvc.perform(post(\"/shipments/S-missing/confirm\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n    }\n}\n","numLines":133,"startLine":1,"totalLines":133}}}
