 val message: String)\n\n/**\n * The closed set of machine-readable error codes. Clients switch on these, so a code is\n * part of the public API: add one deliberately, never rename one casually.\n */\nenum class ErrorCode {\n    ORDER_NOT_FOUND,\n    ORDER_ALREADY_EXISTS,\n    SHIPMENT_NOT_FOUND,\n    SHIPMENT_ALREADY_EXISTS,\n    VALIDATION_FAILED,\n}\n","structuredPatch":[{"oldStart":33,"oldLines":5,"newStart":33,"newLines":6,"lines":["     ORDER_ALREADY_EXISTS,","     SHIPMENT_NOT_FOUND,","     SHIPMENT_ALREADY_EXISTS,","+    SHIPMENT_CANNOT_CONFIRM_WHEN_CANCELLED,","     VALIDATION_FAILED,"," }"]}],"userModified":false,"replaceAll":false}}
