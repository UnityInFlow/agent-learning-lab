\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_NOT_FOUND\"))\n            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n    }\n\n    @Test\n    fun `returns 409 with the error envelope for a duplicate order id`() {\n        mockMvc.perform(createOrder(\"O-3\")).andExpect(status().isCreated)\n\n        mockMvc.perform(createOrder(\"O-3\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_ALREADY_EXISTS\"))\n            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n    }\n\n    @Test\n    fun `newly created order has ACTIVE status`() {\n        mockMvc.perform(createOrder(\"O-4\"))\n            .andExpect(status().isCreated)\n            .andExpect(jsonPath(\"$.status\").value(\"ACTIVE\"))\n    }\n\n    @Test\n    fun `cancels an active order and changes status to CANCELLED`() {\n        mockMvc.perform(createOrder(\"O-5\")).andExpect(status().isCreated)\n\n        mockMvc.perform(post(\"/orders/O-5/cancel\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.orderId\").value(\"O-5\"))\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n    }\n\n    @Test\n    fun `cancel persists the order status`() {\n        mockMvc.perform(createOrder(\"O-6\")).andExpect(status().isCreated)\n\n        mockMvc.perform(post(\"/orders/O-6/cancel\")).andExpect(status().isOk)\n\n        mockMvc.perform(get(\"/orders/O-6\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n    }\n\n    @Test\n    fun `cancelling an already-cancelled order succeeds and returns the order`() {\n        mockMvc.perform(createOrder(\"O-7\")).andExpect(status().isCreated)\n\n        mockMvc.perform(post(\"/orders/O-7/cancel\")).andExpect(status().isOk)\n\n        // Second cancel should also succeed\n        mockMvc.perform(post(\"/orders/O-7/cancel\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n    }\n\n    @Test\n    fun `cancel fails with 409 when order has confirmed shipment`() {\n        mockMvc.perform(createOrder(\"O-8\")).andExpect(status().isCreated)\n\n        // Create and confirm a shipment\n        shipmentRepository.save(\n            Shipment(\"S-8\", \"O-8\", \"DHL\", ShipmentStatus.CONFIRMED)\n        )\n\n        // Try to cancel should fail\n        mockMvc.perform(post(\"/orders/O-8/cancel\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_HAS_CONFIRMED_SHIPMENT\"))\n            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n    }\n\n    @Test\n    fun `cancel with confirmed shipment leaves order ACTIVE and shipment unchanged`() {\n        mockMvc.perform(createOrder(\"O-9\")).andExpect(status().isCreated)\n\n        // Create and confirm a shipment\n        shipmentRepository.save(\n            Shipment(\"S-9\", \"O-9\", \"DHL\", ShipmentStatus.CONFIRMED)\n        )\n\n        // Try to cancel should fail\n        mockMvc.perform(post(\"/orders/O-9/cancel\")).andExpect(status().isConflict)\n\n        // Order should still be ACTIVE\n        mockMvc.perform(get(\"/orders/O-9\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"ACTIVE\"))\n    }\n\n    @Test\n    fun `cancelling a non-existent order returns 404`() {\n        mockMvc.perform(post(\"/orders/does-not-exist/cancel\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_NOT_FOUND\"))\n    }\n\n    @Test\n    fun `cancel cancels all CREATED shipments`() {\n        mockMvc.perform(createOrder(\"O-10\")).andExpect(status().isCreated)\n\n        // Create multiple shipments in CREATED status\n        shipmentRepository.save(Shipment(\"S-10-1\", \"O-10\", \"DHL\", ShipmentStatus.CREATED))\n        shipmentRepository.sav