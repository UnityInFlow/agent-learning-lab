/confirm\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n\n        // Second confirm (idempotent)\n        mockMvc.perform(post(\"/shipments/S-5/confirm\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n    }\n\n    @Test\n    fun `rejects confirming a cancelled shipment`() {\n        // Create a shipment and manually set it to CANCELLED\n        repository.save(\n            Shipment(\n                shipmentId = \"S-6\",\n                orderId = \"O-1\",\n                carrier = \"DHL\",\n                status = ShipmentStatus.CANCELLED,\n            ),\n        )\n\n        mockMvc.perform(post(\"/shipments/S-6/confirm\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_INVALID_STATE\"))\n    }\n\n    @Test\n    fun `rejects confirming a non-existent shipment`() {\n        mockMvc.perform(post(\"/shipments/S-missing/confirm\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n    }\n}"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":584,"cache_read_input_tokens":25272,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":584},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"a2809348-b88e-43c2-b1cc-615f7d6775b0","uuid":"6469040c-bd58-4f7f-9684-2ea48265b941","timestamp":"2026-09-30T11:57:26.068Z","request_id":"req_011CfZamkLnrVJP6jVbWvteb","wire_tool_inputs":{"toolu_019JzgnYtbk9ycBRKVdsFhZF":{"file_path":"/private/var/folders/jr/lwzz65cx5pndqqdgzhnym1pc0000gn/T/observatory-run-1cd964b4-eca2-4296-bc02-26e605254859/sample