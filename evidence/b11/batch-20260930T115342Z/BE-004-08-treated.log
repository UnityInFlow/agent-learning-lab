ach"," import org.junit.jupiter.api.Test"," import org.springframework.beans.factory.annotation.Autowired"]},{"oldStart":11,"oldLines":6,"newStart":14,"newLines":7,"lines":[" import org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post"," import org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath"," import org.springframework.test.web.servlet.result.MockMvcResultMatchers.status","+import java.math.BigDecimal"," "," /**","  * The shipment feature as it exists before BE-003."]},{"oldStart":28,"oldLines":8,"newStart":32,"newLines":14,"lines":["     @Autowired","     lateinit var repository: InMemoryShipmentRepository"," ","+    @Autowired","+    lateinit var orderRepository: InMemoryOrderRepository","+","     @BeforeEach","-    fun reset() = repository.clear()","+    fun reset() {","+        repository.clear()","+        orderRepository.clear()","+    }"," ","     private fun createShipment(shipmentId: String) =","         post(\"/shipments\")"]},{"oldStart":81,"oldLines":4,"newStart":91,"newLines":29,"lines":["             .andExpect(jsonPath(\"$[0].shipmentId\").value(\"S-a\"))","             .andExpect(jsonPath(\"$[1].shipmentId\").value(\"S-b\"))","     }","+","+    @Test","+    fun `rejects creating a shipment for a cancelled order`() {","+        // Create a cancelled order","+        orderRepository.save(","+            Order(","+                orderId = \"O-cancelled\",","+                customerId = \"C-1\",","+                amount = BigDecimal(\"49.90\"),","+                currency = \"EUR\",","+                status = OrderStatus.CANCELLED,","+            ),","+        )","+","+        mockMvc.perform(","+            post(\"/shipments\")","+                .contentType(MediaType.APPLICATION_JSON)","+                .content(","+                    \"\"\"{\"shipmentId\":\"S-cancelled\",\"orderId\":\"O-cancelled\",\"carrier\":\"DHL\"}\"\"\",","+                ),","+        )","+            .andExpect(status().isConflict)","+            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_CANCELLED\"))","+            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)","+    }"," }"]}],"userModified":false,"replaceAll":false}}
