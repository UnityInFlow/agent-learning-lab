{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0189p31MPU2a3sP93hDMtCR8","type":"tool_result","content":"1\tpackage com.unityinflow.sample.shipment\n2\t\n3\timport org.junit.jupiter.api.BeforeEach\n4\timport org.junit.jupiter.api.Test\n5\timport org.springframework.beans.factory.annotation.Autowired\n6\timport org.springframework.boot.test.context.SpringBootTest\n7\timport org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc\n8\timport org.springframework.http.MediaType\n9\timport org.springframework.test.web.servlet.MockMvc\n10\timport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get\n11\timport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post\n12\timport org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath\n13\timport org.springframework.test.web.servlet.result.MockMvcResultMatchers.status\n14\timport com.unityinflow.sample.api.ErrorCode\n15\t\n16\t/**\n17\t * The shipment feature as it exists before BE-003.\n18\t *\n19\t * These are \"the existing tests\" for that benchmark: they must keep passing, and an agent\n20\t * that breaks one has regressed the fixture rather than solved the task.\n21\t */\n22\t@SpringBootTest\n23\t@AutoConfigureMockMvc\n24\tclass ShipmentControllerTest {\n25\t\n26\t    @Autowired\n27\t    lateinit var mockMvc: MockMvc\n28\t\n29\t    @Autowired\n30\t    lateinit var repository: InMemoryShipmentRepository\n31\t\n32\t    @BeforeEach\n33\t    fun reset() = repository.clear()\n34\t\n35\t    private fun createShipment(shipmentId: String) =\n36\t        post(\"/shipments\")\n37\t            .contentType(MediaType.APPLICATION_JSON)\n38\t            .content(\n39\t                \"\"\"{\"shipmentId\":\"$shipmentId\",\"orderId\":\"O-1\",\"carrier\":\"DHL\"}\"\"\",\n40\t            )\n41\t\n42\t    @Test\n43\t    fun `creates a shipment in CREATED status`() {\n44\t        mockMvc.perform(createShipment(\"S-1\"))\n45\t            .andExpect(status().isCreated)\n46\t            .andExpect(jsonPath(\"$.shipmentId\").value(\"S-1\"))\n47\t            .andExpect(jsonPath(\"$.status\").value(\"CREATED\"))\n48\t    }\n49\t\n50\t    @Test\n51\t    fun `rejects a duplicate shipment id with the error envelope`() {\n52\t        mockMvc.perform(createShipment(\"S-2\")).andExpect(status().isCreated)\n53\t\n54\t        mockMvc.perform(createShipment(\"S-2\"))\n55\t            .andExpect(status().isConflict)\n56\t            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_ALREADY_EXISTS\"))\n57\t    }\n58\t\n59\t    @Test\n60\t    fun `returns a shipment by id`() {\n61\t        mockMvc.perform(createShipment(\"S-3\")).andExpect(status().isCreated)\n62\t\n63\t        mockMvc.perform(get(\"/shipments/S-3\"))\n64\t            .andExpect(status().isOk)\n65\t            .andExpect(jsonPath(\"$.carrier\").value(\"DHL\"))\n66\t    }\n67\t\n68\t    @Test\n69\t    fun `reports an unknown shipment through the error envelope`() {\n70\t        mockMvc.perform(get(\"/shipments/S-missing\"))\n71\t            .andExpect(status().isNotFound)\n72\t            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n73\t    }\n74\t\n75\t    @Test\n76\t    fun `lists shipments in id order`() {\n77\t        mockMvc.perform(createShipment(\"S-b\")).andExpect(status().isCreated)\n78\t        mockMvc.perform(createShipment(\"S-a\")).andExpect(status().isCreated)\n79\t\n80\t        mockMvc.perform(get(\"/shipments\"))\n81\t            .andExpect(status().isOk)\n82\t            .andExpect(jsonPath(\"$[0].shipmentId\").value(\"S-a\"))\n83\t            .andExpect(jsonPath(\"$[1].shipmentId\").value(\"S-b\"))\n84\t    }\n85\t\n86\t    @Test\n87\t    fun `confirms a created shipment and moves it to confirmed status`() {\n88\t        mockMvc.perform(createShipment(\"S-4\")).andExpect(status().isCreated)\n89\t\n90\t        mockMvc.perform(post(\"/shipments/S-4/confirm\"))\n91\t            .andExpect(status().isOk)\n92\t            .andExpect(jsonPath(\"$.shipmentId\").value(\"S-4\"))\n93\t            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n94\t    }\n95\t\n96\t    @Test\n97\t    fun `confirms an already confirmed shipment idempotently`() {\n98\t        mockMvc.perform(createShipment(\"S-5\")).andExpect(status().isCreated)\n99\t\n100\t        // First confirm\n101\t        mockMvc.perform(post(\"/shipments/S-5/confirm\"))\n102\t            .andExpect(status().isOk)\n103\t            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n104\t\n105\t        // Second confirm should also succeed\n106\t        mockMvc.perform(post(\"/shipments/S-5/confirm\"))\n107\t            .andExpect(status().isOk)\n108\t            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n109\t    }\n110\t\n111\t    @Test\n112\t    fun `rejects confirming a cancelled shipment with 409 conflict`() {\n113\t        // Manually create and cancel a shipment by directly saving to repository\n114\t        val cancelledShipment = Shipment(\n115\t            shipmentId = \"S-cancelled\",\n116\t            orderId = \"O-1\",\n117\t            carrier = \"DHL\",\n118\t            status = ShipmentStatus.CANCELLED,\n119\t        )\n120\t        repository.save(cancelledShipment)\n121\t\n122\t        mockMvc.perform(post(\"/shipments/S-cancelled/confirm\"))\n123\t            .andExpect(status().isConflict)\n124\t            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_INVALID_STATUS\"))\n125\t    }\n126\t\n127\t    @Test\n128\t    fun `rejects confirming a non-existent shipment with 404`() {\n129\t        mockMvc.perform(post(\"/shipments/S-nonexistent/confirm\"))\n130\t            .andExpect(status().isNotFound)\n131\t            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n132\t    }\n133\t}\n134\t"}]},"parent_tool_use_id":null,"session_id":"85e217db-d451-4839-9afb-dd025682a38d","uuid":"1600f1dc-1937-4794-8bae-67b6ab17664e","timestamp":"2026-09-30T12:02:39.819Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/jr/lwzz65cx5pndqqdgzhnym1pc0000gn/T/observatory-run-9115438e-e4c4-4e44-bff3-873835621b91/sample-service/src/test/kotlin/com/unityinflow/sample/shipment/ShipmentControllerTest.kt","content":"package com.unityinflow.sample.shipment\n\nimport org.junit.jupiter.api.BeforeEach\nimport org.junit.jupiter.api.Test\nimport org.springframework.beans.factory.annotation.Autowired\nimport org.springframework.boot.test.context.SpringBootTest\nimport org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc\nimport org.springframework.http.MediaType\nimport org.springframework.test.web.servlet.MockMvc\nimport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get\nimport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post\nimport org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath\nimport org.springframework.test.web.servlet.result.MockMvcResultMatchers.status\nimport com.unityinflow.sample.api.ErrorCode\n\n/**\n * The shipment feature as it exists before BE-003.\n *\n * These are \"the existing tests\" for that benchmark: they must keep passing, and an agent\n * that breaks one has regressed the fixture rather than solved the task.\n */\n@SpringBootTest\n@AutoConfigureMockMvc\nclass ShipmentControllerTest {\n\n    @Autowired\n    lateinit var mockMvc: MockMvc\n\n    @Autowired\n    lateinit var repository: InMemoryShipmentRepository\n\n    @BeforeEach\n    fun reset() = repository.clear()\n\n    private fun createShipment(shipmentId: String) =\n        post(\"/shipments\")\n            .contentType(MediaType.APPLICATION_JSON)\n            .content(\n                \"\"\"{\"shipmentId\":\"$shipmentId\",\"orderId\":\"O-1\",\"carrier\":\"DHL\"}\"\"\",\n            )\n\n    @Test\n    fun `creates a shipment in CREATED status`() {\n        mockMvc.perform(createShipment(\"S-1\"))\n            .andExpect(status().isCreated)\n            .andExpect(jsonPath(\"$.shipmentId\").value(\"S-1\"))\n            .andExpect(jsonPath(\"$.status\").value(\"CREATED\"))\n    }\n\n    @Test\n    fun `rejects a duplicate shipment id with the error envelope`() {\n        mockMvc.perform(createShipment(\"S-2\")).andExpect(status().isCreated)\n\n        mockMvc.perform(createShipment(\"S-2\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_ALREADY_EXISTS\"))\n    }\n\n    @Test\n    fun `returns a shipment by id`() {\n        mockMvc.perform(createShipment(\"S-3\")).andExpect(status().isCreated)\n\n        mockMvc.perform(get(\"/shipments/S-3\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.carrier\").value(\"DHL\"))\n    }\n\n    @Test\n    fun `reports an unknown shipment through the error envelope`() {\n        mockMvc.perform(get(\"/shipments/S-missing\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n    }\n\n    @Test\n    fun `lists shipments in id order`() {\n        mockMvc.perform(createShipment(\"S-b\")).andExpect(status().isCreated)\n        mockMvc.perform(createShipment(\"S-a\")).andExpect(status().isCreated)\n\n        mockMvc.perform(get(\"/shipments\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$[0].shipmentId\").value(\"S-a\"))\n            .andExpect(jsonPath(\"$[1].shipmentId\").value(\"S-b\"))\n    }\n\n    @Test\n    fun `confirms a created shipment and moves it to confirmed status`() {\n        mockMvc.perform(createShipment(\"S-4\")).andExpect(status().isCreated)\n\n        mockMvc.perform(post(\"/shipments/S-4/confirm\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.shipmentId\").value(\"S-4\"))\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n    }\n\n    @Test\n    fun `confirms an already confirmed shipment idempotently`() {\n        mockMvc.perform(createShipment(\"S-5\")).andExpect(status().isCreated)\n\n        // First confirm\n        mockMvc.perform(post(\"/shipments/S-5/confirm\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n\n        // Second confirm should also succeed\n        mockMvc.perform(post(\"/shipments/S-5/confirm\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n    }\n\n    @Test\n    fun `rejects confirming a cancelled shipment with 409 conflict`() {\n        // Manually create and cancel a shipment by directly saving to repository\n        val cancelledShipment = Shipment(\n            shipmentId = \"S-cancelled\",\n            orderId = \"O-1\",\n            carrier = \"DHL\",\n            status = ShipmentStatus.CANCELLED,\n        )\n        repository.save(cancelledShipment)\n\n        mockMvc.perform(post(\"/shipments/S-cancelled/confirm\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_INVALID_STATUS\"))\n    }\n\n    @Test\n    fun `rejects confirming a non-existent shipment with 404`() {\n        mockMvc.perform(post(\"/shipments/S-nonexistent/confirm\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n    }\n}\n","numLines":134,"startLine":1,"totalLines":134}}}
