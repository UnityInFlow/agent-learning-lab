moryOrderRepository,\n    private val shipmentRepository: com.unityinflow.sample.shipment.InMemoryShipmentRepository,\n) {\n\n    @PostMapping\n    fun create(@RequestBody request: CreateOrderRequest): ResponseEntity<Order> {\n        if (repository.existsById(request.orderId)) {\n            throw ConflictException(\n                ErrorCode.ORDER_ALREADY_EXISTS,\n                \"An order with id '${request.orderId}' already exists\",\n            )\n        }\n\n        val saved = repository.save(\n            Order(request.orderId, request.customerId, request.amount, request.currency),\n        )\n        return ResponseEntity.status(HttpStatus.CREATED).body(saved)\n    }\n\n    @GetMapping(\"/{orderId}\")\n    fun getById(@PathVariable orderId: String): Order =\n        repository.findById(orderId)\n            ?: throw ResourceNotFoundException(\n                ErrorCode.ORDER_NOT_FOUND,\n                \"No order with id '$orderId'\",\n            )\n\n    @PostMapping(\"/{orderId}/cancel\")\n    fun cancel(@PathVariable orderId: String): ResponseEntity<Order> {\n        val order = repository.findById(orderId)\n            ?: throw ResourceNotFoundException(\n                ErrorCode.ORDER_NOT_FOUND,\n                \"No order with id '$orderId'\",\n            )\n\n        // Get all shipments for this order\n        val shipments = shipmentRepository.findByOrderId(orderId)\n\n        // Check if any shipment is CONFIRMED\n        if (shipments.any { it.status == com.unityinflow.sample.shipment.ShipmentStatus.CONFIRMED }) {\n            throw ConflictException(\n                ErrorCode.ORDER_HAS_CONFIRMED_SHIPMENT,\n                \"Cannot cancel order with confirmed shipments\",\n            )\n        }\n\n        // Cancel the order\n        val cancelledOrder = order.copy(status = OrderStatus.CANCELLED)\n        repository.save(cancelledOrder)\n\n        // Cancel all CREATED shipments\n        shipments.forEach { shipment ->\n            if (