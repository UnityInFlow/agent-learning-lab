      .andExpect(status().isCreated)\n            .andExpect(jsonPath(\"$.shipmentId\").value(\"S-1\"))\n            .andExpect(jsonPath(\"$.status\").value(\"CREATED\"))\n    }\n\n    @Test\n    fun `rejects a duplicate shipment id with the error envelope`() {\n        mockMvc.perform(createShipment(\"S-2\")).andExpect(status().isCreated)\n\n        mockMvc.perform(createShipment(\"S-2\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_ALREADY_EXISTS\"))\n    }\n\n    @Test\n    fun `returns a shipment by id`() {\n        mockMvc.perform(createShipment(\"S-3\")).andExpect(status().isCreated)\n\n        mockMvc.perform(get(\"/shipments/S-3\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.carrier\").value(\"DHL\"))\n    }\n\n    @Test\n    fun `reports an unknown shipment through the error envelope`() {\n        mockMvc.perform(get(\"/shipments/S-missing\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n    }\n\n    @Test\n    fun `lists shipments in id order`() {\n        mockMvc.perform(createShipment(\"S-b\")).andExpect(status().isCreated)\n        mockMvc.perform(createShipment(\"S-a\")).andExpect(status().isCreated)\n\n        mockMvc.perform(get(\"/shipments\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$[0].shipmentId\").value(\"S-a\"))\n            .andExpect(jsonPath(\"$[1].shipmentId\").value(\"S-b\"))\n    }\n}\n","structuredPatch":[{"oldStart":1,"oldLines":5,"newStart":1,"newLines":9,"lines":[" package com.unityinflow.sample.shipment"," ","+import com.unityinflow.sample.order.InMemoryOrderRepository","+import com.unityinflow.sample.order.Order","+import com.unityinflow.sample.order.OrderStatus","+import java.math.BigDecimal"," import org.junit.jupiter.api.BeforeEach"," import org.junit.jupiter.api.Test"," import org.springframework.beans.factory.annotation.Autowired"]},{"oldStart":28,"oldLines":8,"newStart":32,"newLines":14,"lines":["     @Autowired","     lateinit var repository: InMemoryShipmentRepository"," ","+    @Autowired","+    lateinit var orderRepository: InMemoryOrderRepository","+","     @BeforeEach","-    fun reset() = repository.clear()","+    fun reset() {","+        repository.clear()","+        orderRepository.clear()","+    }"," ","     private fun createShipment(shipmentId: String) =","         post(\"/shipments\")"]},{"oldStart":81,"oldLines":4,"newStart":91,"newLines":21,"lines":["             .andExpect(jsonPath(\"$[0].shipmentId\").value(\"S-a\"))","             .andExpect(jsonPath(\"$[1].shipmentId\").value(\"S-b\"))","     }","+","+    @Test","+    fun `rejects creating shipment for cancelled order with 409`() {","+        // Create and cancel an order","+        val order = Order(\"O-2\", \"C-1\", BigDecimal(\"49.90\"), \"EUR\", OrderStatus.ACTIVE)","+        orderRepository.save(order)","+        val cancelledOrder = order.copy(status = OrderStatus.CANCELLED)","+        orderRepository.save(cancelledOrder)","+","+        // Try to create shipment for cancelled order","+        mockMvc.perform(","+            post(\"/shipments\")","+                .contentType(MediaType.APPLICATION_JSON)","+                .content(\"\"\"{\"shipmentId\":\"S-4\",\"orderId\":\"O-2\",\"carrier\":\"DHL\"}\"\"\"),","+        ).andExpect(status().isConflict)","+            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_CANCELLED\"))","+    }"," }"]}],"userModified":false,"replaceAll":false}}
