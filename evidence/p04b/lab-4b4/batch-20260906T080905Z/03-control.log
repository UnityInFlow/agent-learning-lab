/confirm\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n\n        mockMvc.perform(post(\"/shipments/S-5/confirm\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n    }\n\n    @Test\n    fun `confirming a non-existent shipment returns 404`() {\n        mockMvc.perform(post(\"/shipments/S-missing/confirm\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n    }\n\n    @Test\n    fun `confirming a CANCELLED shipment returns 409`() {\n        mockMvc.perform(createShipment(\"S-6\")).andExpect(status().isCreated)\n\n        val shipment = repository.findById(\"S-6\")!!\n        val cancelled = shipment.copy(status = ShipmentStatus.CANCELLED)\n        repository.save(cancelled)\n\n        mockMvc.perform(post(\"/shipments/S-6/confirm\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_INVALID_STATUS_FOR_CONFIRM\"))\n    }\n}"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":768,"cache_read_input_tokens":32467,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":768},"output_tokens":4,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"9d45308b-95a2-4f4e-914f-7c713adb32e7","uuid":"d4c8ff8a-2f55-4352-9d99-cb3b7f43c4c6","timestamp":"2026-09-06T08:22:24.889Z","request_id":"req_011CemrxhPBEw4DSizX9xgcw"}
