lled shipment is rejected with 409`() {\n115\t        repository.save(\n116\t            Shipment(\n117\t                shipmentId = \"S-cancelled\",\n118\t                orderId = \"O-1\",\n119\t                carrier = \"DHL\",\n120\t                status = ShipmentStatus.CANCELLED,\n121\t            ),\n122\t        )\n123\t\n124\t        mockMvc.perform(post(\"/shipments/S-cancelled/confirm\"))\n125\t            .andExpect(status().isConflict)\n126\t            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_CANNOT_BE_CONFIRMED\"))\n127\t    }\n128\t\n129\t    @Test\n130\t    fun `confirming a non-existent shipment is rejected with 404`() {\n131\t        mockMvc.perform(post(\"/shipments/S-missing/confirm\"))\n132\t            .andExpect(status().isNotFound)\n133\t            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n134\t    }\n135\t}\n136\t"}]},"parent_tool_use_id":null,"session_id":"bb683db6-9840-46d7-b76b-9b154ee0e678","uuid":"7bec76b7-6985-44a2-8f10-7de9fa3a3a51","timestamp":"2026-09-06T08:27:14.251Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/jr/lwzz65cx5pndqqdgzhnym1pc0000gn/T/observatory-run-9fe27bf1-1e86-49e8-90a0-676b6c438d65/sample-service/src/test/kotlin/com/unityinflow/sample/shipment/ShipmentControllerTest.kt","content":"    @Test\n    fun `lists shipments in id order`() {\n        mockMvc.perform(createShipment(\"S-b\")).andExpect(status().isCreated)\n        mockMvc.perform(createShipment(\"S-a\")).andExpect(status().isCreated)\n\n        mockMvc.perform(get(\"/shipments\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$[0].shipmentId\").value(\"S-a\"))\n            .andExpect(jsonPath(\"$[1].shipmentId\").value(\"S-b\"))\n    }\n\n    @Test\n    fun `confirms a created shipment and moves it to CONFIRMED`() {\n        mockMvc.perform(createShipment(\"S-4\")).andExpect(status().isCreated)\n\n        mockMvc.perform(post(\"/shipments/S-4/confirm\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.shipmentId\").value(\"S-4\"))\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n    }\n\n    @Test\n    fun `confirming an already confirmed shipment succeeds and changes nothing`() {\n        mockMvc.perform(createShipment(\"S-5\")).andExpect(status().isCreated)\n        mockMvc.perform(post(\"/shipments/S-5/confirm\")).andExpect(status().isOk)\n\n        val firstConfirm = mockMvc.perform(post(\"/shipments/S-5/confirm\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n            .andReturn()\n\n        val secondConfirm = mockMvc.perform(post(\"/shipments/S-5/confirm\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n            .andReturn()\n\n        assert(firstConfirm.response.contentAsString == secondConfirm.response.contentAsString)\n    }\n\n    @Test\n    fun `confirming a cancelled shipment is rejected with 409`() {\n        repository.save(\n            Shipment(\n                shipmentId = \"S-cancelled\",\n                orderId = \"O-1\",\n                carrier = \"DHL\",\n                status = ShipmentStatus.CANCELLED,\n            ),\n        )\n\n        mockMvc.perform(post(\"/shipments/S-cancelled/confirm\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_CANNOT_BE_CONFIRMED\"))\n    }\n\n    @Test\n    fun `confirming a non-existent shipment is rejected with 404`() {\n        mockMvc.perform(post(\"/shipments/S-missing/confirm\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n    }\n}\n","numLines":63,"startLine":74,"totalLines":136}}}
