/shipments/S-5/confirm\")).andExpect(status().isOk)\n\n        mockMvc.perform(post(\"/shipments/S-5/confirm\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n    }\n\n    @Test\n    fun `confirming a CANCELLED shipment is rejected with 409`() {\n        val cancelled = Shipment(\n            shipmentId = \"S-6\",\n            orderId = \"O-1\",\n            carrier = \"DHL\",\n            status = ShipmentStatus.CANCELLED,\n        )\n        repository.save(cancelled)\n\n        mockMvc.perform(post(\"/shipments/S-6/confirm\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_CANNOT_CONFIRM\"))\n    }\n\n    @Test\n    fun `confirming a non-existent shipment is rejected with 404`() {\n        mockMvc.perform(post(\"/shipments/S-missing/confirm\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n    }\n}"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":633,"cache_read_input_tokens":32954,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":633},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"e2b59d66-8802-45b4-83ce-d1b84aae3ee1","uuid":"35562266-b4b8-4a24-8612-02d2af2ac2ae","timestamp":"2026-09-07T12:04:27.659Z","request_id":"req_011Cep3hh7RxkC7B7N8gAHiM"}
