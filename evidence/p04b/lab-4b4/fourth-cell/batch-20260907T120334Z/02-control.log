{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HXQe88GaeUMRXfysStqPRf","type":"tool_result","content":"1\tpackage com.unityinflow.sample.shipment\n2\t\n3\timport com.unityinflow.sample.api.ConflictException\n4\timport com.unityinflow.sample.api.ErrorCode\n5\timport com.unityinflow.sample.api.ResourceNotFoundException\n6\timport org.springframework.http.HttpStatus\n7\timport org.springframework.http.ResponseEntity\n8\timport org.springframework.web.bind.annotation.GetMapping\n9\timport org.springframework.web.bind.annotation.PathVariable\n10\timport org.springframework.web.bind.annotation.PostMapping\n11\timport org.springframework.web.bind.annotation.RequestBody\n12\timport org.springframework.web.bind.annotation.RequestMapping\n13\timport org.springframework.web.bind.annotation.RestController\n14\t\n15\t@RestController\n16\t@RequestMapping(\"/shipments\")\n17\tclass ShipmentController(\n18\t    private val repository: InMemoryShipmentRepository,\n19\t) {\n20\t\n21\t    @PostMapping\n22\t    fun create(@RequestBody request: CreateShipmentRequest): ResponseEntity<Shipment> {\n23\t        if (repository.existsById(request.shipmentId)) {\n24\t            throw ConflictException(\n25\t                ErrorCode.SHIPMENT_ALREADY_EXISTS,\n26\t                \"A shipment with id '${request.shipmentId}' already exists\",\n27\t            )\n28\t        }\n29\t\n30\t        val saved = repository.save(\n31\t            Shipment(\n32\t                shipmentId = request.shipmentId,\n33\t                orderId = request.orderId,\n34\t                carrier = request.carrier,\n35\t                status = ShipmentStatus.CREATED,\n36\t            ),\n37\t        )\n38\t        return ResponseEntity.status(HttpStatus.CREATED).body(saved)\n39\t    }\n40\t\n41\t    @GetMapping(\"/{shipmentId}\")\n42\t    fun getById(@PathVariable shipmentId: String): Shipment =\n43\t        repository.findById(shipmentId)\n44\t            ?: throw ResourceNotFoundException(\n45\t                ErrorCode.SHIPMENT_NOT_FOUND,\n46\t                \"No shipment with id '$shipmentId'\",\n47\t            )\n48\t\n49\t    @GetMapping\n50\t    fun list(): List<Shipment> = repository.findAll()\n51\t\n52\t    @PostMapping(\"/{shipmentId}/confirm\")\n53\t    fun confirm(@PathVariable shipmentId: String): Shipment {\n54\t        val shipment = repository.findById(shipmentId)\n55\t            ?: throw ResourceNotFoundException(\n56\t                ErrorCode.SHIPMENT_NOT_FOUND,\n57\t                \"No shipment with id '$shipmentId'\",\n58\t            )\n59\t\n60\t        return when (shipment.status) {\n61\t            ShipmentStatus.CREATED -> {\n62\t                val confirmed = shipment.copy(status = ShipmentStatus.CONFIRMED)\n63\t                repository.save(confirmed)\n64\t            }\n65\t            ShipmentStatus.CONFIRMED -> shipment\n66\t            ShipmentStatus.CANCELLED -> throw ConflictException(\n67\t                ErrorCode.SHIPMENT_CANNOT_CONFIRM,\n68\t                \"Cannot confirm shipment '${shipmentId}': shipment is cancelled\",\n69\t            )\n70\t        }\n71\t    }\n72\t}\n73\t"}]},"parent_tool_use_id":null,"session_id":"d41ac756-c21e-4972-bdd9-d4596b0a89e9","uuid":"1ff6d529-61b0-4386-afb3-2e8b050262ac","timestamp":"2026-09-07T12:11:25.799Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/jr/lwzz65cx5pndqqdgzhnym1pc0000gn/T/observatory-run-8ffecb65-a97d-4a88-a40e-4f03c1b3aaf4/sample-service/src/main/kotlin/com/unityinflow/sample/shipment/ShipmentController.kt","content":"package com.unityinflow.sample.shipment\n\nimport com.unityinflow.sample.api.ConflictException\nimport com.unityinflow.sample.api.ErrorCode\nimport com.unityinflow.sample.api.ResourceNotFoundException\nimport org.springframework.http.HttpStatus\nimport org.springframework.http.ResponseEntity\nimport org.springframework.web.bind.annotation.GetMapping\nimport org.springframework.web.bind.annotation.PathVariable\nimport org.springframework.web.bind.annotation.PostMapping\nimport org.springframework.web.bind.annotation.RequestBody\nimport org.springframework.web.bind.annotation.RequestMapping\nimport org.springframework.web.bind.annotation.RestController\n\n@RestController\n@RequestMapping(\"/shipments\")\nclass ShipmentController(\n    private val repository: InMemoryShipmentRepository,\n) {\n\n    @PostMapping\n    fun create(@RequestBody request: CreateShipmentRequest): ResponseEntity<Shipment> {\n        if (repository.existsById(request.shipmentId)) {\n            throw ConflictException(\n                ErrorCode.SHIPMENT_ALREADY_EXISTS,\n                \"A shipment with id '${request.shipmentId}' already exists\",\n            )\n        }\n\n        val saved = repository.save(\n            Shipment(\n                shipmentId = request.shipmentId,\n                orderId = request.orderId,\n                carrier = request.carrier,\n                status = ShipmentStatus.CREATED,\n            ),\n        )\n        return ResponseEntity.status(HttpStatus.CREATED).body(saved)\n    }\n\n    @GetMapping(\"/{shipmentId}\")\n    fun getById(@PathVariable shipmentId: String): Shipment =\n        repository.findById(shipmentId)\n            ?: throw ResourceNotFoundException(\n                ErrorCode.SHIPMENT_NOT_FOUND,\n                \"No shipment with id '$shipmentId'\",\n            )\n\n    @GetMapping\n    fun list(): List<Shipment> = repository.findAll()\n\n    @PostMapping(\"/{shipmentId}/confirm\")\n    fun confirm(@PathVariable shipmentId: String): Shipment {\n        val shipment = repository.findById(shipmentId)\n            ?: throw ResourceNotFoundException(\n                ErrorCode.SHIPMENT_NOT_FOUND,\n                \"No shipment with id '$shipmentId'\",\n            )\n\n        return when (shipment.status) {\n            ShipmentStatus.CREATED -> {\n                val confirmed = shipment.copy(status = ShipmentStatus.CONFIRMED)\n                repository.save(confirmed)\n            }\n            ShipmentStatus.CONFIRMED -> shipment\n            ShipmentStatus.CANCELLED -> throw ConflictException(\n                ErrorCode.SHIPMENT_CANNOT_CONFIRM,\n                \"Cannot confirm shipment '${shipmentId}': shipment is cancelled\",\n            )\n        }\n    }\n}\n","numLines":73,"startLine":1,"totalLines":73}}}
