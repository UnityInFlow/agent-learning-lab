nts/S-5/confirm\")).andExpect(status().isOk)\n\n        mockMvc.perform(post(\"/shipments/S-5/confirm\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.shipmentId\").value(\"S-5\"))\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n    }\n\n    @Test\n    fun `rejects confirming a CANCELLED shipment with conflict`() {\n        val cancelled = Shipment(\"S-6\", \"O-1\", \"DHL\", ShipmentStatus.CANCELLED)\n        repository.save(cancelled)\n\n        mockMvc.perform(post(\"/shipments/S-6/confirm\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_CANNOT_CONFIRM_CANCELLED\"))\n    }\n\n    @Test\n    fun `rejects confirming a non-existent shipment with not found`() {\n        mockMvc.perform(post(\"/shipments/S-missing/confirm\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n    }\n}"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":819,"cache_read_input_tokens":32724,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":819},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"8acea01e-2a05-4759-8585-c643636baf57","uuid":"74515c16-7347-46fc-9b7a-66d57ce2a281","timestamp":"2026-09-07T13:22:44.676Z","request_id":"req_011Cep9fvJpeh6NATWpZ382v"}
