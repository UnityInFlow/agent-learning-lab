{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QwkkQYSaJ1YRpPcNHJ2C32","type":"tool_result","content":"1\tpackage com.unityinflow.sample.shipment\n2\t\n3\timport org.junit.jupiter.api.BeforeEach\n4\timport org.junit.jupiter.api.Test\n5\timport org.springframework.beans.factory.annotation.Autowired\n6\timport org.springframework.boot.test.context.SpringBootTest\n7\timport org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc\n8\timport org.springframework.http.MediaType\n9\timport org.springframework.test.web.servlet.MockMvc\n10\timport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get\n11\timport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post\n12\timport org.springframework.test.web.servlet.result.MockMvcResultMatchers.content\n13\timport org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath\n14\timport org.springframework.test.web.servlet.result.MockMvcResultMatchers.status\n15\t\n16\t@SpringBootTest\n17\t@AutoConfigureMockMvc\n18\tclass ShipmentControllerTest {\n19\t\n20\t    @Autowired\n21\t    lateinit var mockMvc: MockMvc\n22\t\n23\t    @Autowired\n24\t    lateinit var repository: InMemoryShipmentRepository\n25\t\n26\t    @BeforeEach\n27\t    fun reset() = repository.clear()\n28\t\n29\t    private fun createShipment(shipmentId: String) =\n30\t        post(\"/shipments\")\n31\t            .contentType(MediaType.APPLICATION_JSON)\n32\t            .content(\n33\t                \"\"\"{\"shipmentId\":\"$shipmentId\",\"orderId\":\"O-1\",\"carrier\":\"DHL\"}\"\"\",\n34\t            )\n35\t\n36\t    @Test\n37\t    fun `creates a shipment in CREATED status`() {\n38\t        mockMvc.perform(createShipment(\"S-1\"))\n39\t            .andExpect(status().isCreated)\n40\t            .andExpect(jsonPath(\"$.shipmentId\").value(\"S-1\"))\n41\t            .andExpect(jsonPath(\"$.status\").value(\"CREATED\"))\n42\t    }\n43\t\n44\t    @Test\n45\t    fun `rejects a duplicate shipment id with the error envelope`() {\n46\t        mockMvc.perform(createShipment(\"S-2\")).andExpect(status().isCreated)\n47\t\n48\t        mockMvc.perform(createShipment(\"S-2\"))\n49\t            .andExpect(status().isConflict)\n50\t            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_ALREADY_EXISTS\"))\n51\t    }\n52\t\n53\t    @Test\n54\t    fun `returns a shipment by id`() {\n55\t        mockMvc.perform(createShipment(\"S-3\")).andExpect(status().isCreated)\n56\t\n57\t        mockMvc.perform(get(\"/shipments/S-3\"))\n58\t            .andExpect(status().isOk)\n59\t            .andExpect(jsonPath(\"$.carrier\").value(\"DHL\"))\n60\t    }\n61\t\n62\t    @Test\n63\t    fun `reports an unknown shipment through the error envelope`() {\n64\t        mockMvc.perform(get(\"/shipments/S-missing\"))\n65\t            .andExpect(status().isNotFound)\n66\t            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n67\t    }\n68\t\n69\t    @Test\n70\t    fun `lists shipments in id order`() {\n71\t        mockMvc.perform(createShipment(\"S-b\")).andExpect(status().isCreated)\n72\t        mockMvc.perform(createShipment(\"S-a\")).andExpect(status().isCreated)\n73\t\n74\t        mockMvc.perform(get(\"/shipments\"))\n75\t            .andExpect(status().isOk)\n76\t            .andExpect(jsonPath(\"$[0].shipmentId\").value(\"S-a\"))\n77\t            .andExpect(jsonPath(\"$[1].shipmentId\").value(\"S-b\"))\n78\t    }\n79\t\n80\t    @Test\n81\t    fun `confirms a created shipment and moves it to CONFIRMED status`() {\n82\t        mockMvc.perform(createShipment(\"S-1\")).andExpect(status().isCreated)\n83\t\n84\t        mockMvc.perform(post(\"/shipments/S-1/confirm\"))\n85\t            .andExpect(status().isOk)\n86\t            .andExpect(jsonPath(\"$.shipmentId\").value(\"S-1\"))\n87\t            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n88\t    }\n89\t\n90\t    @Test\n91\t    fun `persists the confirmed status`() {\n92\t 