.code\").value(\"SHIPMENT_NOT_FOUND\"))\n+    }\n+\n+    @Test\n+    fun `confirming a CANCELLED shipment returns 409`() {\n+        mockMvc.perform(createShipment(\"S-6\")).andExpect(status().isCreated)\n+        repository.save(\n+            Shipment(\n+                shipmentId = \"S-cancelled\",\n+                orderId = \"O-1\",\n+                carrier = \"DHL\",\n+                status = ShipmentStatus.CANCELLED,\n+            ),\n+        )\n+\n+        mockMvc.perform(post(\"/shipments/S-cancelled/confirm\"))\n+            .andExpect(status().isConflict)\n+            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_CANNOT_CONFIRM\"))\n+    }\n }","is_error":false}]},"parent_tool_use_id":null,"session_id":"84283b6a-8d34-4b0d-a35f-298f9ff8334f","uuid":"40da63e1-fe43-4dcc-8e7b-a8e68e2705a2","timestamp":"2026-09-07T12:54:08.573Z","tool_use_result":{"stdout":"diff --git a/sample-service/src/test/kotlin/com/unityinflow/sample/shipment/ShipmentControllerTest.kt b/sample-service/src/test/kotlin/com/unityinflow/sample/shipment/ShipmentControllerTest.kt\nindex 64986b7..9fac4b2 100644\n--- a/sample-service/src/test/kotlin/com/unityinflow/sample/shipment/ShipmentControllerTest.kt\n+++ b/sample-service/src/test/kotlin/com/unityinflow/sample/shipment/ShipmentControllerTest.kt\n@@ -81,4 +81,52 @@ class ShipmentControllerTest {\n             .andExpect(jsonPath(\"$[0].shipmentId\").value(\"S-a\"))\n             .andExpect(jsonPath(\"$[1].shipmentId\").value(\"S-b\"))\n     }\n+\n+    @Test\n+    fun `confirms a CREATED shipment and moves it to CONFIRMED`() {\n+        mockMvc.perform(createShipment(\"S-4\")).andExpect(status().isCreated)\n+\n+        mockMvc.perform(post(\"/shipments/S-4/confirm\"))\n+            .andExpect(status().isOk)\n+            .andExpect(jsonPath(\"$.shipmentId\").value(\"S-4\"))\n+            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n+    }\n+\n+    @Test\n+    fun `confirming an already CONFIRMED shipment succeeds and