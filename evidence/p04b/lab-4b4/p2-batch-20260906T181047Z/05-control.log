own shipment`() {\n+        mockMvc.perform(post(\"/shipments/S-missing/confirm\"))\n+            .andExpect(status().isNotFound)\n+            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n+    }\n }","is_error":false}]},"parent_tool_use_id":null,"session_id":"864deef8-b835-43a2-97f7-055423f29e9c","uuid":"dbfc262e-b350-4333-87c3-b38f5198060e","timestamp":"2026-09-06T18:42:18.456Z","tool_use_result":{"stdout":"diff --git a/sample-service/src/test/kotlin/com/unityinflow/sample/shipment/ShipmentControllerTest.kt b/sample-service/src/test/kotlin/com/unityinflow/sample/shipment/ShipmentControllerTest.kt\nindex 64986b7..b8c8316 100644\n--- a/sample-service/src/test/kotlin/com/unityinflow/sample/shipment/ShipmentControllerTest.kt\n+++ b/sample-service/src/test/kotlin/com/unityinflow/sample/shipment/ShipmentControllerTest.kt\n@@ -81,4 +81,41 @@ class ShipmentControllerTest {\n             .andExpect(jsonPath(\"$[0].shipmentId\").value(\"S-a\"))\n             .andExpect(jsonPath(\"$[1].shipmentId\").value(\"S-b\"))\n     }\n+\n+    @Test\n+    fun `confirms a created shipment`() {\n+        mockMvc.perform(createShipment(\"S-4\")).andExpect(status().isCreated)\n+\n+        mockMvc.perform(post(\"/shipments/S-4/confirm\"))\n+            .andExpect(status().isOk)\n+            .andExpect(jsonPath(\"$.shipmentId\").value(\"S-4\"))\n+            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n+    }\n+\n+    @Test\n+    fun `confirm is idempotent on confirmed shipment`() {\n+        mockMvc.perform(createShipment(\"S-5\")).andExpect(status().isCreated)\n+        mockMvc.perform(post(\"/shipments/S-5/confirm\")).andExpect(status().isOk)\n+\n+        mockMvc.perform(post(\"/shipments/S-5/confirm\"))\n+            .andExpect(status().isOk)\n+            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n+    }\n+\n+    @Test\n+    fun `rejects confirm on cancelled shipment`() {\n+        val shipment = Shipment(\"S-6\", \"O-1\", \"DHL\", Ship