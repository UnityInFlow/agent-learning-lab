ent(\"S-confirm-2\")).andExpect(status().isCreated)\n\n        mockMvc.perform(post(\"/shipments/S-confirm-2/confirm\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n\n        mockMvc.perform(post(\"/shipments/S-confirm-2/confirm\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n    }\n\n    @Test\n    fun `confirming a CANCELLED shipment returns 409 with SHIPMENT_INVALID_STATUS`() {\n        mockMvc.perform(createShipment(\"S-confirm-3\")).andExpect(status().isCreated)\n\n        val shipment = repository.findById(\"S-confirm-3\")!!\n        repository.save(shipment.copy(status = ShipmentStatus.CANCELLED))\n\n        mockMvc.perform(post(\"/shipments/S-confirm-3/confirm\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_INVALID_STATUS\"))\n    }\n\n    @Test\n    fun `confirming a non-existent shipment returns 404 with SHIPMENT_NOT_FOUND`() {\n        mockMvc.perform(post(\"/shipments/S-missing/confirm\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n    }\n}\nTESTEOF\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":1840,"cache_read_input_tokens":72522,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1840},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"ae3a7f7c-e754-4932-9459-9b57e85ab55a","uuid":"50cc9c49-2a67-417d-aa71-677f4bbd44e4","timestamp":"2026-09-13T10:32:29.511Z","request_id":"req_011Cf1HY63xBNsN71TJmzEsH","wire_tool_inputs":{"toolu_01WgnNPmjg1JecTvcpE5F1d9":{"command":"cat > sample-service/src/test/kotlin/com/unityinflow/sample/