+package com.unityinflow.sample.order
+
+import com.unityinflow.sample.shipment.InMemoryShipmentRepository
+import com.unityinflow.sample.shipment.Shipment
+import com.unityinflow.sample.shipment.ShipmentStatus
+import java.math.BigDecimal
+import org.junit.jupiter.api.BeforeEach
+import org.junit.jupiter.api.Test
+import org.springframework.beans.factory.annotation.Autowired
+import org.springframework.boot.test.context.SpringBootTest
+import org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc
+import org.springframework.http.MediaType
+import org.springframework.test.web.servlet.MockMvc
+import org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get
+import org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post
+import org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath
+import org.springframework.test.web.servlet.result.MockMvcResultMatchers.status
+
+@SpringBootTest
+@AutoConfigureMockMvc
+class OrderCancellationTest {
+    @Autowired lateinit var mockMvc: MockMvc
+    @Autowired lateinit var orders: InMemoryOrderRepository
+    @Autowired lateinit var shipments: InMemoryShipmentRepository
+
+    @BeforeEach
+    fun reset() {
+        orders.clear()
+        shipments.clear()
+    }
+
+    private fun order(id: String = "O-1") =
+        orders.save(Order(id, "C-1", BigDecimal("10.00"), "EUR"))
+
+    @Test
+    fun `cancel persists the order and cancels only created shipments`() {
+        order()
+        shipments.save(Shipment("S-created", "O-1", "DHL", ShipmentStatus.CREATED))
+        shipments.save(Shipment("S-cancelled", "O-1", "UPS", ShipmentStatus.CANCELLED))
+        shipments.save(Shipment("S-other", "O-2", "DHL", ShipmentStatus.CREATED))
+
+        mockMvc.perform(post("/orders/O-1/cancel"))
+            .andExpect(status().isOk)
+            .andExpect(jsonPath("$.status").value("CANCELLED"))
+
+        mockMvc.perform(get("/orders/O-1"))
+            .andExpect(jsonPath("$.status").value("CANCELLED"))
+        check(shipments.findById("S-created")?.status == ShipmentStatus.CANCELLED)
+        check(shipments.findById("S-cancelled")?.status == ShipmentStatus.CANCELLED)
+        check(shipments.findById("S-other")?.status == ShipmentStatus.CREATED)
+    }
+
+    @Test
+    fun `repeated cancel succeeds without changing anything`() {
+        order()
+        mockMvc.perform(post("/orders/O-1/cancel")).andExpect(status().isOk)
+        mockMvc.perform(post("/orders/O-1/cancel"))
+            .andExpect(status().isOk)
+            .andExpect(jsonPath("$.status").value("CANCELLED"))
+    }
+
+    @Test
+    fun `confirmed shipment rejects cancel without partial changes`() {
+        order()
+        shipments.save(Shipment("S-created", "O-1", "DHL", ShipmentStatus.CREATED))
+        shipments.save(Shipment("S-confirmed", "O-1", "UPS", ShipmentStatus.CONFIRMED))
+
+        mockMvc.perform(post("/orders/O-1/cancel"))
+            .andExpect(status().isConflict)
+            .andExpect(jsonPath("$.error.code").value("ORDER_HAS_CONFIRMED_SHIPMENT"))
+
+        check(orders.findById("O-1")?.status == OrderStatus.ACTIVE)
+        check(shipments.findById("S-created")?.status == ShipmentStatus.CREATED)
+        check(shipments.findById("S-confirmed")?.status == ShipmentStatus.CONFIRMED)
+    }
+
+    @Test
+    fun `unknown order is rejected`() {
+        mockMvc.perform(post("/orders/missing/cancel"))
+            .andExpect(status().isNotFound)
+            .andExpect(jsonPath("$.error.code").value("ORDER_NOT_FOUND"))
+    }
+
+    @Test
+    fun `shipment cannot be created for cancelled order`() {
+        order().also { orders.save(it.copy(status = OrderStatus.CANCELLED)) }
+
+        mockMvc.perform(
+            post("/shipments")
+                .contentType(MediaType.APPLICATION_JSON)
+                .content("""{"shipmentId":"S-1","orderId":"O-1","carrier":"DHL"}"""),
+        )
+            .andExpect(status().isConflict)
+            .andExpect(jsonPath("$.error.code").value("ORDER_CANCELLED"))
+
+        check(shipments.findById("S-1") == null)
+    }
+}
