diff --git a/sample-service/src/main/kotlin/com/unityinflow/sample/shipment/ShipmentController.kt b/sample-service/src/main/kotlin/com/unityinflow/sample/shipment/ShipmentController.kt
index 88727b7fa99a277679537d7ad9bd897adecd0601..47f2e2841644fa5209e435d310420de67079f9f0
--- a/sample-service/src/main/kotlin/com/unityinflow/sample/shipment/ShipmentController.kt
+++ b/sample-service/src/main/kotlin/com/unityinflow/sample/shipment/ShipmentController.kt
@@ -51,6 +51,24 @@
                 "No shipment with id '$shipmentId'",
             )
 
+    @PostMapping("/{shipmentId}/confirm")
+    fun confirm(@PathVariable shipmentId: String): Shipment {
+        val shipment = repository.findById(shipmentId)
+            ?: throw ResourceNotFoundException(
+                ErrorCode.SHIPMENT_NOT_FOUND,
+                "No shipment with id '$shipmentId'",
+            )
+
+        return when (shipment.status) {
+            ShipmentStatus.CREATED -> repository.save(shipment.copy(status = ShipmentStatus.CONFIRMED))
+            ShipmentStatus.CONFIRMED -> shipment
+            ShipmentStatus.CANCELLED -> throw ConflictException(
+                ErrorCode.SHIPMENT_ALREADY_EXISTS,
+                "Shipment with id '$shipmentId' is cancelled and cannot be confirmed",
+            )
+        }
+    }
+
     @GetMapping
     fun list(): List<Shipment> = repository.findAll()
 }
