     fun findAll(): List<Shipment> = store.values.sortedBy { it.shipmentId }
 
+    fun confirm(shipmentId: String): Shipment? =
+        store.computeIfPresent(shipmentId) { _, shipment ->
+            if (shipment.status == ShipmentStatus.CREATED) {
+                shipment.copy(status = ShipmentStatus.CONFIRMED)
+            } else {
+                shipment
+            }
+        }
+
     fun clear() = store.clear()
 }
