+package com.unityinflow.sample.order
+
+import com.unityinflow.sample.shipment.InMemoryShipmentRepository
+import com.unityinflow.sample.shipment.Shipment
+import com.unityinflow.sample.shipment.ShipmentStatus
+import java.math.BigDecimal
+import org.junit.jupiter.api.AfterEach
+import org.junit.jupiter.api.BeforeEach
+import org.junit.jupiter.api.Test
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertNull
+import org.springframework.beans.factory.annotation.Autowired
+import org.springframework.boot.test.context.SpringBootTest
+import org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc
+import org.springframework.http.MediaType
+import org.springframework.test.web.servlet.MockMvc
+import org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post
+import org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath
+import org.springframework.test.web.servlet.result.MockMvcResultMatchers.status
+
+@SpringBootTest
+@AutoConfigureMockMvc
+class OrderCancellationTest {
+
+    @Autowired lateinit var mockMvc: MockMvc
+    @Autowired lateinit var orderRepository: InMemoryOrderRepository
+    @Autowired lateinit var shipmentRepository: InMemoryShipmentRepository
+
+    @BeforeEach
+    fun reset() {
+        orderRepository.clear()
+        shipmentRepository.clear()
+    }
+
+    @AfterEach
+    fun cleanUp() = reset()
+
+    private fun saveOrder(orderId: String = "O-1") =
+        orderRepository.save(Order(orderId, "C-1", BigDecimal("49.90"), "EUR"))
+
+    @Test
+    fun `cancels an order and only its created shipments`() {
+        saveOrder()
+        shipmentRepository.save(Shipment("S-1", "O-1", "DHL", ShipmentStatus.CREATED))
+        shipmentRepository.save(Shipment("S-2", "O-1", "DHL", ShipmentStatus.CANCELLED))
+        shipmentRepository.save(Shipment("S-3", "O-2", "DHL", ShipmentStatus.CREATED))
+
+        mockMvc.perform(post("/orders/O-1/cancel"))
+            .andExpect(status().isOk)
+            .andExpect(jsonPath("$.status").value("CANCELLED"))
+
+        assertEquals(OrderStatus.CANCELLED, orderRepository.findById("O-1")?.status)
+        assertEquals(ShipmentStatus.CANCELLED, shipmentRepository.findById("S-1")?.status)
+        assertEquals(ShipmentStatus.CANCELLED, shipmentRepository.findById("S-2")?.status)
+        assertEquals(ShipmentStatus.CREATED, shipmentRepository.findById("S-3")?.status)
+
+        mockMvc.perform(post("/orders/O-1/cancel"))
+            .andExpect(status().isOk)
+            .andExpect(jsonPath("$.status").value("CANCELLED"))
+    }
+
+    @Test
+    fun `confirmed shipment rejects cancellation without changing anything`() {
+        saveOrder()
+        shipmentRepository.save(Shipment("S-created", "O-1", "DHL", ShipmentStatus.CREATED))
+        shipmentRepository.save(Shipment("S-confirmed", "O-1", "DHL", ShipmentStatus.CONFIRMED))
+
+        mockMvc.perform(post("/orders/O-1/cancel"))
+            .andExpect(status().isConflict)
+            .andExpect(jsonPath("$.error.code").value("ORDER_CANCELLATION_BLOCKED"))
+
+        assertEquals(OrderStatus.ACTIVE, orderRepository.findById("O-1")?.status)
+        assertEquals(ShipmentStatus.CREATED, shipmentRepository.findById("S-created")?.status)
+        assertEquals(ShipmentStatus.CONFIRMED, shipmentRepository.findById("S-confirmed")?.status)
+    }
+
+    @Test
+    fun `unknown order is rejected`() {
+        mockMvc.perform(post("/orders/missing/cancel"))
+            .andExpect(status().isNotFound)
+            .andExpect(jsonPath("$.error.code").value("ORDER_NOT_FOUND"))
+    }
+
+    @Test
+    fun `shipment creation is rejected for a cancelled order`() {
+        orderRepository.save(saveOrder().copy(status = OrderStatus.CANCELLED))
+
+        mockMvc.perform(
+            post("/shipments")
+                .contentType(MediaType.APPLICATION_JSON)
+                .content("""{"shipmentId":"S-1","orderId":"O-1","carrier":"DHL"}"""),
+        )
+            .andExpect(status().isConflict)
+            .andExpect(jsonPath("$.error.code").value("ORDER_CANCELLED"))
+
+        assertNull(shipmentRepository.findById("S-1"))
+    }
+}

