+    @PostMapping("/{orderId}/cancel")
+    fun cancel(@PathVariable orderId: String): Order = synchronized(repository) {
+        val order = repository.findById(orderId)
+            ?: throw ResourceNotFoundException(
+                ErrorCode.ORDER_NOT_FOUND,
+                "No order with id '$orderId'",
+            )
+
+        if (order.status == OrderStatus.CANCELLED) {
+            return@synchronized order
+        }
+
+        val shipments = shipmentRepository.findByOrderId(orderId)
+        if (shipments.any { it.status == ShipmentStatus.CONFIRMED }) {
+            throw ConflictException(
+                ErrorCode.ORDER_CANCELLATION_BLOCKED,
+                "Order '$orderId' cannot be cancelled because a shipment is confirmed",
+            )
+        }
+
+        val cancelledOrder = repository.save(order.copy(status = OrderStatus.CANCELLED))
+        shipments
+            .filter { it.status == ShipmentStatus.CREATED }
+            .forEach { shipmentRepository.save(it.copy(status = ShipmentStatus.CANCELLED)) }
+        cancelledOrder
+    }
+
     @GetMapping("/{orderId}")
     fun getById(@PathVariable orderId: String): Order =
         repository.findById(orderId)
