+    @PostMapping("/{orderId}/cancel")
+    fun cancel(@PathVariable orderId: String): Order {
+        val order = repository.findById(orderId)
+            ?: throw ResourceNotFoundException(
+                ErrorCode.ORDER_NOT_FOUND,
+                "No order with id '$orderId'",
+            )
+
+        return when (order.status) {
+            OrderStatus.CANCELLED -> order
+            OrderStatus.ACTIVE -> cancelActiveOrder(order)
+        }
+    }
+
+    private fun cancelActiveOrder(order: Order): Order {
+        val shipments = shipmentRepository.findByOrderId(order.orderId)
+        val hasConfirmedShipment = shipments.any { shipment ->
+            when (shipment.status) {
+                ShipmentStatus.CREATED, ShipmentStatus.CANCELLED -> false
+                ShipmentStatus.CONFIRMED -> true
+            }
+        }
+        if (hasConfirmedShipment) {
+            throw ConflictException(
+                ErrorCode.ORDER_CANCELLATION_BLOCKED,
+                "Order '${order.orderId}' cannot be cancelled because a shipment is confirmed",
+            )
+        }
+
+        shipments
+            .filter { shipment ->
+                when (shipment.status) {
+                    ShipmentStatus.CREATED -> true
+                    ShipmentStatus.CONFIRMED, ShipmentStatus.CANCELLED -> false
+                }
+            }
+            .forEach { shipment ->
+                shipmentRepository.save(shipment.copy(status = ShipmentStatus.CANCELLED))
+            }
+        return repository.save(order.copy(status = OrderStatus.CANCELLED))
+    }
+
     @GetMapping
     fun list(): List<Order> = repository.findAll()
 }
