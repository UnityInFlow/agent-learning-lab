     fun findAll(): List<Shipment> = store.values.sortedBy { it.shipmentId }
 
+    fun findByOrderId(orderId: String): List<Shipment> =
+        store.values.filter { it.orderId == orderId }.sortedBy { it.shipmentId }
+
+    fun cancelCreatedByOrderId(orderId: String) {
+        findByOrderId(orderId).forEach { shipment ->
+            val updated = when (shipment.status) {
+                ShipmentStatus.CREATED -> shipment.copy(status = ShipmentStatus.CANCELLED)
+                ShipmentStatus.CONFIRMED, ShipmentStatus.CANCELLED -> shipment
+            }
+            store[shipment.shipmentId] = updated
+        }
+    }
+
     fun clear() = store.clear()
 }
