diff --git a/sample-service/src/main/kotlin/com/unityinflow/sample/shipment/ShipmentController.kt b/sample-service/src/main/kotlin/com/unityinflow/sample/shipment/ShipmentController.kt
index 88727b7fa99a277679537d7ad9bd897adecd0601..47f2e2841644fa5209e435d310420de67079f9f0
--- a/sample-service/src/main/kotlin/com/unityinflow/sample/shipment/ShipmentController.kt
+++ b/sample-service/src/main/kotlin/com/unityinflow/sample/shipment/ShipmentController.kt
@@ -51,6 +51,24 @@
                 "No shipment with id '$shipmentId'",
             )
 
+    @PostMapping("/{shipmentId}/confirm")
+    fun confirm(@PathVariable shipmentId: String): Shipment {
+        val shipment = repository.findById(shipmentId)
+            ?: throw ResourceNotFoundException(
+                ErrorCode.SHIPMENT_NOT_FOUND,
+                "No shipment with id '$shipmentId'",
+            )
+
+        return when (shipment.status) {
+            ShipmentStatus.CREATED -> repository.save(shipment.copy(status = ShipmentStatus.CONFIRMED))
+            ShipmentStatus.CONFIRMED -> shipment
+            ShipmentStatus.CANCELLED -> throw ConflictException(
+                ErrorCode.SHIPMENT_ALREADY_EXISTS,
+                "Shipment with id '$shipmentId' is cancelled and cannot be confirmed",
+            )
+        }
+    }
+
     @GetMapping
     fun list(): List<Shipment> = repository.findAll()
 }
diff --git a/sample-service/src/test/kotlin/com/unityinflow/sample/shipment/ShipmentControllerTest.kt b/sample-service/src/test/kotlin/com/unityinflow/sample/shipment/ShipmentControllerTest.kt
index 64986b7e28e3d39ed6dc9e5de602ade8a2f7d42a..4818f94e959aae2d6eb93ea5a3118ea9c6e3d2c3
--- a/sample-service/src/test/kotlin/com/unityinflow/sample/shipment/ShipmentControllerTest.kt
+++ b/sample-service/src/test/kotlin/com/unityinflow/sample/shipment/ShipmentControllerTest.kt
@@ -81,4 +81,49 @@
             .andExpect(jsonPath("$[0].shipmentId").value("S-a"))
             .andExpect(jsonPath("$[1].shipmentId").value("S-b"))
     }
+
+    @Test
+    fun `confirms a created shipment and persists the transition`() {
+        mockMvc.perform(createShipment("S-4")).andExpect(status().isCreated)
+
+        mockMvc.perform(post("/shipments/S-4/confirm"))
+            .andExpect(status().isOk)
+            .andExpect(jsonPath("$.shipmentId").value("S-4"))
+            .andExpect(jsonPath("$.status").value("CONFIRMED"))
+
+        mockMvc.perform(get("/shipments/S-4"))
+            .andExpect(status().isOk)
+            .andExpect(jsonPath("$.status").value("CONFIRMED"))
+    }
+
+    @Test
+    fun `confirming an already confirmed shipment succeeds without changing it`() {
+        mockMvc.perform(createShipment("S-5")).andExpect(status().isCreated)
+        mockMvc.perform(post("/shipments/S-5/confirm")).andExpect(status().isOk)
+
+        mockMvc.perform(post("/shipments/S-5/confirm"))
+            .andExpect(status().isOk)
+            .andExpect(jsonPath("$.shipmentId").value("S-5"))
+            .andExpect(jsonPath("$.status").value("CONFIRMED"))
+    }
+
+    @Test
+    fun `refuses to confirm a cancelled shipment with the error envelope`() {
+        repository.save(
+            Shipment("S-6", "O-1", "DHL", ShipmentStatus.CANCELLED),
+        )
+
+        mockMvc.perform(post("/shipments/S-6/confirm"))
+            .andExpect(status().isConflict)
+            .andExpect(jsonPath("$.error.code").value("SHIPMENT_ALREADY_EXISTS"))
+            .andExpect(jsonPath("$.error.message").isNotEmpty)
+    }
+
+    @Test
+    fun `refuses to confirm an unknown shipment with the error envelope`() {
+        mockMvc.perform(post("/shipments/S-missing/confirm"))
+            .andExpect(status().isNotFound)
+            .andExpect(jsonPath("$.error.code").value("SHIPMENT_NOT_FOUND"))
+            .andExpect(jsonPath("$.error.message").isNotEmpty)
+    }
 }

