@@ -0,0 +1,120 @@
+package com.unityinflow.sample.order
+
+import com.unityinflow.sample.shipment.InMemoryShipmentRepository
+import com.unityinflow.sample.shipment.Shipment
+import com.unityinflow.sample.shipment.ShipmentStatus
+import org.junit.jupiter.api.BeforeEach
+import org.junit.jupiter.api.Test
+import org.springframework.beans.factory.annotation.Autowired
+import org.springframework.boot.test.context.SpringBootTest
+import org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc
+import org.springframework.http.MediaType
+import org.springframework.test.web.servlet.MockMvc
+import org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get
+import org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post
+import org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath
+import org.springframework.test.web.servlet.result.MockMvcResultMatchers.status
+
+@SpringBootTest
+@AutoConfigureMockMvc
+class OrderCancellationTest {
+
+    @Autowired
+    lateinit var mockMvc: MockMvc
+
+    @Autowired
+    lateinit var orderRepository: InMemoryOrderRepository
+
+    @Autowired
+    lateinit var shipmentRepository: InMemoryShipmentRepository
+
+    @BeforeEach
+    fun reset() {
+        orderRepository.clear()
+        shipmentRepository.clear()
+    }
+
+    private fun createOrder(orderId: String) =
+        mockMvc.perform(
+            post("/orders")
+                .contentType(MediaType.APPLICATION_JSON)
+                .content(
+                    """{"orderId":"$orderId","customerId":"C-1","amount":49.90,"currency":"EUR"}""",
+                ),
+        ).andExpect(status().isCreated)
+
+    private fun shipment(id: String, orderId: String, status: ShipmentStatus) =
+        Shipment(id, orderId, "DHL", status)
+
+    @Test
+    fun `cancels the order and only its created shipments`() {
+        createOrder("O-1")
+        shipmentRepository.save(shipment("S-created", "O-1", ShipmentStatus.CREATED))
+        shipmentRepository.save(shipment("S-cancelled", "O-1", ShipmentStatus.CANCELLED))
+        shipmentRepository.save(shipment("S-other", "O-2", ShipmentStatus.CREATED))
+
+        mockMvc.perform(post("/orders/O-1/cancel"))
+            .andExpect(status().isOk)
+            .andExpect(jsonPath("$.status").value("CANCELLED"))
+
+        mockMvc.perform(get("/orders/O-1"))
+            .andExpect(jsonPath("$.status").value("CANCELLED"))
+        check(shipmentRepository.findById("S-created")?.status == ShipmentStatus.CANCELLED)
+        check(shipmentRepository.findById("S-cancelled")?.status == ShipmentStatus.CANCELLED)
+        check(shipmentRepository.findById("S-other")?.status == ShipmentStatus.CREATED)
+    }
+
+    @Test
+    fun `repeated cancellation succeeds without changing shipment state`() {
+        createOrder("O-2")
+        mockMvc.perform(post("/orders/O-2/cancel")).andExpect(status().isOk)
+        shipmentRepository.save(shipment("S-late", "O-2", ShipmentStatus.CREATED))
+
+        mockMvc.perform(post("/orders/O-2/cancel"))
+            .andExpect(status().isOk)
+            .andExpect(jsonPath("$.status").value("CANCELLED"))
+
+        check(shipmentRepository.findById("S-late")?.status == ShipmentStatus.CREATED)
+    }
+
+    @Test
+    fun `confirmed shipment rejects cancellation without any changes`() {
+        createOrder("O-3")
+        shipmentRepository.save(shipment("S-created", "O-3", ShipmentStatus.CREATED))
+        shipmentRepository.save(shipment("S-confirmed", "O-3", ShipmentStatus.CONFIRMED))
+
+        mockMvc.perform(post("/orders/O-3/cancel"))
+            .andExpect(status().isConflict)
+            .andExpect(jsonPath("$.error.code").value("ORDER_CANNOT_BE_CANCELLED"))
+
+        check(orderRepository.findById("O-3")?.status == OrderStatus.ACTIVE)
+        check(shipmentRepository.findById("S-created")?.status == ShipmentStatus.CREATED)
+        check(shipmentRepository.findById("S-confirmed")?.status == ShipmentStatus.CONFIRMED)
+    }
+
+    @Test
+    fun `unknown order rejects cancellation`() {
+        mockMvc.perform(post("/orders/missing/cancel"))
+            .andExpect(status().isNotFound)
+            .andExpect(jsonPath("$.error.code").value("ORDER_NOT_FOUND"))
+    }
+
+    @Test
+    fun `shipment creation for cancelled order is rejected but unknown order remains allowed`() {
+        createOrder("O-4")
+        mockMvc.perform(post("/orders/O-4/cancel")).andExpect(status().isOk)
+
+        val request = { shipmentId: String, orderId: String ->
+            post("/shipments")
+                .contentType(MediaType.APPLICATION_JSON)
+                .content(
+                    """{"shipmentId":"$shipmentId","orderId":"$orderId","carrier":"DHL"}""",
+                )
+        }
+        mockMvc.perform(request("S-refused", "O-4"))
+            .andExpect(status().isConflict)
+            .andExpect(jsonPath("$.error.code").value("ORDER_CANCELLED"))
+        mockMvc.perform(request("S-allowed", "does-not-exist"))
+            .andExpect(status().isCreated)
+    }
+}
