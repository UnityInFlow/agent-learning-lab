     @GetMapping
     fun list(): List<Order> = repository.findAll()
+
+    @PostMapping("/{orderId}/cancel")
+    fun cancel(@PathVariable orderId: String): Order = synchronized(repository) {
+        val order = repository.findById(orderId)
+            ?: throw ResourceNotFoundException(
+                ErrorCode.ORDER_NOT_FOUND,
+                "No order with id '$orderId'",
+            )
+
+        when (order.status) {
+            OrderStatus.CANCELLED -> order
+            OrderStatus.ACTIVE -> {
+                val shipments = shipmentRepository.findByOrderId(orderId)
+                if (shipments.any { it.status == ShipmentStatus.CONFIRMED }) {
+                    throw ConflictException(
+                        ErrorCode.ORDER_HAS_CONFIRMED_SHIPMENT,
+                        "Order '$orderId' has a confirmed shipment",
+                    )
+                }
+
+                shipments.forEach { shipment ->
+                    val cancelledShipment = when (shipment.status) {
+                        ShipmentStatus.CREATED -> shipment.copy(status = ShipmentStatus.CANCELLED)
+                        ShipmentStatus.CANCELLED -> shipment
+                        ShipmentStatus.CONFIRMED -> error("Confirmed shipments were checked before mutation")
+                    }
+                    shipmentRepository.save(cancelledShipment)
+                }
+                repository.save(order.copy(status = OrderStatus.CANCELLED))
+            }
+        }
+    }
 }
