+package com.unityinflow.sample.order
+
+import com.unityinflow.sample.shipment.InMemoryShipmentRepository
+import com.unityinflow.sample.shipment.Shipment
+import com.unityinflow.sample.shipment.ShipmentStatus
+import org.junit.jupiter.api.BeforeEach
+import org.junit.jupiter.api.Test
+import org.springframework.beans.factory.annotation.Autowired
+import org.springframework.boot.test.context.SpringBootTest
+import org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc
+import org.springframework.http.MediaType
+import org.springframework.test.web.servlet.MockMvc
+import org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get
+import org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post
+import org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath
+import org.springframework.test.web.servlet.result.MockMvcResultMatchers.status
+
+@SpringBootTest
+@AutoConfigureMockMvc
+class OrderCancellationTest {
+
+    @Autowired lateinit var mockMvc: MockMvc
+    @Autowired lateinit var orders: InMemoryOrderRepository
+    @Autowired lateinit var shipments: InMemoryShipmentRepository
+
+    @BeforeEach
+    fun reset() {
+        orders.clear()
+        shipments.clear()
+    }
+
+    private fun createOrder(orderId: String) =
+        post("/orders").contentType(MediaType.APPLICATION_JSON).content(
+            """{"orderId":"$orderId","customerId":"C-1","amount":10,"currency":"EUR"}""",
+        )
+
+    private fun createShipment(shipmentId: String, orderId: String) =
+        post("/shipments").contentType(MediaType.APPLICATION_JSON).content(
+            """{"shipmentId":"$shipmentId","orderId":"$orderId","carrier":"DHL"}""",
+        )
+
+    @Test
+    fun `new and fetched orders report ACTIVE status`() {
+        mockMvc.perform(createOrder("O-1"))
+            .andExpect(status().isCreated)
+            .andExpect(jsonPath("$.status").value("ACTIVE"))
+
+        mockMvc.perform(get("/orders/O-1"))
+            .andExpect(status().isOk)
+            .andExpect(jsonPath("$.status").value("ACTIVE"))
+    }
+
+    @Test
+    fun `cancel persists the order and cancels only CREATED shipments`() {
+        mockMvc.perform(createOrder("O-2")).andExpect(status().isCreated)
+        shipments.save(Shipment("S-created", "O-2", "DHL", ShipmentStatus.CREATED))
+        shipments.save(Shipment("S-cancelled", "O-2", "UPS", ShipmentStatus.CANCELLED))
+        shipments.save(Shipment("S-other", "O-other", "DHL", ShipmentStatus.CREATED))
+
+        mockMvc.perform(post("/orders/O-2/cancel"))
+            .andExpect(status().isOk)
+            .andExpect(jsonPath("$.status").value("CANCELLED"))
+
+        assert(orders.findById("O-2")?.status == OrderStatus.CANCELLED)
+        assert(shipments.findById("S-created")?.status == ShipmentStatus.CANCELLED)
+        assert(shipments.findById("S-cancelled")?.status == ShipmentStatus.CANCELLED)
+        assert(shipments.findById("S-other")?.status == ShipmentStatus.CREATED)
+
+        mockMvc.perform(post("/orders/O-2/cancel"))
+            .andExpect(status().isOk)
+            .andExpect(jsonPath("$.status").value("CANCELLED"))
+    }
+
+    @Test
+    fun `confirmed shipment rejects cancellation without any changes`() {
+        mockMvc.perform(createOrder("O-3")).andExpect(status().isCreated)
+        shipments.save(Shipment("S-created", "O-3", "DHL", ShipmentStatus.CREATED))
+        shipments.save(Shipment("S-confirmed", "O-3", "UPS", ShipmentStatus.CONFIRMED))
+
+        mockMvc.perform(post("/orders/O-3/cancel"))
+            .andExpect(status().isConflict)
+            .andExpect(jsonPath("$.error.code").value("ORDER_CANCELLATION_BLOCKED"))
+
+        assert(orders.findById("O-3")?.status == OrderStatus.ACTIVE)
+        assert(shipments.findById("S-created")?.status == ShipmentStatus.CREATED)
+        assert(shipments.findById("S-confirmed")?.status == ShipmentStatus.CONFIRMED)
+    }
+
+    @Test
+    fun `unknown order cannot be cancelled`() {
+        mockMvc.perform(post("/orders/missing/cancel"))
+            .andExpect(status().isNotFound)
+            .andExpect(jsonPath("$.error.code").value("ORDER_NOT_FOUND"))
+    }
+
+    @Test
+    fun `shipment cannot be created for cancelled order but unknown order behavior remains`() {
+        mockMvc.perform(createOrder("O-4")).andExpect(status().isCreated)
+        mockMvc.perform(post("/orders/O-4/cancel")).andExpect(status().isOk)
+
+        mockMvc.perform(createShipment("S-blocked", "O-4"))
+            .andExpect(status().isConflict)
+            .andExpect(jsonPath("$.error.code").value("ORDER_CANCELLED"))
+        mockMvc.perform(createShipment("S-unknown", "O-missing"))
+            .andExpect(status().isCreated)
+    }
+}

