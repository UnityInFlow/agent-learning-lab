@@ -0,0 +1,70 @@
+package com.unityinflow.sample.order
+
+import com.unityinflow.sample.api.ConflictException
+import com.unityinflow.sample.api.ErrorCode
+import com.unityinflow.sample.api.ResourceNotFoundException
+import com.unityinflow.sample.shipment.CreateShipmentRequest
+import com.unityinflow.sample.shipment.InMemoryShipmentRepository
+import com.unityinflow.sample.shipment.Shipment
+import com.unityinflow.sample.shipment.ShipmentStatus
+import org.springframework.stereotype.Service
+
+/** Coordinates state changes which span orders and shipments. */
+@Service
+class OrderShipmentCoordinator(
+    private val orderRepository: InMemoryOrderRepository,
+    private val shipmentRepository: InMemoryShipmentRepository,
+) {
+
+    @Synchronized
+    fun cancelOrder(orderId: String): Order {
+        val order = orderRepository.findById(orderId)
+            ?: throw ResourceNotFoundException(
+                ErrorCode.ORDER_NOT_FOUND,
+                "No order with id '$orderId'",
+            )
+
+        // Cancellation is idempotent, including for orders whose shipment state is later inspected.
+        if (order.status == OrderStatus.CANCELLED) return order
+
+        val shipments = shipmentRepository.findByOrderId(orderId)
+        if (shipments.any { it.status == ShipmentStatus.CONFIRMED }) {
+            throw ConflictException(
+                ErrorCode.ORDER_CANCELLATION_BLOCKED,
+                "Order '$orderId' cannot be cancelled because a shipment has been confirmed",
+            )
+        }
+
+        val cancelled = orderRepository.save(order.copy(status = OrderStatus.CANCELLED))
+        shipments
+            .filter { it.status == ShipmentStatus.CREATED }
+            .forEach { shipmentRepository.save(it.copy(status = ShipmentStatus.CANCELLED)) }
+        return cancelled
+    }
+
+    @Synchronized
+    fun createShipment(request: CreateShipmentRequest): Shipment {
+        if (shipmentRepository.existsById(request.shipmentId)) {
+            throw ConflictException(
+                ErrorCode.SHIPMENT_ALREADY_EXISTS,
+                "A shipment with id '${request.shipmentId}' already exists",
+            )
+        }
+
+        if (orderRepository.findById(request.orderId)?.status == OrderStatus.CANCELLED) {
+            throw ConflictException(
+                ErrorCode.ORDER_CANCELLED,
+                "A shipment cannot be created for cancelled order '${request.orderId}'",
+            )
+        }
+
+        return shipmentRepository.save(
+            Shipment(
+                shipmentId = request.shipmentId,
+                orderId = request.orderId,
+                carrier = request.carrier,
+                status = ShipmentStatus.CREATED,
+            ),
+        )
+    }
+}
