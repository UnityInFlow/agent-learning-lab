     fun findById(shipmentId: String): Shipment? = store[shipmentId]
 
+    /**
+     * Atomically confirms a shipment. Returning the existing value for a confirmed or
+     * cancelled shipment lets the controller apply the lifecycle rules without a
+     * read-then-write race.
+     */
+    fun confirm(shipmentId: String): Shipment? =
+        store.computeIfPresent(shipmentId) { _, shipment ->
