{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018za5WN51JbTTAjZxKGfgHL","type":"tool_result","content":"1\tpackage com.unityinflow.sample.api\n2\t\n3\timport org.springframework.http.HttpStatus\n4\t\n5\t/**\n6\t * Base class for every failure that is part of the API contract.\n7\t *\n8\t * A controller or service signals a failure by throwing one of these; the status code\n9\t * and the response body follow from the exception, in one place.\n10\t */\n11\tsealed class ApiException(\n12\t    val status: HttpStatus,\n13\t    val code: ErrorCode,\n14\t    override val message: String,\n15\t    val fields: List<FieldViolation> = emptyList(),\n16\t) : RuntimeException(message)\n17\t\n18\t/** The addressed resource does not exist → 404. */\n19\tclass ResourceNotFoundException(code: ErrorCode, message: String) :\n20\t    ApiException(HttpStatus.NOT_FOUND, code, message)\n21\t\n22\t/** The request conflicts with the current state of the resource → 409. */\n23\tclass ConflictException(code: ErrorCode, message: String) :\n24\t    ApiException(HttpStatus.CONFLICT, code, message)\n25\t\n26\t/** The request is well-formed but violates a rule of the domain → 400. */\n27\tclass ValidationException(\n28\t    message: String,\n29\t    fields: List<FieldViolation> = emptyList(),\n30\t) : ApiException(HttpStatus.BAD_REQUEST, ErrorCode.VALIDATION_FAILED, message, fields)\n31\t"}]},"parent_tool_use_id":null,"session_id":"d27270e6-2a71-4ed2-a4fd-b8dfd5a3794d","uuid":"9747f4f6-7c68-4be8-9edb-d430b551600c","timestamp":"2026-09-09T16:43:33.577Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/jr/lwzz65cx5pndqqdgzhnym1pc0000gn/T/observatory-run-4452e08a-4401-468c-b1b7-57c48d9c2f7b/sample-service/src/main/kotlin/com/unityinflow/sample/api/ApiExceptions.kt","content":"package com.unityinflow.sample.api\n\nimport org.springframework.http.HttpStatus\n\n/**\n * Base class for every failure that is part of the API contract.\n *\n * A controller or service signals a failure by throwing one of these; the status code\n * and the response body follow from the exception, in one place.\n */\nsealed class ApiException(\n    val status: HttpStatus,\n    val code: ErrorCode,\n    override val message: String,\n    val fields: List<FieldViolation> = emptyList(),\n) : RuntimeException(message)\n\n/** The addressed resource does not exist → 404. */\nclass ResourceNotFoundException(code: ErrorCode, message: String) :\n    ApiException(HttpStatus.NOT_FOUND, code, message)\n\n/** The request conflicts with the current state of the resource → 409. */\nclass ConflictException(code: ErrorCode, message: String) :\n    ApiException(HttpStatus.CONFLICT, code, message)\n\n/** The request is well-formed but violates a rule of the domain → 400. */\nclass ValidationException(\n    message: String,\n    fields: List<FieldViolation> = emptyList(),\n) : ApiException(HttpStatus.BAD_REQUEST, ErrorCode.VALIDATION_FAILED, message, fields)\n","numLines":31,"startLine":1,"totalLines":31}}}
