ckMvc.perform(get(\"/shipments/S-6\"))","+            .andExpect(status().isOk)","+            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))","+    }","+","+    @Test","+    fun `rejects confirm of non-existent shipment with 404 and error code`() {","+        mockMvc.perform(post(\"/shipments/S-missing/confirm\"))","+            .andExpect(status().isNotFound)","+            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))","+    }"," }"]}],"userModified":false,"replaceAll":false}}
