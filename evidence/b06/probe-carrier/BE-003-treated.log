{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016YtRYnKTikHNBNrqns5cBQ","type":"tool_result","content":"diff --git a/sample-service/src/test/kotlin/com/unityinflow/sample/shipment/ShipmentControllerTest.kt b/sample-service/src/test/kotlin/com/unityinflow/sample/shipment/ShipmentControllerTest.kt\nindex 64986b7..33694da 100644\n--- a/sample-service/src/test/kotlin/com/unityinflow/sample/shipment/ShipmentControllerTest.kt\n+++ b/sample-service/src/test/kotlin/com/unityinflow/sample/shipment/ShipmentControllerTest.kt\n@@ -81,4 +81,58 @@ class ShipmentControllerTest {\n             .andExpect(jsonPath(\"$[0].shipmentId\").value(\"S-a\"))\n             .andExpect(jsonPath(\"$[1].shipmentId\").value(\"S-b\"))\n     }\n+\n+    @Test\n+    fun `confirms a shipment and moves it from CREATED to CONFIRMED`() {\n+        mockMvc.perform(createShipment(\"S-4\")).andExpect(status().isCreated)\n+\n+        mockMvc.perform(post(\"/shipments/S-4/confirm\"))\n+            .andExpect(status().isOk)\n+            .andExpect(jsonPath(\"$.shipmentId\").value(\"S-4\"))\n+            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n+\n+        // Verify persistence: fetch and confirm status is CONFIRMED\n+        mockMvc.perform(get(\"/shipments/S-4\"))\n+            .andExpect(status().isOk)\n+            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n+    }\n+\n+    @Test\n+    fun `confirming an already confirmed shipment succeeds without change (idempotent)`() {\n+        mockMvc.perform(createShipment(\"S-5\")).andExpect(status().isCreated)\n+\n+        // First confirm\n+        mockMvc.perform(post(\"/shipments/S-5/confirm\"))\n+            .andExpect(status().isOk)\n+            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n+\n+        // Second confirm should also succeed\n+        mockMvc.perform(post(\"/shipments/S-5/confirm\"))\n+            .andExpect(status().isOk)\n+            .andExpect(jsonPath(\"$.status\").value(\"