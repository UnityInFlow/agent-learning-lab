itory.findById(orderId)\n            ?: throw ResourceNotFoundException(\n                ErrorCode.ORDER_NOT_FOUND,\n                \"No order with id '$orderId'\",\n            )\n\n    @GetMapping\n    fun list(): List<Order> = repository.findAll()\n}\n","structuredPatch":[{"oldStart":46,"oldLines":4,"newStart":46,"newLines":39,"lines":[" ","     @GetMapping","     fun list(): List<Order> = repository.findAll()","+","+    @PostMapping(\"/{orderId}/cancel\")","+    fun cancel(@PathVariable orderId: String): ResponseEntity<Order> {","+        val order = repository.findById(orderId)","+            ?: throw ResourceNotFoundException(","+                ErrorCode.ORDER_NOT_FOUND,","+                \"No order with id '$orderId'\",","+            )","+","+        // If already cancelled, return success without changes","+        if (order.status == OrderStatus.CANCELLED) {","+            return ResponseEntity.ok(order)","+        }","+","+        // Check if any shipment is CONFIRMED; if so, reject","+        val shipments = shipmentRepository.findByOrderId(orderId)","+        if (shipments.any { it.status == ShipmentStatus.CONFIRMED }) {","+            throw ConflictException(","+                ErrorCode.SHIPMENT_CONFIRMED,","+                \"Cannot cancel order '$orderId': a shipment is already confirmed\",","+            )","+        }","+","+        // Cancel the order and all its CREATED shipments","+        val cancelledOrder = order.copy(status = OrderStatus.CANCELLED)","+        repository.save(cancelledOrder)","+","+        for (shipment in shipments) {","+            if (shipment.status == ShipmentStatus.CREATED) {","+                shipmentRepository.save(shipment.copy(status = ShipmentStatus.CANCELLED))","+            }","+        }","+","+        return ResponseEntity.ok(cancelledOrder)","+    }"," }"]}],"userModified":false,"replaceAll":false}}
