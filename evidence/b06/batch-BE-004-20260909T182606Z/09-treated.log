pty)","+    }","+","+    @Test","+    fun `cancelling an order with mixed shipment statuses cancels only CREATED ones`() {","+        // Create order","+        mockMvc.perform(createOrder(\"O-10\")).andExpect(status().isCreated)","+","+        // Add a CREATED shipment","+        val createdShipment = Shipment(\"S-4\", \"O-10\", \"DHL\", ShipmentStatus.CREATED)","+        shipmentRepository.save(createdShipment)","+","+        // Add a CANCELLED shipment (already cancelled from before)","+        val cancelledShipment = Shipment(\"S-5\", \"O-10\", \"UPS\", ShipmentStatus.CANCELLED)","+        shipmentRepository.save(cancelledShipment)","+","+        // Cancel order","+        mockMvc.perform(post(\"/orders/O-10/cancel\").contentType(MediaType.APPLICATION_JSON))","+            .andExpect(status().isOk)","+","+        // Verify the CREATED shipment is now CANCELLED","+        mockMvc.perform(get(\"/shipments/S-4\"))","+            .andExpect(status().isOk)","+            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))","+","+        // Verify the already CANCELLED shipment is still CANCELLED","+        mockMvc.perform(get(\"/shipments/S-5\"))","+            .andExpect(status().isOk)","+            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))","+    }"," }"]}],"userModified":false,"replaceAll":false}}
