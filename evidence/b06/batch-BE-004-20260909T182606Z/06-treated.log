ED\"))","+","+        // Verify the CREATED shipment was cancelled","+        mockMvc.perform(get(\"/shipments/S-3\"))","+            .andExpect(status().isOk)","+            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))","+","+        // Verify the already-cancelled shipment is still cancelled","+        mockMvc.perform(get(\"/shipments/S-4\"))","+            .andExpect(status().isOk)","+            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))","+    }"," }"]}],"userModified":false,"replaceAll":false}}
