ndById(shipmentId: String): Shipment? = store[shipmentId]\n\n    fun findByOrderId(orderId: String): List<Shipment> =\n        store.values.filter { it.orderId == orderId }.sortedBy { it.shipmentId }\n\n    fun findAll(): List<Shipment> = store.values.sortedBy { it.shipmentId }\n\n    fun clear() = store.clear()\n}","originalFile":"package com.unityinflow.sample.shipment\n\nimport java.util.concurrent.ConcurrentHashMap\nimport org.springframework.stereotype.Repository\n\n/**\n * In-memory for the same reason as the order store: a benchmark fixture must start with\n * `./mvnw test` and no external infrastructure.\n */\n@Repository\nclass InMemoryShipmentRepository {\n\n    private val store = ConcurrentHashMap<String, Shipment>()\n\n    fun save(shipment: Shipment): Shipment {\n        store[shipment.shipmentId] = shipment\n        return shipment\n    }\n\n    fun existsById(shipmentId: String): Boolean = store.containsKey(shipmentId)\n\n    fun findById(shipmentId: String): Shipment? = store[shipmentId]\n\n    fun findAll(): List<Shipment> = store.values.sortedBy { it.shipmentId }\n\n    fun clear() = store.clear()\n}\n","structuredPatch":[{"oldStart":21,"oldLines":6,"newStart":21,"newLines":9,"lines":[" ","     fun findById(shipmentId: String): Shipment? = store[shipmentId]"," ","+    fun findByOrderId(orderId: String): List<Shipment> =","+        store.values.filter { it.orderId == orderId }.sortedBy { it.shipmentId }","+","     fun findAll(): List<Shipment> = store.values.sortedBy { it.shipmentId }"," ","     fun clear() = store.clear()"]}],"userModified":false,"replaceAll":false}}
