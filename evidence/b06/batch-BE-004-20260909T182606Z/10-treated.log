ockMvc.perform(\n            post(\"/orders/O-cancel/cancel\")\n                .contentType(MediaType.APPLICATION_JSON),\n        )\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.orderId\").value(\"O-cancel\"))\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n            .andReturn()\n\n        // Verify through a separate GET that order is CANCELLED\n        mockMvc.perform(get(\"/orders/O-cancel\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n\n        // Verify through a separate GET that shipment is now CANCELLED\n        mockMvc.perform(get(\"/shipments/S-1\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n    }\n\n    @Test\n    fun `cancel order with CONFIRMED shipment returns 409 and changes nothing`() {\n        // Create order\n        mockMvc.perform(createOrder(\"O-confirm-test\"))\n            .andExpect(status().isCreated)\n\n        // Create a CONFIRMED shipment for the order\n        shipmentRepository.save(\n            Shipment(\n                shipmentId = \"S-confirm\",\n                orderId = \"O-confirm-test\",\n                carrier = \"DHL\",\n                status = ShipmentStatus.CONFIRMED,\n            ),\n        )\n\n        // Attempt to cancel the order - should fail with 409\n        mockMvc.perform(\n            post(\"/orders/O-confirm-test/cancel\")\n                .contentType(MediaType.APPLICATION_JSON),\n        )\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_CANNOT_CANCEL\"))\n            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n\n        // Verify through a separate GET that order is still ACTIVE\n        mockMvc.perform(get(\"/orders/O-confirm-test\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"ACTIVE\"))\n\n        // Verify through a separate GET that shipment is still CONFIRMED\n        mockMvc.perform(get(\"/shipments/S-confirm\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n    }\n\n    @Test\n    fun `cancel already CANCELLED order succeeds and is idempotent`() {\n        // Create order\n        mockMvc.perform(createOrder(\"O-idempotent\"))\n            .andExpect(status().isCreated)\n\n        // Cancel it once\n        mockMvc.perform(\n            post(\"/orders/O-idempotent/cancel\")\n                .contentType(MediaType.APPLICATION_JSON),\n        )\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n\n        // Cancel it again - should still succeed\n        mockMvc.perform(\n            post(\"/orders/O-idempotent/cancel\")\n                .contentType(MediaType.APPLICATION_JSON),\n        )\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n\n        // Verify through a separate GET that order is still CANCELLED\n        mockMvc.perform(get(\"/orders/O-idempotent\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n    }\n\n    @Test\n    fun `cancel non-existent order returns 404`() {\n        mockMvc.perform(\n            post(\"/orders/O-not-found/cancel\")\n                .contentType(MediaType.APPLICATION_JSON),\n        )\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_NOT_FOUND\"))\n            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n    }\n\n    @Test\n    fun `create shipment on CANCELLED order returns 409`() {\n        // Create order\n        mockMvc.perform(createOrder(\"O-cancelled\"))\n            .andExpect(status().isCreated)\n\n        // Cancel the order\n        mockMvc.perform(\n            post(\"/orders/O-cancelled/cancel\")\n                .contentType(MediaType.APPLICATION_JSON),\n        )\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n\n        // Try to create a shipment for the cancelled order\n        mockMvc.perform(\n            post(\"/shipments\")\n                .contentType(MediaType.APPLICATION_JSON)\n                .content(\n                    \"\"\"{\"shipmentId\":\"S-bad\",\"orderId\":\"O-cancelled\",\"carrier\":\"UPS\"}\"\"\",\n                ),\n        )\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_CANCELLED\"))\n            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n\n        // Verify through a separate GET that no shipment was created\n        mockMvc.perform(get(\"/shipments\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$\").isArray)\n            .andExpect(jsonPath(\"$.length()\").value(0))\n    }\n}","originalFile":"package com.unityinflow.sample.order\n\nimport org.junit.jupiter.api.BeforeEach\nimport org.junit.jupiter.api.Test\nimport org.springframework.beans.factory.annotation.Autowired\nimport org.springframework.boot.test.context.SpringBootTest\nimport org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc\nimport org.springframework.http.MediaType\nimport org.springframework.test.web.servlet.MockMvc\nimport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get\nimport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post\nimport org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath\nimport org.springframework.test.web.servlet.result.MockMvcResultMatchers.status\n\n/**\n * Baseline behaviour of the order feature. BE-002 must not break any of these.\n *\n * Note how the failure cases assert the response *body*, not just the status: the error\n * envelope is part of the API contract, so a change that returns t