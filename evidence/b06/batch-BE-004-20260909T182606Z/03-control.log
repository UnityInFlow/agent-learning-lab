          .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n\n        // Verify the shipment is now cancelled\n        mockMvc.perform(get(\"/shipments/S-1\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n    }\n\n    @Test\n    fun `cancel already cancelled order is idempotent`() {\n        mockMvc.perform(createOrder(\"O-5\")).andExpect(status().isCreated)\n\n        // Cancel the order\n        mockMvc.perform(post(\"/orders/O-5/cancel\")).andExpect(status().isOk)\n\n        // Cancel again, should still succeed\n        mockMvc.perform(post(\"/orders/O-5/cancel\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n    }\n\n    @Test\n    fun `cancel order blocked by confirmed shipment changes nothing`() {\n        mockMvc.perform(createOrder(\"O-6\")).andExpect(status().isCreated)\n\n        // Create a CONFIRMED shipment directly in the repository\n        shipmentRepository.save(\n            Shipment(\n                shipmentId = \"S-2\",\n                orderId = \"O-6\",\n                carrier = \"UPS\",\n                status = ShipmentStatus.CONFIRMED,\n            ),\n        )\n\n        // Attempt to cancel should fail\n        mockMvc.perform(post(\"/orders/O-6/cancel\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_CONFIRMED\"))\n\n        // Verify order is still ACTIVE\n        mockMvc.perform(get(\"/orders/O-6\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"ACTIVE\"))\n\n        // Verify shipment is still CONFIRMED\n        mockMvc.perform(get(\"/shipments/S-2\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n    }\n\n    @Test\n    fun `cancel non-existent order returns 404`() {\n        mockMvc.perform(post(\"/orders/does-not-exist/cancel\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_NOT_FOUND\"))\n            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n    }\n}"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":1259,"cache_read_input_tokens":32707,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1259},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"cd0a0a31-c8f9-4034-bbc8-5a421c2528b1","uuid":"b50f4c18-ec27-4f0f-b720-e87bdacb4b35","timestamp":"2026-09-09T18:45:36.945Z","request_id":"req_011CetMudcn74DTdzhp9dnmT"}
