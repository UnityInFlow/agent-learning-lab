multiple shipments: one created, one confirmed (already in system)\n        shipmentRepository.save(\n            Shipment(\"S-created-1\", \"O-cascade\", \"DHL\", ShipmentStatus.CREATED),\n        )\n        shipmentRepository.save(\n            Shipment(\"S-created-2\", \"O-cascade\", \"FedEx\", ShipmentStatus.CREATED),\n        )\n        shipmentRepository.save(\n            Shipment(\"S-confirmed-1\", \"O-cascade\", \"UPS\", ShipmentStatus.CONFIRMED),\n        )\n\n        // Cancel the order (this should succeed because no CONFIRMED shipments at time of cancel)\n        mockMvc.perform(cancelOrder(\"O-cascade\"))\n            .andExpect(status().isOk)\n\n        // Verify CREATED shipments are now CANCELLED\n        mockMvc.perform(get(\"/shipments/S-created-1\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n\n        mockMvc.perform(get(\"/shipments/S-created-2\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n\n        // Verify CONFIRMED shipment is still CONFIRMED (was already confirmed, not affected by cancel)\n        mockMvc.perform(get(\"/shipments/S-confirmed-1\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n    }\n}","originalFile":"package com.unityinflow.sample.order\n\nimport org.junit.jupiter.api.BeforeEach\nimport org.junit.jupiter.api.Test\nimport org.springframework.beans.factory.annotation.Autowired\nimport org.springframework.boot.test.context.SpringBootTest\nimport org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc\nimport org.springframework.http.MediaType\nimport org.springframework.test.web.servlet.MockMvc\nimport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get\nimport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post\nimport org.springframework.test.web.servlet.result.MockMvcResult