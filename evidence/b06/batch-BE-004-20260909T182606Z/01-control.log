einit var mockMvc: MockMvc\n\n    @Autowired\n    lateinit var repository: InMemoryOrderRepository\n\n    @BeforeEach\n    fun reset() = repository.clear()\n\n    private fun createOrder(orderId: String, amount: String = \"49.90\") =\n        post(\"/orders\")\n            .contentType(MediaType.APPLICATION_JSON)\n            .content(\n                \"\"\"{\"orderId\":\"$orderId\",\"customerId\":\"C-1\",\"amount\":$amount,\"currency\":\"EUR\"}\"\"\",\n            )\n\n    @Test\n    fun `creates an order and returns 201`() {\n        mockMvc.perform(createOrder(\"O-1\"))\n            .andExpect(status().isCreated)\n            .andExpect(jsonPath(\"$.orderId\").value(\"O-1\"))\n    }\n\n    @Test\n    fun `reads back a created order`() {\n        mockMvc.perform(createOrder(\"O-2\")).andExpect(status().isCreated)\n\n        mockMvc.perform(get(\"/orders/O-2\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.currency\").value(\"EUR\"))\n    }\n\n    @Test\n    fun `returns 404 with the error envelope for an unknown order`() {\n        mockMvc.perform(get(\"/orders/does-not-exist\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_NOT_FOUND\"))\n            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n    }\n\n    @Test\n    fun `returns 409 with the error envelope for a duplicate order id`() {\n        mockMvc.perform(createOrder(\"O-3\")).andExpect(status().isCreated)\n\n        mockMvc.perform(createOrder(\"O-3\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_ALREADY_EXISTS\"))\n            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n    }\n}","newString":"package com.unityinflow.sample.order\n\nimport com.unityinflow.sample.shipment.InMemoryShipmentRepository\nimport com.unityinflow.sample.shipment.Shipment\nimport com.unityinflow.sample.shipment.ShipmentStatus\nimport org.junit.jupiter.api.BeforeEach\nimport org.junit.jupiter.api.Test\nimport org.springframework.beans.factory.annotation.Autowired\nimport org.springframework.boot.test.context.SpringBootTest\nimport org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc\nimport org.springframework.http.MediaType\nimport org.springframework.test.web.servlet.MockMvc\nimport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get\nimport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post\nimport org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath\nimport org.springframework.test.web.servlet.result.MockMvcResultMatchers.status\n\n/**\n * Baseline behaviour of the order feature. BE-002 must not break any of these.\n *\n * Note how the failure cases assert the response *body*, not just the status: the error\n * envelope is part of the API contract, so a change that returns the right status with\n * the wrong shape is a breaking change for clients.\n */\n@SpringBootTest\n@AutoConfigureMockMvc\nclass OrderControllerTest {\n\n    @Autowired\n    lateinit var mockMvc: MockMvc\n\n    @Autowired\n    lateinit var repository: InMemoryOrderRepository\n\n    @Autowired\n    lateinit var shipmentRepository: InMemoryShipmentRepository\n\n    @BeforeEach\n    fun reset() {\n        repository.clear()\n        shipmentRepository.clear()\n    }\n\n    private fun createOrder(orderId: String, amount: String = \"49.90\") =\n        post(\"/orders\")\n            .contentType(MediaType.APPLICATION_JSON)\n            .content(\n                \"\"\"{\"orderId\":\"$orderId\",\"customerId\":\"C-1\",\"amount\":$amount,\"currency\":\"EUR\"}\"\"\",\n            )\n\n    private fun cancelOrder(orderId: String) =\n        post(\"/orders/$orderId/cancel\")\n            .contentType(MediaType.APPLICATION_JSON)\n\n    @Test\n    fun `creates an order and returns 201`() {\n        mockMvc.perform(createOrder(\"O-1\"))\n            .andExpect(status().isCreated)\n            .andExpect(jsonPath(\"$.orderId\").value(\"O-1\"))\n    }\n\n    @Test\n    fun `reads back a created order`() {\n        mockMvc.perform(createOrder(\"O-2\")).andExpect(status().isCreated)\n\n        mockMvc.perform(get(\"/orders/O-2\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.currency\").value(\"EUR\"))\n    }\n\n    @Test\n    fun `returns 404 with the error envelope for an unknown order`() {\n        mockMvc.perform(get(\"/orders/does-not-exist\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_NOT_FOUND\"))\n            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n    }\n\n    @Test\n    fun `returns 409 with the error envelope for a duplicate order id`() {\n        mockMvc.perform(createOrder(\"O-3\")).andExpect(status().isCreated)\n\n        mockMvc.perform(createOrder(\"O-3\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_ALREADY_EXISTS\"))\n            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n    }\n\n    @Test\n    fun `creates an order with ACTIVE status`() {\n        mockMvc.perform(createOrder(\"O-4\"))\n            .andExpect(status().isCreated)\n            .andExpect(jsonPath(\"$.status\").value(\"ACTIVE\"))\n    }\n\n    @Test\n    fun `cancels an active order and returns it with CANCELLED status`() {\n        mockMvc.perform(createOrder(\"O-5\")).andExpect(status().isCreated)\n\n        mockMvc.perform(cancelOrder(\"O-5\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.orderId\").value(\"O-5\"))\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n    }\n\n    @Test\n    fun `cancels all CREATED shipments when cancelling an active order`() {\n        mockMvc.perform(createOrder(\"O-6\")).andExpect(status().isCreated)\n\n        // Create two shipments for the order\n        shipmentRepository.save(Shipment(\"S-1\", \"O-6\", \"DHL\", ShipmentStatus.CREATED))\n        shipmentRepository.save(Shipment(\"S-2\", \"O-6\", \"FedEx\", ShipmentStatus.CREATED))\n\n        // Cancel the order\n        mockMvc.perform(cancelOrder(\"O-6\"))\n            .andExpect(status().isOk)\n\n        // Verify both shipments are now cancelled\n        val shipments = shipmentRepository.findByOrderId(\"O-6\")\n        assert(shipments.all { it.status == ShipmentStatus.CANCELLED })\n    }\n\n    @Test\n    fun `cancelling an already cancelled order succeeds and changes nothing`() {\n        mockMvc.perform(createOrder(\"O-7\")).andExpect(status().isCreated)\n\n        // First cancel\n        mockMvc.perform(cancelOrder(\"O-7\"))\n            .andExpect(status().isOk)\n\n        // Second cancel (should succeed due to idempotency)\n        mockMvc.perform(cancelOrder(\"O-7\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n    }\n\n    @Test\n    fun `returns 409 when trying to cancel an order with a CONFIRMED shipment`() {\n        mockMvc.perform(createOrder(\"O-8\")).andExpect(status().isCreated)\n\n        // Create a confirmed shipment\n        shipmentRepository.save(Shipment(\"S-3\", \"O-8\", \"DHL\", ShipmentStatus.CONFIRMED))\n\n        // Try to cancel the order\n        mockMvc.perform(cancelOrder(\"O-8\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_HAS_CONFIRMED_SHIPMENT\"))\n    }\n\n    @Test\n    fun `order stays ACTIVE when cancel fails due to confirmed shipment`() {\n        mockMvc.perform(createOrder(\"O-9\")).andExpect(status().isCreated)\n\n        // Create a confirmed shipment\n        shipmentRepository.save(Shipment(\"S-4\", \"O-9\", \"DHL\", ShipmentStatus.CONFIRMED))\n\n        // Try to cancel the order (fails)\n        mockMvc.perform(cancelOrder(\"O-9\"))\n            .andExpect(status().isConflict)\n\n        // Verify order is still ACTIVE\n        mockMvc.perform(get(\"/orders/O-9\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"ACTIVE\"))\n    }\n\n    @Test\n    fun `returns 404 when cancelling a non-existent order`() {\n        mockMvc.perform(cancelOrder(\"O-does-not-exist\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_NOT_FOUND\"))\n            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n    }\n}","originalFile":"package com.unityinflow.sample.order\n\nimport org.junit.jupiter.api.BeforeEach\nimport org.junit.jupiter.api.Test\nimport org.springframework.beans.factory.annotation.Autowired\nimport org.springframework.boot.test.context.SpringBootTest\nimport org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc\nimport org.springframework.http.MediaType\nimport org.springframework.test.web.servlet.MockMvc\nimport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get\nimport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post\nimport org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath\nimport org.springframework.test.web.servlet.result.MockMvcResultMatchers.status\n\n/**\n * Baseline behaviour of the order feature. BE-002 must not break any of these.\n *\n * Note how the failure cases assert the response *body*, not just the status: the error\n * envelope is part of the API contract, so a change that returns the right status with\n * the wrong shape is a breaking change for clients.\n */\n@SpringBootTest\n@AutoConfigureMockMvc\nclass OrderControllerTest {\n\n    @Autowired\n    lateinit var mockMvc: MockMvc\n\n    @Autowired\n    lateinit var repository: InMemoryOrderRepository\n\n    @BeforeEach\n    fun reset() = repository.clear()\n\n    private fun createOrder(orderId: String, amount: String = \"49.90\") =\n        post(\"/orders\")\n            .contentType(MediaType.APPLICATION_JSO