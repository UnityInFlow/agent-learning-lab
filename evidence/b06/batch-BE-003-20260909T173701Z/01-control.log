eShipment(\"S-5\")).andExpect(status().isCreated)\n\n        // First confirm\n        mockMvc.perform(\n            post(\"/shipments/S-5/confirm\")\n                .contentType(MediaType.APPLICATION_JSON),\n        )\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n\n        // Second confirm should succeed and change nothing\n        mockMvc.perform(\n            post(\"/shipments/S-5/confirm\")\n                .contentType(MediaType.APPLICATION_JSON),\n        )\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n    }\n\n    @Test\n    fun `rejects confirming a CANCELLED shipment with 409 and error code`() {\n        // Create and immediately set status to CANCELLED directly in repository\n        repository.save(\n            Shipment(\n                shipmentId = \"S-cancelled\",\n                orderId = \"O-1\",\n                carrier = \"DHL\",\n                status = ShipmentStatus.CANCELLED,\n            ),\n        )\n\n        mockMvc.perform(\n            post(\"/shipments/S-cancelled/confirm\")\n                .contentType(MediaType.APPLICATION_JSON),\n        )\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_CANNOT_CONFIRM\"))\n            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n    }\n\n    @Test\n    fun `rejects confirming a non-existent shipment with 404 and error code`() {\n        mockMvc.perform(\n            post(\"/shipments/S-missing/confirm\")\n                .contentType(MediaType.APPLICATION_JSON),\n        )\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n    }\n}"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_toke