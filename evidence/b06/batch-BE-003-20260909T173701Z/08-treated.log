nPath(\"$.status\").value(\"CONFIRMED\"))\n    }\n\n    @Test\n    fun `idempotently confirms an already confirmed shipment`() {\n        mockMvc.perform(createShipment(\"S-idempotent\"))\n            .andExpect(status().isCreated)\n\n        // First confirm\n        mockMvc.perform(post(\"/shipments/S-idempotent/confirm\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n\n        // Second confirm (idempotent)\n        mockMvc.perform(post(\"/shipments/S-idempotent/confirm\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n\n        // Verify state is unchanged\n        mockMvc.perform(get(\"/shipments/S-idempotent\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n    }\n\n    @Test\n    fun `rejects confirming a cancelled shipment with 409`() {\n        // Create and manually set to CANCELLED\n        val shipment = Shipment(\n            shipmentId = \"S-cancelled\",\n            orderId = \"O-1\",\n            carrier = \"DHL\",\n            status = ShipmentStatus.CANCELLED,\n        )\n        repository.save(shipment)\n\n        mockMvc.perform(post(\"/shipments/S-cancelled/confirm\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_CANNOT_BE_CONFIRMED\"))\n\n        // Verify state is unchanged\n        mockMvc.perform(get(\"/shipments/S-cancelled\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n    }\n\n    @Test\n    fun `rejects confirming a nonexistent shipment with 404`() {\n        mockMvc.perform(post(\"/shipments/S-missing/confirm\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n    }\n}"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"sto