irm\n        mockMvc.perform(post(\"/shipments/S-5/confirm\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n\n        // Second confirm (retry)\n        mockMvc.perform(post(\"/shipments/S-5/confirm\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n    }\n\n    @Test\n    fun `rejects confirming a CANCELLED shipment with HTTP 409`() {\n        // Manually create a CANCELLED shipment in the repository\n        val cancelledShipment = Shipment(\n            shipmentId = \"S-cancelled\",\n            orderId = \"O-1\",\n            carrier = \"DHL\",\n            status = ShipmentStatus.CANCELLED,\n        )\n        repository.save(cancelledShipment)\n\n        mockMvc.perform(post(\"/shipments/S-cancelled/confirm\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_CANNOT_BE_CONFIRMED\"))\n    }\n\n    @Test\n    fun `rejects confirming a non-existent shipment with HTTP 404`() {\n        mockMvc.perform(post(\"/shipments/S-nonexistent/confirm\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n    }\n}"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":658,"cache_read_input_tokens":20980,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":658},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"6f864608-db16-4eea-8cf4-d1ae7f0d6069","uuid":"7bf1cc40-b3e8-4afc-ac03-de4b61b2180b","timestamp":"2026-09-09T17:50:14.766Z","request_id":"req_011CetHgtfKyCUJPSfs1ibdD"}
