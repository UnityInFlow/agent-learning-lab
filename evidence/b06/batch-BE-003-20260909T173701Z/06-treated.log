        mockMvc.perform(get(\"/shipments/S-6\"))","+            .andExpect(status().isOk)","+            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))","+    }","+","+    @Test","+    fun `rejects confirming unknown shipment with 404`() {","+        mockMvc.perform(post(\"/shipments/S-unknown/confirm\"))","+            .andExpect(status().isNotFound)","+            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))","+    }"," }"]}],"userModified":false,"replaceAll":false}}
