ect(jsonPath(\"$.shipmentId\").value(\"S-1\"))\n46\t            .andExpect(jsonPath(\"$.status\").value(\"CREATED\"))\n47\t    }\n48\t\n49\t    @Test\n50\t    fun `rejects a duplicate shipment id with the error envelope`() {\n51\t        mockMvc.perform(createShipment(\"S-2\")).andExpect(status().isCreated)\n52\t\n53\t        mockMvc.perform(createShipment(\"S-2\"))\n54\t            .andExpect(status().isConflict)\n55\t            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_ALREADY_EXISTS\"))\n56\t    }\n57\t\n58\t    @Test\n59\t    fun `returns a shipment by id`() {\n60\t        mockMvc.perform(createShipment(\"S-3\")).andExpect(status().isCreated)\n61\t\n62\t        mockMvc.perform(get(\"/shipments/S-3\"))\n63\t            .andExpect(status().isOk)\n64\t            .andExpect(jsonPath(\"$.carrier\").value(\"DHL\"))\n65\t    }\n66\t\n67\t    @Test\n68\t    fun `reports an unknown shipment through the error envelope`() {\n69\t        mockMvc.perform(get(\"/shipments/S-missing\"))\n70\t            .andExpect(status().isNotFound)\n71\t            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n72\t    }\n73\t\n74\t    @Test\n75\t    fun `lists shipments in id order`() {\n76\t        mockMvc.perform(createShipment(\"S-b\")).andExpect(status().isCreated)\n77\t        mockMvc.perform(createShipment(\"S-a\")).andExpect(status().isCreated)\n78\t\n79\t        mockMvc.perform(get(\"/shipments\"))\n80\t            .andExpect(status().isOk)\n81\t            .andExpect(jsonPath(\"$[0].shipmentId\").value(\"S-a\"))\n82\t            .andExpect(jsonPath(\"$[1].shipmentId\").value(\"S-b\"))\n83\t    }\n84\t\n85\t    @Test\n86\t    fun `confirms a created shipment and persists it`() {\n87\t        mockMvc.perform(createShipment(\"S-4\")).andExpect(status().isCreated)\n88\t\n89\t        // Confirm the shipment\n90\t        mockMvc.perform(post(\"/shipments/S-4/confirm\"))\n91\t            .andExpect(status().isOk)\n92\t            .andExpect(jsonPath(\"$.shipmentId\").value(\"S-4\"))\n93\t            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n94\t\n95\t        // Verify it was persisted as CONFIRMED\n96\t        mockMvc.perform(get(\"/shipments/S-4\"))\n97\t            .andExpect(status().isOk)\n98\t            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n99\t            .andExpect(jsonPath(\"$.carrier\").value(\"DHL\"))\n100\t    }\n101\t\n102\t    @Test\n103\t    fun `confirm is idempotent for already confirmed shipment`() {\n104\t        mockMvc.perform(createShipment(\"S-5\")).andExpect(status().isCreated)\n105\t\n106\t        // First confirm\n107\t        mockMvc.perform(post(\"/shipments/S-5/confirm\"))\n108\t            .andExpect(status().isOk)\n109\t            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n110\t\n111\t        // Second confirm succeeds\n112\t        mockMvc.perform(post(\"/shipments/S-5/confirm\"))\n113\t            .andExpect(status().isOk)\n114\t            .andExpect(jsonPath(\"$.shipmentId\").value(\"S-5\"))\n115\t            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n116\t\n117\t        // Verify state is still CONFIRMED\n118\t        mockMvc.perform(get(\"/shipments/S-5\"))\n119\t            .andExpect(status().isOk)\n120\t            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n121\t    }\n122\t\n123\t    @Test\n124\t    fun `confirms a cancelled shipment is rejected with conflict`() {\n125\t        // Create and immediately save a CANCELLED shipment directly to the repository\n126\t        repository.save(Shipment(\"S-6\", \"O-1\", \"DHL\", ShipmentStatus.CANCELLED))\n127\t\n128\t        // Attempt to confirm\n129\t        mockMvc.perform(post(\"/shipments/S-6/confirm\"))\n130\t            .andExpect(status().isConflict)\n131\t            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_CANCELLED\"))\n132\t\n133\t        // Verify it is still CANCELLED\n134\t        mockMvc.perform(get(\"/shipments/S-6\"))\n135\t            .andExpect(status().isOk)\n136\t            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n137\t    }\n138\t\n139\t    @Test\n140\t    fun `confirms an unknown shipment is rejected with not found`() {\n141\t        mockMvc.perform(post(\"/shipments/S-unknown/confirm\"))\n142\t            .andExpect(status().isNotFound)\n143\t            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n144\t    }\n145\t}\n146\t"}]},"parent_tool_use_id":null,"session_id":"f367e145-8b2a-4a98-8d7f-dd1384f85bfe","uuid":"c5e1ad2d-19ce-456e-9769-035bb84c5948","timestamp":"2026-09-09T18:17:36.378Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/jr/lwzz65cx5pndqqdgzhnym1pc0000gn/T/observatory-run-c253656e-47d3-4bfb-8410-d478b8978f08/sample-service/src/test/kotlin/com/unityinflow/sample/shipment/ShipmentControllerTest.kt","content":"package com.unityinflow.sample.shipment\n\nimport org.junit.jupiter.api.BeforeEach\nimport org.junit.jupiter.api.Test\nimport org.springframework.beans.factory.annotation.Autowired\nimport org.springframework.boot.test.context.SpringBootTest\nimport org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc\nimport org.springframework.http.MediaType\nimport org.springframework.test.web.servlet.MockMvc\nimport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get\nimport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post\nimport org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath\nimport org.springframework.test.web.servlet.result.MockMvcResultMatchers.status\n\n/**\n * The shipment feature as it exists before BE-003.\n *\n * These are \"the existing tests\" for that benchmark: they must keep passing, and an agent\n * that breaks one has regressed the fixture rather than solved the task.\n */\n@SpringBootTest\n@AutoConfigureMockMvc\nclass ShipmentControllerTest {\n\n    @Autowired\n    lateinit var mockMvc: MockMvc\n\n    @Autowired\n    lateinit var repository: InMemoryShipmentRepository\n\n    @BeforeEach\n    fun reset() = repository.clear()\n\n    private fun createShipment(shipmentId: String) =\n        post(\"/shipments\")\n            .contentType(MediaType.APPLICATION_JSON)\n            .content(\n                \"\"\"{\"shipmentId\":\"$shipmentId\",\"orderId\":\"O-1\",\"carrier\":\"DHL\"}\"\"\",\n            )\n\n    @Test\n    fun `creates a shipment in CREATED status`() {\n        mockMvc.perform(createShipment(\"S-1\"))\n            .andExpect(status().isCreated)\n            .andExpect(jsonPath(\"$.shipmentId\").value(\"S-1\"))\n            .andExpect(jsonPath(\"$.status\").value(\"CREATED\"))\n    }\n\n    @Test\n    fun `rejects a duplicate shipment id with the error envelope`() {\n        mockMvc.perform(createShipment(\"S-2\")).andExpect(status().isCreated)\n\n        mockMvc.perform(createShipment(\"S-2\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_ALREADY_EXISTS\"))\n    }\n\n    @Test\n    fun `returns a shipment by id`() {\n        mockMvc.perform(createShipment(\"S-3\")).andExpect(status().isCreated)\n\n        mockMvc.perform(get(\"/shipments/S-3\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.carrier\").value(\"DHL\"))\n    }\n\n    @Test\n    fun `reports an unknown shipment through the error envelope`() {\n        mockMvc.perform(get(\"/shipments/S-missing\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n    }\n\n    @Test\n    fun `lists shipments in id order`() {\n        mockMvc.perform(createShipment(\"S-b\")).andExpect(status().isCreated)\n        mockMvc.perform(createShipment(\"S-a\")).andExpect(status().isCreated)\n\n        mockMvc.perform(get(\"/shipments\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$[0].shipmentId\").value(\"S-a\"))\n            .andExpect(jsonPath(\"$[1].shipmentId\").value(\"S-b\"))\n    }\n\n    @Test\n    fun `confirms a created shipment and persists it`() {\n        mockMvc.perform(createShipment(\"S-4\")).andExpect(status().isCreated)\n\n        // Confirm the shipment\n        mockMvc.perform(post(\"/shipments/S-4/confirm\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.shipmentId\").value(\"S-4\"))\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n\n        // Verify it was persisted as CONFIRMED\n        mockMvc.perform(get(\"/shipments/S-4\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n            .andExpect(jsonPath(\"$.carrier\").value(\"DHL\"))\n    }\n\n    @Test\n    fun `confirm is idempotent for already confirmed shipment`() {\n        mockMvc.perform(createShipment(\"S-5\")).andExpect(status().isCreated)\n\n        // First confirm\n        mockMvc.perform(post(\"/shipments/S-5/confirm\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n\n        // Second confirm succeeds\n        mockMvc.perform(post(\"/shipments/S-5/confirm\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.shipmentId\").value(\"S-5\"))\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n\n        // Verify state is still CONFIRMED\n        mockMvc.perform(get(\"/shipments/S-5\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n    }\n\n    @Test\n    fun `confirms a cancelled shipment is rejected with conflict`() {\n        // Create and immediately save a CANCELLED shipment directly to the repository\n        repository.save(Shipment(\"S-6\", \"O-1\", \"DHL\", ShipmentStatus.CANCELLED))\n\n        // Attempt to confirm\n        mockMvc.perform(post(\"/shipments/S-6/confirm\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_CANCELLED\"))\n\n        // Verify it is still CANCELLED\n        mockMvc.perform(get(\"/shipments/S-6\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n    }\n\n    @Test\n    fun `confirms an unknown shipment is rejected with not found`() {\n        mockMvc.perform(post(\"/shipments/S-unknown/confirm\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n    }\n}\n","numLines":146,"startLine":1,"totalLines":146}}}
