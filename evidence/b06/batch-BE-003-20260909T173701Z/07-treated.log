tatus.CANCELLED,\n        )\n        repository.save(cancelledShipment)\n\n        // Attempt to confirm\n        mockMvc.perform(post(\"/shipments/S-cancelled/confirm\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_CANNOT_CONFIRM_CANCELLED\"))\n\n        // Verify state is unchanged (still CANCELLED)\n        mockMvc.perform(get(\"/shipments/S-cancelled\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n    }\n\n    @Test\n    fun `rejects confirming non-existent shipment with 404 not found`() {\n        mockMvc.perform(post(\"/shipments/S-missing/confirm\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n    }\n}","originalFile":"package com.unityinflow.sample.shipment\n\nimport org.junit.jupiter.api.BeforeEach\nimport org.junit.jupiter.api.Test\nimport org.springframework.beans.factory.annotation.Autowired\nimport org.springframework.boot.test.context.SpringBootTest\nimport org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc\nimport org.springframework.http.MediaType\nimport org.springframework.test.web.servlet.MockMvc\nimport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get\nimport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post\nimport org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath\nimport org.springframework.test.web.servlet.result.MockMvcResultMatchers.status\n\n/**\n * The shipment feature as it exists before BE-003.\n *\n * These are \"the existing tests\" for that benchmark: they must keep passing, and an agent\n * that breaks one has regressed the fixture rather than solved the task.\n */\n@SpringBootTest\n@AutoConfigureMockMvc\nclass ShipmentControllerTest {\n\n    @Autowired\n    lateinit var mockMvc: MockMvc\n\n    @Autowired\n    lateinit var repository: InMemoryShipmentRepository\n\n    @BeforeEach\n    fun reset() = repository.clear()\n\n    private fun createShipment(shipmentId: String) =\n        post(\"/shipments\")\n            .contentType(MediaType.APPLICATION_JSON)\n            .content(\n                \"\"\"{\"shipmentId\":\"$shipmentId\",\"orderId\":\"O-1\",\"carrier\":\"DHL\"}\"\"\",\n            )\n\n    @Test\n    fun `creates a shipment in CREATED status`() {\n        mockMvc.perform(createShipment(\"S-1\"))\n            .andExpect(status().isCreated)\n            .andExpect(jsonPath(\"$.shipmentId\").value(\"S-1\"))\n            .andExpect(jsonPath(\"$.status\").value(\"CREATED\"))\n    }\n\n    @Test\n    fun `rejects a duplicate shipment id with the error envelope`() {\n        mockMvc.perform(createShipment(\"S-2\")).andExpect(status().isCreated)\n\n        mockMvc.perform(createShipment(\"S-2\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_ALREADY_EXISTS\"))\n    }\n\n    @Test\n    fun `returns a shipment by id`() {\n        mockMvc.perform(createShipment(\"S-3\")).andExpect(status().isCreated)\n\n        mockMvc.perform(get(\"/shipments/S-3\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.carrier\").value(\"DHL\"))\n    }\n\n    @Test\n    fun `reports an unknown shipment through the error envelope`() {\n        mockMvc.perform(get(\"/shipments/S-missing\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n    }\n\n    @Test\n    fun `lists shipments in id order`() {\n        mockMvc.perform(createShipment(\"S-b\")).andExpect(status().isCreated)\n        mockMvc.perform(createShipment(\"S-a\")).andExpect(status().isCreated)\n\n        mockMvc.perform(get(\"/shipments\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$[0].shipmentId\").value(\"S-a\"))\n            .andExpect(jsonPath(\"$[1].shipmentId\").value(\"S-b\"))\n    }\n}\n","structuredPatch":[{"oldStart":81,"oldLines":4,"newStart":81,"newLines":79,"lines":["             .andExpect(jsonPath(\"$[0].shipmentId\").value(\"S-a\"))","             .andExpect(jsonPath(\"$[1].shipmentId\").value(\"S-b\"))","     }","+","+    @Test","+    fun `confirms a created shipment and returns it with CONFIRMED status`() {","+        // Create a shipment in CREATED status","+        mockMvc.perform(createShipment(\"S-confirm-1\")).andExpect(status().isCreated)","+","+        // Confirm the shipment","+        mockMvc.perform(post(\"/shipments/S-confirm-1/confirm\"))","+            .andExpect(status().isOk)","+            .andExpect(jsonPath(\"$.shipmentId\").value(\"S-confirm-1\"))","+            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))","+","+        // Verify the state persisted by reading it back","+        mockMvc.perform(get(\"/shipments/S-confirm-1\"))","+            .andExpect(status().isOk)","+            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))","+    }","+","+    @Test","+    fun `confirm is idempotent for already confirmed shipment`() {","+        mockMvc.perform(createShipment(\"S-confirm-2\")).andExpect(status().isCreated)","+","+        // First confirm","+        val firstConfirm = mockMvc.perform(post(\"/shipments/S-confirm-2/confirm\"))","+            .andExpect(status().isOk)","+            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))","+            .andReturn()","+            .response","+            .contentAsString","+","+        // Second confirm (idempotent)","+        val secondConfirm = mockMvc.perform(post(\"/shipments/S-confirm-2/confirm\"))","+            .andExpect(status().isOk)","+            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))","+            .andReturn()","+            .response","+            .contentAsString","+","+        // Both responses should be identical","+        assert(firstConfirm == secondConfirm) { \"Idempotent confirm should return identical response\" }","+","+        // Verify state is still CONFIRMED","+        mockMvc.perform(get(\"/shipments/S-confirm-2\"))","+            .andExpect(status().isOk)","+            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))","+    }","+","+    @Test","+    fun `rejects confirming a cancelled shipment with 409 conflict`() {","+        // Create and setup a cancelled shipment directly in repo","+        val cancelledShipment = Shipment(","+            shipmentId = \"S-cancelled\",","+            orderId = \"O-1\",","+            carrier = \"DHL\",","+            status = ShipmentStatus.CANCELLED,","+        )","+        repository.save(cancelledShipment)","+","+        // Attempt to confirm","+        mockMvc.perform(post(\"/shipments/S-cancelled/confirm\"))","+            .andExpect(status().isConflict)","+            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_CANNOT_CONFIRM_CANCELLED\"))","+","+        // Verify state is unchanged (still CANCELLED)","+        mockMvc.perform(get(\"/shipments/S-cancelled\"))","+            .andExpect(status().isOk)","+            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))","+    }","+","+    @Test","+    fun `rejects confirming non-existent shipment with 404 not found`() {","+        mockMvc.perform(post(\"/shipments/S-missing/confirm\"))","+            .andExpect(status().isNotFound)","+            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))","+    }"," }"]}],"userModified":false,"replaceAll":false}}
