irm is idempotent on already confirmed shipment`() {\n        mockMvc.perform(createShipment(\"S-5\")).andExpect(status().isCreated)\n        mockMvc.perform(post(\"/shipments/S-5/confirm\")).andExpect(status().isOk)\n\n        // Confirm again\n        mockMvc.perform(post(\"/shipments/S-5/confirm\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n\n        // Verify state is still CONFIRMED\n        mockMvc.perform(get(\"/shipments/S-5\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n    }\n\n    @Test\n    fun `rejects confirm on cancelled shipment with error envelope`() {\n        // Create a shipment and manually cancel it\n        mockMvc.perform(createShipment(\"S-6\")).andExpect(status().isCreated)\n        repository.save(\n            Shipment(\n                shipmentId = \"S-6\",\n                orderId = \"O-1\",\n                carrier = \"DHL\",\n                status = ShipmentStatus.CANCELLED,\n            ),\n        )\n\n        // Attempt to confirm\n        mockMvc.perform(post(\"/shipments/S-6/confirm\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_INVALID_STATE_FOR_CONFIRM\"))\n\n        // Verify shipment remains CANCELLED\n        mockMvc.perform(get(\"/shipments/S-6\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n    }\n\n    @Test\n    fun `rejects confirm on non-existent shipment through error envelope`() {\n        mockMvc.perform(post(\"/shipments/S-missing/confirm\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n    }\n}"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":666,"cache_re