firm of already CONFIRMED succeeds and changes nothing`() {\n        mockMvc.perform(createShipment(\"S-5\")).andExpect(status().isCreated)\n\n        // First confirm\n        mockMvc.perform(post(\"/shipments/S-5/confirm\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n\n        // Second confirm (retry)\n        mockMvc.perform(post(\"/shipments/S-5/confirm\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n\n        // Verify persistence through GET\n        mockMvc.perform(get(\"/shipments/S-5\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n    }\n\n    @Test\n    fun `rejects confirming a CANCELLED shipment with the error envelope`() {\n        mockMvc.perform(createShipment(\"S-6\")).andExpect(status().isCreated)\n\n        // Directly set status to CANCELLED in repository to simulate a terminal state\n        val shipment = repository.findById(\"S-6\")!!\n        repository.save(shipment.copy(status = ShipmentStatus.CANCELLED))\n\n        // Attempt to confirm should fail\n        mockMvc.perform(post(\"/shipments/S-6/confirm\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_CANCELLED\"))\n\n        // Verify status is unchanged\n        mockMvc.perform(get(\"/shipments/S-6\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n    }\n\n    @Test\n    fun `rejects confirming a nonexistent shipment through the error envelope`() {\n        mockMvc.perform(post(\"/shipments/S-missing/confirm\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n    }\n}"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input