ndExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n            .andReturn()\n\n        val confirmBody = confirmResponse.response.contentAsString\n        assert(confirmBody.contains(\"\\\"status\\\":\\\"CONFIRMED\\\"\")) { \"Confirm response should contain CONFIRMED status\" }\n\n        mockMvc.perform(get(\"/shipments/S-confirm-1\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n    }\n\n    @Test\n    fun `confirming an already confirmed shipment succeeds without change`() {\n        mockMvc.perform(createShipment(\"S-confirm-idempotent\")).andExpect(status().isCreated)\n        mockMvc.perform(post(\"/shipments/S-confirm-idempotent/confirm\"))\n            .andExpect(status().isOk)\n\n        val secondConfirmResponse = mockMvc.perform(post(\"/shipments/S-confirm-idempotent/confirm\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n            .andReturn()\n\n        val secondBody = secondConfirmResponse.response.contentAsString\n        assert(secondBody.contains(\"\\\"status\\\":\\\"CONFIRMED\\\"\")) { \"Second confirm should return CONFIRMED\" }\n\n        mockMvc.perform(get(\"/shipments/S-confirm-idempotent\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n    }\n\n    @Test\n    fun `rejecting confirm of a cancelled shipment with error envelope`() {\n        mockMvc.perform(createShipment(\"S-cancelled\")).andExpect(status().isCreated)\n        repository.save(\n            Shipment(\n                shipmentId = \"S-cancelled\",\n                orderId = \"O-1\",\n                carrier = \"DHL\",\n                status = ShipmentStatus.CANCELLED,\n            ),\n        )\n\n        mockMvc.perform(post(\"/shipments/S-cancelled/confirm\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_ALREADY_CANCELLED\"))\n\n        mockMvc.perform(get(\"/shipments/S-cancelled\"))","numLines":60,"startLine":73,"totalLines":144}}}
