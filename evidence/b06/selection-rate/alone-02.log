med shipment idempotently`() {\n        mockMvc.perform(createShipment(\"S-5\")).andExpect(status().isCreated)\n        mockMvc.perform(post(\"/shipments/S-5/confirm\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n\n        mockMvc.perform(post(\"/shipments/S-5/confirm\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n\n        mockMvc.perform(get(\"/shipments/S-5\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n    }\n\n    @Test\n    fun `rejects confirming a non-existent shipment`() {\n        mockMvc.perform(post(\"/shipments/S-missing/confirm\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n    }\n\n    @Test\n    fun `rejects confirming a cancelled shipment with 409 and error code`() {\n        val cancelledShipment = Shipment(\"S-6\", \"O-1\", \"DHL\", ShipmentStatus.CANCELLED)\n        repository.save(cancelledShipment)\n\n        mockMvc.perform(post(\"/shipments/S-6/confirm\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_INVALID_STATUS\"))\n\n        mockMvc.perform(get(\"/shipments/S-6\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n    }\n}"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":1347,"cache_read_input_tokens":29375,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1347},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"8a66f984-a23e-4090-a756-e841001aef84","uuid":"04c7a13a-de07-4c3e-a974-0c20d7