hipment is rejected with not found`() {\n        mockMvc.perform(post(\"/shipments/S-nonexistent/confirm\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n    }\n}"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":656,"cache_read_input_tokens":23254,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":656},"output_tokens":4,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"1a9e0da5-e106-4497-9f91-55e38d5619e0","uuid":"bf6096c6-30ff-4484-b1e9-3732f5a7206b","timestamp":"2026-09-09T16:50:40.247Z","request_id":"req_011CetD9FXLGZ6cTorZhMyec"}
