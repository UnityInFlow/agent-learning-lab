         mockMvc.perform(get(\"/shipments/S-1\"))\n                .andExpect(status().isOk)\n                .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n        }\n\n        @Test\n        fun `confirm is idempotent on already confirmed shipment`() {\n            // Create and confirm a shipment\n            mockMvc.perform(createShipment(\"S-2\")).andExpect(status().isCreated)\n            mockMvc.perform(post(\"/shipments/S-2/confirm\"))\n                .andExpect(status().isOk)\n                .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n\n            // Confirm again - should succeed and return the same state\n            mockMvc.perform(post(\"/shipments/S-2/confirm\"))\n                .andExpect(status().isOk)\n                .andExpect(jsonPath(\"$.shipmentId\").value(\"S-2\"))\n                .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n\n            // Verify state is still CONFIRMED\n            mockMvc.perform(get(\"/shipments/S-2\"))\n                .andExpect(status().isOk)\n                .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n        }\n\n        @Test\n        fun `rejects confirming a cancelled shipment with 409 conflict`() {\n            // Create a cancelled shipment by writing directly to repository\n            repository.save(\n                Shipment(\n                    shipmentId = \"S-cancelled\",\n                    orderId = \"O-1\",\n                    carrier = \"DHL\",\n                    status = ShipmentStatus.CANCELLED,\n                ),\n            )\n\n            // Try to confirm it\n            mockMvc.perform(post(\"/shipments/S-cancelled/confirm\"))\n                .andExpect(status().isConflict)\n                .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_CANNOT_CONFIRM\"))\n\n            // Verify it is still in CANCELLED status (unchanged)\n            mockMvc.perform(get(\"/shipments/S-cancelled\"))\n                .andExpect(status().isOk)\n                .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n        }\n\n        @Test\n        fun `rejects confirming an unknown shipment with 404 not found`() {\n            mockMvc.perform(post(\"/shipments/S-missing/confirm\"))\n                .andExpect(status().isNotFound)\n                .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n        }\n    }\n}"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":596,"cache_read_input_tokens":22971,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":596},"output_tokens":4,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"1a879a1b-8953-41fc-abe2-3c5285dd6331","uuid":"008675ae-e60e-44fa-ac53-9ff84b1ae169","timestamp":"2026-09-09T16:56:25.177Z","request_id":"req_011CetDagu1cqMBvrxfngpMs"}
