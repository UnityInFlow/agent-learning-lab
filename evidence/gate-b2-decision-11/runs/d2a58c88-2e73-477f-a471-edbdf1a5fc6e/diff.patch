+        val allocated = shipments.filter { it.status != ShipmentStatus.CANCELLED }.sumOf { it.quantity }
+        val delivered = shipments.filter { it.status == ShipmentStatus.DELIVERED }.sumOf { it.quantity }
+
+        val status = when {
+            delivered >= this.quantity -> FulfilmentStatus.DELIVERED
+            allocated >= this.quantity -> FulfilmentStatus.FULLY_ALLOCATED
+            allocated > 0 -> FulfilmentStatus.PARTIALLY_ALLOCATED
+            else -> FulfilmentStatus.UNALLOCATED
+        }
+
+        return this.copy(fulfilment = Fulfilment(allocated = allocated, delivered = delivered, status = status))
