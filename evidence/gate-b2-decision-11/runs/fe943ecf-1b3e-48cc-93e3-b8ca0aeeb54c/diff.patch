+fun Order.withFulfilment(shipmentRepository: InMemoryShipmentRepository): Order {
+    val shipments = shipmentRepository.findByOrderId(orderId)
+    val allocated = shipments
+        .filter { it.status != ShipmentStatus.CANCELLED }
+        .sumOf { it.quantity }
+    val delivered = shipments
+        .filter { it.status == ShipmentStatus.DELIVERED }
+        .sumOf { it.quantity }
+
+    val state = when {
+        delivered >= quantity -> FulfilmentState.DELIVERED
+        allocated >= quantity -> FulfilmentState.FULLY_ALLOCATED
+        allocated > 0 -> FulfilmentState.PARTIALLY_ALLOCATED
+        else -> FulfilmentState.UNALLOCATED
+    }
+
+    return copy(fulfilment = FulfilmentStatus(allocated, delivered, state))
