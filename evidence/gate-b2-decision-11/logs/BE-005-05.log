rderRepository,\n) {\n\n    @PostMapping\n    fun create(@RequestBody request: CreateShipmentRequest): ResponseEntity<Shipment> {\n        if (request.quantity < 1) {\n            throw ValidationException(\n                \"Invalid quantity\",\n                listOf(FieldViolation(\"quantity\", \"quantity must be positive\")),\n            )\n        }\n\n        if (repository.existsById(request.shipmentId)) {\n            throw ConflictException(\n                ErrorCode.SHIPMENT_ALREADY_EXISTS,\n                \"A shipment with id '${request.shipmentId}' already exists\",\n            )\n        }\n\n        val order = orderRepository.findById(request.orderId)\n        if (order != null) {\n            val existingShipments = repository.findByOrderId(request.orderId)\n            val allocated = existingShipments\n                .filter { it.status != ShipmentStatus.CANCELLED }\n                .sumOf { it.quantity }\n\n            if (allocated + request.quantity > order.quantity) {\n                throw ConflictException(\n                    ErrorCode.VALIDATION_FAILED,\n                    \"Shipment would exceed order quantity\",\n                )\n            }\n        }\n\n        val saved = repository.save(\n            Shipment(\n                shipmentId = request.shipmentId,\n                orderId = request.orderId,\n                carrier = request.carrier,\n                status = ShipmentStatus.CREATED,\n                quantity = request.quantity,\n            ),\n        )\n        return ResponseEntity.status(HttpStatus.CREATED).body(saved)\n    }\n\n    @GetMapping(\"/{shipmentId}\")\n    fun getById(@PathVariable shipmentId: String): Shipment =\n        repository.findById(shipmentId)\n            ?: throw ResourceNotFoundException(\n                ErrorCode.SHIPMENT_NOT_FOUND,\n                \"No shipment with id '$shipmentId'\",\n            )\n\n    @GetMapping\n    fun list(\n        @RequestParam(defaultValue = \"100\") limit: Int,\n        @RequestParam(defaultValue = \"0\") offset: Int,\n    ): ResponseEntity<List<Shipment>> {\n        if (limit < 1 || limit > 100) {\n            throw ValidationException(\n                \"Invalid limit\",\n                listOf(FieldViolation(\"limit\", \"limit must be between 1 and 100\")),\n            )\n        }\n        if (offset < 0) {\n            throw ValidationException(\n                \"Invalid offset\",\n                listOf(FieldViolation(\"offset\", \"offset must be 0 or more\")),\n            )\n        }\n\n        val shipments = repository.findAllPaged(limit, offset)\n        val headers = HttpHeaders().apply {\n            add(\"X-Total-Count\", repository.count().toString())\n        }\n        return ResponseEntity.ok().headers(headers).body(shipments)\n    }\n\n    @PostMapping(\"/{shipmentId}/confirm\")\n    fun confirm(@PathVariable shipmentId: String): Shipment {\n        val shipment = repository.findById(shipmentId)\n            ?: throw ResourceNotFoundException(\n                ErrorCode.SHIPMENT_NOT_FOUND,\n                \"No shipment with id '$shipmentId'\",\n            )\n\n        if (shipment.status != ShipmentStatus.CREATED) {\n            throw ConflictException(\n                ErrorCode.VALIDATION_FAILED,\n                \"Cannot confirm shipment in ${shipment.status} status\",\n            )\n        }\n\n        val updated = shipment.copy(status = ShipmentStatus.CONFIRMED)\n        repository.save(updated)\n        return updated\n    }\n\n    @PostMapping(\"/{shipmentId}/deliver\")\n    fun deliver(@PathVariable shipmentId: String): Shipment {\n        val shipment = repository.findById(shipmentId)\n            ?: throw ResourceNotFoundException(\n                ErrorCode.SHIPMENT_NOT_FOUND,\n                \"No shipment with id '$shipmentId'\",\n            )\n\n        if (shipment.status != ShipmentStatus.CONFIRMED) {\n            throw ConflictException(\n                ErrorCode.VALIDATION_FAILED,\n                \"Cannot deliver shipment in ${shipment.status} status\",\n            )\n        }\n\n        val updated = shipment.copy(status = ShipmentStatus.DELIVERED)\n        repository.save(updated)\n        return updated\n    }\n\n    @PostMapping(\"/{shipmentId}/cancel\")\n    fun cancel(@PathVariable shipmentId: String): Shipment {\n        val shipment = repository.findById(shipmentId)\n            ?: throw ResourceNotFoundException(\n                ErrorCode.SHIPMENT_NOT_FOUND,\n                \"No shipment with id '$shipmentId'\",\n            )\n\n        if (shipment.status != ShipmentStatus.CREATED) {\n            throw ConflictException(\n                ErrorCode.VALIDATION_FAILED,\n                \"Cannot cancel shipment in ${shipment.status} status\",\n            )\n        }\n\n        val updated = shipment.copy(status = ShipmentStatus.CANCELLED)\n        repository.save(updated)\n        return updated\n    }\n}","originalFile":"package com.unityinflow.sample.shipment\n\nimport com.unityinflow.sample.api.ConflictException\nimport com.unityinflow.sample.api.ErrorCode\nimport com.unityinflow.sample.api.ResourceNotFoundException\nimport org.springframework.http.HttpStatus\nimport org.springframework.http.ResponseEntity\nimport org.springframework.web.bind.annotation.GetMapping\nimport org.springframework.web.bind.annotation.PathVariable\nimport org.springframework.web.bind.annotation.PostMapping\nimport org.springframework.web.bind.annotation.RequestBody\nimport org.springframework.web.bind.annotation.RequestMapping\nimport org.springframework.web.bind.annotation.RestController\n\n/**\n * Baseline shipment API: create, read, list.\n *\n * There is deliberately no way to confirm a shipment. That is BE-003.\n */\n@RestController\n@RequestMapping(\"/shipments\")\nclass ShipmentController(\n    private val repository: InMemoryShipmentRepository,\n) {\n\n    @PostMapping\n    fun create(@RequestBody request: CreateShipmentRequest): ResponseEntity<Shipment> {\n        if (repository.existsById(request.shipmentId)) {\n            throw ConflictException(\n                ErrorCode.SHIPMENT_ALREADY_EXISTS,\n                \"A shipment with id '${request.shipmentId}' already exists\",\n            )\n        }\n\n        val saved = repository.save(\n            Shipment(\n                shipmentId = request.shipmentId,\n                orderId = request.orderId,\n                carrier = request.carrier,\n                status = ShipmentStatus.CREATED,\n            ),\n        )\n        return ResponseEntity.status(HttpStatus.CREATED).body(saved)\n    }\n\n    @GetMapping(\"/{shipmentId}\")\n    fun getById(@PathVariable shipmentId: String): Shipment =\n        repository.findById(shipmentId)\n            ?: throw ResourceNotFoundException(\n                ErrorCode.SHIPMENT_NOT_FOUND,\n                \"No shipment with id '$shipmentId'\",\n            )\n\n    @GetMapping\n    fun list(): List<Shipment> = repository.findAll()\n}\n","structuredPatch":[{"oldStart":2,"oldLines":7,"newStart":2,"newLines":11,"lines":[" "," import com.unityinflow.sample.api.ConflictException"," import com.unityinflow.sample.api.ErrorCode","+import com.unityinflow.sample.api.FieldViolation"," import com.unityinflow.sample.api.ResourceNotFoundException","+import com.unityinflow.sample.api.ValidationException","+import com.unityinflow.sample.order.InMemoryOrderRepository","+import org.springframework.http.HttpHeaders"," import org.springframework.http.HttpStatus"," import org.springframework.http.ResponseEntity"," import org.springframework.web.bind.annotation.GetMapping"]},{"oldStart":10,"oldLines":21,"newStart":14,"newLines":25,"lines":[" import org.springframework.web.bind.annotation.PostMapping"," import org.springframework.web.bind.annotation.RequestBody"," import org.springframework.web.bind.annotation.RequestMapping","+import org.springframework.web.bind.annotation.RequestParam"," import org.springfr