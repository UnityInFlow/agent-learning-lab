ipmentStatus.CREATED,\n            ),\n        )\n        return ResponseEntity.status(HttpStatus.CREATED).body(saved)\n    }\n\n    @GetMapping(\"/{shipmentId}\")\n    fun getById(@PathVariable shipmentId: String): Shipment =\n        repository.findById(shipmentId)\n            ?: throw ResourceNotFoundException(\n                ErrorCode.SHIPMENT_NOT_FOUND,\n                \"No shipment with id '$shipmentId'\",\n            )\n\n    @GetMapping\n    fun list(\n        @RequestParam(defaultValue = \"100\") limit: Int,\n        @RequestParam(defaultValue = \"0\") offset: Int,\n    ): ResponseEntity<List<Shipment>> {\n        if (limit < 1 || limit > 100) {\n            throw ValidationException(\n                \"Invalid limit\",\n                listOf(FieldViolation(\"limit\", \"Limit must be between 1 and 100\")),\n            )\n        }\n        if (offset < 0) {\n            throw ValidationException(\n                \"Invalid offset\",\n                listOf(FieldViolation(\"offset\", \"Offset must be 0 or greater\")),\n            )\n        }\n\n        val total = repository.countAll()\n        val shipments = repository.findAll(limit, offset)\n        return ResponseEntity.ok()\n            .header(\"X-Total-Count\", total.toString())\n            .body(shipments)\n    }\n\n    @PostMapping(\"/{shipmentId}/confirm\")\n    fun confirm(@PathVariable shipmentId: String): Shipment {\n        val shipment = repository.findById(shipmentId)\n            ?: throw ResourceNotFoundException(\n                ErrorCode.SHIPMENT_NOT_FOUND,\n                \"No shipment with id '$shipmentId'\",\n            )\n\n        if (shipment.status != ShipmentStatus.CREATED) {\n            throw ConflictException(\n                ErrorCode.INVALID_TRANSITION,\n                \"Cannot confirm a shipment in status ${shipment.status}\",\n            )\n        }\n\n        val updated = shipment.copy(status = ShipmentStatus.CONFIRMED)\n        return repository.save(upd