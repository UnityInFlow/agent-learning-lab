der.quantity - currentAllocated})\",\n                )\n            }\n        }\n\n        val saved = repository.save(\n            Shipment(\n                shipmentId = request.shipmentId,\n                orderId = request.orderId,\n                carrier = request.carrier,\n                status = ShipmentStatus.CREATED,\n                quantity = quantity,\n            ),\n        )\n        return ResponseEntity.status(HttpStatus.CREATED).body(saved)\n    }\n\n    @GetMapping(\"/{shipmentId}\")\n    fun getById(@PathVariable shipmentId: String): Shipment =\n        repository.findById(shipmentId)\n            ?: throw ResourceNotFoundException(\n                ErrorCode.SHIPMENT_NOT_FOUND,\n                \"No shipment with id '$shipmentId'\",\n            )\n\n    @GetMapping\n    fun list(\n        @RequestParam(defaultValue = \"100\") limit: Int?,\n        @RequestParam(defaultValue = \"0\") offset: Int?,\n    ): ResponseEntity<List<Shipment>> {\n        val actualLimit = limit ?: 100\n        val actualOffset = offset ?: 0\n\n        if (actualLimit < 1 || actualLimit > 100) {\n            throw ValidationException(\n                \"Invalid limit\",\n                listOf(FieldViolation(\"limit\", \"Limit must be between 1 and 100\")),\n            )\n        }\n\n        if (actualOffset < 0) {\n            throw ValidationException(\n                \"Invalid offset\",\n                listOf(FieldViolation(\"offset\", \"Offset must be non-negative\")),\n            )\n        }\n\n        val result = repository.findAllPaginated(actualLimit, actualOffset)\n        return ResponseEntity.ok()\n            .header(\"X-Total-Count\", result.total.toString())\n            .body(result.items)\n    }\n\n    @PostMapping(\"/{shipmentId}/confirm\")\n    fun confirm(@PathVariable shipmentId: String): Shipment {\n        val shipment = repository.findById(shipmentId)\n            ?: throw ResourceNotFoundException(\n                ErrorCode.SHIPMENT_NOT_FOUND,\n                \"No shipment with id '$shipmentId'\",\n            )\n\n        if (shipment.status != ShipmentStatus.CREATED) {\n            throw ConflictException(\n                ErrorCode.INVALID_SHIPMENT_TRANSITION,\n                \"Cannot confirm a shipment in status ${shipment.status}\",\n            )\n        }\n\n        val updated = shipment.copy(status = ShipmentStatus.CONFIRMED)\n        repository.save(updated)\n        return updated\n    }\n\n    @PostMapping(\"/{shipmentId}/deliver\")\n    fun deliver(@PathVariable shipmentId: String): Shipment {\n        val shipment = repository.findById(shipmentId)\n            ?: throw ResourceNotFoundException(\n                ErrorCode.SHIPMENT_NOT_FOUND,\n                \"No shipment with id '$shipmentId'\",\n            )\n\n        if (shipment.status != ShipmentStatus.CONFIRMED) {\n            throw ConflictException(\n                ErrorCode.INVALID_SHIPMENT_TRANSITION,\n                \"Cannot deliver a shipment in status ${shipment.status}\",\n            )\n        }\n\n        val updated = shipment.copy(status = ShipmentStatus.DELIVERED)\n        repository.save(updated)\n        return updated\n    }\n\n    @PostMapping(\"/{shipmentId}/cancel\")\n    fun cancel(@PathVariable shipmentId: String): Shipment {\n        val shipment = repository.findById(shipmentId)\n            ?: throw ResourceNotFoundException(\n                ErrorCode.SHIPMENT_NOT_FOUND,\n                \"No shipment with id '$shipmentId'\",\n            )\n\n        if (shipment.status != ShipmentStatus.CREATED) {\n            throw ConflictException(\n                ErrorCode.INVALID_SHIPMENT_TRANSITION,\n                \"Cannot cancel a shipment in status ${shipment.status}\",\n            )\n        }\n\n        val updated = shipment.copy(status = ShipmentStatus.CANCELLED)\n        repository.save(updated)\n        return updated\n    }\n}"}}}
