quest.customerId,\n            amount = request.amount,\n            currency = request.currency,\n            quantity = quantity,\n            fulfilment = Fulfilment(0, 0, FulfilmentStatus.UNALLOCATED),\n        )\n        val saved = repository.save(order)\n        return ResponseEntity.status(HttpStatus.CREATED).body(saved)\n    }\n\n    @GetMapping(\"/{orderId}\")\n    fun getById(@PathVariable orderId: String): Order {\n        val order = repository.findById(orderId)\n            ?: throw ResourceNotFoundException(\n                ErrorCode.ORDER_NOT_FOUND,\n                \"No order with id '$orderId'\",\n            )\n        return enrichWithFulfilment(order)\n    }\n\n    @GetMapping\n    fun list(\n        @RequestParam(defaultValue = \"100\") limit: Int?,\n        @RequestParam(defaultValue = \"0\") offset: Int?,\n        @RequestParam(name = \"fulfilment\") fulfilmentParam: String?,\n    ): ResponseEntity<List<Order>> {\n        val actualLimit = limit ?: 100\n        val actualOffset = offset ?: 0\n\n        if (actualLimit < 1 || actualLimit > 100) {\n            throw ValidationException(\n                \"Invalid limit\",\n                listOf(FieldViolation(\"limit\", \"Limit must be between 1 and 100\")),\n            )\n        }\n\n        if (actualOffset < 0) {\n            throw ValidationException(\n                \"Invalid offset\",\n                listOf(FieldViolation(\"offset\", \"Offset must be non-negative\")),\n            )\n        }\n\n        val result = if (fulfilmentParam != null) {\n            val status = try {\n                FulfilmentStatus.valueOf(fulfilmentParam)\n            } catch (e: IllegalArgumentException) {\n                throw ValidationException(\n                    \"Invalid fulfilment status\",\n                    listOf(FieldViolation(\"fulfilment\", \"Unknown fulfilment status '$fulfilmentParam'\")),\n                )\n            }\n            repository.findByFulfilmentStatusPaginated(status, actualLimit, actualOffset)\n        } else {\n            repository.findAllPaginated(actualLimit, actualOffset)\n        }\n\n        val enriched = result.items.map { enrichWithFulfilment(it) }\n        return ResponseEntity.ok()\n            .header(\"X-Total-Count\", result.total.toString())\n            .body(enriched)\n    }\n\n    @PutMapping(\"/{orderId}/quantity\")\n    fun updateQuantity(\n        @PathVariable orderId: String,\n        @RequestBody request: UpdateOrderQuantityRequest,\n    ): Order {\n        if (request.quantity < 1) {\n            throw ValidationException(\n                \"Invalid quantity\",\n                listOf(FieldViolation(\"quantity\", \"Quantity must be at least 1\")),\n            )\n        }\n\n        val order = repository.findById(orderId)\n            ?: throw ResourceNotFoundException(\n                ErrorCode.ORDER_NOT_FOUND,\n                \"No order with id '$orderId'\",\n            )\n\n        val shipments = shipmentRepository.findByOrderId(orderId)\n        val allocated = shipments\n            .filter { it.status != ShipmentStatus.CANCELLED }\n            .sumOf { it.quantity }\n\n        if (request.quantity < allocated) {\n            throw ConflictException(\n                ErrorCode.ALLOCATION_EXCEEDS_QUANTITY,\n                \"New quantity (${ request.quantity}) is less than allocated quantity ($allocated)\",\n            )\n        }\n\n        val updated = order.copy(quantity = request.quantity)\n        val enriched = enrichWithFulfilment(updated)\n        repository.save(enriched)\n        return enriched\n    }\n\n    private fun enrichWithFulfilment(order: Order): Order {\n        val shipments = shipmentRepository.findByOrderId(order.orderId)\n        val allocated = shipments\n            .filter { it.status != ShipmentStatus.CANCELLED }\n            .sumOf { it.quantity }\n        val delivered = shipments\n            .filter { it.status == ShipmentStatus.DELIVERED }\n            .sumOf { it.quantity }\n\n        val status = when {\n            delivered >= order.quantity -> FulfilmentStatus.DELIVERED\n            allocated >= order.quantity -> FulfilmentStatus.FULLY_ALLOCATED\n            allocated > 0 -> FulfilmentStatus.PARTIALLY_ALLOCATED\n            else -> FulfilmentStatus.UNALLOCATED\n        }\n\n        return order.copy(fulfilment = Fulfilment(allocated, delivered, status))\n    }\n}\n\nenum class ShipmentStatus {\n    CREATED,\n    CONFIRMED,\n    DELIVERED,\n    CANCELLED,\n}"}}}
