e(\"ORDER_ALREADY_EXISTS\"))\n            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n    }\n}\n","structuredPatch":[{"oldStart":1,"oldLines":5,"newStart":1,"newLines":6,"lines":[" package com.unityinflow.sample.order"," ","+import com.unityinflow.sample.customer.InMemoryCustomerRepository"," import org.junit.jupiter.api.BeforeEach"," import org.junit.jupiter.api.Test"," import org.springframework.beans.factory.annotation.Autowired"]},{"oldStart":29,"oldLines":8,"newStart":30,"newLines":20,"lines":["     @Autowired","     lateinit var repository: InMemoryOrderRepository"," ","+    @Autowired","+    lateinit var customerRepository: InMemoryCustomerRepository","+","     @BeforeEach","-    fun reset() = repository.clear()","+    fun reset() {","+        repository.clear()","+        customerRepository.clear()","+        // Create a test customer for orders","+        mockMvc.perform(","+            post(\"/customers\")","+                .contentType(MediaType.APPLICATION_JSON)","+                .content(\"\"\"{\"customerId\":\"C-1\",\"name\":\"Test Customer\",\"email\":\"test@example.com\"}\"\"\"),","+        )","+    }"," ","     private fun createOrder(orderId: String, amount: String = \"49.90\") =","         post(\"/orders\")"]}],"userModified":false,"replaceAll":false}}
