"+            ),","+        )","+        shipmentRepository.save(","+            Shipment(","+                shipmentId = \"S-2\",","+                orderId = \"O-shipments\",","+                carrier = \"UPS\",","+                status = ShipmentStatus.CREATED,","+            ),","+        )","+","+        mockMvc.perform(cancelOrder(\"O-shipments\"))","+            .andExpect(status().isOk)","+            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))","+","+        // Verify both shipments are now CANCELLED","+        val s1 = shipmentRepository.findById(\"S-1\")","+        val s2 = shipmentRepository.findById(\"S-2\")","+        assert(s1 != null && s1.status == ShipmentStatus.CANCELLED)","+        assert(s2 != null && s2.status == ShipmentStatus.CANCELLED)","+    }","+","+    @Test","+    fun `cancelling an order does not cancel confirmed or already cancelled shipments`() {","+        mockMvc.perform(createOrder(\"O-mixed\")).andExpect(status().isCreated)","+","+        // Add shipments with different statuses","+        shipmentRepository.save(","+            Shipment(","+                shipmentId = \"S-created\",","+                orderId = \"O-mixed\",","+                carrier = \"DHL\",","+                status = ShipmentStatus.CREATED,","+            ),","+        )","+        shipmentRepository.save(","+            Shipment(","+                shipmentId = \"S-already-cancelled\",","+                orderId = \"O-mixed\",","+                carrier = \"UPS\",","+                status = ShipmentStatus.CANCELLED,","+            ),","+        )","+","+        mockMvc.perform(cancelOrder(\"O-mixed\"))","+            .andExpect(status().isOk)","+            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))","+","+        // Verify CREATED shipment is CANCELLED","+        val created = shipmentRepository.findById(\"S-created\")","+        assert(created != null && created.status == ShipmentStatus.CANCELLED)","+","+        // Verify already CANCELLED shipment remains CANCELLED","+        val alreadyCancelled = shipmentRepository.findById(\"S-already-cancelled\")","+        assert(alreadyCancelled != null && alreadyCancelled.status == ShipmentStatus.CANCELLED)","+    }"," }"]}],"userModified":false,"replaceAll":false}}
