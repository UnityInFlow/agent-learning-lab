derId'\",\n            )\n\n    @GetMapping\n    fun list(): List<Order> = repository.findAll()\n\n    @PostMapping(\"/{orderId}/cancel\")\n    fun cancel(@PathVariable orderId: String): ResponseEntity<Order> {\n        val order = repository.findById(orderId)\n            ?: throw ResourceNotFoundException(\n                ErrorCode.ORDER_NOT_FOUND,\n                \"No order with id '$orderId'\",\n            )\n\n        if (order.status == OrderStatus.CANCELLED) {\n            return ResponseEntity.ok(order)\n        }\n\n        val shipments = shipmentRepository.findByOrderId(orderId)\n        if (shipments.any { it.status == ShipmentStatus.CONFIRMED }) {\n            throw ConflictException(\n                ErrorCode.ORDER_NOT_FOUND,\n                \"Cannot cancel an order with a confirmed shipment\",\n            )\n        }\n\n        val cancelledOrder = order.copy(status = OrderStatus.CANCELLED)\n        repository.save(cancelledOrder)\n\n        shipments\n            .filter { it.status == ShipmentStatus.CREATED }\n            .forEach { shipment ->\n                shipmentRepository.save(shipment.copy(status = ShipmentStatus.CANCELLED))\n            }\n\n        return ResponseEntity.ok(cancelledOrder)\n    }\n}"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":1350,"cache_read_input_tokens":35934,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1350},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"f639b769-6950-4666-8762-d934fced4819","uuid":"52aa3f9d-9d1e-45fa-aefb-9dd994124659","timestamp":"2026-09-09T10:28:14.246Z","request_id":"req_011CeshyjQj1iTnFoAyiqTML"}
