 FieldViolation(val field: String, val message: String)\n\n/**\n * The closed set of machine-readable error codes. Clients switch on these, so a code is\n * part of the public API: add one deliberately, never rename one casually.\n */\nenum class ErrorCode {\n    ORDER_NOT_FOUND,\n    ORDER_ALREADY_EXISTS,\n    ORDER_CANCELLED,\n    SHIPMENT_NOT_FOUND,\n    SHIPMENT_ALREADY_EXISTS,\n    VALIDATION_FAILED,\n}\n","structuredPatch":[{"oldStart":32,"oldLines":6,"newStart":32,"newLines":7,"lines":["     ORDER_NOT_FOUND,","     ORDER_ALREADY_EXISTS,","     ORDER_CANCELLED,","+    ORDER_HAS_CONFIRMED_SHIPMENT,","     SHIPMENT_NOT_FOUND,","     SHIPMENT_ALREADY_EXISTS,","     VALIDATION_FAILED,"]}],"userModified":false,"replaceAll":false}}
