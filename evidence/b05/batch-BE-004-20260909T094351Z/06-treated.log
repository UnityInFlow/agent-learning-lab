Id }\n\n    fun clear() = store.clear()\n}\n","structuredPatch":[{"oldStart":23,"oldLines":5,"newStart":23,"newLines":8,"lines":[" ","     fun findAll(): List<Shipment> = store.values.sortedBy { it.shipmentId }"," ","+    fun findByOrderId(orderId: String): List<Shipment> =","+        store.values.filter { it.orderId == orderId }.sortedBy { it.shipmentId }","+","     fun clear() = store.clear()"," }"]}],"userModified":false,"replaceAll":false}}
