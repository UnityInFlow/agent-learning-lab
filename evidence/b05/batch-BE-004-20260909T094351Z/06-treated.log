n@AutoConfigureMockMvc\nclass ShipmentControllerTest {\n\n    @Autowired\n    lateinit var mockMvc: MockMvc\n\n    @Autowired\n    lateinit var repository: InMemoryShipmentRepository\n\n    @BeforeEach\n    fun reset() = repository.clear()\n\n    private fun createShipment(shipmentId: String) =\n        post(\"/shipments\")\n            .contentType(MediaType.APPLICATION_JSON)\n            .content(\n                \"\"\"{\"shipmentId\":\"$shipmentId\",\"orderId\":\"O-1\",\"carrier\":\"DHL\"}\"\"\",\n            )\n\n    @Test\n    fun `creates a shipment in CREATED status`() {\n        mockMvc.perform(createShipment(\"S-1\"))\n            .andExpect(status().isCreated)\n            .andExpect(jsonPath(\"$.shipmentId\").value(\"S-1\"))\n            .andExpect(jsonPath(\"$.status\").value(\"CREATED\"))\n    }\n\n    @Test\n    fun `rejects a duplicate shipment id with the error envelope`() {\n        mockMvc.perform(createShipment(\"S-2\")).andExpect(status().isCreated)\n\n        mockMvc.perform(createShipment(\"S-2\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_ALREADY_EXISTS\"))\n    }\n\n    @Test\n    fun `returns a shipment by id`() {\n        mockMvc.perform(createShipment(\"S-3\")).andExpect(status().isCreated)\n\n        mockMvc.perform(get(\"/shipments/S-3\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.carrier\").value(\"DHL\"))\n    }\n\n    @Test\n    fun `reports an unknown shipment through the error envelope`() {\n        mockMvc.perform(get(\"/shipments/S-missing\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n    }\n\n    @Test\n    fun `lists shipments in id order`() {\n        mockMvc.perform(createShipment(\"S-b\")).andExpect(status().isCreated)\n        mockMvc.perform(createShipment(\"S-a\")).andExpect(status().isCreated)\n\n        mockMvc.perform(get(\"/shipments\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$[0].shipmentId\").value(\"S-a\"))\n            .andExpect(jsonPath(\"$[1].shipmentId\").value(\"S-b\"))\n    }\n}\n","structuredPatch":[{"oldStart":1,"oldLines":5,"newStart":1,"newLines":8,"lines":[" package com.unityinflow.sample.shipment"," ","+import com.unityinflow.sample.order.InMemoryOrderRepository","+import com.unityinflow.sample.order.Order","+import com.unityinflow.sample.order.OrderStatus"," import org.junit.jupiter.api.BeforeEach"," import org.junit.jupiter.api.Test"," import org.springframework.beans.factory.annotation.Autowired"]},{"oldStart":11,"oldLines":6,"newStart":14,"newLines":7,"lines":[" import org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post"," import org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath"," import org.springframework.test.web.servlet.result.MockMvcResultMatchers.status","+import java.math.BigDecimal"," "," /**","  * The shipment feature as it exists before BE-003."]},{"oldStart":28,"oldLines":14,"newStart":32,"newLines":20,"lines":["     @Autowired","     lateinit var repository: InMemoryShipmentRepository"," ","+    @Autowired","+    lateinit var orderRepository: InMemoryOrderRepository","+","     @BeforeEach","-    fun reset() = repository.clear()","+    fun reset() {","+        repository.clear()","+        orderRepository.clear()","+    }"," ","-    private fun createShipment(shipmentId: String) =","+    private fun createShipment(shipmentId: String, orderId: String = \"O-1\") =","         post(\"/shipments\")","             .contentType(MediaType.APPLICATION_JSON)","             .content(","-                \"\"\"{\"shipmentId\":\"$shipmentId\",\"orderId\":\"O-1\",\"carrier\":\"DHL\"}\"\"\",","+                \"\"\"{\"shipmentId\":\"$shipmentId\",\"orderId\":\"$orderId\",\"carrier\":\"DHL\"}\"\"\",","             )"," ","     @Test"]},{"oldStart":81,"oldLines":4,"newStart":91,"newLines":43,"lines":["             .andExpect(jsonPath(\"$[0].shipmentId\").value(\"S-a\"))","             .andExpect(jsonPath(\"$[1].shipmentId\").value(\"S-b\"))","     }","+","+    @Test","+    fun `rejects creating shipment for cancelled order with 409 ORDER_CANCELLED`() {","+        // Create and cancel an order","+        orderRepository.save(","+            Order(","+                orderId = \"O-cancel-test\",","+                customerId = \"C-1\",","+                amount = BigDecimal(\"50.00\"),","+                currency = \"EUR\",","+                status = OrderStatus.CANCELLED,","+            ),","+        )","+","+        // Attempt to create shipment - should fail","+        mockMvc.perform(createShipment(\"S-cancel-test\", \"O-cancel-test\"))","+            .andExpect(status().isConflict)","+            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_CANCELLED\"))","+            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)","+    }","+","+    @Test","+    fun `allows creating shipment for active order`() {","+        // Create an active order","+        orderRepository.save(","+            Order(","+                orderId = \"O-active\",","+                customerId = \"C-1\",","+                amount = BigDecimal(\"50.00\"),","+                currency = \"EUR\",","+                status = OrderStatus.ACTIVE,","+            ),","+        )","+","+        // Create shipment should succeed","+        mockMvc.perform(createShipment(\"S-active\", \"O-active\"))","+            .andExpect(status().isCreated)","+            .andExpect(jsonPath(\"$.status\").value(\"CREATED\"))","+    }"," }"]}],"userModified":false,"replaceAll":false}}
