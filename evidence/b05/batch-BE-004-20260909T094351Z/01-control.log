\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n    }\n\n    @Test\n    fun `cancelling an already cancelled order succeeds and changes nothing`() {\n        mockMvc.perform(createOrder(\"O-7\")).andExpect(status().isCreated)\n        mockMvc.perform(cancelOrder(\"O-7\")).andExpect(status().isOk)\n\n        mockMvc.perform(cancelOrder(\"O-7\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n    }\n\n    @Test\n    fun `cancelling an order with a CREATED shipment cancels the shipment`() {\n        mockMvc.perform(createOrder(\"O-8\")).andExpect(status().isCreated)\n        shipmentRepository.save(\n            Shipment(\"S-1\", \"O-8\", \"DHL\", ShipmentStatus.CREATED),\n        )\n\n        mockMvc.perform(cancelOrder(\"O-8\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n\n        val cancelled = shipmentRepository.findById(\"S-1\")\n        assert(cancelled?.status == ShipmentStatus.CANCELLED)\n    }\n\n    @Test\n    fun `cancelling an order with a CONFIRMED shipment returns 409 and changes nothing`() {\n        mockMvc.perform(createOrder(\"O-9\")).andExpect(status().isCreated)\n        shipmentRepository.save(\n            Shipment(\"S-2\", \"O-9\", \"DHL\", ShipmentStatus.CONFIRMED),\n        )\n\n        mockMvc.perform(cancelOrder(\"O-9\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_CANNOT_BE_CANCELLED\"))\n\n        val order = repository.findById(\"O-9\")\n        assert(order?.status == OrderStatus.ACTIVE)\n    }\n\n    @Test\n    fun `cancelling an order with multiple shipments cancels only CREATED ones`() {\n        mockMvc.perform(createOrder(\"O-10\")).andExpect(status().isCreated)\n        shipmentRepository.save(\n            Shipment(\"S-3\", \"O-10\", \"DHL\", ShipmentStatus.CREATED),\n        )\n        shipmentRepository.save(\n     