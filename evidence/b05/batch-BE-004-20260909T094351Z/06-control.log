derId'\",\n            )\n\n    @PostMapping(\"/{orderId}/cancel\")\n    fun cancel(@PathVariable orderId: String): ResponseEntity<Order> {\n        val order = repository.findById(orderId)\n            ?: throw ResourceNotFoundException(\n                ErrorCode.ORDER_NOT_FOUND,\n                \"No order with id '$orderId'\",\n            )\n\n        if (order.status == OrderStatus.CANCELLED) {\n            return ResponseEntity.ok(order)\n        }\n\n        val shipments = shipmentRepository.findByOrderId(orderId)\n        val confirmedShipments = shipments.filter { it.status == ShipmentStatus.CONFIRMED }\n\n        if (confirmedShipments.isNotEmpty()) {\n            throw ConflictException(\n                ErrorCode.ORDER_HAS_CONFIRMED_SHIPMENTS,\n                \"Cannot cancel order with confirmed shipments\",\n            )\n        }\n\n        val cancelledOrder = order.copy(status = OrderStatus.CANCELLED)\n        repository.save(cancelledOrder)\n\n        shipments.filter { it.status == ShipmentStatus.CREATED }\n            .forEach { shipmentRepository.updateStatus(it.shipmentId, ShipmentStatus.CANCELLED) }\n\n        return ResponseEntity.ok(cancelledOrder)\n    }\n\n    @GetMapping\n    fun list(): List<Order> = repository.findAll()\n}"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":954,"cache_read_input_tokens":35722,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":954},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"8cc03857-752c-48a6-8d45-2b4290cafaeb","uuid":"0c948416-0009-44a6-ab68-b02482eac4d2","timestamp":"2026-09-09T10:21:46.652Z","request_id":"req_011CeshVBQbjKgrsGwSv1MsY"}
