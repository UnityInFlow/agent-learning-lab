i.BeforeEach\nimport org.junit.jupiter.api.Test\nimport org.springframework.beans.factory.annotation.Autowired\nimport org.springframework.boot.test.context.SpringBootTest\nimport org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc\nimport org.springframework.http.MediaType\nimport org.springframework.test.web.servlet.MockMvc\nimport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get\nimport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post\nimport org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath\nimport org.springframework.test.web.servlet.result.MockMvcResultMatchers.status\n\n/**\n * Baseline behaviour of the order feature. BE-002 must not break any of these.\n *\n * Note how the failure cases assert the response *body*, not just the status: the error\n * envelope is part of the API contract, so a change that returns the right status with\n * the wrong shape is a breaking change for clients.\n */\n@SpringBootTest\n@AutoConfigureMockMvc\nclass OrderControllerTest {\n\n    @Autowired\n    lateinit var mockMvc: MockMvc\n\n    @Autowired\n    lateinit var repository: InMemoryOrderRepository\n\n    @Autowired\n    lateinit var shipmentRepository: InMemoryShipmentRepository\n\n    @BeforeEach\n    fun reset() {\n        repository.clear()\n        shipmentRepository.clear()\n    }\n\n    private fun createOrder(orderId: String, amount: String = \"49.90\") =\n        post(\"/orders\")\n            .contentType(MediaType.APPLICATION_JSON)\n            .content(\n                \"\"\"{\"orderId\":\"$orderId\",\"customerId\":\"C-1\",\"amount\":$amount,\"currency\":\"EUR\"}\"\"\",\n            )\n\n    private fun cancelOrder(orderId: String) =\n        post(\"/orders/$orderId/cancel\")\n            .contentType(MediaType.APPLICATION_JSON)\n\n    @Test\n    fun `creates an order and returns 201`() {\n        mockMvc.perform(createOrder(\"O-1\"))\n            .andExpect(status().isCreated)\n            .andExpect(jsonPath(\"$.orderId\").value(\"O-1\"))\n    }\n\n    @Test\n    fun `reads back a created order`() {\n        mockMvc.perform(createOrder(\"O-2\")).andExpect(status().isCreated)\n\n        mockMvc.perform(get(\"/orders/O-2\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.currency\").value(\"EUR\"))\n    }\n\n    @Test\n    fun `returns 404 with the error envelope for an unknown order`() {\n        mockMvc.perform(get(\"/orders/does-not-exist\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_NOT_FOUND\"))\n            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n    }\n\n    @Test\n    fun `returns 409 with the error envelope for a duplicate order id`() {\n        mockMvc.perform(createOrder(\"O-3\")).andExpect(status().isCreated)\n\n        mockMvc.perform(createOrder(\"O-3\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_ALREADY_EXISTS\"))\n            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n    }\n\n    @Test\n    fun `cancel_active_order_succeeds_and_cancels_created_shipments`() {\n        // Create an order\n        mockMvc.perform(createOrder(\"O-cancel-1\")).andExpect(status().isCreated)\n\n        // Create some shipments for this order\n        shipmentRepository.save(Shipment(\"S-1\", \"O-cancel-1\", \"DHL\", ShipmentStatus.CREATED))\n        shipmentRepository.save(Shipment(\"S-2\", \"O-cancel-1\", \"FedEx\", ShipmentStatus.CREATED))\n\n        // Cancel the order\n        mockMvc.perform(cancelOrder(\"O-cancel-1\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.orderId\").value(\"O-cancel-1\"))\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n\n        // Verify the order is CANCELLED\n        mockMvc.perform(get(\"/orders/O-cancel-1\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n\n        // Verify the shipments are CANCELLED\n        val shipment1 = shipmentRepository.findById(\"S-1\")\n        assert(shipment1?.status == ShipmentStatus.CANCELLED)\n        val shipment2 = shipmentRepository.findById(\"S-2\")\n        assert(shipment2?.status == ShipmentStatus.CANCELLED)\n    }\n\n    @Test\n    fun `cancel_already_cancelled_order_succeeds_idempotently`() {\n        // Create and cancel an order\n        mockMvc.perform(createOrder(\"O-cancel-2\")).andExpect(status().isCreated)\n        mockMvc.perform(cancelOrder(\"O-cancel-2\")).andExpect(status().isOk)\n\n        // Cancel it again - should succeed\n        mockMvc.perform(cancelOrder(\"O-cancel-2\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n    }\n\n    @Test\n    fun `cancel_fails_409_when_shipment_confirmed_and_changes_nothing`() {\n        // Create an order\n        mockMvc.perform(createOrder(\"O-cancel-3\")).andExpect(status().isCreated)\n\n        // Create a CONFIRMED shipment\n        shipmentRepository.save(Shipment(\"S-3\", \"O-cancel-3\", \"DHL\", ShipmentStatus.CONFIRMED))\n\n        // Try to cancel - should fail with 409\n        mockMvc.perform(cancelOrder(\"O-cancel-3\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_CONFIRMED\"))\n\n        // Verify the order is still ACTIVE\n        val order = repository.findById(\"O-cancel-3\")\n        assert(order?.status == OrderStatus.ACTIVE)\n\n        // Verify the shipment is still CONFIRMED\n        val shipment = shipmentRepository.findById(\"S-3\")\n        assert(shipment?.status == ShipmentStatus.CONFIRMED)\n    }\n\n    @Test\n    fun `cancel_fails_404_for_unknown_order`() {\n        mockMvc.perform(cancelOrder(\"O-does-not-exist\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_NOT_FOUND\"))\n            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n    }\n\n    @Test\n    fun `newly_created_order_has_active_status`() {\n        mockMvc.perform(createOrder(\"O-status-1\"))\n            .andExpect(status().isCreated)\n            .andExpect(jsonPath(\"$.status\").value(\"ACTIVE\"))\n    }\n}","originalFile":"package com.unityinflow.sample.order\n\nimport org.junit.jupiter.api.BeforeEach\nimport org.junit.jupiter.api.Test\nimport org.springframework.beans.factory.annotation.Autowired\nimport org.springframework.boot.test.context.SpringBootTest\nimport org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc\nimport org.springframework.http.MediaType\nimport org.springframework.test.web.servlet.MockMvc\nimport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get\nimport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post\nimport org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath\nimport org.springframework.test.web.servlet.result.MockMvcResultMatchers.status\n\n/**\n * Baseline behaviour of the order feature. BE-002 must not break any of these.\n *\n * Note how the failure cases assert the response *body*, not just the status: the error\n * envelope is part of the API contract, so a change that returns the right status with\n * the wrong shape is a breaking change for clients.\n */\n@SpringBootTest\n@AutoConfigureMockMvc\nclass OrderControllerTest {\n\n    @Autowired\n    lateinit var mockMvc: MockMvc\n\n    @Autowired\n    lateinit var repository: InMemoryOrderRepository\n\n    @BeforeEach\n    fun reset() = repository.clear()\n\n    private fun createOrder(orderId: String, amount: String = \"49.90\") =\n        post(\"/orders\")\n            .contentType(MediaType.APPLICATION_JSON)\n            .content(\n                \"\"\"{\"orderId\":\"$orderId\",\"customerId\":\"C-1\",\"amount\":$amount,\"currency\":\"EUR\"}\"\"\",\n            )\n\n    @Test\n    fun `creates an order and returns 201`() {\n        mockMvc.perform(createOrder(\"O-1\"))\n            .andExpect(status().isCreated)\n            .andExpect(jsonPath(\"$.orderId\").value(\"O-1\"))\n    }\n\n    @Test\n    fun `reads back a created order`() {\n        mockMvc.perform(createOrder(\"O-2\")).andExpect(status().isCreated)\n\n        mockMvc.perform(get(\"/orders/O-2\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.currency\").value(\"EUR\"))\n    }\n\n    @Test\n    fun `returns 404 with the error envelope for an unknown order`() {\n        mockMvc.perform(get(\"/orders/does-not-exist\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_NOT_FOUND\"))\n            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n    }\n\n    @Test\n    fun `returns 409 with the error envelope for a duplicate order id`() {\n        mockMvc.perform(createOrder(\"O-3\")).andExpect(status().isCreated)\n\n        mockMvc.perform(createOrder(\"O-3\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_ALREADY_EXISTS\"))\n            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n    }\n}\n","structuredPatch":[{"oldStart":1,"oldLines":5,"newStart":1,"newLines":8,"lines":[" package com.unityinflow.sample.order"," ","+import com.unityinflow.sample.shipment.InMemoryShipmentRepository","+import com.unityinflow.sample.shipment.Shipment","+import com.unityinflow.sample.shipment.ShipmentStatus"," import org.junit.jupiter.api.BeforeEach"," import org.junit.jupiter.api.Test"," import org.springframework.beans.factory.annotation.Autowired"]},{"oldStart":29,"oldLines":8,"newStart":32,"newLines":14,"lines":["     @Autowired","     lateinit var repository: InMemoryOrderRepository"," ","+    @Autowired","+    lateinit var shipmentRepository: InMemoryShipmentRepository","+","     @BeforeEach","-    fun reset() = repository.clea