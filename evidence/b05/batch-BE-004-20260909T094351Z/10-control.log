tomerId\":\"C-1\",\"amount\":$amount,\"currency\":\"EUR\"}\"\"\",\n            )\n\n    private fun cancelOrder(orderId: String) =\n        post(\"/orders/$orderId/cancel\")\n            .contentType(MediaType.APPLICATION_JSON)\n\n    private fun createShipment(shipmentId: String, orderId: String) =\n        post(\"/shipments\")\n            .contentType(MediaType.APPLICATION_JSON)\n            .content(\n                \"\"\"{\"shipmentId\":\"$shipmentId\",\"orderId\":\"$orderId\",\"carrier\":\"DHL\"}\"\"\",\n            )\n\n    @Test\n    fun `creates an order and returns 201`() {\n        mockMvc.perform(createOrder(\"O-1\"))\n            .andExpect(status().isCreated)\n            .andExpect(jsonPath(\"$.orderId\").value(\"O-1\"))\n    }\n\n    @Test\n    fun `reads back a created order`() {\n        mockMvc.perform(createOrder(\"O-2\")).andExpect(status().isCreated)\n\n        mockMvc.perform(get(\"/orders/O-2\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.currency\").value(\"EUR\"))\n    }\n\n    @Test\n    fun `returns 404 with the error envelope for an unknown order`() {\n        mockMvc.perform(get(\"/orders/does-not-exist\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_NOT_FOUND\"))\n            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n    }\n\n    @Test\n    fun `returns 409 with the error envelope for a duplicate order id`() {\n        mockMvc.perform(createOrder(\"O-3\")).andExpect(status().isCreated)\n\n        mockMvc.perform(createOrder(\"O-3\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_ALREADY_EXISTS\"))\n            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n    }\n\n    @Test\n    fun `newly created order is ACTIVE`() {\n        mockMvc.perform(createOrder(\"O-4\"))\n            .andExpect(status().isCreated)\n            .andExpect(jsonPath(\"$.status\").value(\"ACTIVE\"))\n    }\n\n    @Test\n    fun `cancels an ACTIVE order and returns 200`() {\n        mockMvc.perform(createOrder(\"O-5\")).andExpect(status().isCreated)\n\n        mockMvc.perform(cancelOrder(\"O-5\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.orderId\").value(\"O-5\"))\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n    }\n\n    @Test\n    fun `cancelling an already CANCELLED order succeeds and changes nothing`() {\n        mockMvc.perform(createOrder(\"O-6\")).andExpect(status().isCreated)\n        mockMvc.perform(cancelOrder(\"O-6\")).andExpect(status().isOk)\n\n        mockMvc.perform(cancelOrder(\"O-6\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n    }\n\n    @Test\n    fun `returns 404 when cancelling a non-existent order`() {\n        mockMvc.perform(cancelOrder(\"does-not-exist\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_NOT_FOUND\"))\n    }\n\n    @Test\n    fun `cancels CREATED shipments when cancelling an order`() {\n        mockMvc.perform(createOrder(\"O-7\")).andExpect(status().isCreated)\n        mockMvc.perform(createShipment(\"S-7-1\", \"O-7\")).andExpect(status().isCreated)\n        mockMvc.perform(createShipment(\"S-7-2\", \"O-7\")).andExpect(status().isCreated)\n\n        mockMvc.perform(cancelOrder(\"O-7\")).andExpect(status().isOk)\n\n        mockMvc.perform(get(\"/shipments/S-7-1\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n        mockMvc.perform(get(\"/shipments/S-7-2\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n    }\n\n    @Test\n    fun `rejects cancel if order has a CONFIRMED shipment with 409`() {\n        mockMvc.perform(createOrder(\"O-8\")).andExpect(status().isCreated)\n        mockMvc.perform(createShipment(\"S-8\", \"O-8\")).andExpect(status().isCreated)\n\n        val shipment = com.unityinflow.sample.shipment.Shipment(\n            shipmentId = \"S-8\",\n            orderId = \"O-8\",\n            carrier = \"DHL\",\n            status = com.unityinflow.sample.shipment.ShipmentStatus.CONFIRMED,\n        )\n        shipmentRepository.save(shipment)\n\n        mockMvc.perform(cancelOrder(\"O-8\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_CANCELLED\"))\n\n        mockMvc.perform(get(\"/orders/O-8\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"ACTIVE\"))\n    }\n\n    @Test\n    fun `prevents shipment creation for CANCELLED orders`() {\n        mockMvc.perform(createOrder(\"O-9\")).andExpect(status().isCreated)\n        mockMvc.perform(cancelOrder(\"O-9\")).andExpect(status().isOk)\n\n        mockMvc.perform(createShipment(\"S-9\", \"O-9\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_CANCELLED\"))\n    }\n}","originalFile":"package com.unityinflow.sample.order\n\nimport org.junit.jupiter.api.BeforeEach\nimport org.junit.jupiter.api.Test\nimport org.springframework.beans.factory.annotation.Autowired\nimport org.springframework.boot.test.context.SpringBootTest\nimport org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc\nimport org.springframework.http.MediaType\nimport org.springframework.test.web.servlet.MockMvc\nimport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get\nimport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post\nimport org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath\nimport org.springframework.test.web.servlet.result.MockMvcResultMatchers.status\n\n/**\n * Baseline behaviour of the order feature. BE-002 must not break any of these.\n *\n * Note how the failure cases 