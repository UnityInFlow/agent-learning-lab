).isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n\n        mockMvc.perform(get(\"/shipments/S-2\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n    }\n\n    @Test\n    fun `cancelling already cancelled order succeeds and changes nothing`() {\n        mockMvc.perform(createOrder(\"O-6\")).andExpect(status().isCreated)\n\n        // First cancel\n        mockMvc.perform(post(\"/orders/O-6/cancel\"))\n            .andExpect(status().isOk)\n\n        // Second cancel - should succeed (idempotent)\n        mockMvc.perform(post(\"/orders/O-6/cancel\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n    }\n\n    @Test\n    fun `cancel with confirmed shipment returns 409 and changes nothing`() {\n        mockMvc.perform(createOrder(\"O-7\")).andExpect(status().isCreated)\n\n        // Create a shipment\n        mockMvc.perform(\n            post(\"/shipments\")\n                .contentType(MediaType.APPLICATION_JSON)\n                .content(\"\"\"{\"shipmentId\":\"S-3\",\"orderId\":\"O-7\",\"carrier\":\"DHL\"}\"\"\"),\n        ).andExpect(status().isCreated)\n\n        // Confirm the shipment by writing directly to repository (BE-003 doesn't exist yet)\n        val shipment = shipmentRepository.findById(\"S-3\")!!\n        shipmentRepository.save(shipment.copy(status = ShipmentStatus.CONFIRMED))\n\n        // Try to cancel - should fail\n        mockMvc.perform(post(\"/orders/O-7/cancel\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_CANCELLED_ERROR\"))\n            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n\n        // Verify order is still active\n        mockMvc.perform(get(\"/orders/O-7\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"ACTIVE\"))\n\n        // Verify shipment is still confirmed\n        mockMvc.perform(get(\"/shipments/S-3\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n    }\n\n    @Test\n    fun `cancelling unknown order returns 404`() {\n        mockMvc.perform(post(\"/orders/O-nonexistent/cancel\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_NOT_FOUND\"))\n            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n    }\n\n    @Test\n    fun `new order is created with ACTIVE status`() {\n        mockMvc.perform(createOrder(\"O-8\"))\n            .andExpect(status().isCreated)\n            .andExpect(jsonPath(\"$.status\").value(\"ACTIVE\"))\n    }\n}"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":1571,"cache_read_input_tokens":25183,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1571},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"654eb423-1112-4848-9096-98ba72a204a8","uuid":"d1302c95-558a-4ee3-9996-ece4e188f59b","timestamp":"2026-09-09T09:53:18.886Z","request_id":"req_011CesfJJc9Yb2mg5mpD1gBU"}
