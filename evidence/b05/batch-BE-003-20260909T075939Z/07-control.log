{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01D7aY8NLtgtCyDXR4FLMSBR","type":"tool_result","content":"1\tpackage com.unityinflow.sample.shipment\n2\t\n3\timport com.unityinflow.sample.api.ConflictException\n4\timport com.unityinflow.sample.api.ErrorCode\n5\timport com.unityinflow.sample.api.ResourceNotFoundException\n6\timport org.springframework.http.HttpStatus\n7\timport org.springframework.http.ResponseEntity\n8\timport org.springframework.web.bind.annotation.GetMapping\n9\timport org.springframework.web.bind.annotation.PathVariable\n10\timport org.springframework.web.bind.annotation.PostMapping\n11\timport org.springframework.web.bind.annotation.RequestBody\n12\timport org.springframework.web.bind.annotation.RequestMapping\n13\timport org.springframework.web.bind.annotation.RestController\n14\t\n15\t@RestController\n16\t@RequestMapping(\"/shipments\")\n17\tclass ShipmentController(\n18\t    private val repository: InMemoryShipmentRepository,\n19\t) {\n20\t\n21\t    @PostMapping\n22\t    fun create(@RequestBody request: CreateShipmentRequest): ResponseEntity<Shipment> {\n23\t        if (repository.existsById(request.shipmentId)) {\n24\t            throw ConflictException(\n25\t                ErrorCode.SHIPMENT_ALREADY_EXISTS,\n26\t                \"A shipment with id '${request.shipmentId}' already exists\",\n27\t            )\n28\t        }\n29\t\n30\t        val saved = repository.save(\n31\t            Shipment(\n32\t                shipmentId = request.shipmentId,\n33\t                orderId = request.orderId,\n34\t                carrier = request.carrier,\n35\t                status = ShipmentStatus.CREATED,\n36\t            ),\n37\t        )\n38\t        return ResponseEntity.status(HttpStatus.CREATED).body(saved)\n39\t    }\n40\t\n41\t    @PostMapping(\"/{shipmentId}/confirm\")\n42\t    fun confirm(@PathVariable shipmentId: String): Shipment {\n43\t        val shipment = repository.findById(shipmentId)\n44\t            ?: throw ResourceNotFoundException(\n45\t                ErrorCode.SHIPMENT_NOT_FOUND,\n46\t                \"No shipment with id '$shipmentId'\",\n47\t            )\n48\t\n49\t        if (shipment.status == ShipmentStatus.CANCELLED) {\n50\t            throw ConflictException(\n51\t                ErrorCode.SHIPMENT_INVALID_STATUS,\n52\t                \"Cannot confirm a shipment with status ${shipment.status}\",\n53\t            )\n54\t        }\n55\t\n56\t        if (shipment.status == ShipmentStatus.CREATED) {\n57\t            val confirmed = shipment.copy(status = ShipmentStatus.CONFIRMED)\n58\t            return repository.save(confirmed)\n59\t        }\n60\t\n61\t        return shipment\n62\t    }\n63\t\n64\t    @GetMapping(\"/{shipmentId}\")\n65\t    fun getById(@PathVariable shipmentId: String): Shipment =\n66\t        repository.findById(shipmentId)\n67\t            ?: throw ResourceNotFoundException(\n68\t                ErrorCode.SHIPMENT_NOT_FOUND,\n69\t                \"No shipment with id '$shipmentId'\",\n70\t            )\n71\t\n72\t    @GetMapping\n73\t    fun list(): List<Shipment> = repository.findAll()\n74\t}\n75\t"}]},"parent_tool_use_id":null,"session_id":"afb9616e-ebe1-4f95-b394-047aeee1bfaf","uuid":"c85dfd1e-a42b-493a-a462-1c2019b9ac2a","timestamp":"2026-09-09T08:27:19.442Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/jr/lwzz65cx5pndqqdgzhnym1pc0000gn/T/observatory-run-42f3f80b-0443-4c5a-bb80-10ff8bc4c223/sample-service/src/main/kotlin/com/unityinflow/sample/shipment/ShipmentController.kt","content":"package com.unityinflow.sample.shipment\n\nimport com.unityinflow.sample.api.ConflictException\nimport com.unityinflow.sample.api.ErrorCode\nimport com.unityinflow.sample.api.ResourceNotFoundException\nimport org.springframework.http.HttpStatus\nimport org.springframework.http.ResponseEntity\nimport org.springframework.web.bind.annotation.GetMapping\nimport org.springframework.web.bind.annotation.PathVariable\nimport org.springframework.web.bind.annotation.PostMapping\nimport org.springframework.web.bind.annotation.RequestBody\nimport org.springframework.web.bind.annotation.RequestMapping\nimport org.springframework.web.bind.annotation.RestController\n\n@RestController\n@RequestMapping(\"/shipments\")\nclass ShipmentController(\n    private val repository: InMemoryShipmentRepository,\n) {\n\n    @PostMapping\n    fun create(@RequestBody request: CreateShipmentRequest): ResponseEntity<Shipment> {\n        if (repository.existsById(request.shipmentId)) {\n            throw ConflictException(\n                ErrorCode.SHIPMENT_ALREADY_EXISTS,\n                \"A shipment with id '${request.shipmentId}' already exists\",\n            )\n        }\n\n        val saved = repository.save(\n            Shipment(\n                shipmentId = request.shipmentId,\n                orderId = request.orderId,\n                carrier = request.carrier,\n                status = ShipmentStatus.CREATED,\n            ),\n        )\n        return ResponseEntity.status(HttpStatus.CREATED).body(saved)\n    }\n\n    @PostMapping(\"/{shipmentId}/confirm\")\n    fun confirm(@PathVariable shipmentId: String): Shipment {\n        val shipment = repository.findById(shipmentId)\n            ?: throw ResourceNotFoundException(\n                ErrorCode.SHIPMENT_NOT_FOUND,\n                \"No shipment with id '$shipmentId'\",\n            )\n\n        if (shipment.status == ShipmentStatus.CANCELLED) {\n            throw ConflictException(\n                ErrorCode.SHIPMENT_INVALID_STATUS,\n                \"Cannot confirm a shipment with status ${shipment.status}\",\n            )\n        }\n\n        if (shipment.status == ShipmentStatus.CREATED) {\n            val confirmed = shipment.copy(status = ShipmentStatus.CONFIRMED)\n            return repository.save(confirmed)\n        }\n\n        return shipment\n    }\n\n    @GetMapping(\"/{shipmentId}\")\n    fun getById(@PathVariable shipmentId: String): Shipment =\n        repository.findById(shipmentId)\n            ?: throw ResourceNotFoundException(\n                ErrorCode.SHIPMENT_NOT_FOUND,\n                \"No shipment with id '$shipmentId'\",\n            )\n\n    @GetMapping\n    fun list(): List<Shipment> = repository.findAll()\n}\n","numLines":75,"startLine":1,"totalLines":75}}}
