rform(createShipment(\"S-5\")).andExpect(status().isCreated)\n\n        // First confirm\n        mockMvc.perform(\n            post(\"/shipments/S-5/confirm\")\n                .contentType(MediaType.APPLICATION_JSON)\n        )\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n\n        // Second confirm (idempotent)\n        mockMvc.perform(\n            post(\"/shipments/S-5/confirm\")\n                .contentType(MediaType.APPLICATION_JSON)\n        )\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n    }\n\n    @Test\n    fun `confirming a cancelled shipment returns 409 with error code`() {\n        // Directly create a CANCELLED shipment in the repository\n        repository.save(\n            Shipment(\n                shipmentId = \"S-cancelled\",\n                orderId = \"O-1\",\n                carrier = \"DHL\",\n                status = ShipmentStatus.CANCELLED\n            )\n        )\n\n        mockMvc.perform(\n            post(\"/shipments/S-cancelled/confirm\")\n                .contentType(MediaType.APPLICATION_JSON)\n        )\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_CANNOT_BE_CONFIRMED\"))\n    }\n\n    @Test\n    fun `confirming a non-existent shipment returns 404 with error code`() {\n        mockMvc.perform(\n            post(\"/shipments/S-missing/confirm\")\n                .contentType(MediaType.APPLICATION_JSON)\n        )\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n    }\n}"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":711,"cache_read_input_tokens":20436,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":711},"output_token