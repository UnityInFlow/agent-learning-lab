\"/shipments/S-confirm-2/confirm\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n\n        mockMvc.perform(post(\"/shipments/S-confirm-2/confirm\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n    }\n\n    @Test\n    fun `rejects confirming a cancelled shipment with 409`() {\n        repository.save(\n            Shipment(\n                shipmentId = \"S-cancelled\",\n                orderId = \"O-1\",\n                carrier = \"DHL\",\n                status = ShipmentStatus.CANCELLED,\n            ),\n        )\n\n        mockMvc.perform(post(\"/shipments/S-cancelled/confirm\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_CANNOT_CONFIRM_CANCELLED\"))\n    }\n\n    @Test\n    fun `rejects confirming a non-existent shipment with 404`() {\n        mockMvc.perform(post(\"/shipments/S-missing/confirm\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n    }\n}"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":817,"cache_read_input_tokens":21733,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":817},"output_tokens":4,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"d46de782-f925-4b08-8c72-ef7ff90d09db","uuid":"1f7130fe-a81f-44cd-8fcd-e7d3783a0959","timestamp":"2026-09-09T10:58:57.124Z","request_id":"req_011CeskKpgWdtJFopaKPVwM8"}
