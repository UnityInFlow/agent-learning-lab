onfirm\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n\n        // Retry should also succeed\n        mockMvc.perform(post(\"/shipments/S-5/confirm\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n    }\n\n    @Test\n    fun `rejects confirming a cancelled shipment`() {\n        // Create a shipment and manually set it to CANCELLED by writing to the repository directly\n        repository.save(\n            Shipment(\n                shipmentId = \"S-6\",\n                orderId = \"O-1\",\n                carrier = \"DHL\",\n                status = ShipmentStatus.CANCELLED,\n            ),\n        )\n\n        mockMvc.perform(post(\"/shipments/S-6/confirm\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_CANNOT_CONFIRM_CANCELLED\"))\n    }\n\n    @Test\n    fun `rejects confirming a non-existent shipment`() {\n        mockMvc.perform(post(\"/shipments/S-missing/confirm\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n    }\n}"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":632,"cache_read_input_tokens":18432,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":632},"output_tokens":4,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"602e4904-947d-4bec-bb30-d95c88566eb1","uuid":"0d3ee636-2c6d-41bc-91b8-6aec2b94712e","timestamp":"2026-09-09T10:56:23.531Z","request_id":"req_011Cesk8VFQpByfk9yM4isst"}
