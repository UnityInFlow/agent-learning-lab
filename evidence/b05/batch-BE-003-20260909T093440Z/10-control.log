{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DZ3g6VubTK4ntJU39EfHrS","type":"tool_result","content":"1\tpackage com.unityinflow.sample.api\n2\t\n3\t/**\n4\t * The error contract of this service.\n5\t *\n6\t * Every error response carries the same envelope, so clients can branch on a stable\n7\t * `code` instead of parsing prose:\n8\t *\n9\t * ```json\n10\t * { \"error\": { \"code\": \"ORDER_NOT_FOUND\", \"message\": \"No order with id 'O-9'\", \"fields\": [] } }\n11\t * ```\n12\t *\n13\t * Responses are produced centrally by [GlobalExceptionHandler]; controllers throw an\n14\t * [ApiException] rather than assembling bodies themselves.\n15\t */\n16\tdata class ApiError(val error: ApiErrorBody)\n17\t\n18\tdata class ApiErrorBody(\n19\t    val code: ErrorCode,\n20\t    val message: String,\n21\t    val fields: List<FieldViolation> = emptyList(),\n22\t)\n23\t\n24\t/** Which input was rejected and why — populated for validation failures. */\n25\tdata class FieldViolation(val field: String, val message: String)\n26\t\n27\t/**\n28\t * The closed set of machine-readable error codes. Clients switch on these, so a code is\n29\t * part of the public API: add one deliberately, never rename one casually.\n30\t */\n31\tenum class ErrorCode {\n32\t    ORDER_NOT_FOUND,\n33\t    ORDER_ALREADY_EXISTS,\n34\t    SHIPMENT_NOT_FOUND,\n35\t    SHIPMENT_ALREADY_EXISTS,\n36\t    SHIPMENT_ALREADY_CANCELLED,\n37\t    VALIDATION_FAILED,\n38\t}\n39\t"}]},"parent_tool_use_id":null,"session_id":"782d60db-4d8a-49ba-b7de-9a534d12081e","uuid":"a2a84846-afec-40e3-9189-2c5ad391bb68","timestamp":"2026-09-09T09:42:25.859Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/jr/lwzz65cx5pndqqdgzhnym1pc0000gn/T/observatory-run-c549ec18-2fd2-46b2-b6b3-5971f92a5f3e/sample-service/src/main/kotlin/com/unityinflow/sample/api/ApiError.kt","content":"package com.unityinflow.sample.api\n\n/**\n * The error contract of this service.\n *\n * Every error response carries the same envelope, so clients can branch on a stable\n * `code` instead of parsing prose:\n *\n * ```json\n * { \"error\": { \"code\": \"ORDER_NOT_FOUND\", \"message\": \"No order with id 'O-9'\", \"fields\": [] } }\n * ```\n *\n * Responses are produced centrally by [GlobalExceptionHandler]; controllers throw an\n * [ApiException] rather than assembling bodies themselves.\n */\ndata class ApiError(val error: ApiErrorBody)\n\ndata class ApiErrorBody(\n    val code: ErrorCode,\n    val message: String,\n    val fields: List<FieldViolation> = emptyList(),\n)\n\n/** Which input was rejected and why — populated for validation failures. */\ndata class FieldViolation(val field: String, val message: String)\n\n/**\n * The closed set of machine-readable error codes. Clients switch on these, so a code is\n * part of the public API: add one deliberately, never rename one casually.\n */\nenum class ErrorCode {\n    ORDER_NOT_FOUND,\n    ORDER_ALREADY_EXISTS,\n    SHIPMENT_NOT_FOUND,\n    SHIPMENT_ALREADY_EXISTS,\n    SHIPMENT_ALREADY_CANCELLED,\n    VALIDATION_FAILED,\n}\n","numLines":39,"startLine":1,"totalLines":39}}}
