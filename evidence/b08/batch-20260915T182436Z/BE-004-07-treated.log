      .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n\n        // Retry the cancel\n        mockMvc.perform(post(\"/orders/O-5/cancel\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n    }\n\n    @Test\n    fun `rejects cancel if order has a confirmed shipment`() {\n        mockMvc.perform(createOrder(\"O-6\")).andExpect(status().isCreated)\n\n        // Create a shipment manually in CONFIRMED state\n        val confirmedShipment = Shipment(\"S-6\", \"O-6\", \"DHL\", ShipmentStatus.CONFIRMED)\n        shipmentRepository.save(confirmedShipment)\n\n        mockMvc.perform(post(\"/orders/O-6/cancel\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_CONFIRMED_SHIPMENT_EXISTS\"))\n            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n\n        // Verify order is still ACTIVE\n        mockMvc.perform(get(\"/orders/O-6\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"ACTIVE\"))\n\n        // Verify shipment is still CONFIRMED\n        mockMvc.perform(get(\"/shipments/S-6\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n    }\n\n    @Test\n    fun `returns 404 when cancelling non-existent order`() {\n        mockMvc.perform(post(\"/orders/O-does-not-exist/cancel\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_NOT_FOUND\"))\n            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n    }\n\n    @Test\n    fun `cancels created shipments when order is cancelled`() {\n        mockMvc.perform(createOrder(\"O-7\")).andExpect(status().isCreated)\n\n        // Create multiple shipments\n        val shipment1 = Shipment(\"S-7-1\", \"O-7\", \"DHL\", ShipmentStatus.CREATED)\n        val shipment2 = Shipment(\"S-7-2\", \"O-7\", \"UPS\", ShipmentStatus.CREATED)\n        shipmentRepository.save(shipment1)\n        shipmentRepository.save(shipment2)\n\n        mockMvc.perform(post(\"/orders/O-7/cancel\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n\n        // Verify both shipments are now CANCELLED\n        mockMvc.perform(get(\"/shipments/S-7-1\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n\n        mockMvc.perform(get(\"/shipments/S-7-2\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n    }\n}"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":504,"cache_read_input_tokens":32104,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":504},"output_tokens":8,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"5d75d319-d986-4fac-aa07-dfc361a1e415","uuid":"4ea02949-9b3a-44ab-a7e4-40b44d2f1d5f","timestamp":"2026-09-16T07:10:40.742Z","request_id":"req_011Cf6haf7fFLdmTwsNX384J","wire_tool_inputs":{"toolu_019V17zUacmr8uz3EwS9LYvY":{"file_path":"/private/var/folders/jr/lwzz65cx5pndqqdgzhnym1pc0000gn/T/observatory-run-7792f10e-ceb3-4bcf-aca1-1d16727d1f9c/sample-service/src/test/kotlin/com/unityinflow/sample/order/OrderControllerTest.kt","old_string":"    @Test\n    fun `returns 409 with the error envelope for a duplicate order id`() {\n        mockMvc.perform(createOrder(\"O-3\")).andExpect(status().isCreated)\n\n        mockMvc.perform(createOrder(\"O-3\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_ALREADY_EXISTS\"))\n            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n    }\n}","new_string":"    @Test\n    fun `returns 409 with t