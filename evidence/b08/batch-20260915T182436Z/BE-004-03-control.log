ror.code\").value(\"ORDER_CANNOT_BE_CANCELLED\"))\n\n        // Verify order is still ACTIVE\n        mockMvc.perform(get(\"/orders/O-7\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"ACTIVE\"))\n\n        // Verify shipment is still CONFIRMED\n        mockMvc.perform(get(\"/shipments/S-3\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n    }\n\n    @Test\n    fun `returns 404 when cancelling a non-existent order`() {\n        mockMvc.perform(post(\"/orders/O-missing/cancel\").contentType(MediaType.APPLICATION_JSON))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_NOT_FOUND\"))\n    }\n}"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":543,"cache_read_input_tokens":28994,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":543},"output_tokens":8,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"ff1cf43c-e5f2-4ec2-be70-a9358d261176","uuid":"184634ba-a0e0-4141-a101-0dcbe9ae3bc4","timestamp":"2026-09-15T19:42:37.705Z","request_id":"req_011Cf5o7YMouaWka3jgifeeb","wire_tool_inputs":{"toolu_01GMS44Xm75afenpjEuNoMMk":{"file_path":"/private/var/folders/jr/lwzz65cx5pndqqdgzhnym1pc0000gn/T/observatory-run-e8bb7e73-b596-4127-a5ae-945a1bfbc66d/sample-service/src/test/kotlin/com/unityinflow/sample/order/OrderControllerTest.kt","old_string":"    @Test\n    fun `returns 409 with the error envelope for a duplicate order id`() {\n        mockMvc.perform(createOrder(\"O-3\")).andExpect(status().isCreated)\n\n        mockMvc.perform(createOrder(\"O-3\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_ALREADY_EXISTS\"))\n 