einit var mockMvc: MockMvc\n\n    @Autowired\n    lateinit var repository: InMemoryOrderRepository\n\n    @BeforeEach\n    fun reset() = repository.clear()\n\n    private fun createOrder(orderId: String, amount: String = \"49.90\") =\n        post(\"/orders\")\n            .contentType(MediaType.APPLICATION_JSON)\n            .content(\n                \"\"\"{\"orderId\":\"$orderId\",\"customerId\":\"C-1\",\"amount\":$amount,\"currency\":\"EUR\"}\"\"\",\n            )\n\n    @Test\n    fun `creates an order and returns 201`() {\n        mockMvc.perform(createOrder(\"O-1\"))\n            .andExpect(status().isCreated)\n            .andExpect(jsonPath(\"$.orderId\").value(\"O-1\"))\n    }\n\n    @Test\n    fun `reads back a created order`() {\n        mockMvc.perform(createOrder(\"O-2\")).andExpect(status().isCreated)\n\n        mockMvc.perform(get(\"/orders/O-2\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.currency\").value(\"EUR\"))\n    }\n\n    @Test\n    fun `returns 404 with the error envelope for an unknown order`() {\n        mockMvc.perform(get(\"/orders/does-not-exist\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_NOT_FOUND\"))\n            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n    }\n\n    @Test\n    fun `returns 409 with the error envelope for a duplicate order id`() {\n        mockMvc.perform(createOrder(\"O-3\")).andExpect(status().isCreated)\n\n        mockMvc.perform(createOrder(\"O-3\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_ALREADY_EXISTS\"))\n            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n    }\n}","newString":"package com.unityinflow.sample.order\n\nimport com.unityinflow.sample.shipment.InMemoryShipmentRepository\nimport com.unityinflow.sample.shipment.Shipment\nimport com.unityinflow.sample.shipment.ShipmentStatus\nimport org.junit.jupiter.api.BeforeEach\nimport org.junit.jupiter.api.Test\nimport org.springframework.beans.factory.annotation.Autowired\nimport org.springframework.boot.test.context.SpringBootTest\nimport org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc\nimport org.springframework.http.MediaType\nimport org.springframework.test.web.servlet.MockMvc\nimport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get\nimport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post\nimport org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath\nimport org.springframework.test.web.servlet.result.MockMvcResultMatchers.status\n\n/**\n * Baseline behaviour of the order feature. BE-002 must not break any of these.\n *\n * Note how the failure cases assert the response *body*, not just the status: the error\n * envelope is part of the API contract, so a change that returns the right status with\n * the wrong shape is a breaking change for clients.\n */\n@SpringBootTest\n@AutoConfigureMockMvc\nclass OrderControllerTest {\n\n    @Autowired\n    lateinit var mockMvc: MockMvc\n\n    @Autowired\n    lateinit var repository: InMemoryOrderRepository\n\n    @Autowired\n    lateinit var shipmentRepository: InMemoryShipmentRepository\n\n    @BeforeEach\n    fun reset() {\n        repository.clear()\n        shipmentRepository.clear()\n    }\n\n    private fun createOrder(orderId: String, amount: String = \"49.90\") =\n        post(\"/orders\")\n            .contentType(MediaType.APPLICATION_JSON)\n            .content(\n                \"\"\"{\"orderId\":\"$orderId\",\"customerId\":\"C-1\",\"amount\":$amount,\"currency\":\"EUR\"}\"\"\",\n            )\n\n    @Test\n    fun `creates an order and returns 201`() {\n        mockMvc.perform(createOrder(\"O-1\"))\n            .andExpect(status().isCreated)\n            .andExpect(jsonPath(\"$.orderId\").value(\"O-1\"))\n    }\n\n    @Test\n    fun `reads back a created order`() {\n        mockMvc.perform(createOrder(\"O-2\")).andExpect(status().isCreated)\n\n        mockMvc.perform(get(\"/orders/O-2\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.currency\").value(\"EUR\"))\n    }\n\n    @Test\n    fun `returns 404 with the error envelope for an unknown order`() {\n        mockMvc.perform(get(\"/orders/does-not-exist\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_NOT_FOUND\"))\n            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n    }\n\n    @Test\n    fun `returns 409 with the error envelope for a duplicate order id`() {\n        mockMvc.perform(createOrder(\"O-3\")).andExpect(status().isCreated)\n\n        mockMvc.perform(createOrder(\"O-3\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_ALREADY_EXISTS\"))\n            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n    }\n\n    @Test\n    fun `newly created order has ACTIVE status`() {\n        mockMvc.perform(createOrder(\"O-new\"))\n            .andExpect(status().isCreated)\n            .andExpect(jsonPath(\"$.status\").value(\"ACTIVE\"))\n    }\n\n    @Test\n    fun `cancels an ACTIVE order and returns 200 with CANCELLED status`() {\n        mockMvc.perform(createOrder(\"O-to-cancel\")).andExpect(status().isCreated)\n\n        mockMvc.perform(post(\"/orders/O-to-cancel/cancel\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n            .andExpect(jsonPath(\"$.orderId\").value(\"O-to-cancel\"))\n    }\n\n    @Test\n    fun `cancelling a CANCELLED order succeeds and returns 200 (idempotent)`() {\n        mockMvc.perform(createOrder(\"O-idempotent\")).andExpect(status().isCreated)\n\n        // First cancel\n        mockMvc.perform(post(\"/orders/O-idempotent/cancel\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n\n        // Second cancel (should also succeed)\n        mockMvc.perform(post(\"/orders/O-idempotent/cancel\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n    }\n\n    @Test\n    fun `cancelling a non-existent order returns 404 ORDER_NOT_FOUND`() {\n        mockMvc.perform(post(\"/orders/O-missing/cancel\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_NOT_FOUND\"))\n            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n    }\n\n    @Test\n    fun `cancelling an order cancels all CREATED shipments`() {\n        mockMvc.perform(createOrder(\"O-with-shipments\")).andExpect(status().isCreated)\n\n        // Create two CREATED shipments\n        shipmentRepository.save(\n            Shipment(\"S-1\", \"O-with-shipments\", \"DHL\", ShipmentStatus.CREATED),\n        )\n        shipmentRepository.save(\n            Shipment(\"S-2\", \"O-with-shipments\", \"UPS\", ShipmentStatus.CREATED),\n        )\n\n        // Cancel the order\n        mockMvc.perform(post(\"/orders/O-with-shipments/cancel\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n\n        // Verify shipments are now CANCELLED\n        mockMvc.perform(get(\"/shipments/S-1\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n\n        mockMvc.perform(get(\"/shipments/S-2\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n    }\n\n    @Test\n    fun `cancelling an order with a CONFIRMED shipment is rejected with 409 and nothing changes`() {\n        mockMvc.perform(createOrder(\"O-with-confirmed\")).andExpect(status().isCreated)\n\n        // Create a CONFIRMED shipment\n        shipmentRepository.save(\n            Shipment(\"S-confirmed\", \"O-with-confirmed\", \"DHL\", ShipmentStatus.CONFIRMED),\n        )\n\n        // Attempt to cancel\n        mockMvc.perform(post(\"/orders/O-with-confirmed/cancel\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_CANNOT_BE_CANCELLED\"))\n            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n\n        // Verify order is still ACTIVE\n        mockMvc.perform(get(\"/orders/O-with-confirmed\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"ACTIVE\"))\n\n        // Verify shipment is still CONFIRMED\n        mockMvc.perform(get(\"/shipments/S-confirmed\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n    }\n\n    @Test\n    fun `cancelling an order with mixed shipments (CREATED and CONFIRMED) is rejected`() {\n        mockMvc.perform(createOrder(\"O-mixed\")).andExpect(status().isCreated)\n\n        // Create both CREATED and CONFIRMED shipments\n        shipmentRepository.save(\n            Shipment(\"S-created\", \"O-mixed\", \"DHL\", ShipmentStatus.CREATED),\n        )\n        shipmentRepository.save(\n            Shipment(\"S-confirmed\", \"O-mixed\", \"UPS\", ShipmentStatus.CONFIRMED),\n        )\n\n        // Attempt to cancel\n        mockMvc.perform(post(\"/orders/O-mixed/cancel\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_CANNOT_BE_CANCELLED\"))\n\n        // Verify order is still ACTIVE\n        mockMvc.perform(get(\"/orders/O-mixed\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"ACTIVE\"))\n\n        // Verify CREATED shipment is still CREATED\n        mockMvc.perform(get(\"/shipments/S-created\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CREATED\"))\n\n        // Verify CONFIRMED shipment is still CONFIRMED\n        mockMvc.perform(get(\"/shipments/S-confirmed\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n    }\n\n    @Test\n    fun `cancelled order status persists across reads`() {\n        mockMvc.perform(createOrder(\"O-persist\")).andExpect(status().isCreated)\n\n        // Cancel the order\n        mockMvc.perform(post(\"/orders/O-persist/cancel\"))\n            .andExpect(status().isOk)\n\n        // Read back and verify it's still CANCELLED\n        mockMvc.perform(get(\"/orders/O-persist\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n    }\n}","originalFile":"package com.unityinflow.sample.order\n\nimport org.junit.jupiter.api.BeforeEach\nimport org.junit.jupiter.api.Test\nimport org.springframework.beans.factory.annotation.Autowired\nimport org.springframework.boot.test.context.SpringBootTest\nimport org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc\nimport org.springframework.http.MediaType\nimport org.springframework.test.web.servlet.MockMvc\nimport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get\nimport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post\nimport org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath\nimport org.springframework.test.web.servlet.result.MockMvcResultMatchers.status\n\n/**\n * Baseline behaviour of the order feature. BE-002 must not break any of these.\n *\n * Note how the failure cases assert the response *body*, not just the status: the error\n * envelope is part of the API contract, so a change that returns the right status with\n * the wrong shape is a breaking change for clients.\n */\n@SpringBootTest\n@AutoConfigureMockMvc\nclass OrderControllerTest {\n\n    @Autowired\n    lateinit var mockMvc: MockMvc\n\n    @Autowired\n    lateinit var repository: InMemoryOrderRepository\n\n    @BeforeEach\n    fun reset() = repository.clear()\n\