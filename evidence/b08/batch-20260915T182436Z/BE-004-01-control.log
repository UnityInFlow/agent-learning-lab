(\"/orders/O-missing/cancel\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_NOT_FOUND\"))\n            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n    }\n\n    @Test\n    fun `cancelling an order cancels all CREATED shipments`() {\n        mockMvc.perform(createOrder(\"O-with-shipments\")).andExpect(status().isCreated)\n\n        // Create two CREATED shipments\n        shipmentRepository.save(\n            Shipment(\"S-1\", \"O-with-shipments\", \"DHL\", ShipmentStatus.CREATED),\n        )\n        shipmentRepository.save(\n            Shipment(\"S-2\", \"O-with-shipments\", \"UPS\", ShipmentStatus.CREATED),\n        )\n\n        // Cancel the order\n        mockMvc.perform(post(\"/orders/O-with-shipments/cancel\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n\n        // Verify shipments are now CANCELLED\n        mockMvc.perform(get(\"/shipments/S-1\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n\n        mockMvc.perform(get(\"/shipments/S-2\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n    }\n\n    @Test\n    fun `cancelling an order with a CONFIRMED shipment is rejected with 409 and nothing changes`() {\n        mockMvc.perform(createOrder(\"O-with-confirmed\")).andExpect(status().isCreated)\n\n        // Create a CONFIRMED shipment\n        shipmentRepository.save(\n            Shipment(\"S-confirmed\", \"O-with-confirmed\", \"DHL\", ShipmentStatus.CONFIRMED),\n        )\n\n        // Attempt to cancel\n        mockMvc.perform(post(\"/orders/O-with-confirmed/cancel\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_CANNOT_BE_CANCELLED\"))\n            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n\n        // Verify order