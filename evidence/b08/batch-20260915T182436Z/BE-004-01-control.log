st\n    fun `creates a shipment for an ACTIVE order`() {\n        // Create an ACTIVE order\n        val activeOrder = Order(\n            orderId = \"O-active\",\n            customerId = \"C-1\",\n            amount = BigDecimal(\"49.90\"),\n            currency = \"EUR\",\n            status = OrderStatus.ACTIVE,\n        )\n        orderRepository.save(activeOrder)\n\n        // Create a shipment for the ACTIVE order\n        mockMvc.perform(createShipment(\"S-active\", \"O-active\"))\n            .andExpect(status().isCreated)\n            .andExpect(jsonPath(\"$.orderId\").value(\"O-active\"))\n            .andExpect(jsonPath(\"$.status\").value(\"CREATED\"))\n    }\n\n    @Test\n    fun `creates a shipment for a non-existent order (keeps current behaviour)`() {\n        // Create a shipment for a non-existent order (should succeed)\n        mockMvc.perform(createShipment(\"S-no-order\", \"O-missing\"))\n            .andExpect(status().isCreated)\n            .andExpect(jsonPath(\"$.orderId\").value(\"O-missing\"))\n            .andExpect(jsonPath(\"$.status\").value(\"CREATED\"))\n    }\n}"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":3726,"cache_read_input_tokens":28674,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3726},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"9b0e5ed8-e134-42fc-b402-d223c1ef56ae","uuid":"625ef244-f957-407b-8136-8c95ea7055f8","timestamp":"2026-09-15T19:28:34.906Z","request_id":"req_011Cf5n2Q9wN185v31Zkg4YY","wire_tool_inputs":{"toolu_01ThVs3iwys3enb8WAVsiGbc":{"file_path":"/private/var/folders/jr/lwzz65cx5pndqqdgzhnym1pc0000gn/T/observatory-run-19c31787-da83-4958-a833-19582d08ac5d/sample-service/src/test/kotlin/com/unityinflow/sample/shipment/ShipmentControllerTest.kt","old_s