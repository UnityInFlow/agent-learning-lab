 fun findById(orderId: String): Order? = store[orderId]\n\n    fun findAll(): List<Order> = store.values.sortedBy { it.orderId }\n\n    fun clear() = store.clear()\n}\n","numLines":28,"startLine":1,"totalLines":28}}}
