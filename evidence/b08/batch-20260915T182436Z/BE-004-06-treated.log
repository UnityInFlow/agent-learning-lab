{"type":"assistant","message":{"model":"claude-haiku-4-5-20251001","id":"msg_011Cf6h2AY4pUEex7VZJXVgF","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01NpzL2zioDvR9Pq3V6iShUt","name":"Edit","input":{"replace_all":false,"file_path":"/private/var/folders/jr/lwzz65cx5pndqqdgzhnym1pc0000gn/T/observatory-run-eb2fe52a-6374-4a83-84c8-98079b8a9f4f/sample-service/src/test/kotlin/com/unityinflow/sample/order/OrderControllerTest.kt","old_string":"package com.unityinflow.sample.order\n\nimport org.junit.jupiter.api.BeforeEach\nimport org.junit.jupiter.api.Test\nimport org.springframework.beans.factory.annotation.Autowired\nimport org.springframework.boot.test.context.SpringBootTest\nimport org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc\nimport org.springframework.http.MediaType\nimport org.springframework.test.web.servlet.MockMvc\nimport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get\nimport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post\nimport org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath\nimport org.springframework.test.web.servlet.result.MockMvcResultMatchers.status\n\n/**\n * Baseline behaviour of the order feature. BE-002 must not break any of these.\n *\n * Note how the failure cases assert the response *body*, not just the status: the error\n * envelope is part of the API contract, so a change that returns the right status with\n * the wrong shape is a breaking change for clients.\n */\n@SpringBootTest\n@AutoConfigureMockMvc\nclass OrderControllerTest {\n\n    @Autowired\n    lateinit var mockMvc: MockMvc\n\n    @Autowired\n    lateinit var repository: InMemoryOrderRepository\n\n    @BeforeEach\n    fun reset() = repository.clear()\n\n    private fun createOrder(orderId: String, amount: String = \"49.90\") =\n        post(\"/orders\")\n            .contentType(MediaType.APPLICATION_JSON)\n            .content(\n                \"\"\"{\"orderId\":\"$orderId\",\"customerId\":\"C-1\",\"amount\":$amount,\"currency\":\"EUR\"}\"\"\",\n            )\n\n    @Test\n    fun `creates an order and returns 201`() {\n        mockMvc.perform(createOrder(\"O-1\"))\n            .andExpect(status().isCreated)\n            .andExpect(jsonPath(\"$.orderId\").value(\"O-1\"))\n    }\n\n    @Test\n    fun `reads back a created order`() {\n        mockMvc.perform(createOrder(\"O-2\")).andExpect(status().isCreated)\n\n        mockMvc.perform(get(\"/orders/O-2\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.currency\").value(\"EUR\"))\n    }\n\n    @Test\n    fun `returns 404 with the error envelope for an unknown order`() {\n        mockMvc.perform(get(\"/orders/does-not-exist\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_NOT_FOUND\"))\n            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n    }\n\n    @Test\n    fun `returns 409 with the error envelope for a duplicate order id`() {\n        mockMvc.perform(createOrder(\"O-3\")).andExpect(status().isCreated)\n\n        mockMvc.perform(createOrder(\"O-3\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_ALREADY_EXISTS\"))\n            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n    }\n}","new_string":"package com.unityinflow.sample.order\n\nimport com.unityinflow.sample.shipment.InMemoryShipmentRepository\nimport com.unityinflow.sample.shipment.Shipment\nimport com.unityinflow.sample.shipment.ShipmentStatus\nimport org.junit.jupiter.api.BeforeEach\nimport org.junit.jupiter.api.Test\nimport org.springframework.beans.factory.annotation.Autowired\nimport org.springframework.boot.test.context.SpringBootTest\nimport org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc\nimport org.springframework.http.MediaType\nimport org.springframework.test.web.servlet.MockMvc\nimport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get\nimport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post\nimport org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath\nimport org.springframework.test.web.servlet.result.MockMvcResultMatchers.status\n\n/**\n * Baseline behaviour of the order feature. BE-002 must not break any of these.\n *\n * Note how the failure cases assert the response *body*, not just the status: the error\n * envelope is part of the API contract, so a change that returns the right status with\n * the wrong shape is a breaking change for clients.\n */\n@SpringBootTest\n@AutoConfigureMockMvc\nclass OrderControllerTest {\n\n    @Autowired\n    lateinit var mockMvc: MockMvc\n\n    @Autowired\n    lateinit var repository: InMemoryOrderRepository\n\n    @Autowired\n    lateinit var shipmentRepository: InMemoryShipmentRepository\n\n    @BeforeEach\n    fun reset() {\n        repository.clear()\n        shipmentRepository.clear()\n    }\n\n    private fun createOrder(orderId: String, amount: String = \"49.90\") =\n        post(\"/orders\")\n            .contentType(MediaType.APPLICATION_JSON)\n            .content(\n                \"\"\"{\"orderId\":\"$orderId\",\"customerId\":\"C-1\",\"amount\":$amount,\"currency\":\"EUR\"}\"\"\",\n            )\n\n    private fun cancelOrder(orderId: String) =\n        post(\"/orders/$orderId/cancel\")\n            .contentType(MediaType.APPLICATION_JSON)\n\n    @Test\n    fun `creates an order and returns 201`() {\n        mockMvc.perform(createOrder(\"O-1\"))\n            .andExpect(status().isCreated)\n            .andExpect(jsonPath(\"$.orderId\").value(\"O-1\"))\n            .andExpect(jsonPath(\"$.status\").value(\"ACTIVE\"))\n    }\n\n    @Test\n    fun `reads back a created order`() {\n        mockMvc.perform(createOrder(\"O-2\")).andExpect(status().isCreated)\n\n        mockMvc.perform(get(\"/orders/O-2\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.currency\").value(\"EUR\"))\n            .andExpect(jsonPath(\"$.status\").value(\"ACTIVE\"))\n    }\n\n    @Test\n    fun `returns 404 with the error envelope for an unknown order`() {\n        mockMvc.perform(get(\"/orders/does-not-exist\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_NOT_FOUND\"))\n            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n    }\n\n    @Test\n    fun `returns 409 with the error envelope for a duplicate order id`() {\n        mockMvc.perform(createOrder(\"O-3\")).andExpect(status().isCreated)\n\n        mockMvc.perform(createOrder(\"O-3\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_ALREADY_EXISTS\"))\n            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n    }\n\n    @Test\n    fun `cancels an active order and returns 200`() {\n        mockMvc.perform(createOrder(\"O-cancel-1\")).andExpect(status().isCreated)\n\n        mockMvc.perform(cancelOrder(\"O-cancel-1\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.orderId\").value(\"O-cancel-1\"))\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n    }\n\n    @Test\n    fun `cancels an active order and cancels its created shipments`() {\n        mockMvc.perform(createOrder(\"O-cancel-2\")).andExpect(status().isCreated)\n\n        // Create a shipment for the order\n        mockMvc.perform(\n            post(\"/shipments\")\n                .contentType(MediaType.APPLICATION_JSON)\n                .content(\"\"\"{\"shipmentId\":\"S-cancel-1\",\"orderId\":\"O-cancel-2\",\"carrier\":\"DHL\"}\"\"\")\n        ).andExpect(status().isCreated)\n\n        // Cancel the order\n        mockMvc.perform(cancelOrder(\"O-cancel-2\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n\n        // Verify the shipment is also cancelled\n        mockMvc.perform(get(\"/shipments/S-cancel-1\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n    }\n\n    @Test\n    fun `cancelling an already-cancelled order succeeds idempotently`() {\n        mockMvc.perform(createOrder(\"O-cancel-3\")).andExpect(status().isCreated)\n\n        // First cancel\n        mockMvc.perform(cancelOrder(\"O-cancel-3\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n\n        // Second cancel should also succeed\n        mockMvc.perform(cancelOrder(\"O-cancel-3\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n\n        // Verify order is still cancelled\n        mockMvc.perform(get(\"/orders/O-cancel-3\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n    }\n\n    @Test\n    fun `cancelling an order with a confirmed shipment fails with 409 and changes nothing`() {\n        mockMvc.perform(createOrder(\"O-cancel-4\")).andExpect(status().isCreated)\n\n        // Create a shipment and manually set it to CONFIRMED\n        val shipment = Shipment(\n            shipmentId = \"S-cancel-2\",\n            orderId = \"O-cancel-4\",\n            carrier = \"DHL\",\n            status = ShipmentStatus.CONFIRMED\n        )\n        shipmentRepository.save(shipment)\n\n        // Try to cancel the order\n        mockMvc.perform(cancelOrder(\"O-cancel-4\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_HAS_CONFIRMED_SHIPMENT\"))\n\n        // Verify order is still ACTIVE\n        mockMvc.perform(get(\"/orders/O-cancel-4\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"ACTIVE\"))\n\n        // Verify shipment is still CONFIRMED\n        mockMvc.perform(get(\"/shipments/S-cancel-2\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n    }\n\n    @Test\n    fun `cancelling a non-existent order returns 404`() {\n        mockMvc.perform(cancelOrder(\"O-does-not-exist\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_NOT_FOUND\"))\n    }\n\n    @Test\n    fun `creating a shipment for a cancelled order fails with 409`() {\n        mockMvc.perform(createOrder(\"O-cancel-5\")).andExpect(status().isCreated)\n\n        // Cancel the order\n        mockMvc.perform(cancelOrder(\"O-cancel-5\"))\n            .andExpect(status().isOk)\n\n        // Try to create a shipment for the cancelled order\n        mockMvc.perform(\n            post(\"/shipments\")\n                .contentType(MediaType.APPLICATION_JSON)\n                .content(\"\"\"{\"shipmentId\":\"S-cancel-3\",\"orderId\":\"O-cancel-5\",\"carrier\":\"DHL\"}\"\"\")\n        ).andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_CANCELLED\"))\n    }\n}"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":1543,"cache_read_input_tokens":29706,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1543},"output_tokens":5,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"6d568ecb-f5ca-4a72-980c-19dd0eec9c73","uuid":"96d6ec21-cd09-4360-a8c9-39114a0de58d","timestamp":"2026-09-16T07:03:27.613Z","request_id":"req_011Cf6h29qPUbgC8t871Kyzm","wire_tool_inputs":{"toolu_01NpzL2zioDvR9Pq3V6iShUt":{"file_path":"/private/var/folders/jr/lwzz65cx5pndqqdgzhnym1pc0000gn/T/observatory-run-eb2fe52a-6374-4a83-84c8-98079b8a9f4f/sample-service/src/test/kotlin/com/unityinflow/sample/order/OrderControllerTest.kt","old_string":"package com.unityinflow.sample.order\n\nimport org.junit.jupiter.api.BeforeEach\nimport org.junit.jupiter.api.Test\nimport org.springframework.beans.factory.annotation.Autowired\nimport org.springframework.boot.test.context.SpringBootTest\nimport org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc\nimport org.springframework.http.MediaType\nimport org.springframework.test.web.servlet.MockMvc\nimport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get\nimport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post\nimport org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath\nimport org.springframework.test.web.servlet.result.MockMvcResultMatchers.status\n\n/**\n * Baseline behaviour of the order feature. BE-002 must not break any of these.\n *\n * Note how the failure cases assert the response *body*, not just the status: the error\n * envelope is part of the API contract, so a change that returns the right status with\n * the wrong shape is a breaking change for clients.\n */\n@SpringBootTest\n@AutoConfigureMockMvc\nclass OrderControllerTest {\n\n    @Autowired\n    lateinit var mockMvc: MockMvc\n\n    @Autowired\n    lateinit var repository: InMemoryOrderRepository\n\n    @BeforeEach\n    fun reset() = repository.clear()\n\n    private fun createOrder(orderId: String, amount: String = \"49.90\") =\n        post(\"/orders\")\n            .contentType(MediaType.APPLICATION_JSON)\n            .content(\n                \"\"\"{\"orderId\":\"$orderId\",\"customerId\":\"C-1\",\"amount\":$amount,\"currency\":\"EUR\"}\"\"\",\n            )\n\n    @Test\n    fun `creates an order and returns 201`() {\n        mockMvc.perform(createOrder(\"O-1\"))\n            .andExpect(status().isCreated)\n            .andExpect(jsonPath(\"$.orderId\").value(\"O-1\"))\n    }\n\n    @Test\n    fun `reads back a created order`() {\n        mockMvc.perform(createOrder(\"O-2\")).andExpect(status().isCreated)\n\n        mockMvc.perform(get(\"/orders/O-2\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.currency\").value(\"EUR\"))\n    }\n\n    @Test\n    fun `returns 404 with the error envelope for an unknown order`() {\n        mockMvc.perform(get(\"/orders/does-not-exist\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_NOT_FOUND\"))\n            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n    }\n\n    @Test\n    fun `returns 409 with the error envelope for a duplicate order id`() {\n        mockMvc.perform(createOrder(\"O-3\")).andExpect(status().isCreated)\n\n        mockMvc.perform(createOrder(\"O-3\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_ALREADY_EXISTS\"))\n            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n    }\n}","new_string":"package com.unityinflow.sample.order\n\nimport com.unityinflow.sample.shipment.InMemoryShipmentRepository\nimport com.unityinflow.sample.shipment.Shipment\nimport com.unityinflow.sample.shipment.ShipmentStatus\nimport org.junit.jupiter.api.BeforeEach\nimport org.junit.jupiter.api.Test\nimport org.springframework.beans.factory.annotation.Autowired\nimport org.springframework.boot.test.context.SpringBootTest\nimport org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc\nimport org.springframework.http.MediaType\nimport org.springframework.test.web.servlet.MockMvc\nimport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get\nimport org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post\nimport org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath\nimport org.springframework.test.web.servlet.result.MockMvcResultMatchers.status\n\n/**\n * Baseline behaviour of the order feature. BE-002 must not break any of these.\n *\n * Note how the failure cases assert the response *body*, not just the status: the error\n * envelope is part of the API contract, so a change that returns the right status with\n * the wrong shape is a breaking change for clients.\n */\n@SpringBootTest\n@AutoConfigureMockMvc\nclass OrderControllerTest {\n\n    @Autowired\n    lateinit var mockMvc: MockMvc\n\n    @Autowired\n    lateinit var repository: InMemoryOrderRepository\n\n    @Autowired\n    lateinit var shipmentRepository: InMemoryShipmentRepository\n\n    @BeforeEach\n    fun reset() {\n        repository.clear()\n        shipmentRepository.clear()\n    }\n\n    private fun createOrder(orderId: String, amount: String = \"49.90\") =\n        post(\"/orders\")\n            .contentType(MediaType.APPLICATION_JSON)\n            .content(\n                \"\"\"{\"orderId\":\"$orderId\",\"customerId\":\"C-1\",\"amount\":$amount,\"currency\":\"EUR\"}\"\"\",\n            )\n\n    private fun cancelOrder(orderId: String) =\n        post(\"/orders/$orderId/cancel\")\n            .contentType(MediaType.APPLICATION_JSON)\n\n    @Test\n    fun `creates an order and returns 201`() {\n        mockMvc.perform(createOrder(\"O-1\"))\n            .andExpect(status().isCreated)\n            .andExpect(jsonPath(\"$.orderId\").value(\"O-1\"))\n            .andExpect(jsonPath(\"$.status\").value(\"ACTIVE\"))\n    }\n\n    @Test\n    fun `reads back a created order`() {\n        mockMvc.perform(createOrder(\"O-2\")).andExpect(status().isCreated)\n\n        mockMvc.perform(get(\"/orders/O-2\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.currency\").value(\"EUR\"))\n            .andExpect(jsonPath(\"$.status\").value(\"ACTIVE\"))\n    }\n\n    @Test\n    fun `returns 404 with the error envelope for an unknown order`() {\n        mockMvc.perform(get(\"/orders/does-not-exist\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_NOT_FOUND\"))\n            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n    }\n\n    @Test\n    fun `returns 409 with the error envelope for a duplicate order id`() {\n        mockMvc.perform(createOrder(\"O-3\")).andExpect(status().isCreated)\n\n        mockMvc.perform(createOrder(\"O-3\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_ALREADY_EXISTS\"))\n            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n    }\n\n    @Test\n    fun `cancels an active order and returns 200`() {\n        mockMvc.perform(createOrder(\"O-cancel-1\")).andExpect(status().isCreated)\n\n        mockMvc.perform(cancelOrder(\"O-cancel-1\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.orderId\").value(\"O-cancel-1\"))\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n    }\n\n    @Test\n    fun `cancels an active order and cancels its created shipments`() {\n        mockMvc.perform(createOrder(\"O-cancel-2\")).andExpect(status().isCreated)\n\n        // Create a shipment for the order\n        mockMvc.perform(\n            post(\"/shipments\")\n                .contentType(MediaType.APPLICATION_JSON)\n                .content(\"\"\"{\"shipmentId\":\"S-cancel-1\",\"orderId\":\"O-cancel-2\",\"carrier\":\"DHL\"}\"\"\")\n        ).andExpect(status().isCreated)\n\n        // Cancel the order\n        mockMvc.perform(cancelOrder(\"O-cancel-2\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n\n        // Verify the shipment is also cancelled\n        mockMvc.perform(get(\"/shipments/S-cancel-1\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n    }\n\n    @Test\n    fun `cancelling an already-cancelled order succeeds idempotently`() {\n        mockMvc.perform(createOrder(\"O-cancel-3\")).andExpect(status().isCreated)\n\n        // First cancel\n        mockMvc.perform(cancelOrder(\"O-cancel-3\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n\n        // Second cancel should also succeed\n        mockMvc.perform(cancelOrder(\"O-cancel-3\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n\n        // Verify order is still cancelled\n        mockMvc.perform(get(\"/orders/O-cancel-3\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n    }\n\n    @Test\n    fun `cancelling an order with a confirmed shipment fails with 409 and changes nothing`() {\n        mockMvc.perform(createOrder(\"O-cancel-4\")).andExpect(status().isCreated)\n\n        // Create a shipment and manually set it to CONFIRMED\n        val shipment = Shipment(\n            shipmentId = \"S-cancel-2\",\n            orderId = \"O-cancel-4\",\n            carrier = \"DHL\",\n            status = ShipmentStatus.CONFIRMED\n        )\n        shipmentRepository.save(shipment)\n\n        // Try to cancel the order\n        mockMvc.perform(cancelOrder(\"O-cancel-4\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_HAS_CONFIRMED_SHIPMENT\"))\n\n        // Verify order is still ACTIVE\n        mockMvc.perform(get(\"/orders/O-cancel-4\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"ACTIVE\"))\n\n        // Verify shipment is still CONFIRMED\n        mockMvc.perform(get(\"/shipments/S-cancel-2\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n    }\n\n    @Test\n    fun `cancelling a non-existent order returns 404`() {\n        mockMvc.perform(cancelOrder(\"O-does-not-exist\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_NOT_FOUND\"))\n    }\n\n    @Test\n    fun `creating a shipment for a cancelled order fails with 409`() {\n        mockMvc.perform(createOrder(\"O-cancel-5\")).andExpect(status().isCreated)\n\n        // Cancel the order\n        mockMvc.perform(cancelOrder(\"O-cancel-5\"))\n            .andExpect(status().isOk)\n\n        // Try to create a shipment for the cancelled order\n        mockMvc.perform(\n            post(\"/shipments\")\n                .contentType(MediaType.APPLICATION_JSON)\n                .content(\"\"\"{\"shipmentId\":\"S-cancel-3\",\"orderId\":\"O-cancel-5\",\"carrier\":\"DHL\"}\"\"\")\n        ).andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_CANCELLED\"))\n    }\n}"}}}
