ble shipmentId: String): Shipment =\n        repository.findById(shipmentId)\n            ?: throw ResourceNotFoundException(\n                ErrorCode.SHIPMENT_NOT_FOUND,\n                \"No shipment with id '$shipmentId'\",\n            )\n\n    @GetMapping\n    fun list(): List<Shipment> = repository.findAll()\n}\n","structuredPatch":[{"oldStart":51,"oldLines":6,"newStart":51,"newLines":31,"lines":["                 \"No shipment with id '$shipmentId'\",","             )"," ","+    @PostMapping(\"/{shipmentId}/confirm\")","+    fun confirm(@PathVariable shipmentId: String): Shipment {","+        val shipment = repository.findById(shipmentId)","+            ?: throw ResourceNotFoundException(","+                ErrorCode.SHIPMENT_NOT_FOUND,","+                \"No shipment with id '$shipmentId'\",","+            )","+","+        if (shipment.status == ShipmentStatus.CANCELLED) {","+            throw ConflictException(","+                ErrorCode.SHIPMENT_INVALID_STATE,","+                \"Cannot confirm a shipment in CANCELLED status\",","+            )","+        }","+","+        // If already CONFIRMED, this is idempotent - just return it unchanged","+        if (shipment.status == ShipmentStatus.CONFIRMED) {","+            return shipment","+        }","+","+        // Transition CREATED -> CONFIRMED","+        val confirmed = shipment.copy(status = ShipmentStatus.CONFIRMED)","+        return repository.save(confirmed)","+    }","+","     @GetMapping","     fun list(): List<Shipment> = repository.findAll()"," }"]}],"userModified":false,"replaceAll":false}}
