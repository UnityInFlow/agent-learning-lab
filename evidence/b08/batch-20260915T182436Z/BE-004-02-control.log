derId'\",\n            )\n\n    @PostMapping(\"/{orderId}/cancel\")\n    fun cancel(@PathVariable orderId: String): ResponseEntity<Order> {\n        val order = repository.findById(orderId)\n            ?: throw ResourceNotFoundException(\n                ErrorCode.ORDER_NOT_FOUND,\n                \"No order with id '$orderId'\",\n            )\n\n        // If already cancelled, succeed without changes (idempotent)\n        if (order.status == OrderStatus.CANCELLED) {\n            return ResponseEntity.ok(order)\n        }\n\n        // Check if any shipment is CONFIRMED - if so, reject the entire operation\n        val allShipments = shipmentRepository.findAll()\n        val orderShipments = allShipments.filter { it.orderId == orderId }\n        if (orderShipments.any { it.status == ShipmentStatus.CONFIRMED }) {\n            throw ConflictException(\n                ErrorCode.ORDER_CANNOT_BE_CANCELLED,\n                \"Cannot cancel order with id '$orderId' because it has confirmed shipments\",\n            )\n        }\n\n        // Cancel the order and all CREATED shipments\n        val cancelledOrder = order.copy(status = OrderStatus.CANCELLED)\n        repository.save(cancelledOrder)\n\n        // Cancel all CREATED shipments\n        for (shipment in orderShipments) {\n            if (shipment.status == ShipmentStatus.CREATED) {\n                val cancelledShipment = shipment.copy(status = ShipmentStatus.CANCELLED)\n                shipmentRepository.save(cancelledShipment)\n            }\n        }\n\n        return ResponseEntity.ok(cancelledOrder)\n    }\n\n    @GetMapping\n    fun list(): List<Order> = repository.findAll()\n}"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":572,"cache_read_input_tokens":24377,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":572},"output_tokens":4,"service_tier":"standard","infe