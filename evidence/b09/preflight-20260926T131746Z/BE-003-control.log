confirmed shipments`() {\n        mockMvc.perform(createShipment(\"S-5\")).andExpect(status().isCreated)\n        mockMvc.perform(post(\"/shipments/S-5/confirm\")).andExpect(status().isOk)\n\n        mockMvc.perform(post(\"/shipments/S-5/confirm\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.shipmentId\").value(\"S-5\"))\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n    }\n\n    @Test\n    fun `rejects confirming a cancelled shipment`() {\n        repository.save(Shipment(\"S-6\", \"O-6\", \"DHL\", ShipmentStatus.CANCELLED))\n\n        mockMvc.perform(post(\"/shipments/S-6/confirm\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_CANNOT_BE_CONFIRMED\"))\n    }\n\n    @Test\n    fun `rejects confirming a non-existent shipment`() {\n        mockMvc.perform(post(\"/shipments/S-missing/confirm\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n    }\n}"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":768,"cache_read_input_tokens":24089,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":768},"output_tokens":6,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"4a8fed83-ef57-4b0f-a039-7e9b00f95f8d","uuid":"71c7f535-3c55-4f1e-a84e-6e58219df593","timestamp":"2026-09-26T13:22:02.446Z","request_id":"req_011CfS7zQxAGhfMn39toZ2Mk","wire_tool_inputs":{"toolu_018Va8VbDRPzTmVYzLUxwzCW":{"file_path":"/private/var/folders/jr/lwzz65cx5pndqqdgzhnym1pc0000gn/T/observatory-run-9e3060de-edf2-4342-ba92-a0c07b9c54c4/sample-service/src/test/kotlin/com/unityinflow/sample/shipment/ShipmentControllerTest.kt","old_string":"    @Test\n    