\n\n    @Test\n    fun `new order starts in ACTIVE status`() {\n        mockMvc.perform(createOrder(\"O-4\"))\n            .andExpect(status().isCreated)\n            .andExpect(jsonPath(\"$.status\").value(\"ACTIVE\"))\n    }\n\n    @Test\n    fun `cancel ACTIVE order succeeds and returns CANCELLED status`() {\n        mockMvc.perform(createOrder(\"O-5\")).andExpect(status().isCreated)\n\n        mockMvc.perform(post(\"/orders/O-5/cancel\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.orderId\").value(\"O-5\"))\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n    }\n\n    @Test\n    fun `cancel already CANCELLED order succeeds idempotently`() {\n        mockMvc.perform(createOrder(\"O-6\")).andExpect(status().isCreated)\n\n        // First cancel\n        mockMvc.perform(post(\"/orders/O-6/cancel\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n\n        // Second cancel should also succeed\n        mockMvc.perform(post(\"/orders/O-6/cancel\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n    }\n\n    @Test\n    fun `cancel unknown order returns 404`() {\n        mockMvc.perform(post(\"/orders/unknown/cancel\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_NOT_FOUND\"))\n    }\n\n    @Test\n    fun `cancel CREATED shipments when cancelling order`() {\n        mockMvc.perform(createOrder(\"O-7\")).andExpect(status().isCreated)\n\n        // Create two shipments for the order\n        shipmentRepository.save(Shipment(\"S-1\", \"O-7\", \"DHL\", ShipmentStatus.CREATED))\n        shipmentRepository.save(Shipment(\"S-2\", \"O-7\", \"FedEx\", ShipmentStatus.CREATED))\n\n        // Cancel the order\n        mockMvc.perform(post(\"/orders/O-7/cancel\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n\n        // Verify shipments are cancelled\n        mockMvc.perform(get(\"/shipments/S-1\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n\n        mockMvc.perform(get(\"/shipments/S-2\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n    }\n\n    @Test\n    fun `cancel order with CONFIRMED shipment returns 409 and changes nothing`() {\n        mockMvc.perform(createOrder(\"O-8\")).andExpect(status().isCreated)\n\n        // Create a CONFIRMED shipment\n        shipmentRepository.save(Shipment(\"S-3\", \"O-8\", \"DHL\", ShipmentStatus.CONFIRMED))\n\n        // Try to cancel the order\n        mockMvc.perform(post(\"/orders/O-8/cancel\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_CONFIRMED_SHIPMENT_EXISTS\"))\n\n        // Verify order is still ACTIVE\n        mockMvc.perform(get(\"/orders/O-8\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"ACTIVE\"))\n\n        // Verify shipment is still CONFIRMED\n        mockMvc.perform(get(\"/shipments/S-3\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n    }\n\n    @Test\n    fun `cancel order does not affect CANCELLED shipments`() {\n        mockMvc.perform(createOrder(\"O-9\")).andExpect(status().isCreated)\n\n        // Create a CANCELLED shipment and a CREATED shipment\n        shipmentRepository.save(Shipment(\"S-4\", \"O-9\", \"DHL\", ShipmentStatus.CANCELLED))\n        shipmentRepository.save(Shipment(\"S-5\", \"O-9\", \"FedEx\", ShipmentStatus.CREATED))\n\n        // Cancel the order\n        mockMvc.perform(post(\"/orders/O-9/cancel\"))\n            .andExpect(status().isOk)\n\n        // Verify CANCELLED shipment is still CANCELLED\n        mockMvc.perform(get(\"/shipments/S-4\"))\n  