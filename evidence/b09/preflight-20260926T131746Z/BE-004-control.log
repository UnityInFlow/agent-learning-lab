       .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n    }\n\n    @Test\n    fun `cancel nonexistent order fails with 404`() {\n        mockMvc.perform(cancelOrder(\"does-not-exist\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_NOT_FOUND\"))\n    }\n\n    @Test\n    fun `cancel order with confirmed shipment fails with 409 and changes nothing`() {\n        mockMvc.perform(createOrder(\"O-6\")).andExpect(status().isCreated)\n\n        // Add a confirmed shipment\n        val confirmedShipment = Shipment(\n            shipmentId = \"S-confirmed\",\n            orderId = \"O-6\",\n            carrier = \"DHL\",\n            status = ShipmentStatus.CONFIRMED,\n        )\n        shipmentRepository.save(confirmedShipment)\n\n        // Try to cancel - should fail\n        mockMvc.perform(cancelOrder(\"O-6\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_CANNOT_BE_CANCELLED\"))\n\n        // Verify order is still ACTIVE\n        mockMvc.perform(get(\"/orders/O-6\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"ACTIVE\"))\n\n        // Verify shipment is still CONFIRMED\n        mockMvc.perform(get(\"/shipments/S-confirmed\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n    }\n\n    @Test\n    fun `cancel order cancels created shipments`() {\n        mockMvc.perform(createOrder(\"O-7\")).andExpect(status().isCreated)\n\n        // Add two created shipments\n        val shipment1 = Shipment(\n            shipmentId = \"S-1-created\",\n            orderId = \"O-7\",\n            carrier = \"DHL\",\n            status = ShipmentStatus.CREATED,\n        )\n        val shipment2 = Shipment(\n            shipmentId = \"S-2-created\",\n            orderId = \"O-7\",\n            carrier = \