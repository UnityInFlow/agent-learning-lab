eated)\n\n        mockMvc.perform(createOrder(\"O-3\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_ALREADY_EXISTS\"))\n            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n    }\n}\n","structuredPatch":[{"oldStart":1,"oldLines":5,"newStart":1,"newLines":8,"lines":[" package com.unityinflow.sample.order"," ","+import com.unityinflow.sample.shipment.InMemoryShipmentRepository","+import com.unityinflow.sample.shipment.Shipment","+import com.unityinflow.sample.shipment.ShipmentStatus"," import org.junit.jupiter.api.BeforeEach"," import org.junit.jupiter.api.Test"," import org.springframework.beans.factory.annotation.Autowired"]},{"oldStart":29,"oldLines":8,"newStart":32,"newLines":14,"lines":["     @Autowired","     lateinit var repository: InMemoryOrderRepository"," ","+    @Autowired","+    lateinit var shipmentRepository: InMemoryShipmentRepository","+","     @BeforeEach","-    fun reset() = repository.clear()","+    fun reset() {","+        repository.clear()","+        shipmentRepository.clear()","+    }"," ","     private fun createOrder(orderId: String, amount: String = \"49.90\") =","         post(\"/orders\")"]},{"oldStart":72,"oldLines":4,"newStart":81,"newLines":101,"lines":["             .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_ALREADY_EXISTS\"))","             .andExpect(jsonPath(\"$.error.message\").isNotEmpty)","     }","+","+    @Test","+    fun `creates an order with ACTIVE status`() {","+        mockMvc.perform(createOrder(\"O-active\"))","+            .andExpect(status().isCreated)","+            .andExpect(jsonPath(\"$.status\").value(\"ACTIVE\"))","+    }","+","+    @Test","+    fun `cancels an ACTIVE order and returns the cancelled order`() {","+        mockMvc.perform(createOrder(\"O-cancel\")).andExpect(status().isCreated)","+","+        mockMvc.perform(post(\"/orders/O-cancel/cancel\"))","+            .andExpect(status().isOk)","+            .andExpect(jso