sage\").isNotEmpty)\n    }\n\n    @Test\n    fun `creates an order with ACTIVE status`() {\n        mockMvc.perform(createOrder(\"O-active\"))\n            .andExpect(status().isCreated)\n            .andExpect(jsonPath(\"$.status\").value(\"ACTIVE\"))\n    }\n\n    @Test\n    fun `cancels an ACTIVE order and returns the cancelled order`() {\n        mockMvc.perform(createOrder(\"O-cancel\")).andExpect(status().isCreated)\n\n        mockMvc.perform(post(\"/orders/O-cancel/cancel\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.orderId\").value(\"O-cancel\"))\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n    }\n\n    @Test\n    fun `cancels CREATED shipments when cancelling an order`() {\n        // Create order and shipments\n        mockMvc.perform(createOrder(\"O-shipments\")).andExpect(status().isCreated)\n        shipmentRepository.save(Shipment(\"S-1\", \"O-shipments\", \"DHL\", ShipmentStatus.CREATED))\n        shipmentRepository.save(Shipment(\"S-2\", \"O-shipments\", \"UPS\", ShipmentStatus.CREATED))\n\n        // Cancel order\n        mockMvc.perform(post(\"/orders/O-shipments/cancel\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n\n        // Verify shipments are cancelled\n        mockMvc.perform(get(\"/shipments/S-1\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n        mockMvc.perform(get(\"/shipments/S-2\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n    }\n\n    @Test\n    fun `cancelling an already CANCELLED order succeeds without changes`() {\n        mockMvc.perform(createOrder(\"O-twice\")).andExpect(status().isCreated)\n\n        // First cancel\n        mockMvc.perform(post(\"/orders/O-twice/cancel\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CAN