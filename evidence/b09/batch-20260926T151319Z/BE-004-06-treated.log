de\").value(\"ORDER_ALREADY_EXISTS\"))\n            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n    }\n}\n","structuredPatch":[{"oldStart":1,"oldLines":5,"newStart":1,"newLines":8,"lines":[" package com.unityinflow.sample.order"," ","+import com.unityinflow.sample.shipment.InMemoryShipmentRepository","+import com.unityinflow.sample.shipment.Shipment","+import com.unityinflow.sample.shipment.ShipmentStatus"," import org.junit.jupiter.api.BeforeEach"," import org.junit.jupiter.api.Test"," import org.springframework.beans.factory.annotation.Autowired"]},{"oldStart":29,"oldLines":8,"newStart":32,"newLines":14,"lines":["     @Autowired","     lateinit var repository: InMemoryOrderRepository"," ","+    @Autowired","+    lateinit var shipmentRepository: InMemoryShipmentRepository","+","     @BeforeEach","-    fun reset() = repository.clear()","+    fun reset() {","+        repository.clear()","+        shipmentRepository.clear()","+    }"," ","     private fun createOrder(orderId: String, amount: String = \"49.90\") =","         post(\"/orders\")"]},{"oldStart":39,"oldLines":6,"newStart":48,"newLines":10,"lines":["                 \"\"\"{\"orderId\":\"$orderId\",\"customerId\":\"C-1\",\"amount\":$amount,\"currency\":\"EUR\"}\"\"\",","             )"," ","+    private fun cancelOrder(orderId: String) =","+        post(\"/orders/$orderId/cancel\")","+            .contentType(MediaType.APPLICATION_JSON)","+","     @Test","     fun `creates an order and returns 201`() {","         mockMvc.perform(createOrder(\"O-1\"))"]},{"oldStart":72,"oldLines":4,"newStart":85,"newLines":103,"lines":["             .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_ALREADY_EXISTS\"))","             .andExpect(jsonPath(\"$.error.message\").isNotEmpty)","     }","+","+    @Test","+    fun `newly created order has ACTIVE status`() {","+        mockMvc.perform(createOrder(\"O-4\"))","+            .andExpect(status().isCreated)","+            .andExpect(jsonPath(\"$.status\").value(\"AC