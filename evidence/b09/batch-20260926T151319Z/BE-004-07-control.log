2 = shipmentRepository.findById(\"S-2\")!!\n        assert(s1.status == ShipmentStatus.CANCELLED)\n        assert(s2.status == ShipmentStatus.CANCELLED)\n    }\n\n    @Test\n    fun `cancel fails with 409 if any shipment is CONFIRMED`() {\n        mockMvc.perform(createOrder(\"O-7\")).andExpect(status().isCreated)\n        shipmentRepository.save(\n            Shipment(\"S-3\", \"O-7\", \"DHL\", ShipmentStatus.CREATED)\n        )\n        shipmentRepository.save(\n            Shipment(\"S-4\", \"O-7\", \"UPS\", ShipmentStatus.CONFIRMED)\n        )\n\n        mockMvc.perform(post(\"/orders/O-7/cancel\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_HAS_CONFIRMED_SHIPMENT\"))\n            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n\n        // Verify order and shipments are unchanged\n        val order = repository.findById(\"O-7\")!!\n        assert(order.status == OrderStatus.ACTIVE)\n        val s3 = shipmentRepository.findById(\"S-3\")!!\n        assert(s3.status == ShipmentStatus.CREATED)\n        val s4 = shipmentRepository.findById(\"S-4\")!!\n        assert(s4.status == ShipmentStatus.CONFIRMED)\n    }\n\n    @Test\n    fun `cancelling an already-cancelled order succeeds and changes nothing`() {\n        mockMvc.perform(createOrder(\"O-8\")).andExpect(status().isCreated)\n        mockMvc.perform(post(\"/orders/O-8/cancel\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n\n        // Retry the cancel\n        mockMvc.perform(post(\"/orders/O-8/cancel\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n    }\n\n    @Test\n    fun `cancel returns 404 for unknown order`() {\n        mockMvc.perform(post(\"/orders/unknown-order/cancel\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_NOT_FOUND\"))\n            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n    }\n}"}}}
