rm(post(\"/shipments/S-5/confirm\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n\n        // Second confirm (retry) should also succeed\n        mockMvc.perform(post(\"/shipments/S-5/confirm\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.shipmentId\").value(\"S-5\"))\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n    }\n\n    @Test\n    fun `rejects confirming a CANCELLED shipment with 409`() {\n        // Create a shipment\n        mockMvc.perform(createShipment(\"S-6\")).andExpect(status().isCreated)\n\n        // Manually set it to CANCELLED in the repository\n        val cancelled = Shipment(\"S-6\", \"O-1\", \"DHL\", ShipmentStatus.CANCELLED)\n        repository.save(cancelled)\n\n        // Try to confirm it\n        mockMvc.perform(post(\"/shipments/S-6/confirm\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_CANNOT_BE_CONFIRMED\"))\n    }\n\n    @Test\n    fun `rejects confirming a non-existent shipment with 404`() {\n        mockMvc.perform(post(\"/shipments/S-missing/confirm\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n    }\n}"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":672,"cache_read_input_tokens":21151,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":672},"output_tokens":4,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"5445dfba-4ed0-4af4-9f4f-92982f9451f4","uuid":"d963b586-0e5e-4910-b06e-834ebd45d629","timestamp":"2026-09-26T18:17:00.453Z","request_id":"req_011CfSWUp34zHA8zr19giKuh","wire_tool_inputs":{"toolu_016X