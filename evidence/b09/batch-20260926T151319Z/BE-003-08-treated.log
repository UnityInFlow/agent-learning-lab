ED`() {\n        mockMvc.perform(createShipment(\"S-4\")).andExpect(status().isCreated)\n\n        mockMvc.perform(confirmShipment(\"S-4\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.shipmentId\").value(\"S-4\"))\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n    }\n\n    @Test\n    fun `confirm is idempotent on already confirmed shipment`() {\n        mockMvc.perform(createShipment(\"S-5\")).andExpect(status().isCreated)\n        mockMvc.perform(confirmShipment(\"S-5\")).andExpect(status().isOk)\n\n        // Confirm again\n        mockMvc.perform(confirmShipment(\"S-5\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.shipmentId\").value(\"S-5\"))\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n    }\n\n    @Test\n    fun `rejects confirming a cancelled shipment with error envelope`() {\n        // Insert a cancelled shipment directly to repository\n        repository.save(\n            Shipment(\n                shipmentId = \"S-cancelled\",\n                orderId = \"O-1\",\n                carrier = \"DHL\",\n                status = ShipmentStatus.CANCELLED,\n            ),\n        )\n\n        mockMvc.perform(confirmShipment(\"S-cancelled\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_INVALID_STATE_TRANSITION\"))\n    }\n\n    @Test\n    fun `rejects confirming a non-existent shipment with error envelope`() {\n        mockMvc.perform(confirmShipment(\"S-missing\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n    }\n}","originalFile":"package com.unityinflow.sample.shipment\n\nimport org.junit.jupiter.api.BeforeEach\nimport org.junit.jupiter.api.Test\nimport org.springframework.beans.factory.annotation.Autowired\nimport org.springframework.boot.test.context.SpringBootTest\nimport org.springframework.