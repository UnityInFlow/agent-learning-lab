        mockMvc.perform(createOrder(\"O-8\")).andExpect(status().isCreated)\n        shipmentRepository.save(\n            Shipment(\"S-3\", \"O-8\", \"DHL\", ShipmentStatus.CONFIRMED)\n        )\n\n        // Try to cancel - should fail\n        mockMvc.perform(cancelOrder(\"O-8\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_CANNOT_BE_CANCELLED\"))\n            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n\n        // Verify order is still ACTIVE\n        mockMvc.perform(get(\"/orders/O-8\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"ACTIVE\"))\n    }\n\n    @Test\n    fun `cancelling returns 404 for non-existent order`() {\n        mockMvc.perform(cancelOrder(\"O-nonexistent\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_NOT_FOUND\"))\n            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n    }\n\n    @Test\n    fun `cancelling an order with both CREATED and CONFIRMED shipments fails`() {\n        // Create order with one CREATED and one CONFIRMED shipment\n        mockMvc.perform(createOrder(\"O-9\")).andExpect(status().isCreated)\n        shipmentRepository.save(\n            Shipment(\"S-4\", \"O-9\", \"DHL\", ShipmentStatus.CREATED)\n        )\n        shipmentRepository.save(\n            Shipment(\"S-5\", \"O-9\", \"UPS\", ShipmentStatus.CONFIRMED)\n        )\n\n        // Try to cancel - should fail\n        mockMvc.perform(cancelOrder(\"O-9\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_CANNOT_BE_CANCELLED\"))\n\n        // Verify the CREATED shipment is still CREATED (not cancelled)\n        val s4 = shipmentRepository.findById(\"S-4\")\n        assert(s4?.status == ShipmentStatus.CREATED)\n    }\n}"}}}
