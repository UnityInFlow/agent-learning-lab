succeeds without changing it`() {\n        mockMvc.perform(createShipment(\"S-confirm-2\")).andExpect(status().isCreated)\n        mockMvc.perform(\n            post(\"/shipments/S-confirm-2/confirm\")\n                .contentType(MediaType.APPLICATION_JSON)\n        ).andExpect(status().isOk)\n\n        // Confirm again (idempotent retry)\n        mockMvc.perform(\n            post(\"/shipments/S-confirm-2/confirm\")\n                .contentType(MediaType.APPLICATION_JSON)\n        )\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CONFIRMED\"))\n    }\n\n    @Test\n    fun `rejects confirming a cancelled shipment with 409`() {\n        mockMvc.perform(createShipment(\"S-confirm-3\")).andExpect(status().isCreated)\n\n        // Manually set shipment to CANCELLED in repository\n        val shipment = repository.findById(\"S-confirm-3\")!!\n        repository.save(shipment.copy(status = ShipmentStatus.CANCELLED))\n\n        mockMvc.perform(\n            post(\"/shipments/S-confirm-3/confirm\")\n                .contentType(MediaType.APPLICATION_JSON)\n        )\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_INVALID_STATE\"))\n    }\n\n    @Test\n    fun `rejects confirming a non-existent shipment with 404`() {\n        mockMvc.perform(\n            post(\"/shipments/S-missing/confirm\")\n                .contentType(MediaType.APPLICATION_JSON)\n        )\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n    }\n}"}}}
