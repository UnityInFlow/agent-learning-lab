{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DDzdunPaAwpjrcZ7dYCPn4","type":"tool_result","content":"85\t    fun `lists shipments in id order`() {\n86\t        mockMvc.perform(createShipment(\"S-b\")).andExpect(status().isCreated)\n87\t        mockMvc.perform(createShipment(\"S-a\")).andExpect(status().isCreated)\n88\t\n89\t        mockMvc.perform(get(\"/shipments\"))\n90\t            .andExpect(status().isOk)\n91\t            .andExpect(jsonPath(\"$[0].shipmentId\").value(\"S-a\"))\n92\t            .andExpect(jsonPath(\"$[1].shipmentId\").value(\"S-b\"))\n93\t    }\n94\t\n95\t    @Test\n96\t    fun `rejects shipment creation for cancelled order with 409`() {\n97\t        // Create a cancelled order\n98\t        orderRepository.save(\n99\t            Order(\n100\t                orderId = \"O-cancelled\",\n101\t                customerId = \"C-1\",\n102\t                amount = BigDecimal(\"49.90\"),\n103\t                currency = \"EUR\",\n104\t                status = OrderStatus.CANCELLED,\n105\t            ),\n106\t        )\n107\t\n108\t        // Try to create a shipment for the cancelled order\n109\t        mockMvc.perform(\n110\t            post(\"/shipments\")\n111\t                .contentType(MediaType.APPLICATION_JSON)\n112\t                .content(\n113\t                    \"\"\"{\"shipmentId\":\"S-cancelled\",\"orderId\":\"O-cancelled\",\"carrier\":\"DHL\"}\"\"\",\n114\t                ),\n115\t        )\n116\t            .andExpect(status().isConflict)\n117\t            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_CANCELLED\"))\n118\t            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n119\t    }\n120\t}\n121\t"}]},"parent_tool_use_id":null,"session_id":"83b4d0d6-98a2-4d8b-833c-b182dc09618e","uuid":"b63e7481-10a2-46bf-80b7-7b48e7672319","timestamp":"2026-09-26T19:52:38.849Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/jr/lwzz65cx5pndqqdgzhnym1pc0000gn/T/observatory-run-5bc8b735-6d49-4fed-89e6-194fafc4350f/sample-service/src/test/kotlin/com/unityinflow/sample/shipment/ShipmentControllerTest.kt","content":"    fun `lists shipments in id order`() {\n        mockMvc.perform(createShipment(\"S-b\")).andExpect(status().isCreated)\n        mockMvc.perform(createShipment(\"S-a\")).andExpect(status().isCreated)\n\n        mockMvc.perform(get(\"/shipments\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$[0].shipmentId\").value(\"S-a\"))\n            .andExpect(jsonPath(\"$[1].shipmentId\").value(\"S-b\"))\n    }\n\n    @Test\n    fun `rejects shipment creation for cancelled order with 409`() {\n        // Create a cancelled order\n        orderRepository.save(\n            Order(\n                orderId = \"O-cancelled\",\n                customerId = \"C-1\",\n                amount = BigDecimal(\"49.90\"),\n                currency = \"EUR\",\n                status = OrderStatus.CANCELLED,\n            ),\n        )\n\n        // Try to create a shipment for the cancelled order\n        mockMvc.perform(\n            post(\"/shipments\")\n                .contentType(MediaType.APPLICATION_JSON)\n                .content(\n                    \"\"\"{\"shipmentId\":\"S-cancelled\",\"orderId\":\"O-cancelled\",\"carrier\":\"DHL\"}\"\"\",\n                ),\n        )\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_CANCELLED\"))\n            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n    }\n}\n","numLines":37,"startLine":85,"totalLines":121}}}
