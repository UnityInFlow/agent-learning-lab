 mockMvc.perform(createShipment(\"S-1\"))\n            .andExpect(status().isCreated)\n            .andExpect(jsonPath(\"$.shipmentId\").value(\"S-1\"))\n            .andExpect(jsonPath(\"$.status\").value(\"CREATED\"))\n    }\n\n    @Test\n    fun `rejects a duplicate shipment id with the error envelope`() {\n        mockMvc.perform(createShipment(\"S-2\")).andExpect(status().isCreated)\n\n        mockMvc.perform(createShipment(\"S-2\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_ALREADY_EXISTS\"))\n    }\n\n    @Test\n    fun `returns a shipment by id`() {\n        mockMvc.perform(createShipment(\"S-3\")).andExpect(status().isCreated)\n\n        mockMvc.perform(get(\"/shipments/S-3\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.carrier\").value(\"DHL\"))\n    }\n\n    @Test\n    fun `reports an unknown shipment through the error envelope`() {\n        mockMvc.perform(get(\"/shipments/S-missing\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"SHIPMENT_NOT_FOUND\"))\n    }\n\n    @Test\n    fun `lists shipments in id order`() {\n        mockMvc.perform(createShipment(\"S-b\")).andExpect(status().isCreated)\n        mockMvc.perform(createShipment(\"S-a\")).andExpect(status().isCreated)\n\n        mockMvc.perform(get(\"/shipments\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$[0].shipmentId\").value(\"S-a\"))\n            .andExpect(jsonPath(\"$[1].shipmentId\").value(\"S-b\"))\n    }\n}\n","structuredPatch":[{"oldStart":1,"oldLines":5,"newStart":1,"newLines":6,"lines":[" package com.unityinflow.sample.shipment"," ","+import com.unityinflow.sample.order.InMemoryOrderRepository"," import org.junit.jupiter.api.BeforeEach"," import org.junit.jupiter.api.Test"," import org.springframework.beans.factory.annotation.Autowired"]},{"oldStart":28,"oldLines":8,"newStart":29,"newLines":14,"lines":["     @Autowired","     lateinit var repository: InMemoryShipmentRepository"," ","+    @Autowired","+    lateinit var orderRepository: InMemoryOrderRepository","+","     @BeforeEach","-    fun reset() = repository.clear()","+    fun reset() {","+        repository.clear()","+        orderRepository.clear()","+    }"," ","     private fun createShipment(shipmentId: String) =","         post(\"/shipments\")"]},{"oldStart":81,"oldLines":4,"newStart":88,"newLines":26,"lines":["             .andExpect(jsonPath(\"$[0].shipmentId\").value(\"S-a\"))","             .andExpect(jsonPath(\"$[1].shipmentId\").value(\"S-b\"))","     }","+","+    @Test","+    fun `rejects shipment creation for cancelled order`() {","+        // Create and cancel an order","+        mockMvc.perform(","+            post(\"/orders\")","+                .contentType(MediaType.APPLICATION_JSON)","+                .content(\"\"\"{\"orderId\":\"O-cancelled\",\"customerId\":\"C-1\",\"amount\":\"49.90\",\"currency\":\"EUR\"}\"\"\")","+        ).andExpect(status().isCreated)","+","+        mockMvc.perform(post(\"/orders/O-cancelled/cancel\"))","+            .andExpect(status().isOk)","+","+        // Try to create a shipment for the cancelled order","+        mockMvc.perform(","+            post(\"/shipments\")","+                .contentType(MediaType.APPLICATION_JSON)","+                .content(\"\"\"{\"shipmentId\":\"S-cancelled\",\"orderId\":\"O-cancelled\",\"carrier\":\"DHL\"}\"\"\")","+        )","+            .andExpect(status().isConflict)","+            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_IS_CANCELLED\"))","+    }"," }"]}],"userModified":false,"replaceAll":false}}
