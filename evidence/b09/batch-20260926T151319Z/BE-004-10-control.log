entRepository.save(\n            Shipment(\n                shipmentId = \"S-1\",\n                orderId = \"O-6\",\n                carrier = \"DHL\",\n                status = ShipmentStatus.CONFIRMED,\n            ),\n        )\n\n        mockMvc.perform(post(\"/orders/O-6/cancel\"))\n            .andExpect(status().isConflict)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_CANNOT_CANCEL_CONFIRMED\"))\n            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n\n        // Verify order is still ACTIVE\n        mockMvc.perform(get(\"/orders/O-6\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"ACTIVE\"))\n    }\n\n    @Test\n    fun `cancel returns 404 for non-existent order`() {\n        mockMvc.perform(post(\"/orders/does-not-exist/cancel\"))\n            .andExpect(status().isNotFound)\n            .andExpect(jsonPath(\"$.error.code\").value(\"ORDER_NOT_FOUND\"))\n            .andExpect(jsonPath(\"$.error.message\").isNotEmpty)\n    }\n\n    @Test\n    fun `cancelling an active order cancels its created shipments`() {\n        mockMvc.perform(createOrder(\"O-7\")).andExpect(status().isCreated)\n\n        // Create two shipments with CREATED status\n        shipmentRepository.save(\n            Shipment(\n                shipmentId = \"S-2\",\n                orderId = \"O-7\",\n                carrier = \"DHL\",\n                status = ShipmentStatus.CREATED,\n            ),\n        )\n        shipmentRepository.save(\n            Shipment(\n                shipmentId = \"S-3\",\n                orderId = \"O-7\",\n                carrier = \"FedEx\",\n                status = ShipmentStatus.CREATED,\n            ),\n        )\n\n        mockMvc.perform(post(\"/orders/O-7/cancel\"))\n            .andExpect(status().isOk)\n\n        // Verify both shipments are now CANCELLED\n        mockMvc.perform(get(\"/shipments/S-2\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n\n        mockMvc.perform(get(\"/shipments/S-3\"))\n            .andExpect(status().isOk)\n            .andExpect(jsonPath(\"$.status\").value(\"CANCELLED\"))\n    }\n}"}}}
