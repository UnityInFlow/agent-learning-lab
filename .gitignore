.DS_Store
*.local
runs/raw/

# memtrace local store — machine-specific runtime state, never shared
.memdb/

# Arm H scratch worktrees (evidence/b04/armH-*/wt-*): 35 MB of full source trees, one per run.
# KEPT ON DISK, not deleted -- section 6 forbids deleting evidence. What is committed instead is
# everything derived from them that a stranger needs: results.tsv, the per-run .jsonl transcripts,
# provenance.txt, and pom-diffs/ (one diff per run; a zero-byte diff IS the HELD evidence).
evidence/b04/armH-*/wt-*/

# lab probe scratch worktrees (nested git repos; a gitlink is not evidence) - stop 11
evidence/**/wt-*/

# The E-007 batch driver's PID lockfile: runtime state, never evidence.
evidence/p04b/lab-4b4/.batch.lock

# The E-008 fourth-cell batch driver's PID lockfile: runtime state, never evidence.
evidence/p04b/lab-4b4/fourth-cell/.batch.lock

# The B9 preflight/batch PID lockfile, shared by both drivers on purpose: runtime state, never
# evidence. The b08 and b08a locks were never added here and never committed either; this entry
# exists so a `git add -A` cannot turn a live lock into a tracked file mid-batch.
evidence/b09/.batch.lock

# The B9 router-permission probe's three ARENAS are throwaway git repos the probe itself inits, so
# a gitlink is not evidence — the same reason stop 11's wt-*/ entry exists above. The probe's
# EVIDENCE is its logs, its RESULT.tsv and the router log it produced, and those ARE tracked.
evidence/b09/router-permission-probe-*/baseline/
evidence/b09/router-permission-probe-*/overlay-permission/
evidence/b09/router-permission-probe-*/cli-allowlist/

# Python bytecode from `python3 -m py_compile` on tools/ — a verification step, not an artifact
__pycache__/

# Mid-flight batch and preflight logs are appended to while a run is live; committing one
# records a partial file that reads like a finished run. The evidence that matters — the run
# record, the init read-back, the manifest and OBSERVED.md — is committed explicitly.
evidence/b08a/preflight-launch.out

# THE FILE NAMED `1`, AND WHY AN IGNORE RULE RATHER THAN A SIXTH DELETION.
# tools/codex-score.sh:293-294 treats LAB_SCORE_DRY_RUN as the PATH the prompt is copied to, not
# as a boolean. §0a's table says to run it as `LAB_SCORE_DRY_RUN=1`, so every preflight writes a
# ~28 KB prompt to a file literally named `1` in the repository root. It has been committed by
# accident FIVE times (0dac30b, 9708073, 5f1b83d, 1031a99, a447799) and explicitly removed once
# (ad94999, whose message reads "the LAB_SCORE_DRY_RUN=1 artefact, committed twice"), and it
# happened again at the stop-21 preflight. A deletion fixes an instance; this fixes the class.
# The artefact itself is KEPT, under evidence/, wherever a session's preflight is recorded.
/1
/score-prompt-dry-run.md

# A pid lock is live process state, never evidence. evidence/b10/.batch.lock was committed at
# bdccd1b and had to be deleted at 89f04ea; committing one means a later `git checkout` can
# resurrect a lock for a pid that is long gone, which is the one input the batch driver's exit-8
# guard trusts.
evidence/*/.batch.lock
evidence/b10/.df.lock
